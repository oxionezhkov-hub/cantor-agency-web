<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Выгрузка Avito — Cantor Agency</title>
<meta name="robots" content="noindex, nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;600;700;900&family=Geologica:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="icon" type="image/svg+xml" href="/Frame 1000011449.svg">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --red:#E8391D;--red-dark:#C42D13;--red-light:#FF6347;
  --dark:#0F0F0F;--dark2:#1A1A1A;--text:#1C1C1C;--muted:#888;
  --bg:#F6F5F2;--white:#FFFFFF;--border:#E2E0DC;
  --accent-bg:#FFF3F0;--warm-bg:#FFFBF9;
  --shadow-sm:0 2px 8px rgba(0,0,0,0.06);
  --shadow-md:0 12px 40px rgba(0,0,0,0.1);
  --shadow-red:0 8px 28px rgba(232,57,29,0.28);
  --r-sm:6px;--r-md:10px;--r-lg:16px;--r-xl:20px;
  --green:#1e8449;--green-bg:#eafaf1;
  --amber:#9a6f00;--amber-bg:#fef9e7;
  --gray:#6b6b6b;--gray-bg:#f1f0ed;
  --red-text:#c0392b;--red-bg:#fdf2f2;
}
html{-webkit-text-size-adjust:100%}
body{font-family:'Geologica',sans-serif;color:var(--text);background:var(--bg);line-height:1.6;min-height:100vh;-webkit-font-smoothing:antialiased}
.hidden{display:none !important}
button{font-family:inherit}
input,textarea,select{font-family:inherit}

/* ── TOPBAR ── */
.topbar{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;border-bottom:1.5px solid var(--border);background:var(--white);position:sticky;top:0;z-index:20}
.brand{font-family:'Unbounded',sans-serif;font-weight:700;font-size:14px;letter-spacing:-0.01em;color:var(--dark);text-decoration:none;display:flex;align-items:center;gap:8px;background:none;border:none;cursor:pointer}
.topbar-right{display:flex;align-items:center;gap:10px}

/* ── BUTTONS ── */
.btn-red{background:var(--red);color:white;border:none;border-radius:var(--r-md);padding:10px 18px;font-size:13px;font-weight:700;cursor:pointer;transition:all 0.2s;white-space:nowrap}
.btn-red:hover{background:var(--red-dark)}
.btn-red:disabled{opacity:0.55;cursor:wait}
.btn-outline{background:white;color:var(--text);border:1.5px solid var(--border);border-radius:var(--r-md);padding:10px 18px;font-size:13px;font-weight:700;cursor:pointer;transition:all 0.18s;white-space:nowrap}
.btn-outline:hover{border-color:var(--red);color:var(--red)}
.btn-ghost-sm{background:none;border:1.5px solid var(--border);border-radius:var(--r-sm);padding:6px 11px;font-size:12px;font-weight:700;color:var(--muted);cursor:pointer;transition:all 0.15s;white-space:nowrap}
.btn-ghost-sm:hover{border-color:var(--red);color:var(--red)}
.btn-ghost-sm.danger:hover{border-color:#c0392b;color:#c0392b}

/* ── TOAST ── */
.toast{position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(16px);background:var(--dark);color:white;padding:12px 20px;border-radius:var(--r-md);font-size:13.5px;font-weight:600;box-shadow:var(--shadow-md);opacity:0;pointer-events:none;transition:all 0.25s ease;display:flex;align-items:center;gap:8px;z-index:200;max-width:80vw}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ── ADMIN GATE ── */
#adminGate{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}
.gate-card{width:100%;max-width:380px;background:var(--white);border:1.5px solid var(--border);border-radius:var(--r-xl);box-shadow:var(--shadow-md);padding:36px 30px;text-align:center}
.gate-card h1{font-family:'Unbounded',sans-serif;font-size:19px;font-weight:700;color:var(--dark);margin-bottom:8px;letter-spacing:-0.02em}
.gate-card p{font-size:13px;color:var(--muted);margin-bottom:22px;line-height:1.6}
.gate-card input{width:100%;border:1.5px solid var(--border);border-radius:var(--r-md);padding:13px 14px;font-size:15px;color:var(--text);outline:none;transition:border-color 0.2s;background:white;margin-bottom:12px;text-align:center;letter-spacing:0.1em}
.gate-card input:focus{border-color:var(--red)}
.gate-error{font-size:12px;color:var(--red);margin:-4px 0 14px;display:none}
.gate-error.show{display:block}

/* ── LAYOUT ── */
.wrap{max-width:1160px;margin:0 auto;padding:28px 24px 80px;display:grid;grid-template-columns:320px 1fr;gap:22px;align-items:start}
@media(max-width:860px){.wrap{grid-template-columns:1fr}}

.panel{background:var(--white);border:1.5px solid var(--border);border-radius:var(--r-lg);padding:18px}
.panel-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}
.panel-head h2{font-family:'Unbounded',sans-serif;font-size:15px;font-weight:700;color:var(--dark)}

/* ── ACCOUNTS LIST ── */
.acct-list{display:flex;flex-direction:column;gap:8px}
.acct-row{display:flex;align-items:center;gap:10px;border:1.5px solid var(--border);border-radius:var(--r-md);padding:11px 12px;cursor:pointer;transition:all 0.15s}
.acct-row:hover{border-color:var(--red)}
.acct-row.active{border-color:var(--red);background:var(--accent-bg)}
.acct-avatar{width:32px;height:32px;border-radius:50%;background:var(--dark);color:white;display:flex;align-items:center;justify-content:center;font-family:'Unbounded',sans-serif;font-weight:700;font-size:12px;flex-shrink:0}
.acct-info{flex:1;min-width:0}
.acct-name{font-size:13px;font-weight:700;color:var(--dark);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.acct-meta{font-size:11px;color:var(--muted);margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.empty-note{font-size:13px;color:var(--muted);padding:16px 4px;text-align:center;line-height:1.6}

/* ── DETAIL ── */
.field-row{margin-bottom:14px}
.field-row label{display:block;font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px}
.field-row input{width:100%;border:1.5px solid var(--border);border-radius:var(--r-md);padding:11px 13px;font-size:13.5px;outline:none;background:white}
.field-row input:focus{border-color:var(--red)}
.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:520px){.field-grid{grid-template-columns:1fr}}

.date-row{display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin:18px 0}
.date-row .field-row{margin-bottom:0;flex:1;min-width:150px}

.summary-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin:16px 0}
.stat-tile{background:var(--bg);border-radius:var(--r-md);padding:12px 14px}
.stat-tile .num{font-family:'Unbounded',sans-serif;font-size:20px;font-weight:700;color:var(--dark)}
.stat-tile .lbl{font-size:11px;color:var(--muted);margin-top:2px}

.err-box{background:var(--red-bg);color:var(--red-text);border-radius:var(--r-md);padding:12px 14px;font-size:12.5px;margin:14px 0;line-height:1.6}
.err-box ul{margin:6px 0 0 18px}

.runs-table{width:100%;border-collapse:collapse;font-size:12.5px;margin-top:10px}
.runs-table th{text-align:left;color:var(--muted);font-weight:700;font-size:11px;text-transform:uppercase;letter-spacing:0.03em;padding:6px 8px;border-bottom:1.5px solid var(--border)}
.runs-table td{padding:8px;border-bottom:1px solid var(--border);vertical-align:top}
.status-pill{display:inline-block;padding:2px 9px;border-radius:100px;font-size:10.5px;font-weight:700}
.status-ok{background:var(--green-bg);color:var(--green)}
.status-partial{background:var(--amber-bg);color:var(--amber)}
.status-failed{background:var(--red-bg);color:var(--red-text)}

.modal-overlay{position:fixed;inset:0;background:rgba(10,10,10,0.45);backdrop-filter:blur(3px);z-index:900;display:flex;align-items:center;justify-content:center;padding:20px}
.modal-card{width:100%;max-width:440px;background:var(--white);border-radius:var(--r-xl);box-shadow:var(--shadow-md);padding:26px}
.modal-card h3{font-family:'Unbounded',sans-serif;font-size:16px;margin-bottom:16px}
.modal-actions{display:flex;gap:8px;margin-top:18px}
.hint{font-size:11.5px;color:var(--muted);margin-top:-8px;margin-bottom:14px;line-height:1.5}

/* ── TABS ── */
.tabs{display:flex;gap:4px;border-bottom:1.5px solid var(--border);margin:18px 0 16px}
.tab-btn{background:none;border:none;padding:9px 4px;margin-right:18px;font-size:13px;font-weight:700;color:var(--muted);cursor:pointer;border-bottom:2px solid transparent;transition:all 0.15s}
.tab-btn:hover{color:var(--text)}
.tab-btn.active{color:var(--red);border-bottom-color:var(--red)}
.tab-pane{display:none}
.tab-pane.active{display:block}

/* ── OVERVIEW ── */
.ov-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:16px}
.ov-card{background:var(--bg);border-radius:var(--r-md);padding:13px 14px}
.ov-card .lbl{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.03em;margin-bottom:4px}
.ov-card .val{font-family:'Unbounded',sans-serif;font-size:18px;font-weight:700;color:var(--dark)}
.ov-card .sub{font-size:11.5px;color:var(--muted);margin-top:2px}
.profile-box{font-size:12.5px;color:var(--text);background:var(--warm-bg);border:1px solid var(--border);border-radius:var(--r-md);padding:12px 14px;margin-bottom:16px;line-height:1.7}
.profile-box b{color:var(--dark)}
.review-item{border-bottom:1px solid var(--border);padding:10px 0;font-size:12.5px}
.review-item:last-child{border-bottom:none}
.review-score{color:var(--amber);font-weight:700}

/* ── LISTINGS / DATA TABLES ── */
.data-table-wrap{overflow-x:auto;margin-top:4px}
.data-table{width:100%;border-collapse:collapse;font-size:12.5px;white-space:nowrap}
.data-table th{text-align:left;color:var(--muted);font-weight:700;font-size:10.5px;text-transform:uppercase;letter-spacing:0.03em;padding:7px 9px;border-bottom:1.5px solid var(--border);position:sticky;top:0;background:var(--white)}
.data-table td{padding:7px 9px;border-bottom:1px solid var(--border);vertical-align:top}
.data-table td.wrap-cell{white-space:normal;max-width:260px}
.data-table a{color:var(--red);text-decoration:none}
.data-table a:hover{text-decoration:underline}
.loading-note{font-size:12.5px;color:var(--muted);padding:14px 4px}

/* ── CHATS ── */
.chat-list{display:flex;flex-direction:column;gap:6px;max-height:520px;overflow-y:auto}
.chat-row{border:1.5px solid var(--border);border-radius:var(--r-md);padding:10px 12px;cursor:pointer;transition:all 0.15s}
.chat-row:hover{border-color:var(--red)}
.chat-row.active{border-color:var(--red);background:var(--accent-bg)}
.chat-row .ct-title{font-size:12.5px;font-weight:700;color:var(--dark);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chat-row .ct-preview{font-size:12px;color:var(--muted);margin-top:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chat-row .ct-date{font-size:10.5px;color:var(--muted);margin-top:3px}
.chat-split{display:grid;grid-template-columns:280px 1fr;gap:16px}
@media(max-width:760px){.chat-split{grid-template-columns:1fr}}
.thread{display:flex;flex-direction:column;gap:8px;max-height:520px;overflow-y:auto;padding:4px}
.bubble{max-width:78%;padding:9px 12px;border-radius:12px;font-size:12.5px;line-height:1.5}
.bubble.client{align-self:flex-start;background:var(--gray-bg);border-bottom-left-radius:3px}
.bubble.manager{align-self:flex-end;background:var(--accent-bg);border-bottom-right-radius:3px}
.bubble .b-meta{font-size:10px;color:var(--muted);margin-top:4px}
</style>
</head>
<body>

<div id="adminGate">
  <form id="gateForm" class="gate-card">
    <h1>Выгрузка Avito</h1>
    <p>Внутренний инструмент. Введите пароль доступа.</p>
    <input type="password" id="gatePassword" placeholder="Пароль" autocomplete="off" autofocus>
    <div class="gate-error" id="gateError">Неверный пароль</div>
    <button type="submit" class="btn-red" style="width:100%">Войти</button>
  </form>
</div>

<div id="app" class="hidden">
  <div class="topbar">
    <div class="brand">Cantor <span style="color:var(--red)">/ Avito</span></div>
    <div class="topbar-right">
      <button class="btn-outline" onclick="logout()">Выйти</button>
    </div>
  </div>

  <div class="wrap">
    <div class="panel">
      <div class="panel-head">
        <h2>Кабинеты</h2>
        <button class="btn-ghost-sm" onclick="openAccountModal()">+ Добавить</button>
      </div>
      <div class="acct-list" id="acctList"></div>
    </div>

    <div class="panel" id="detailPanel">
      <div class="empty-note" id="noAccountNote">Выберите кабинет слева или добавьте новый, чтобы сделать выгрузку.</div>
      <div id="detailContent" class="hidden">
        <div class="panel-head">
          <h2 id="detailName">—</h2>
          <div style="display:flex;gap:8px">
            <button class="btn-ghost-sm" onclick="editCurrentAccount()">Изменить</button>
            <button class="btn-ghost-sm danger" onclick="deleteCurrentAccount()">Удалить</button>
          </div>
        </div>
        <div style="font-size:12px;color:var(--muted);margin-bottom:6px">User ID: <span id="detailUserId">—</span></div>
        <div style="font-size:12px;color:var(--muted)">Последняя выгрузка: <span id="detailLastExport">никогда</span></div>

        <div class="date-row">
          <div class="field-row">
            <label>Период с</label>
            <input type="date" id="dateFrom" onchange="onPeriodChange()">
          </div>
          <div class="field-row">
            <label>Период по</label>
            <input type="date" id="dateTo" onchange="onPeriodChange()">
          </div>
        </div>

        <div class="tabs">
          <button class="tab-btn active" data-tab="overview" onclick="switchTab('overview')">Обзор</button>
          <button class="tab-btn" data-tab="listings" onclick="switchTab('listings')">Объявления</button>
          <button class="tab-btn" data-tab="chats" onclick="switchTab('chats')">Сообщения</button>
          <button class="tab-btn" data-tab="export" onclick="switchTab('export')">Экспорт в XLSX</button>
        </div>

        <div class="tab-pane active" id="tab-overview">
          <div id="overviewBox"><div class="loading-note">Загрузка…</div></div>
        </div>

        <div class="tab-pane" id="tab-listings">
          <div id="listingsBox"><div class="loading-note">Загрузка…</div></div>
        </div>

        <div class="tab-pane" id="tab-chats">
          <div class="chat-split">
            <div>
              <div id="chatListBox"><div class="loading-note">Загрузка…</div></div>
              <button class="btn-ghost-sm hidden" id="loadMoreChatsBtn" style="margin-top:8px;width:100%" onclick="loadMoreChats()">Показать ещё</button>
            </div>
            <div id="threadBox"><div class="empty-note">Выберите чат слева.</div></div>
          </div>
        </div>

        <div class="tab-pane" id="tab-export">
          <div style="margin-bottom:14px">
            <button class="btn-red" id="exportBtn" onclick="runExport()">⬇ Выгрузить в XLSX</button>
          </div>
          <div id="summaryBox" class="hidden">
            <div class="summary-grid" id="summaryGrid"></div>
            <div id="errorBox" class="err-box hidden"></div>
          </div>

          <div class="panel-head" style="margin-top:22px">
            <h2 style="font-size:13px">История выгрузок</h2>
          </div>
          <div id="runsBox"><div class="empty-note">Пока не было выгрузок.</div></div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal-overlay hidden" id="accountModal">
  <div class="modal-card">
    <h3 id="modalTitle">Новый кабинет</h3>
    <div class="field-row">
      <label>Название кабинета</label>
      <input type="text" id="fName" placeholder="Например, «Репетиторы — Москва»">
    </div>
    <div class="field-grid">
      <div class="field-row">
        <label>Client ID</label>
        <input type="text" id="fClientId" autocapitalize="off" autocorrect="off" spellcheck="false">
      </div>
      <div class="field-row">
        <label>User ID (аккаунт)</label>
        <input type="text" id="fUserId" autocapitalize="off" autocorrect="off" spellcheck="false">
      </div>
    </div>
    <div class="field-row">
      <label>Client Secret</label>
      <input type="password" id="fClientSecret" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false">
    </div>
    <div class="hint" id="secretHint"></div>
    <div class="modal-actions">
      <button class="btn-red" style="flex:1" onclick="saveAccount()">Сохранить</button>
      <button class="btn-outline" onclick="closeAccountModal()">Отмена</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
// cantor.agency's DNS is on reg.ru, not Cloudflare, so /api/* on that domain never
// reaches this worker — call the workers.dev host directly instead (same pattern
// as mba-mybrand's/serp-analysis's API_BASE), relying on the worker's permissive CORS headers.
const API_BASE = 'https://mainweb.oxion-ezhkov.workers.dev';
const ADMIN_STORAGE_KEY = 'avito_export_admin_ok';
// Client-side gate only (same convention as /serp-analysis) — not a real auth boundary.
// Real protection is that Avito client_secret values are never sent back to the browser
// after being saved (see maskAvitoAccount in _worker.js).
const ADMIN_PASSWORD = '12345678';

let accounts = [];
let selectedId = null;
let editingAccountId = null;
let lastExportResult = null;
let currentTab = 'overview';
let overviewCache = null; // { key, data }
let chatOffset = 0;
let chatList = [];
let chatHasMore = false;
let selectedChatId = null;

async function api(path, opts) {
  const res = await fetch(API_BASE + path, {
    headers: { 'Content-Type': 'application/json' },
    ...opts,
  });
  if (!res.ok) {
    const body = await res.json().catch(() => ({}));
    throw new Error(body.message || body.error || ('http_' + res.status));
  }
  return res.json();
}

function escapeHtml(v) {
  return String(v == null ? '' : v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function initials(name) {
  const parts = String(name || '?').trim().split(/\s+/).filter(Boolean);
  return ((parts[0] || '?')[0] + (parts[1] ? parts[1][0] : '')).toUpperCase();
}
function fmtDate(iso) {
  if (!iso) return '';
  const d = new Date(iso);
  return d.toLocaleDateString('ru-RU', { day:'2-digit', month:'2-digit', year:'numeric' }) + ' ' + d.toLocaleTimeString('ru-RU', { hour:'2-digit', minute:'2-digit' });
}
let toastTimer = null;
function showToast(text) {
  const toast = document.getElementById('toast');
  toast.textContent = text;
  toast.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove('show'), 2400);
}

/* ════════════ GATE ════════════ */
function isAdminUnlocked() { return localStorage.getItem(ADMIN_STORAGE_KEY) === '1'; }
function logout() {
  localStorage.removeItem(ADMIN_STORAGE_KEY);
  document.getElementById('app').classList.add('hidden');
  document.getElementById('adminGate').classList.remove('hidden');
}
document.getElementById('gateForm').addEventListener('submit', (e) => {
  e.preventDefault();
  const input = document.getElementById('gatePassword');
  const err = document.getElementById('gateError');
  if (input.value === ADMIN_PASSWORD) {
    localStorage.setItem(ADMIN_STORAGE_KEY, '1');
    input.value = '';
    err.classList.remove('show');
    boot();
  } else {
    err.classList.add('show');
  }
});

/* ════════════ ACCOUNTS ════════════ */
async function loadAccounts() {
  const { accounts: list } = await api('/api/avito/accounts');
  accounts = list;
  renderAccounts();
}

function renderAccounts() {
  const box = document.getElementById('acctList');
  if (!accounts.length) {
    box.innerHTML = '<div class="empty-note">Кабинетов пока нет — добавьте первый.</div>';
    return;
  }
  box.innerHTML = accounts.map((a) => `
    <div class="acct-row ${a.id === selectedId ? 'active' : ''}" onclick="selectAccount('${a.id}')">
      <div class="acct-avatar">${escapeHtml(initials(a.name))}</div>
      <div class="acct-info">
        <div class="acct-name">${escapeHtml(a.name)}</div>
        <div class="acct-meta">ID ${escapeHtml(a.userId)}</div>
      </div>
    </div>
  `).join('');
}

function getAccount(id) { return accounts.find((a) => a.id === id); }

async function selectAccount(id) {
  selectedId = id;
  renderAccounts();
  const a = getAccount(id);
  document.getElementById('noAccountNote').classList.add('hidden');
  document.getElementById('detailContent').classList.remove('hidden');
  document.getElementById('detailName').textContent = a.name;
  document.getElementById('detailUserId').textContent = a.userId;
  document.getElementById('detailLastExport').textContent = a.lastExportAt ? fmtDate(a.lastExportAt) : 'никогда';
  document.getElementById('summaryBox').classList.add('hidden');
  lastExportResult = null;

  const today = new Date();
  const monthAgo = new Date(today.getTime() - 29 * 86400000);
  document.getElementById('dateTo').value = today.toISOString().slice(0, 10);
  document.getElementById('dateFrom').value = monthAgo.toISOString().slice(0, 10);

  overviewCache = null;
  chatOffset = 0;
  chatList = [];
  selectedChatId = null;
  switchTab('overview');

  await loadRuns(id);
}

/* ════════════ LIVE VIEW: TABS ════════════ */
function switchTab(tab) {
  currentTab = tab;
  document.querySelectorAll('.tab-btn').forEach((b) => b.classList.toggle('active', b.dataset.tab === tab));
  document.querySelectorAll('.tab-pane').forEach((p) => p.classList.toggle('active', p.id === 'tab-' + tab));
  if (tab === 'overview') loadOverview();
  if (tab === 'listings') loadListings();
  if (tab === 'chats' && chatList.length === 0) loadChats(true);
}

function onPeriodChange() {
  overviewCache = null;
  if (currentTab === 'overview') loadOverview();
  if (currentTab === 'listings') loadListings();
}

function overviewCacheKey() {
  return selectedId + '|' + document.getElementById('dateFrom').value + '|' + document.getElementById('dateTo').value;
}

async function fetchOverviewData() {
  const key = overviewCacheKey();
  if (overviewCache && overviewCache.key === key) return overviewCache.data;
  const dateFrom = document.getElementById('dateFrom').value;
  const dateTo = document.getElementById('dateTo').value;
  const data = await api(`/api/avito/overview?accountId=${encodeURIComponent(selectedId)}&dateFrom=${encodeURIComponent(dateFrom)}&dateTo=${encodeURIComponent(dateTo)}`);
  overviewCache = { key, data };
  return data;
}

function fmtMoney(v) {
  return Number(v).toLocaleString('ru-RU', { maximumFractionDigits: 2 }) + ' ₽';
}

async function loadOverview() {
  if (!selectedId) return;
  const box = document.getElementById('overviewBox');
  if (!overviewCache || overviewCache.key !== overviewCacheKey()) box.innerHTML = '<div class="loading-note">Загрузка…</div>';
  try {
    const data = await fetchOverviewData();
    renderOverview(data);
  } catch (e) {
    box.innerHTML = `<div class="loading-note">Не удалось загрузить: ${escapeHtml(e.message)}</div>`;
  }
}

function renderOverview(data) {
  const box = document.getElementById('overviewBox');
  const self = data.self || {};
  const balance = data.balance || {};
  const rating = (data.rating && data.rating.rating) || {};
  const reviews = (data.reviews && data.reviews.reviews) || [];

  let html = `<div class="profile-box">
    <div><b>${escapeHtml(self.name || 'Профиль недоступен')}</b></div>
    ${self.email ? `<div>Email: ${escapeHtml(self.email)}</div>` : ''}
    ${self.phone ? `<div>Телефон: ${escapeHtml(self.phone)}</div>` : ''}
    ${self.profile_url ? `<div><a href="${escapeHtml(self.profile_url)}" target="_blank" rel="noopener">Профиль на Avito ↗</a></div>` : ''}
  </div>`;

  html += '<div class="ov-grid">';
  html += `<div class="ov-card"><div class="lbl">Баланс</div><div class="val">${balance.real != null ? fmtMoney(balance.real) : '—'}</div>${balance.bonus ? `<div class="sub">+ ${fmtMoney(balance.bonus)} бонусов</div>` : ''}</div>`;
  html += `<div class="ov-card"><div class="lbl">Рейтинг</div><div class="val">${rating.score != null ? Number(rating.score).toFixed(1) : '—'}</div><div class="sub">${rating.reviewsCount || 0} отзывов</div></div>`;
  html += `<div class="ov-card"><div class="lbl">Объявлений</div><div class="val">${data.counts ? data.counts.items : '—'}</div></div>`;
  html += `<div class="ov-card"><div class="lbl">Чатов всего</div><div class="val">${data.counts ? data.counts.chatsTotal : '—'}</div></div>`;
  html += '</div>';

  if (reviews.length) {
    html += '<div class="panel-head" style="margin-top:2px"><h2 style="font-size:13px">Последние отзывы</h2></div>';
    html += reviews.slice(0, 8).map((r) => `
      <div class="review-item">
        <span class="review-score">★ ${escapeHtml(r.score)}</span> — ${escapeHtml((r.sender && r.sender.name) || 'Клиент')}
        ${r.item && r.item.title ? ` · ${escapeHtml(r.item.title)}` : ''}
        <div>${escapeHtml(r.text || '')}</div>
      </div>
    `).join('');
  }

  if (data.errors && data.errors.length) {
    html += `<div class="err-box">Часть данных недоступна:<ul>${data.errors.map((e) => `<li>${escapeHtml(e)}</li>`).join('')}</ul></div>`;
  }

  box.innerHTML = html;
}

async function loadListings() {
  if (!selectedId) return;
  const box = document.getElementById('listingsBox');
  if (!overviewCache || overviewCache.key !== overviewCacheKey()) box.innerHTML = '<div class="loading-note">Загрузка…</div>';
  try {
    const data = await fetchOverviewData();
    renderListings(data.items || []);
  } catch (e) {
    box.innerHTML = `<div class="loading-note">Не удалось загрузить: ${escapeHtml(e.message)}</div>`;
  }
}

function renderListings(items) {
  const box = document.getElementById('listingsBox');
  if (!items.length) { box.innerHTML = '<div class="empty-note">Нет активных объявлений.</div>'; return; }
  box.innerHTML = `<div class="data-table-wrap"><table class="data-table">
    <thead><tr><th>Объявление</th><th>Статус</th><th>Цена</th><th>Показы</th><th>Контакты</th><th>В избр.</th><th>Расходы за период</th></tr></thead>
    <tbody>${items.map((it) => `
      <tr>
        <td class="wrap-cell"><a href="${escapeHtml(it.url)}" target="_blank" rel="noopener">${escapeHtml(it.title)}</a><div style="color:var(--muted);font-size:11px">${escapeHtml(it.address)}</div></td>
        <td>${escapeHtml(it.status)}</td>
        <td>${it.price !== '' && it.price != null ? Number(it.price).toLocaleString('ru-RU') + ' ₽' : '—'}</td>
        <td>${escapeHtml(it.views)}</td>
        <td>${escapeHtml(it.contacts)}</td>
        <td>${escapeHtml(it.favorites)}</td>
        <td>${it.spend !== '' ? escapeHtml(it.spend) : '—'}</td>
      </tr>
    `).join('')}</tbody>
  </table></div>`;
}

/* ════════════ LIVE VIEW: CHATS ════════════ */
async function loadChats(reset) {
  if (!selectedId) return;
  if (reset) {
    chatOffset = 0;
    chatList = [];
    selectedChatId = null;
    document.getElementById('threadBox').innerHTML = '<div class="empty-note">Выберите чат слева.</div>';
    document.getElementById('chatListBox').innerHTML = '<div class="loading-note">Загрузка…</div>';
  }
  const box = document.getElementById('chatListBox');
  try {
    const data = await api(`/api/avito/chats?accountId=${encodeURIComponent(selectedId)}&limit=30&offset=${chatOffset}`);
    chatList = chatList.concat(data.chats);
    chatOffset += data.chats.length;
    chatHasMore = data.hasMore;
    renderChatList();
    document.getElementById('loadMoreChatsBtn').classList.toggle('hidden', !chatHasMore);
  } catch (e) {
    box.innerHTML = `<div class="loading-note">Не удалось загрузить: ${escapeHtml(e.message)}</div>`;
  }
}
function loadMoreChats() { loadChats(false); }

function renderChatList() {
  const box = document.getElementById('chatListBox');
  if (!chatList.length) { box.innerHTML = '<div class="empty-note">Чатов нет.</div>'; return; }
  box.innerHTML = `<div class="chat-list">${chatList.map((c) => `
    <div class="chat-row ${c.chat_id === selectedChatId ? 'active' : ''}" onclick="selectChat('${escapeHtml(c.chat_id)}')">
      <div class="ct-title">${escapeHtml(c.item_title || 'Без объявления')}</div>
      <div class="ct-preview">${c.last_message_author_is_manager ? 'Вы: ' : ''}${escapeHtml(c.last_message_text || '')}</div>
      <div class="ct-date">${c.updated ? fmtDate(c.updated) : ''}</div>
    </div>
  `).join('')}</div>`;
}

async function selectChat(chatId) {
  selectedChatId = chatId;
  renderChatList();
  const box = document.getElementById('threadBox');
  box.innerHTML = '<div class="loading-note">Загрузка переписки…</div>';
  try {
    const data = await api(`/api/avito/messages?accountId=${encodeURIComponent(selectedId)}&chatId=${encodeURIComponent(chatId)}`);
    renderThread(data.messages || []);
  } catch (e) {
    const note = String(e.message).includes('402')
      ? 'На этом кабинете не подключена платная подписка Avito на API мессенджера.'
      : `Не удалось загрузить переписку: ${escapeHtml(e.message)}`;
    box.innerHTML = `<div class="loading-note">${note}</div>`;
  }
}

function renderThread(messages) {
  const box = document.getElementById('threadBox');
  if (!messages.length) { box.innerHTML = '<div class="empty-note">Сообщений нет.</div>'; return; }
  box.innerHTML = `<div class="thread" id="threadScroll">${messages.map((m) => `
    <div class="bubble ${m.author}">
      <div>${escapeHtml(m.text)}</div>
      <div class="b-meta">${fmtDate(m.datetime)}</div>
    </div>
  `).join('')}</div>`;
  const scroller = document.getElementById('threadScroll');
  scroller.scrollTop = scroller.scrollHeight;
}

async function loadRuns(accountId) {
  const box = document.getElementById('runsBox');
  try {
    const { runs } = await api('/api/avito/runs?accountId=' + encodeURIComponent(accountId));
    if (!runs.length) {
      box.innerHTML = '<div class="empty-note">Пока не было выгрузок.</div>';
      return;
    }
    box.innerHTML = `
      <table class="runs-table">
        <thead><tr><th>Дата</th><th>Период</th><th>Статус</th><th>Объявл.</th><th>Чаты</th><th>Сообщ.</th></tr></thead>
        <tbody>
          ${runs.map((r) => `
            <tr>
              <td>${fmtDate(r.finishedAt)}</td>
              <td>${escapeHtml(r.dateFrom)} — ${escapeHtml(r.dateTo)}</td>
              <td><span class="status-pill status-${r.status}">${r.status === 'ok' ? 'ок' : r.status === 'partial' ? 'частично' : 'ошибка'}</span></td>
              <td>${r.counts ? r.counts.items : '—'}</td>
              <td>${r.counts ? r.counts.chatsInRange : '—'}</td>
              <td>${r.counts ? r.counts.messages : '—'}</td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
  } catch (e) {
    box.innerHTML = '<div class="empty-note">Не удалось загрузить историю.</div>';
  }
}

/* ════════════ ACCOUNT MODAL ════════════ */
function openAccountModal(id) {
  editingAccountId = id || null;
  const a = id ? getAccount(id) : null;
  document.getElementById('modalTitle').textContent = a ? 'Изменить кабинет' : 'Новый кабинет';
  document.getElementById('fName').value = a ? a.name : '';
  document.getElementById('fClientId').value = a ? a.clientId : '';
  document.getElementById('fUserId').value = a ? a.userId : '';
  document.getElementById('fClientSecret').value = '';
  document.getElementById('secretHint').textContent = a
    ? 'Оставьте пустым, чтобы не менять сохранённый секрет.'
    : 'Выдаётся в личном кабинете разработчика Avito вместе с Client ID.';
  document.getElementById('accountModal').classList.remove('hidden');
}
function closeAccountModal() { document.getElementById('accountModal').classList.add('hidden'); }

function editCurrentAccount() { if (selectedId) openAccountModal(selectedId); }

async function saveAccount() {
  const name = document.getElementById('fName').value.trim();
  const clientId = document.getElementById('fClientId').value.trim();
  const userId = document.getElementById('fUserId').value.trim();
  const clientSecret = document.getElementById('fClientSecret').value.trim();
  if (!name || !clientId || !userId || (!editingAccountId && !clientSecret)) {
    showToast('Заполните название, Client ID, User ID и секрет');
    return;
  }
  try {
    if (editingAccountId) {
      const body = { id: editingAccountId, name, clientId, userId };
      if (clientSecret) body.clientSecret = clientSecret;
      const { account } = await api('/api/avito/accounts', { method: 'PUT', body: JSON.stringify(body) });
      accounts = accounts.map((a) => (a.id === account.id ? account : a));
    } else {
      const { account } = await api('/api/avito/accounts', { method: 'POST', body: JSON.stringify({ name, clientId, userId, clientSecret }) });
      accounts.push(account);
      selectedId = account.id;
    }
    accounts.sort((a, b) => a.name.localeCompare(b.name, 'ru'));
    renderAccounts();
    closeAccountModal();
    showToast('Кабинет сохранён');
    if (selectedId) selectAccount(selectedId);
  } catch (e) {
    showToast('Ошибка сохранения: ' + e.message);
  }
}

async function deleteCurrentAccount() {
  if (!selectedId) return;
  const a = getAccount(selectedId);
  if (!confirm(`Удалить кабинет «${a.name}»? История выгрузок тоже будет удалена.`)) return;
  try {
    await api('/api/avito/accounts', { method: 'DELETE', body: JSON.stringify({ id: selectedId }) });
    accounts = accounts.filter((x) => x.id !== selectedId);
    selectedId = null;
    renderAccounts();
    document.getElementById('detailContent').classList.add('hidden');
    document.getElementById('noAccountNote').classList.remove('hidden');
    showToast('Кабинет удалён');
  } catch (e) {
    showToast('Ошибка удаления: ' + e.message);
  }
}

/* ════════════ EXPORT ════════════ */
function loadScriptOnce(src) {
  return new Promise((resolve, reject) => {
    if (document.querySelector(`script[src="${src}"]`)) return resolve();
    const s = document.createElement('script');
    s.src = src;
    s.onload = resolve;
    s.onerror = reject;
    document.head.appendChild(s);
  });
}

async function runExport() {
  if (!selectedId) return;
  const dateFrom = document.getElementById('dateFrom').value;
  const dateTo = document.getElementById('dateTo').value;
  if (!dateFrom || !dateTo) { showToast('Укажите период'); return; }

  const btn = document.getElementById('exportBtn');
  const original = btn.textContent;
  btn.disabled = true;
  btn.textContent = '⏳ Выгружаем...';

  try {
    const result = await api('/api/avito/export', {
      method: 'POST',
      body: JSON.stringify({ accountId: selectedId, dateFrom, dateTo }),
    });
    lastExportResult = result;
    renderSummary(result);
    await downloadXlsx(result);
    await loadRuns(selectedId);
    const a = getAccount(selectedId);
    if (a) a.lastExportAt = new Date().toISOString();
    document.getElementById('detailLastExport').textContent = fmtDate(a && a.lastExportAt);
    showToast('Готово — файл скачан');
  } catch (e) {
    showToast('Ошибка выгрузки: ' + e.message);
  } finally {
    btn.disabled = false;
    btn.textContent = original;
  }
}

function renderSummary(result) {
  const box = document.getElementById('summaryBox');
  box.classList.remove('hidden');
  document.getElementById('summaryGrid').innerHTML = `
    <div class="stat-tile"><div class="num">${result.counts.items}</div><div class="lbl">Объявлений</div></div>
    <div class="stat-tile"><div class="num">${result.counts.chatsInRange}</div><div class="lbl">Чатов за период</div></div>
    <div class="stat-tile"><div class="num">${result.counts.messages}</div><div class="lbl">Сообщений</div></div>
  `;
  const errBox = document.getElementById('errorBox');
  if (result.errors && result.errors.length) {
    errBox.classList.remove('hidden');
    errBox.innerHTML = `Выгружено не всё — часть данных пропущена:<ul>${result.errors.map((e) => `<li>${escapeHtml(e)}</li>`).join('')}</ul>`;
  } else {
    errBox.classList.add('hidden');
  }
}

const AUTHOR_LABEL = { client: 'клиент', manager: 'менеджер' };

async function downloadXlsx(result) {
  await loadScriptOnce('https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js');

  const statsRows = result.stats.map((r) => ({
    'ID объявления': r.item_id,
    'Название': r.title,
    'Статус': r.status,
    'Категория': r.category,
    'Адрес': r.address,
    'Ссылка': r.url,
    'Показы': r.views,
    'Уникальные показы': r.uniqViews,
    'Контакты': r.contacts,
    'Уникальные контакты': r.uniqContacts,
    'В избранном': r.favorites,
    'Расходы': r.spend,
    'Период с': r.dateFrom,
    'Период по': r.dateTo,
  }));

  const chatRows = result.chats.map((r) => ({
    'chat_id': r.chat_id,
    'item_id': r.item_id,
    'Объявление': r.item_title,
    'Адрес объявления': r.item_address,
    'Дата первого сообщения': r.first_message_at,
    'Дата последнего сообщения': r.last_message_at,
    'Кто написал первым': AUTHOR_LABEL[r.first_author] || r.first_author,
    'Сообщений всего': r.messages_total,
    'От клиента': r.messages_client,
    'От менеджера': r.messages_manager,
    'Ср. время ответа менеджера, сек': r.avg_manager_response_sec,
    'Был звонок': r.has_call,
    'Итоговый статус': r.final_status,
  }));

  const messageRows = result.messages.map((r) => ({
    'chat_id': r.chat_id,
    'message_id': r.message_id,
    'Дата/время': r.datetime,
    'Автор': AUTHOR_LABEL[r.author] || r.author,
    'Тип': r.type,
    'Текст': r.text,
    'Время ответа собеседника, сек': r.response_time_sec,
  }));

  // json_to_sheet infers headers from the first row's keys — on an empty array that leaves
  // a sheet with no header row at all, which reads as broken rather than "no data for period".
  const STATS_HEADERS = ['ID объявления', 'Название', 'Статус', 'Категория', 'Адрес', 'Ссылка', 'Показы', 'Уникальные показы', 'Контакты', 'Уникальные контакты', 'В избранном', 'Расходы', 'Период с', 'Период по'];
  const CHAT_HEADERS = ['chat_id', 'item_id', 'Объявление', 'Адрес объявления', 'Дата первого сообщения', 'Дата последнего сообщения', 'Кто написал первым', 'Сообщений всего', 'От клиента', 'От менеджера', 'Ср. время ответа менеджера, сек', 'Был звонок', 'Итоговый статус'];
  const MESSAGE_HEADERS = ['chat_id', 'message_id', 'Дата/время', 'Автор', 'Тип', 'Текст', 'Время ответа собеседника, сек'];

  function sheetWithHeaders(headers, rows) {
    const ws = XLSX.utils.aoa_to_sheet([headers]);
    XLSX.utils.sheet_add_json(ws, rows, { origin: 'A2', skipHeader: true, header: headers });
    return ws;
  }

  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, sheetWithHeaders(STATS_HEADERS, statsRows), 'Статистика объявлений');
  XLSX.utils.book_append_sheet(wb, sheetWithHeaders(CHAT_HEADERS, chatRows), 'Чаты');
  XLSX.utils.book_append_sheet(wb, sheetWithHeaders(MESSAGE_HEADERS, messageRows), 'Сообщения');

  const accountName = (getAccount(selectedId) || {}).name || 'avito';
  const safeName = accountName.replace(/[^a-zA-Zа-яА-Я0-9_-]/g, '_');
  XLSX.writeFile(wb, `avito-${safeName}-${result.meta.dateFrom}_${result.meta.dateTo}.xlsx`);
}

/* ════════════ BOOT ════════════ */
async function boot() {
  document.getElementById('adminGate').classList.add('hidden');
  document.getElementById('app').classList.remove('hidden');
  try {
    await loadAccounts();
  } catch (e) {
    showToast('Не удалось загрузить кабинеты: ' + e.message);
  }
}

if (isAdminUnlocked()) boot();

window.openAccountModal = openAccountModal;
window.closeAccountModal = closeAccountModal;
window.saveAccount = saveAccount;
window.editCurrentAccount = editCurrentAccount;
window.deleteCurrentAccount = deleteCurrentAccount;
window.selectAccount = selectAccount;
window.runExport = runExport;
window.logout = logout;
window.switchTab = switchTab;
window.onPeriodChange = onPeriodChange;
window.loadMoreChats = loadMoreChats;
window.selectChat = selectChat;
</script>
