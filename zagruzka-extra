function probGroups(items) {
  const g = new Map();
  for (const it of items) {
    const key = String(it.msg || '').slice(0, 180);
    if (!g.has(key)) g.set(key, { msg: it.msg, kind: it.kind, items: [] });
    g.get(key).items.push(it);
  }
  return [...g.values()].map((x) => ({ kind: x.kind, msg: x.msg, where: x.items.map((it) => it.where).filter(Boolean) })).sort((a, b) => b.where.length - a.where.length);
}
function probCards(groups) {
  return groups.map((g) => `<div class="pcard ${g.kind || 'warn'}"><div class="pc-h"><div class="pc-t">${esc(g.msg)}</div>${g.where.length > 1 ? `<span class="chip">${g.where.length}</span>` : ''}</div>${g.where.length ? `<div class="pc-w">${g.where.slice(0, 40).map((w) => `<span class="pill">${w}</span>`).join('')}${g.where.length > 40 ? `<span class="pill">ещё ${g.where.length - 40}</span>` : ''}</div>` : ''}</div>`).join('');
}
function openProbs(slug) {
  const f = feedBy(slug); if (!f) return;
  const s = f.stat || {};
  const items = [];
  if (s.error) items.push({ kind: 'err', msg: s.error, where: '' });
  if (s.s3Error) items.push({ kind: 'err', msg: 'XML не выложен в хранилище: ' + s.s3Error, where: '' });
  (s.tabs || []).filter((t) => t.error).forEach((t) => items.push({ kind: 'err', msg: t.error, where: '' }));
  const multi = [];
  (s.problems || []).forEach((p) => {
    if (p.ids && p.ids.length > 1) { multi.push({ kind: 'warn', msg: p.msg, where: p.ids.slice(0, 20).map((id) => `<b>${esc(id)}</b>`) }); return; }
    items.push({ kind: 'warn', msg: p.msg, where: [p.row && `стр. ${p.row}`, p.id && `<b>${esc(p.id)}</b>`].filter(Boolean).join(' · ') });
  });
  const groups = multi.concat(probGroups(items));
  const fixes = (s.fixes || []).map((x) => `<div class="pcard fix"><div class="pc-h"><div class="pc-t"><b>${esc(x.tag)}</b>: «${esc(x.from)}» → «${esc(x.to)}»</div><span class="chip">${int(x.n)}</span></div></div>`).join('');
  openModal(`${mHead('Ошибки XML — ' + f.name)}<div class="m-b">
    ${items.length ? `<div class="psum"><div class="big ${items.some((x) => x.kind === 'err') ? 'red' : 'amber'}">${items.length}</div><div class="note">${s.builtAt ? 'Сборка ' + esc(ago(Date.parse(s.builtAt))) + ' · ' : ''}в XML ${int(s.ads)} объявлений</div></div>` : '<div class="ok-box">Ошибок сборки нет</div>'}
    ${probCards(groups)}
    ${fixes ? `<h3 class="ph2">Исправлено при сборке</h3><div class="note">В XML подставлены значения, которые Авито принимает. Таблица сама не меняется.</div>${fixes}` : ''}
    ${s.catalogError ? `<div class="warn-box">Справочник Авито не проверен: ${esc(s.catalogError)}</div>` : ''}
    <div class="note">Это ошибки сборки XML. Что Авито сделал с объявлениями — кнопка «Отчёт».</div></div>`, true);
}

const R = {};
let reportSession = 0;
function reportCsv(rows) {
  const q = (v) => `"${String(v == null ? '' : v).replace(/"/g, '""')}"`;
  const lines = [['ID в файле', 'ID на Авито', 'Раздел', 'Статус', 'Тип', 'Код', 'Сообщение', 'Ссылка'].map(q).join(';')];
  rows.forEach((it) => ((it.messages && it.messages.length) ? it.messages : [{}]).forEach((m) => lines.push([it.adId, it.avitoId, it.section, it.avitoStatus, m.type, m.code, m.text, it.url].map(q).join(';'))));
  return '\uFEFF' + lines.join('\r\n');
}
async function openReport(slug) {
  const session = ++reportSession;
  let reportTimer = null, reportBusy = false;
  const f = feedBy(slug); if (!f) return;
  openModal(`${mHead('Отчёт Авито — ' + f.name)}<div class="m-b" id="repBody"><div class="note">Запрашиваю отчёт у Авито…</div></div>
    <div class="m-f"><button class="btn" type="button" id="repRe">${I('refresh', 'ic-sm')}Обновить</button><span class="grow"></span><button class="btn primary" type="button" id="repCsv" disabled>Скачать ошибки</button></div>`, true);
  const loadRep = async (force = false) => {
    if (reportBusy || session !== reportSession || !$('#repBody')) return;
    clearTimeout(reportTimer); reportBusy = true;
    $('#repRe').disabled = true;
    if ($('#repCsv')) $('#repCsv').disabled = true;
    const r = await api(`${API}/${slug}/report${force ? '?refresh=1' : ''}`);
    reportBusy = false;
    if (session !== reportSession || !$('#repBody')) return;
    $('#repRe').disabled = false;
    if (!$('#repBody')) return;
    if (denied(r)) return;
    if (!r.ok) { $('#repBody').innerHTML = `<div class="err-box">${esc(r.data.error || 'Авито не отдал отчёт')}</div>`; return; }
    R[slug] = r.data; paintReport(slug);
    if (r.data.summary && r.data.summary.retryAt) {
      const delay = Math.max(15000, r.data.summary.retryAt - Date.now());
      $('#repRe').disabled = true;
      reportTimer = setTimeout(() => { if (session === reportSession && $('#repBody')) loadRep(); }, delay);
    }
  };
  $('#repRe').onclick = () => { if ($('#repBody')) $('#repBody').innerHTML = '<div class="note">Запрашиваю отчёт…</div>'; loadRep(true); };
  $('#repCsv').onclick = () => {
    const d = R[slug]; if (!d) return;
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([reportCsv(d.problems || [])], { type: 'text/csv;charset=utf-8' }));
    a.download = `oshibki_${f.slug}_${d.summary.reportId || 'last'}.csv`; document.body.appendChild(a); a.click();
    setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
  };
  loadRep();
}
function paintReport(slug) {
  const d = R[slug]; if (!d || !$('#repBody')) return;
  const s = d.summary || {};
  const src = d.source;
  const secs = s.complete && Array.isArray(s.sectionStats?.sections) ? s.sectionStats.sections : [];
  const tone = (x) => /^success|successful/.test(x || '') ? 'green' : /error|fail/.test(x || '') ? 'red' : 'amber';
  const srcBox = !src ? '' : src.kind === 'cantor'
    ? `<div class="ok-box">Кабинет грузится из XML этого раздела${src.enabled ? '' : ' — но автозагрузка в кабинете выключена'}</div>`
    : `<div class="warn-box">${src.kind === 'none' ? 'В кабинете не указана ссылка на фид' : 'Кабинет грузится из другой ссылки'}${src.urls && src.urls[0] ? ': <span class="mono">' + esc(src.urls[0]) + '</span>' : ''}. После «Подключить» Авито возьмёт XML этого раздела.</div>`;
  const items = [];
  (d.problems || []).forEach((it) => {
    const msgs = it.messages || [];
    const bad = msgs.filter((m) => m.type === 'error' || m.type === 'alarm');
    const ms = bad.length ? bad : msgs.filter((m) => m.type !== 'info');
    const href = httpUrl(it.url);
    const where = href ? `<a href="${esc(href)}" target="_blank" rel="noopener">${esc(it.adId || it.avitoId || 'объявление')}</a>` : esc(it.adId || it.avitoId || '');
    (ms.length ? ms : [{ text: it.section }]).forEach((m) => items.push({ kind: bad.length ? 'err' : 'warn', msg: m.text || it.section || 'Проблема', where }));
  });
  if ($('#repCsv')) $('#repCsv').disabled = !(d.problems || []).length || !s.complete;
  $('#repBody').innerHTML = `${srcBox}
    ${s.warning ? `<div class="warn-box">${esc(s.warning)}</div>` : ''}
    ${s.processingReportId != null ? `<div class="warn-box">Авито обрабатывает загрузку №${esc(String(s.processingReportId))}. Ниже последний завершённый отчёт.</div>` : ''}
    <div class="note">Отчёт ${esc(String(s.reportId || '—'))}${s.finishedAt ? ' · ' + esc(fmtAt(Date.parse(s.finishedAt))) : ''} · ${int(s.totalItems ?? (s.sectionStats && s.sectionStats.count) ?? s.items)} объявлений</div>
    ${secs.length ? `<div class="tiles">${secs.map((x) => `<div class="tile ${tone(x.slug)}"><div class="t-v">${int(x.count)}</div><div class="t-l">${esc(x.title || '')}</div></div>`).join('')}</div>` : ''}
    ${items.length ? `<h3 class="ph2">Проблемы — ${(d.problems || []).length}</h3>${probCards(probGroups(items))}` : s.complete && !s.warning ? '<div class="ok-box">Проблемных объявлений в отчёте нет</div>' : '<div class="note">Полный список ошибок ещё не получен</div>'}`;
}

function openHelp() {
  openModal(`${mHead('Как работать')}<div class="m-b help">
    <h3>Что это</h3><p>Объявления живут в Google Таблице по шаблону BananLab. Сервис собирает из неё XML, кладёт его в хранилище, Авито забирает файл сам. Этот раздел не видит кабинеты и таблицы других разделов сайта.</p>
    <h3>Новый кабинет</h3><ol>
      <li>«Кабинет» → название, client_id и client_secret из кабинета разработчика Авито. Кнопка проверяет ключи, без верных ключей кабинет не сохранится.</li>
      <li>Таблица: «Настройки доступа» → добавьте адрес сервисного аккаунта (он написан сверху) как читателя. Либо откройте доступ «все, у кого есть ссылка».</li>
      <li>У строки кабинета «Добавить таблицу» → вставьте ссылку → «Вкладки» → отметьте вкладку с объявлениями → «Сохранить». XML соберётся сразу.</li>
      <li>«Подключить» → почта для отчётов. Ссылка запишется в автозагрузку Авито.</li>
      <li>«В Авито» — забрать XML сейчас (Авито разрешает не чаще раза в час).</li>
      <li>Через некоторое время «Отчёт» — что опубликовалось. «Ошибки» в строке — это ещё сборка таблицы, не ответ Авито.</li>
    </ol>
    <h3>Фото</h3><p>В Images нужны готовые фотографии. Обработка BananLab (плашки, текст, фон, изменение пропорций) здесь не выполняется; дождитесь её окончания и проверьте Category. В колонке Images — ссылки, по одной на строку или через « | ». Закрытые ссылки Яндекс.Диска работают, если на вкладке «Яндекс.Диск.Доступ» в ячейке A2 есть токен. Публичные ссылки — без токена.</p>
    <h3>Если не обновилось</h3><p>«Пересобрать», затем «В Авито». Если кабинет не грузит совсем — проверьте, что автозагрузка включена в профиле Авито и тариф активен. Текст ошибки показывается в окне, ничего не проглатывается молча.</p>
  </div>`, true);
}

function openLog() {
  const month = new Date(Date.now() + 3 * 3600e3).toISOString().slice(0, 7);
  openModal(`${mHead('Журнал')}<div class="m-b" id="logBody"><div class="note">Загружаю…</div></div>`, true);
  api(API + '/log?month=' + month).then((r) => {
    if (!$('#logBody')) return;
    if (denied(r)) return;
    if (!r.ok) { $('#logBody').innerHTML = `<div class="err-box">${esc(r.data.error || 'Не удалось загрузить журнал')}</div>`; return; }
    const accounts = r.data.accounts || {};
    let cur = '';
    const rows = (r.data.entries || []).map((e) => {
      const dd = new Date(e.t + 3 * 3600e3).toISOString().slice(0, 10);
      const head = dd !== cur ? `<div class="lg-day">${esc(dd)}</div>` : '';
      cur = dd;
      const acc = (e.acc || []).map((id) => accounts[id] || id).join(', ');
      const extra = [e.name, acc, e.detail].filter(Boolean).join(' — ');
      return `${head}<div class="lg-row"><span class="lg-t">${esc(new Date(e.t).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Moscow' }))}</span><div><b>${esc(e.by || 'Загрузка Экстра')}</b> · ${esc(e.act || '')}${extra ? `<div class="note">${esc(extra)}</div>` : ''}</div></div>`;
    }).join('');
    $('#logBody').innerHTML = rows || emptyState('За этот месяц записей нет', 'Здесь будут добавления кабинетов, сборки и подключения.');
  });
}

$('#accAdd').addEventListener('click', () => openAccount(null));
$('#feedAdd').addEventListener('click', () => openFeed(null));
$('#reloadBtn').addEventListener('click', () => { $('#rows').innerHTML = '<tr><td colspan="6"><div class="empty">Загрузка…</div></td></tr>'; load(); });
$('#helpBtn').addEventListener('click', openHelp);
$('#logBtn').addEventListener('click', openLog);
$('#outBtn').addEventListener('click', () => { try { localStorage.removeItem(PW_KEY); } catch (e) {} showGate(''); });
$('#gateForm').addEventListener('submit', async (ev) => {
  ev.preventDefault();
  const btn = $('#gateBtn');
  const pw = $('#gatePw').value;
  if (!pw || btn.disabled) return;
  btn.disabled = true; $('#gateErr').textContent = '';
  try { localStorage.setItem(PW_KEY, pw); } catch (e) { btn.disabled = false; $('#gateErr').textContent = 'Браузер не сохранил пароль'; return; }
  const r = await api(API);
  if (r.status === 401) {
    try { localStorage.removeItem(PW_KEY); } catch (e) {}
    btn.disabled = false; $('#gateErr').textContent = 'Неверный пароль'; return;
  }
  if (!r.ok) { btn.disabled = false; $('#gateErr').textContent = r.data.error || 'Нет связи с сервером'; return; }
  $('#gatePw').value = '';
  $('#gate').hidden = true; $('#app').hidden = false;
  F.feeds = r.data.feeds || []; F.accounts = r.data.accounts || []; F.serviceAccount = r.data.serviceAccount || null; F.loaded = true;
  renderSa(); render();
});

if (!getPw()) showGate('');
else { $('#gate').hidden = true; $('#app').hidden = false; load(); }
})();
</script>
