<script>
(function () {
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;' }[c]));
const I = (n, c) => `<svg class="ic${c ? ' ' + c : ''}"><use href="#i-${n}"/></svg>`;
const API_BASE = 'https://mainweb.oxion-ezhkov.workers.dev';
const API_PROXY_URL = 'https://functions.yandexcloud.net/d4eiu56ijlg0jn5o9rch';
const ROUTES = location.hostname.endsWith('workers.dev')
  ? [(p) => location.origin + p, (p) => `${API_PROXY_URL}?p=${encodeURIComponent(p)}`]
  : [(p) => `${API_PROXY_URL}?p=${encodeURIComponent(p)}`, (p) => API_BASE + p];
const PW_KEY = 'zagruzka_extra_pw';
const BY_KEY = 'zagruzka_extra_by';
const API = '/api/dashboard/feeds-extra';
let route = 0;
const inflight = new Set();
const F = { feeds: [], accounts: [], serviceAccount: null, loaded: false };
const getPw = () => { try { return localStorage.getItem(PW_KEY) || ''; } catch (e) { return ''; } };
const actor = () => { try { return (localStorage.getItem(BY_KEY) || '').trim().slice(0, 40); } catch (e) { return ''; } };

function toast(msg) {
  const t = $('#toast'); t.textContent = msg; t.classList.remove('hide');
  clearTimeout(toast._t); toast._t = setTimeout(() => t.classList.add('hide'), 4800);
}
const int = (v) => v == null ? '—' : Number(v).toLocaleString('ru-RU');
const fmtAt = (ms) => ms ? new Date(ms).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Moscow' }) : '—';
function ago(ms) { if (!ms) return '—'; const m = Math.round((Date.now() - ms) / 60000); if (m < 1) return 'только что'; if (m < 60) return m + ' мин назад'; return fmtAt(ms); }
function emptyState(title, sub) { return `<div class="empty"><div>${esc(title)}</div>${sub ? `<div class="small faint">${esc(sub)}</div>` : ''}</div>`; }
function httpUrl(u) { return /^https?:\/\//i.test(String(u || '')) ? String(u) : ''; }

async function api(path, opts) {
  const headers = { 'Content-Type': 'application/json', 'x-dashboard-password': getPw() };
  for (let i = 0; i < ROUTES.length; i++) {
    const idx = (route + i) % ROUTES.length;
    try {
      const res = await fetch(ROUTES[idx](path), { ...opts, headers, signal: AbortSignal.timeout(90000) });
      const data = await res.json().catch(() => ({}));
      if ((res.status === 502 || res.status === 504) && (!opts || !opts.method || opts.method === 'GET') && i < ROUTES.length - 1) continue;
      route = idx;
      return { status: res.status, ok: res.ok, data };
    } catch (e) { /* next route */ }
  }
  return { status: 0, ok: false, data: { error: 'Нет связи с сервером. Проверьте интернет и нажмите ещё раз.' } };
}
