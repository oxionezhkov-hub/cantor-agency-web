async function load() {
  const r = await api(API);
  if (denied(r)) return;
  if (!r.ok) {
    $('#rows').innerHTML = `<tr><td colspan="6">${emptyState(r.data.error || 'Не удалось загрузить', 'Нажмите обновить.')}</td></tr>`;
    $('#saBox').textContent = 'Список не загрузился.';
    return;
  }
