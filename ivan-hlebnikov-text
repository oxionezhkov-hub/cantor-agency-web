  .copy-btn,.dl-btn{padding:8px 14px}
  .kit-head{flex-wrap:wrap}
  .tg-body{padding:24px 20px 28px}
  .tr-section{padding:22px 18px}
  .tr-toc ol{grid-template-columns:1fr}
  .tr-line{flex-direction:column;gap:4px}
  .tr-who{flex:none}
  .tabs{justify-content:flex-start}
  .tab-btn{padding:9px 15px;font-size:12.5px}
}
