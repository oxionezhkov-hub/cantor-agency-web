  const cn={'Авито':'ЗП специалистов Авито','Профи':'ЗП специалистов Профи','Блогеры':'ЗП специалистов Блогеры','Сайты-визитки':'ЗП специалистов Сайты','MBA Личный бренд':'ЗП команды MBA','Яндекс Директ':'ЗП специалистов Яндекс Директ','ТБ Авито':'Тестовые балансы Авито','ТБ Профи':'Тестовые балансы Профи'};
  return `
  <section class="panel"><div class="panel-b tw" style="padding-top:12px"><table data-tk="cf">
    <thead><tr><th></th>${cols.map(m=>`<th class="n${m===CUR?' cur':''}">${MN[m]}</th>`).join('')}<th class="n"><button class="addm" data-addmonth title="Добавить месяц" aria-label="Добавить месяц">+</button>Итого</th></tr></thead><tbody>
