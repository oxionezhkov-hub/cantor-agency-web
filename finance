V.clients=()=>{
  const cm=FACT_MONTHS;
  const act=CLIENTS.filter(c=>c.status==='Активен'),gone=CLIENTS.filter(c=>c.status!=='Активен');
  const PAYS=CLIENTS.map(clientPays);
  // Активные сверху, внутри — по фамилии (последнее слово имени).
  const surname=c=>{const w=normName(c.name);return (w[w.length-1]||'')+' '+w.join(' ')};
  const ORDER=CLIENTS.map((c,i)=>i).sort((i,j)=>(CLIENTS[i].status!=='Активен')-(CLIENTS[j].status!=='Активен')||surname(CLIENTS[i]).localeCompare(surname(CLIENTS[j]),'ru'));
  const tot=sum(PAYS,p=>sum(Object.values(p)));
  const life=c=>{const end=c.left||NOW;return Math.max(1,(new Date(end)-new Date(c.start))/864e5/30.4)};
  const byDir=DIRS.map(d=>({d,v:sum(OPS.filter(o=>o.cat===d&&o.kind==='rev'),o=>o.amt),n:new Set(OPS.filter(o=>o.cat===d&&o.kind==='rev').map(o=>o.client)).size})).filter(x=>x.v);
  return `
  <section class="panel"><div class="panel-b tw" style="padding-top:12px"><table data-tk="clients">
    <thead><tr><th>Клиент</th><th>Старт</th><th>Статус</th><th>След. оплата</th>${cm.map(m=>`<th class="n">${MN[m]}</th>`).join('')}<th class="n">Всего</th></tr></thead><tbody>
    ${ORDER.map(ci=>{const c=CLIENTS[ci];return `<tr class="clk${openCl===ci?' sel':''}" data-cl="${ci}"><td><b style="color:var(--ink)">${esc(c.name)}</b>${c.note?`<i class="info" data-tipcell="${esc(c.note)}" tabindex="0" aria-label="Примечание">i</i>`:''}</td><td class="num">${dt(c.start)}</td><td>${c.status==='Активен'?'<span class="st on">Активен</span>':`<span class="st off">Ушёл ${dt(c.left)}<i class="info" data-tipcell="${esc(c.reason)} · ${life(c).toFixed(1).replace('.',',')} мес с нами" tabindex="0" aria-label="Причина ухода">i</i></span>`}</td><td>${(()=>{const n=nextPay(c),soon=n&&(new Date(n)-new Date(NOW))/864e5<=7;return `<button type="button" class="cal nx${n?(soon?' soon':''):' empty'}" data-cal="cl" data-ci="${ci}" title="Изменить дату"><span>${n?dt(n):'—'}</span></button>`})()}</td>${cm.map(m=>cell(PAYS[ci][m]||0)).join('')}<td class="n"><b>${rub(sum(Object.values(PAYS[ci])))}</b></td></tr>${openCl===ci?clCard(c,ci,cm.length+5):''}`}).join('')}
    <tr class="newrow" data-clnew title="Добавить клиента"><td colspan="${cm.length+5}"><span>+</span></td></tr>
    <tr class="tot"><td colspan="4">Итого</td>${cm.map(m=>cell(sum(PAYS,p=>p[m]||0))).join('')}${cell(tot)}</tr>
  </tbody></table></div></section>
`
};

function beCalc(){
  const g=id=>+String(document.getElementById(id).value).replace(/[^\d]/g,'')||0, f=g('be-f'),p=g('be-p'),c=g('be-c');
  const per=p*(1-TAX-0.013)-c, need=per>0?Math.ceil(f/per):Infinity, have=CLIENTS.filter(x=>x.status==='Активен').length, ok=have>=need;
  document.getElementById('be-out').innerHTML=`<div class="be">
    <div class="be-n"><span class="big">${have}</span><span class="be-of">из ${isFinite(need)?need:'—'}</span></div>
    <div class="be-r"><span class="muted">${rub(per)} с клиента</span></div>
  </div>
  <div class="bar" style="height:8px;margin-top:10px"><i style="width:${isFinite(need)?Math.min(100,have/need*100):0}%;background:${ok?'var(--green)':'var(--amber)'}"></i></div>`
}


