    ${row('Всего поступлений',tIn,'tot')}
    ${grp('Списания','opex')}
    ${OUT.filter(c=>EXTRA.cogs.includes(c)||EXTRA.opex.includes(c)||used('out',c)).map(c=>row(esc(LBL['cogs:'+c]||LBL['opex:'+c]||cn[c]||c),o=>o.out[c],'',-1,{s:'out',k:c})).join('')}
    ${row('Всего списаний',tOut,'tot',-1)}
