const GEAR='<svg class="ic" viewBox="0 0 24 24"><path d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1"/><circle cx="15" cy="6" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="17" cy="18" r="2"/></svg>';
const rowKey=tr=>tr.cells[0].textContent.trim();
const colNames=tb=>[...tb.tHead.rows[0].cells].map(c=>c.textContent.trim());
function tsOf(key){return TS[key]||(TS[key]={c:[],r:[]})}
function enhanceTables(){
  document.querySelectorAll('table[data-tk]').forEach(tb=>{
    tb.tHead.rows[0].cells[0].insertAdjacentHTML('afterbegin',`<button class="gear" data-gear="${tb.dataset.tk}" title="Строки и столбцы" aria-label="Настроить строки и столбцы">${GEAR}</button>`);
    applyTS(tb)})
}
function applyTS(tb){
  const st=tsOf(tb.dataset.tk), hide=colNames(tb).map((n,i)=>i>0&&st.c.includes(n));
  [...tb.rows].forEach(tr=>{let ci=0;
    [...tr.cells].forEach(c=>{const span=c.colSpan||1;let all=true;for(let i=ci;i<ci+span;i++)if(!hide[i])all=false;c.hidden=all;ci+=span});
    if(tr.parentNode.tagName==='TBODY'&&!tr.classList.contains('grp'))tr.hidden=st.r.includes(rowKey(tr))})
}
function markCur(){
  document.querySelectorAll('.curcol').forEach(x=>x.remove());
  document.querySelectorAll('.tw table').forEach(tb=>{const th=tb.querySelector('thead th.cur');if(!th||th.hidden)return;
    const w=tb.parentNode,o=document.createElement('div');o.className='curcol';
    o.style.left=(tb.offsetLeft+th.offsetLeft)+'px';o.style.top=tb.offsetTop+'px';o.style.width=th.offsetWidth+'px';o.style.height=tb.offsetHeight+'px';w.appendChild(o)})
