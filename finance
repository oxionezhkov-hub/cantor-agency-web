<main id="app"></main>

<script>
// ── API ──
// Страница на cantor.agency, API — в воркере Cloudflare. Как в Avito Tasks: без VPN *.workers.dev
// из РФ часто не открывается, поэтому запросы идут через функцию Яндекс Облака (yc-dashboard-api-proxy,
// пропускает /api/dashboard/*), а если она не ответила — напрямую в воркер.
const API_BASE='https://mainweb.oxion-ezhkov.workers.dev';
const API_PROXY_URL='https://functions.yandexcloud.net/d4eiu56ijlg0jn5o9rch';
const API_PATH='/api/dashboard/finance/';
// Вход — тот же токен, что у руководителя в Avito Tasks; если его нет, код из Telegram.
const K_TOKEN='fin.token', K_AT_TOKEN='avitoTasks.token';
const ROUTES=(()=>{const host=location.hostname,same=p=>location.origin+p,direct=p=>API_BASE+p,proxy=p=>API_PROXY_URL+'?p='+encodeURIComponent(p);
  if(host==='localhost'||host==='127.0.0.1')return [same];
  if(/workers\.dev$/.test(host))return [same,proxy];
  return [proxy,direct]})();
let routeFirst=0, TOKEN=null;
const lsGet=k=>{try{return localStorage.getItem(k)}catch(e){return null}};
const lsSet=(k,v)=>{try{localStorage.setItem(k,v)}catch(e){}};
const lsDel=k=>{try{localStorage.removeItem(k)}catch(e){}};
async function api(action,body){
  const payload=JSON.stringify(Object.assign({token:TOKEN},body||{}));let lastErr;
  for(let n=0;n<ROUTES.length;n++){const idx=(routeFirst+n)%ROUTES.length;
    try{const ctrl=new AbortController(),timer=setTimeout(()=>ctrl.abort(),25000);
      const res=await fetch(ROUTES[idx](API_PATH+action),{method:'POST',headers:{'Content-Type':'application/json'},body:payload,signal:ctrl.signal});
      clearTimeout(timer);const data=await res.json().catch(()=>({}));
      if((res.status===502||res.status===504)&&n<ROUTES.length-1)continue;
      routeFirst=idx;return{ok:res.ok,status:res.status,data}}catch(e){lastErr=e}}
  throw lastErr||new Error('network')
}

// ── справочники ──
const MNAMES=['Январь','Февраль','Март','Апрель','Май','Июнь','Июль','Август','Сентябрь','Октябрь','Ноябрь','Декабрь'];
// Сегодня по Москве
const NOW=new Date(Date.now()+3*3600e3).toISOString().slice(0,10), CUR=NOW.slice(0,7), YEAR=+NOW.slice(0,4);
let MONTHS=[], FACT_MONTHS=[];
const MN={};
const monthName=k=>{const [y,m]=k.split('-').map(Number);return MNAMES[m-1]+(y!==YEAR?' '+y:'')};
const DIRS=['Авито','Профи','Блогеры','Сайты-визитки','MBA Личный бренд'];
const DCOL={'Авито первичные':'var(--c1)','Авито продления':'#F08C00','Авито':'var(--c1)','Профи':'var(--c2)','Блогеры':'var(--c3)','Сайты-визитки':'var(--c4)','MBA Личный бренд':'var(--c5)','Яндекс Директ':'var(--c6)'};
const TAX=0.08;
// Данные (операции, планы, остатки, сотрудники, клиенты) приходят с сервера — см. load().
let OPS=[], PLAN={}, CFP={}, SNAPS=[], STAFF=[], CLIENTS=[];
const MAIN_ACCS=['Альфа','Плати по миру'];
const ACCS=[
 {id:'Альфа',kind:'Расчётный счёт',bank:true},
 {id:'Плати по миру',kind:'Карта для зарубежных сервисов',bank:true},
 {id:'Олег',kind:'Личная карта руководителя',owner:true},
 {id:'Stripe',kind:'Приём оплат из-за рубежа',bank:true},
 {id:'Скулсмарт',kind:'Счёт партнёра',bank:false}
];
// ── разбор журнала ──
const ACTIVE_FROM=new Date(Date.parse(NOW)-35*864e5).toISOString().slice(0,10);
const nextId=()=>OPS.reduce((m,o)=>Math.max(m,o.id),0)+1;
function classify(o){
  const n=o.n.toLowerCase(), tail=(o.n.split(' - ')[1]||'').toLowerCase();
  o.amt=o.inc||-o.out;
  if(o.inc){
    if(n.startsWith('зп ')){o.kind='fin';o.cat='Финансирование от партнёра';return o}
    o.kind='rev';o.cat=n.includes('mba')?'MBA Личный бренд':n.startsWith('авито')?(n.includes('продлен')?'Авито продления':'Авито первичные'):n.startsWith('профи')?'Профи':n.startsWith('блогер')?'Блогеры':n.startsWith('сайт')?'Сайты-визитки':'Прочее';
    o.renew=n.includes('продлен');
    const h=o.n.match(/@[\w.]+/);o.client=h?h[0]:(n.includes('schoolsmart')?'Schoolsmart':'');
    return o}
  if(n.startsWith('зп ')){
    o.emp=o.n.slice(3).split(/[\s-]/)[0].replace('София','Софья');
    const t=tail;
    o.cat=t.includes('руковод')?'Руководитель':t.includes('клиент')?'Клиентские менеджеры':t.includes('ассист')?'Ассистент':t.includes('авито')?'Авито':t.includes('профи')?'Профи':t.includes('блогер')?'Блогеры':t.includes('сайт')?'Сайты-визитки':(t.includes('mba')||t.includes('подкаст'))?'MBA Личный бренд':'Прочее';
    o.kind=['Руководитель','Клиентские менеджеры','Ассистент'].includes(o.cat)?'opex':'cogs';o.sal=true;return o}
  if(n.includes('баланс')){o.kind='cogs';o.cat=n.includes('профи')?'ТБ Профи':'ТБ Авито';return o}
  if(n.includes('возврат')){o.kind='refund';o.cat='Возвраты клиентам';return o}
  if(n.includes('дивиденд')){o.kind='div';o.cat='Дивиденды';return o}
  if(n.includes('комиси')||n.includes('комисси')){o.kind='opex';o.cat='Комиссии банка';return o}
  o.kind='opex';o.cat='Сервисы и админ';return o
}
const mOf=o=>o.d.slice(0,7);
const sum=(a,f)=>a.reduce((s,x)=>s+(f?f(x):x),0);

// ── форматирование ──
const nf=new Intl.NumberFormat('ru-RU',{maximumFractionDigits:0});
const rub=v=>(Math.round(v)<0?'−':'')+nf.format(Math.abs(Math.round(v)))+' ₽';
const k=v=>{const a=Math.abs(v),s=v<0?'−':'';return a>=1e6?s+(a/1e6).toFixed(2).replace('.',',')+' млн':a>=1e3?s+Math.round(a/1e3)+' тыс':s+Math.round(a)};
const pct=v=>isFinite(v)?(Math.round(v*1000)/10).toString().replace('.',',')+' %':'—';
const dt=s=>s.slice(8,10)+'.'+s.slice(5,7);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const cell=(v,cls='')=>`<td class="n ${cls}${Math.round(v)===0?' zero':''}">${rub(v)}</td>`;

// ── расчёт P&L по месяцу (кассовый метод) ──
// Свои названия статей и добавленные статьи (rev / cogs / opex)
let LBL={}, EXTRA={rev:[],cogs:[],opex:[]};
const savePC=()=>persist();
const OPEX_BASE=['Руководитель','Клиентские менеджеры','Ассистент','Сервисы и админ','Комиссии банка'];
const REV_KEYS=()=>['Авито первичные','Авито продления',...DIRS.filter(d=>d!=='Авито'),...EXTRA.rev], COGS_KEYS=()=>[...DIRS,'ТБ Авито','ТБ Профи',...EXTRA.cogs], OPEX_KEYS=()=>[...OPEX_BASE,...EXTRA.opex];
const kindForCat=c=>(EXTRA.rev.includes(c)||c==='Авито первичные'||c==='Авито продления')?'rev':EXTRA.cogs.includes(c)?'cogs':EXTRA.opex.includes(c)?'opex':null;
const lblOf=(kind,cat,def)=>LBL[kind+':'+cat]||def||cat;
// Выручка в P&L — только подтверждённая: оплата с подписанным актом, в месяце акта.
// Расходы, возвраты и всё в CF — по дате денег.
const actM=o=>o.act?o.act.slice(0,7):null;
function pnl(m){
  const ops=OPS.filter(o=>mOf(o)===m), by=(kind,cat)=>sum(ops.filter(o=>o.kind===kind&&(!cat||o.cat===cat)),o=>Math.abs(o.amt));
  const acted=OPS.filter(o=>o.kind==='rev'&&actM(o)===m);
  const rev={};REV_KEYS().forEach(d=>rev[d]=sum(acted.filter(o=>o.cat===d),o=>o.amt));
  const noAct=sum(ops.filter(o=>o.kind==='rev'&&!o.act),o=>o.amt);
  const refunds=by('refund');
  const cogs={};COGS_KEYS().forEach(c=>cogs[c]=by('cogs',c));
  const opex={};OPEX_KEYS().forEach(c=>opex[c]=by('opex',c));
  return Object.assign(finish({rev,refunds,cogs,opex,div:by('div')}),{noAct})
}
function planPnl(m){
  const p=PLAN[m];if(!p)return null;
  const rev={},cogs={},opex={};REV_KEYS().forEach(d=>rev[d]=p.rev[d]||0);
  COGS_KEYS().forEach(c=>cogs[c]=p.cogs[c]||0);
  OPEX_KEYS().forEach(c=>opex[c]=p.opex[c]||0);
  return finish({rev,refunds:0,cogs,opex,div:0})
}
function finish(x){
  x.revT=sum(Object.values(x.rev));x.net=x.revT-x.refunds;x.cogsT=sum(Object.values(x.cogs));
  x.gross=x.net-x.cogsT;x.gm=x.net>0?x.gross/x.net:NaN;x.opexT=sum(Object.values(x.opex));
  x.ebitda=x.gross-x.opexT;x.tax=x.revT*TAX;x.np=x.ebitda-x.tax;x.npm=x.net>0?x.np/x.net:NaN;return x
}
const P={},PP={};

// ── ДДС ──
function cf(m){const ops=OPS.filter(o=>mOf(o)===m);return{inc:sum(ops.filter(o=>o.amt>0),o=>o.amt),out:sum(ops.filter(o=>o.amt<0),o=>-o.amt),fin:sum(ops.filter(o=>o.kind==='fin'),o=>o.amt)}}
function cfAll(){let bal=0;return MONTHS.map(m=>{const c=cf(m);c.m=m;c.start=bal;bal+=c.inc-c.out;c.end=bal;return c})}

// ── состояние ──
const TABS=[['overview','Обзор'],['pnl','P&L'],['cf','CF'],['ops','Операции'],['staff','Сотрудники'],['clients','Клиенты']];
let editId=null, openCl=null;
let opDate=NOW, opType='out', calMonth=null, payDate=NOW, openEmp=null;
let CFG={accs:{off:[],extra:[]},cats:{off:[],extra:[]}};
const saveCFG=()=>persist();
const allAccs=()=>[...new Set([...ACCS.map(a=>a.id),...CFG.accs.extra])];
const allCats=()=>[...new Set([...OPS.map(o=>o.cat),...CFG.cats.extra,...EXTRA.rev,...EXTRA.cogs,...EXTRA.opex])];
let tab='overview', opsFilter={q:'',kind:'',acc:'',m:'',cat:''};
try{const t=localStorage.getItem('fin.tab');if(t&&TABS.some(x=>x[0]===t))tab=t}catch(e){}
