function barsChart(series,opts={}){
  // series: [{m, bars:[{v,color}], line?}]
  const W=opts.w||720,H=opts.h||240,pl=56,pr=12,pt=14,pb=28,iw=W-pl-pr,ih=H-pt-pb;
  let vals=[];series.forEach(s=>{s.bars.forEach(b=>vals.push(b.v));if(s.line!=null)vals.push(s.line)});
  let max=Math.max(0,...vals),min=Math.min(0,...vals);const step=nice((max-min)/4);max=Math.ceil(max/step)*step;min=Math.floor(min/step)*step;if(max===min)max=step;
  const y=v=>pt+ih*(max-v)/(max-min), bw=iw/series.length;
  let g='';for(let v=min;v<=max+1;v+=step)g+=`<line class="${v===0?'zl':'gl'}" x1="${pl}" x2="${W-pr}" y1="${y(v)}" y2="${y(v)}"/><text x="${pl-8}" y="${y(v)+4}" text-anchor="end">${k(v)}</text>`;
  series.forEach((s,i)=>{const n=s.bars.length,gw=bw*.62,w=gw/n,x0=pl+bw*i+(bw-gw)/2;
    s.bars.forEach((b,j)=>{const y1=y(Math.max(0,b.v)),y2=y(Math.min(0,b.v));g+=`<rect x="${x0+j*w+1}" y="${y1}" width="${Math.max(1,w-2)}" height="${Math.max(1,y2-y1)}" rx="3" fill="${b.color}" ${b.op?`opacity="${b.op}"`:''} class="mk" data-tip="${esc((MN[s.m]||s.m)+(b.name?' · '+b.name:''))}|${rub(b.v)}"></rect>`});
    g+=`<text x="${pl+bw*i+bw/2}" y="${H-8}" text-anchor="middle">${(MN[s.m]||s.m)}</text>`});
  const lp=series.map((s,i)=>s.line==null?null:[pl+bw*i+bw/2,y(s.line),s]).filter(Boolean);
  if(lp.length){g+=`<polyline fill="none" stroke="var(--ink)" stroke-width="2" points="${lp.map(p=>p[0]+','+p[1]).join(' ')}"/>`;
    lp.forEach((p,i)=>g+=`<circle cx="${p[0]}" cy="${p[1]}" r="${i===lp.length-1?4.5:3}" fill="var(--surface)" stroke="var(--ink)" stroke-width="2" class="mk" data-tip="${esc(MN[p[2].m]+(opts.lineName?' · '+opts.lineName:''))}|${rub(p[2].line)}"></circle>`)}
  return `<svg class="chart" viewBox="0 0 ${W} ${H}" role="img">${g}</svg>`
}
function nice(x){if(x<=0)return 1;const p=Math.pow(10,Math.floor(Math.log10(x))),f=x/p;return (f<=1?1:f<=2?2:f<=2.5?2.5:f<=5?5:10)*p}
const legend=items=>`<div class="legend">${items.map(([c,t,line])=>`<span>${line?`<svg width="18" height="10"><line x1="0" x2="18" y1="5" y2="5" stroke="${c}" stroke-width="2"/><circle cx="9" cy="5" r="3" fill="var(--surface)" stroke="${c}" stroke-width="2"/></svg>`:`<i class="dot" style="background:${c}"></i>`}${t}</span>`).join('')}</div>`;

