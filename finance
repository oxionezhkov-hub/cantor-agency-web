  const fact=m=>{const o={in:{},out:{}};OPS.filter(x=>mOf(x)===m).forEach(x=>{const s=x.amt>0?o.in:o.out;s[x.cat]=(s[x.cat]||0)+Math.abs(x.amt)});return o};
  const F={},PL={};cols.forEach(m=>{F[m]=m<=CUR?fact(m):null;PL[m]=CFP[m]||null});
  const tIn=o=>o&&sum(Object.values(o.in)), tOut=o=>o&&sum(Object.values(o.out));
  // Остатки: факт — по журналу; план — от фактического остатка прошлого месяца (для будущих — от планового)
  const bal={};let fEnd=0,pEnd=0;cols.forEach(m=>{const f=F[m],p=PL[m],fs=fEnd,ps=m<=CUR?fEnd:pEnd;
