function openCal(btn,cur,onPick,onClear){
  closeDD();const pop=document.createElement('div');pop.className='ddm calp';document.body.appendChild(pop);
  let cm=(cur||NOW).slice(0,7);
  const draw=()=>{const [y,m]=cm.split('-').map(Number), first=new Date(y,m-1,1), days=new Date(y,m,0).getDate(), off=(first.getDay()+6)%7;
    const iso=d=>`${y}-${String(m).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    let cells='';for(let i=0;i<off;i++)cells+='<span></span>';
    for(let d=1;d<=days;d++){const v=iso(d);cells+=`<button type="button" class="cd${v===cur?' on':''}${v===NOW?' today':''}" data-day="${v}">${d}</button>`}
    pop.innerHTML=`<div class="cal-h"><button type="button" class="icon-btn" data-cm="-1" aria-label="Предыдущий месяц"><svg class="ic" viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"/></svg></button><b>${MNAMES[m-1]} ${y}</b><button type="button" class="icon-btn" data-cm="1" aria-label="Следующий месяц"><svg class="ic" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg></button></div>
      <div class="cal-g">${['Пн','Вт','Ср','Чт','Пт','Сб','Вс'].map(w=>`<i>${w}</i>`).join('')}${cells}</div>${onClear?'<button type="button" class="cal-clear" data-calclear>Без даты</button>':''}`};
  draw();const r=btn.getBoundingClientRect();pop.style.top=(r.bottom+window.scrollY+4)+'px';pop.style.left=Math.max(16,r.left+window.scrollX)+'px';btn.classList.add('on');
  pop.addEventListener('click',e=>{e.stopPropagation();const c=e.target.closest('[data-cm]');if(c){const [y,m]=cm.split('-').map(Number),d=new Date(y,m-1+(+c.dataset.cm),1);cm=`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;draw();return}
    if(e.target.closest('[data-calclear]')){closeDD();onClear();return}
    const d=e.target.closest('[data-day]');if(d){onPick(d.dataset.day);btn.querySelector('span').textContent=dt(d.dataset.day);closeDD()}});
}

