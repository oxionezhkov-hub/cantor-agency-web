<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="robots" content="noindex, nofollow">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#F4F3F0" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)">
<script>
  // Тема та же, что в Avito Tasks (общая настройка). Ставим до отрисовки, чтобы не мигало.
  try { var t = localStorage.getItem('avitoTasks.theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
</script>
<title>Финансы · Cantor</title>
<link rel="preload" href="/fonts/geologica-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="icon" type="image/svg+xml" href="/images/brand/favicon.svg">
<style>
/* Layout: sticky top bar with tabs, single 1120px column of panels — same shell as Avito Tasks. */
:root{
  --accent:#E8391D;--accent-600:#C42D13;--accent-bg:#FFF0EB;--accent-ring:rgba(232,57,29,.16);
  --bg:#F4F3F0;--surface:#fff;--surface-2:#FAF9F7;--sunken:#EFEDE9;
  --line:#E5E2DD;--line-2:#EEECE8;
  --ink:#151515;--text:#2A2927;--muted:#76716A;--faint:#A7A29B;
  --green:#1C8048;--green-bg:#E6F4EC;--amber:#B06500;--amber-bg:#FFF2DA;--blue:#2556C4;--blue-bg:#E9EFFC;--red:#D5311A;--red-bg:#FDEBE7;
  --c1:#E8391D;--c2:#2556C4;--c3:#1C8048;--c4:#B06500;--c5:#7A4FC9;--c6:#76716A;
  --shadow:0 1px 2px rgba(22,20,18,.04),0 3px 12px rgba(22,20,18,.05);
  --shadow-lg:0 18px 48px rgba(22,20,18,.16);
  --r:14px;--r-sm:10px;
  --font:'Geologica',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  --display:'Unbounded','Geologica',sans-serif;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --accent:#FF5A3C;--accent-600:#FF7A60;--accent-bg:#3A1C15;--accent-ring:rgba(255,90,60,.22);
  --bg:#121211;--surface:#1B1A19;--surface-2:#201F1D;--sunken:#161514;--line:#2E2C2A;--line-2:#282624;
  --ink:#F4F2EE;--text:#DEDAD4;--muted:#A19B93;--faint:#6E6962;
  --green:#4CC784;--green-bg:#133222;--amber:#F2A93B;--amber-bg:#35270D;--blue:#7FA2F5;--blue-bg:#18264A;--red:#FF6F57;--red-bg:#3D1812;
  --c1:#FF5A3C;--c2:#7FA2F5;--c3:#4CC784;--c4:#F2A93B;--c5:#B595F0;--c6:#A19B93;
  --shadow:0 1px 2px rgba(0,0,0,.3);--shadow-lg:0 18px 48px rgba(0,0,0,.5);color-scheme:dark}}
:root[data-theme="dark"]{
  --accent:#FF5A3C;--accent-600:#FF7A60;--accent-bg:#3A1C15;--accent-ring:rgba(255,90,60,.22);
  --bg:#121211;--surface:#1B1A19;--surface-2:#201F1D;--sunken:#161514;--line:#2E2C2A;--line-2:#282624;
  --ink:#F4F2EE;--text:#DEDAD4;--muted:#A19B93;--faint:#6E6962;
  --green:#4CC784;--green-bg:#133222;--amber:#F2A93B;--amber-bg:#35270D;--blue:#7FA2F5;--blue-bg:#18264A;--red:#FF6F57;--red-bg:#3D1812;
  --c1:#FF5A3C;--c2:#7FA2F5;--c3:#4CC784;--c4:#F2A93B;--c5:#B595F0;--c6:#A19B93;
  --shadow:0 1px 2px rgba(0,0,0,.3);--shadow-lg:0 18px 48px rgba(0,0,0,.5);color-scheme:dark}
*{box-sizing:border-box;margin:0;padding:0}
html{overflow-y:scroll;scrollbar-gutter:stable}
@supports not selector(::-webkit-scrollbar){*{scrollbar-width:thin;scrollbar-color:var(--line) transparent}}
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--line);border-radius:999px;border:2px solid var(--bg)}
::-webkit-scrollbar-thumb:hover{background:var(--faint)}
::-webkit-scrollbar-button{display:none!important;width:0;height:0}
::-webkit-scrollbar-button:single-button{display:none!important}
::-webkit-scrollbar-corner{background:transparent}
body{font-family:var(--font);font-size:15px;line-height:1.5;color:var(--text);background:var(--bg);-webkit-font-smoothing:antialiased;overflow-x:hidden}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:31;background:var(--bg)}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer;background:none;border:0}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:8px}
.num,td.n,th.n{font-variant-numeric:tabular-nums}
.muted{color:var(--muted)}

.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:30;background:color-mix(in srgb,var(--bg) 86%,transparent);backdrop-filter:saturate(1.4) blur(14px);-webkit-backdrop-filter:saturate(1.4) blur(14px);border-bottom:1px solid var(--line-2)}
.top-in{max-width:1160px;margin:0 auto;min-height:60px;display:flex;align-items:center;gap:14px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.brand{display:flex;align-items:center;gap:10px;flex:none}
.logo{width:32px;height:32px;border-radius:10px;background:var(--accent);color:#fff;display:grid;place-items:center;font-family:var(--display);font-weight:700;font-size:15px}
.brand b{font-family:var(--display);font-size:14px;color:var(--ink);letter-spacing:-.01em}
.tabs{display:flex;gap:4px;min-width:0;overflow-x:auto;scrollbar-width:none;flex:1}
.tabs::-webkit-scrollbar{display:none}
.tab{flex:none;height:36px;padding:0 14px;border-radius:999px;font-weight:600;font-size:14px;color:var(--muted);display:inline-flex;align-items:center;gap:7px;border:1px solid transparent}
.tab:hover{color:var(--ink);background:var(--sunken)}
.tab.on{color:var(--ink);background:var(--surface);box-shadow:var(--shadow);border-color:var(--line)}
.tab .count{font-size:11px;font-weight:700;background:var(--accent);color:#fff;border-radius:999px;padding:1px 6px;line-height:1.5}
.icon-btn{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;color:var(--muted);flex:none}
.icon-btn:hover{background:var(--sunken);color:var(--ink)}
.ic{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}

main{max-width:1160px;margin:0 auto;padding-block:22px 64px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:grid;gap:18px}
.mock{display:flex;gap:10px;align-items:flex-start;background:var(--blue-bg);color:var(--blue);border-radius:var(--r);padding:12px 16px;font-size:13.5px}
.mock b{font-weight:600}
.hello{display:flex;align-items:flex-end;justify-content:flex-end;gap:12px;flex-wrap:wrap}
.hello h1{font-family:var(--display);font-size:22px;font-weight:700;color:var(--ink);letter-spacing:-.015em;line-height:1.25;text-wrap:balance}
.hello p{color:var(--muted);font-size:14px}
.seg{display:inline-flex;background:var(--sunken);border-radius:999px;padding:3px;gap:2px;flex-wrap:wrap}
.seg button{height:30px;padding:0 12px;border-radius:999px;font-size:13px;font-weight:600;color:var(--muted)}
.seg button.on{background:var(--surface);color:var(--ink);box-shadow:var(--shadow)}

.panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);min-width:0}
.panel-h{display:flex;align-items:center;gap:10px;padding:16px 18px 6px;flex-wrap:wrap}
.panel-h h2{font-size:15px;font-weight:700;color:var(--ink);flex:1;min-width:0}
.panel-h .hint{font-size:12.5px;color:var(--muted)}
.panel-b{padding:8px 18px 18px}
.grid{display:grid;gap:18px}
.g2{grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr))}
.g3{grid-template-columns:2fr 1fr}
@media (max-width:860px){.g3{grid-template-columns:1fr}}

.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,170px),1fr));gap:12px}
.kpi{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:14px 16px;box-shadow:var(--shadow);display:grid;gap:2px;align-content:start}
.kpi .l{font-size:12px;font-weight:600;color:var(--muted);letter-spacing:.01em}
.kpi .v{font-family:var(--display);font-size:20px;font-weight:700;color:var(--ink);line-height:1.3;font-variant-numeric:tabular-nums;white-space:nowrap}
.kpi .s{font-size:12.5px;color:var(--muted)}
.up{color:var(--green)}.down{color:var(--red)}.warn{color:var(--amber)}

.pill{display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;border-radius:999px;padding:2px 9px;line-height:1.6;white-space:nowrap}
.pill.g{background:var(--green-bg);color:var(--green)}.pill.r{background:var(--red-bg);color:var(--red)}.pill.a{background:var(--amber-bg);color:var(--amber)}.pill.b{background:var(--blue-bg);color:var(--blue)}.pill.n{background:var(--sunken);color:var(--muted)}
.dot{width:8px;height:8px;border-radius:50%;display:inline-block;flex:none}

.tw{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:13.5px}
th{font-size:11.5px;font-weight:600;color:var(--muted);text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);white-space:nowrap;letter-spacing:.02em}
td{padding:8px 10px;border-bottom:1px solid var(--line-2);white-space:nowrap}
td.n,th.n{text-align:right}
td.wrap{white-space:normal;min-width:200px}
tr.grp td{font-size:11.5px;font-weight:700;color:var(--muted);letter-spacing:.06em;text-transform:uppercase;background:var(--surface-2);padding-top:10px}
tr.tot td{font-weight:700;color:var(--ink);background:var(--surface-2)}
tr.key td{font-weight:700;color:var(--ink)}
tr.sub td{color:var(--muted);font-size:12.5px}
td.zero{color:var(--faint)}
th.cur,td.cur{background:transparent}
.tw{position:relative}
.curcol{position:absolute;pointer-events:none;border:2px solid var(--blue);border-radius:10px;z-index:2}
th.cur{color:var(--blue)}
tbody tr:hover td{background:var(--surface-2)}
.pf{display:grid;gap:1px;line-height:1.25}
.pf .p{font-size:11.5px;color:var(--faint)}

.chart{width:100%;height:auto;display:block}
.chart text{fill:var(--muted);font-size:11px;font-family:var(--font)}
.chart .gl{stroke:var(--line-2);stroke-width:1}
.chart .zl{stroke:var(--line);stroke-width:1}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12.5px;color:var(--muted);padding-top:8px}
.legend span{display:inline-flex;align-items:center;gap:6px}

.list{display:grid}
.row{display:flex;gap:12px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line-2)}
.row:last-child{border-bottom:0}
.row .main{flex:1;min-width:0}
.row .t{font-weight:600;color:var(--ink);font-size:14px;overflow-wrap:anywhere}
.row .m{font-size:12.5px;color:var(--muted)}
.row .amt{font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}
.alert-ic{width:32px;height:32px;border-radius:10px;display:grid;place-items:center;flex:none}

.toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.input,.select{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-sm);padding:7px 11px;font-size:13.5px;min-height:36px;min-width:0}
.input:focus,.select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-ring)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:36px;padding:0 14px;border-radius:999px;font-weight:600;font-size:13.5px;border:1px solid transparent;white-space:nowrap}
.btn-primary{background:var(--accent);color:#fff}.btn-primary:hover{background:var(--accent-600)}
.btn-ghost{background:var(--surface);border-color:var(--line);color:var(--ink)}.btn-ghost:hover{border-color:var(--faint)}
.form{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,150px),1fr));gap:10px;align-items:end;padding:14px;background:var(--surface-2);border:1px dashed var(--line);border-radius:var(--r-sm);margin-bottom:12px}
.form label{display:grid;gap:4px;font-size:12px;font-weight:600;color:var(--muted)}
.amt-in{color:var(--green)}.amt-out{color:var(--text)}

.accs{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:12px}
.acc{border:1px solid var(--line);border-radius:var(--r);padding:14px 16px;display:grid;gap:6px;background:var(--surface)}
.acc .nm{display:flex;justify-content:space-between;gap:8px;font-weight:600;color:var(--ink)}
.bal-in{display:inline-flex;max-width:100%;align-items:center;gap:6px;border:1px solid transparent;border-radius:var(--r-sm);padding:2px 8px;margin:0 -9px;cursor:text}
.bal-in:hover{background:var(--sunken)}
.bal-in:focus-within{background:var(--surface);border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-ring)}
.bal-in span{font-family:var(--display);font-size:20px;font-weight:700;color:var(--ink)}
input.bal{field-sizing:content;min-width:1ch;max-width:100%;padding:0;border:0;background:none;outline:none;font-family:var(--display);font-size:20px;font-weight:700;color:var(--ink);font-variant-numeric:tabular-nums}
input.bal::placeholder{color:var(--faint);font-size:14px;font-family:var(--font);font-weight:500}
.acc .ln{display:flex;justify-content:space-between;gap:8px;font-size:12.5px;color:var(--muted)}

.bar{height:8px;border-radius:999px;background:var(--sunken);overflow:hidden;min-width:70px}
.bar i{display:block;height:100%;border-radius:999px;background:var(--accent)}
.calc{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,160px),1fr));gap:10px}
.calc label{display:grid;gap:4px;font-size:12px;font-weight:600;color:var(--muted)}
.big{font-family:var(--display);font-size:28px;font-weight:700;color:var(--ink);line-height:1.2;font-variant-numeric:tabular-nums}
.note{font-size:12.5px;color:var(--muted);line-height:1.5}
.avatar{width:30px;height:30px;border-radius:50%;display:inline-grid;place-items:center;font-size:12px;font-weight:700;color:#fff;flex:none}
.gear{width:26px;height:26px;border-radius:8px;display:inline-grid;place-items:center;color:var(--muted);vertical-align:middle;margin:-4px 6px -4px -6px}
.gear:hover,.gear.on{background:var(--sunken);color:var(--ink)}
.gear .ic{width:16px;height:16px}
.tsp{position:absolute;z-index:40;width:min(380px,calc(100vw - 32px));max-height:min(70vh,520px);display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow-lg);animation:drop .14s ease-out}
@keyframes drop{from{opacity:0;transform:translateY(-6px)}}
.tsp-h{display:flex;align-items:center;gap:8px;padding:12px 12px 10px 16px;border-bottom:1px solid var(--line-2)}
.tsp-h b{flex:1;font-size:14px;color:var(--ink)}
.tsp-b{overflow:auto;padding:8px 8px 12px;display:grid;gap:10px}
.tsp-l{font-size:11.5px;font-weight:700;color:var(--muted);letter-spacing:.06em;text-transform:uppercase;padding:6px 8px 4px}
.tsp-i{display:flex;align-items:center;gap:10px;padding:6px 8px;border-radius:8px;font-size:13.5px;cursor:pointer}
.tsp-i:hover{background:var(--sunken)}
.tsp-i input{width:16px;height:16px;accent-color:var(--accent);flex:none}
.btn-quiet{color:var(--muted)}.btn-quiet:hover{color:var(--ink);background:var(--sunken)}
.btn-sm{min-height:30px;padding:0 10px;font-size:12.5px}
[hidden]{display:none!important}
tr.clk{cursor:pointer}
tr[data-cl] td:first-child::after,tr[data-emp] td:first-child::after{content:"✎";margin-left:8px;color:var(--faint);opacity:0;transition:opacity .15s}
tr[data-cl]:hover td:first-child::after,tr[data-emp]:hover td:first-child::after{opacity:1}
tr.edit td{background:var(--surface-2);border-bottom-color:transparent}
tr.edit .input,tr.edit .select{min-height:34px}
.btn-danger{color:var(--red)}.btn-danger:hover{background:var(--red-bg)}
.opbar{display:flex;gap:8px;align-items:center;padding:10px;background:var(--surface-2);border:1px dashed var(--line);border-radius:var(--r-sm);margin-bottom:12px}
.opbar .grow{flex:1;min-width:160px}
.opbar .amt{width:120px}
.opbar .select{width:auto;max-width:190px}
.opbar .gear{margin:0;width:36px;height:36px}
.cal{position:relative;display:inline-flex;align-items:center;gap:6px;height:36px;padding:0 10px;border-radius:var(--r-sm);border:1px solid var(--line);background:var(--surface);color:var(--muted);cursor:pointer;font-size:13px;font-weight:600;flex:none}
.cal:hover{color:var(--ink);border-color:var(--faint)}
.cal.on{color:var(--ink);border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-ring)}
.cal input{position:absolute;inset:0;opacity:0;pointer-events:none;width:100%}
.tsp-add{display:flex;gap:6px;padding:6px 8px 2px}
.tsp-add .input{flex:1}
@media (max-width:900px){.opbar{flex-wrap:wrap}.opbar .grow{flex-basis:100%}}
.dd-btn{display:inline-flex;align-items:center;justify-content:space-between;gap:6px;text-align:left;cursor:pointer;white-space:nowrap}
.dd-btn span{overflow:hidden;text-overflow:ellipsis;min-width:0}
.dd-btn .ic{width:15px;height:15px;color:var(--muted);flex:none}
.dd-btn:hover{border-color:var(--faint)}
.dd-btn.on{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-ring)}
.ddm{position:absolute;z-index:45;max-width:min(320px,calc(100vw - 32px));overflow:visible;background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow-lg);padding:6px;display:grid;gap:1px;animation:drop .12s ease-out}
.ddo{display:block;width:100%;text-align:left;padding:8px 10px;border-radius:9px;font-size:13.5px;color:var(--text);white-space:nowrap}
.ddo:hover{background:var(--sunken);color:var(--ink)}
.ddo.on{background:var(--accent-bg);color:var(--accent);font-weight:600}
.calp{padding:10px;width:280px}
.cal-h{display:flex;align-items:center;justify-content:space-between;padding:0 0 6px}
.cal-h b{font-size:14px;color:var(--ink)}
.cal-h .icon-btn{width:32px;height:32px}
.cal-g{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;text-align:center}
.cal-g i{font-style:normal;font-size:11px;font-weight:600;color:var(--faint);padding:4px 0}
.cd{height:34px;border-radius:9px;font-size:13.5px;font-variant-numeric:tabular-nums;color:var(--text)}
.cd:hover{background:var(--sunken)}
.cd.today{color:var(--accent);font-weight:700}
.cd.on{background:var(--accent);color:#fff;font-weight:700}
.opbar .seg{flex:none}
.seg .seg-ic{width:34px;padding:0;display:grid;place-items:center}
.seg .seg-ic .ic{width:16px;height:16px}
.seg .seg-ic[data-optype="in"].on{color:var(--green)}
.seg .seg-ic[data-optype="out"].on{color:var(--ink)}
.avm{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;padding:6px 0 0 56px;font-size:12px;color:var(--muted);text-align:center}
.avm div{display:grid;gap:1px}.avm b{color:var(--ink);font-weight:600}
@media (max-width:640px){.avm{padding-left:0}}
.ctip{position:absolute;z-index:60;pointer-events:none;background:var(--ink);color:var(--bg);border-radius:10px;padding:6px 10px;display:grid;gap:1px;font-size:12px;box-shadow:var(--shadow-lg);white-space:nowrap}
.ctip span{opacity:.75}.ctip b{font-size:13.5px;font-variant-numeric:tabular-nums}
.chart .mk{cursor:default;transition:opacity .12s}.chart .mk:hover{opacity:.8}
.tbtn{width:36px;height:36px;border-radius:var(--r-sm);display:grid;place-items:center;flex:none;transition:background .15s,color .15s}
.tbtn .ic{width:18px;height:18px;stroke-width:2.2}
.tbtn.in{background:var(--green-bg);color:var(--green)}.tbtn.in .dn{display:none}
.tbtn.out{background:var(--red-bg);color:var(--red)}.tbtn.out .up{display:none}
.rl{cursor:text;border-radius:6px;padding:1px 4px;margin:-1px -4px}
.rl:hover{background:var(--sunken);color:var(--ink)}
.rl-in{min-height:30px;padding:4px 8px;width:min(260px,100%)}
.grp-in{display:flex;align-items:center;justify-content:space-between;gap:8px}
