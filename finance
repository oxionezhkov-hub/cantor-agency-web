function bind(){
  const $=id=>document.getElementById(id);


  if($('op-v')){$('op-v').addEventListener('focus',()=>openAmt($('op-v')));$('op-v').addEventListener('click',()=>openAmt($('op-v')));
    $('op-v').addEventListener('input',()=>{if($('op-v').value)closeDD()});$('op-v').addEventListener('blur',()=>setTimeout(()=>{const p=document.querySelector('.amtp');if(p&&!p.matches(':hover'))p.remove()},150))}
  if($('addOp'))$('addOp').addEventListener('submit',e=>{e.preventDefault();const v=+String($('op-v').value).replace(/[^\d.]/g,''),inc=$('op-t').value==='in';
    const o=classify({id:nextId(),d:$('op-d').value,n:$('op-n').value.trim(),acc:$('op-a').value,out:inc?0:v,inc:inc?v:0});if($('op-c').value){o.cat=$('op-c').value;const k=kindForCat(o.cat);if(k)o.kind=k}OPS.push(o);recalc();render()});
  ['f-q','f-k','f-a','f-m'].forEach(id=>{if($(id))$(id).addEventListener(id==='f-q'?'input':'change',()=>{opsFilter={q:$('f-q').value,kind:$('f-k').value,acc:$('f-a').value,m:$('f-m').value,cat:opsFilter.cat,am:opsFilter.am};const pos=$('f-q').selectionStart;render();if(id==='f-q'){$('f-q').focus();$('f-q').setSelectionRange(pos,pos)}})});
  document.querySelectorAll('input.bal').forEach(el=>{
    const save=()=>{const v=el.value.replace(/[^\d-]/g,'');if(v==='')return;const acc=el.dataset.acc;
      SNAPS=SNAPS.filter(s=>!(s.acc===acc&&s.d===NOW));SNAPS.push({acc,d:NOW,v:+v});render()};
    el.addEventListener('change',save);el.addEventListener('keydown',e=>{if(e.key==='Enter')el.blur()})});
}
function recalc(){
  // Месяцы до текущего включительно есть всегда; дальше — те, что добавлены кнопкой «+».
  let k=MONTHS.length?MONTHS[MONTHS.length-1]:CUR;while(k<CUR){const [y,m]=k.split('-').map(Number),d=new Date(y,m,1);k=`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;MONTHS.push(k)}
  if(!MONTHS.includes(CUR))MONTHS.push(CUR);
  MONTHS=[...new Set(MONTHS)].sort();MONTHS.forEach(m=>{MN[m]=monthName(m)});FACT_MONTHS=MONTHS.filter(m=>m<=CUR);
  MONTHS.forEach(m=>{P[m]=pnl(m);PP[m]=planPnl(m)})
}
document.addEventListener('click',e=>{
  const cb=e.target.closest('[data-cal]');if(cb){const was=cb.classList.contains('on');closeDD();if(!was){
    if(cb.dataset.cal==='op')openCal(cb,opDate,v=>{opDate=v;document.getElementById('op-d').value=v});
    else if(cb.dataset.cal==='emp'){const s=STAFF[+cb.dataset.si];openCal(cb,s.next||NOW,v=>{s.next=v;s.noNext=false;render()},()=>{s.next=null;s.noNext=true;render()})}
    else if(cb.dataset.cal==='act'){const o=OPS.find(x=>x.id===+cb.dataset.oid);openCal(cb,o.act||o.d,v=>{o.act=v;recalc();render()},o.act?()=>{delete o.act;recalc();render()}:null)}
    else if(cb.dataset.cal==='clstart'){const c=CLIENTS[+cb.dataset.ci];openCal(cb,c.start||NOW,v=>{c.start=v;c.startSet=true;delete c.next;render()})}
    else if(cb.dataset.cal==='clleft'){const c=CLIENTS[+cb.dataset.ci];openCal(cb,c.left||NOW,v=>{c.left=v;render()})}
    else if(cb.dataset.cal==='cl'){const c=CLIENTS[+cb.dataset.ci];openCal(cb,nextPay(c)||NOW,v=>{c.next=v;c.noNext=false;render()},()=>{c.next=null;c.noNext=true;render()})}
    else openCal(cb,payDate,v=>{payDate=v})}return}
  if(!e.target.closest('.ddm,.dd-btn,#op-v'))closeDD();
  const ot=e.target.closest('[data-optoggle]');if(ot){opType=opType==='in'?'out':'in';document.getElementById('op-t').value=opType;ot.classList.toggle('in',opType==='in');ot.classList.toggle('out',opType==='out');const n=opType==='in'?'Приход':'Расход';ot.title=n;ot.setAttribute('aria-label',n+' — нажмите, чтобы переключить');return}
  const ed=e.target.closest('[data-ed]');if(ed){const k=ed.dataset.ed;if(k==='save')saveEdit();else{if(k==='del')OPS=OPS.filter(o=>o.id!==editId);editId=null;recalc();render()}return}
  const tr=e.target.closest('tr[data-op]');if(tr){editId=+tr.dataset.op;render();const n=document.getElementById('e-n');if(n)n.focus();return}
  const pa=e.target.closest('[data-payadd]');if(pa){const s=STAFF[+pa.dataset.payadd],v=+String(document.getElementById('pay-v').value).replace(/[^\d.]/g,'');if(!v)return;
    OPS.push({id:nextId(),d:payDate,n:`ЗП ${s.n} - ${s.role||''}`,acc:document.getElementById('pay-a').value,out:v,inc:0,amt:-v,kind:OPEX_BASE.includes(s.line)?'opex':'cogs',cat:s.line,sal:true,emp:s.n});delete s.isNew;delete s.next;recalc();render();return}
  const pd=e.target.closest('[data-paydel]');if(pd){OPS=OPS.filter(o=>o.id!==+pd.dataset.paydel);recalc();render();return}
  const ed2=e.target.closest('[data-empdel]');if(ed2){STAFF.splice(+ed2.dataset.empdel,1);openEmp=null;render();return}
  if(e.target.closest('[data-empclose]')){openEmp=null;render();return}
  if(e.target.closest('[data-empnew]')){STAFF.push({n:'Новый сотрудник',role:'',rate:'',line:'Авито',pay:'Альфа',isNew:true});openEmp=STAFF.length-1;render();const i=document.querySelector('[data-sf="n"]');if(i){i.focus();i.select()}return}
  const er=e.target.closest('tr[data-emp]');if(er){const i=+er.dataset.emp;openEmp=openEmp===i?null:i;payDate=NOW;render();return}
  const cst=e.target.closest('[data-cst]');if(cst){const c=CLIENTS[+cst.dataset.ci];c.status=cst.dataset.cst;c.manualStatus=true;if(c.status!=='Активен'&&!c.left)c.left=NOW;if(c.status==='Активен'){c.left='';c.reason=''}render();return}
  const cld=e.target.closest('[data-cldel]');if(cld){const gone=CLIENTS[+cld.dataset.cldel];if(gone&&gone.pid)CFG.hiddenPids=[...new Set([...(CFG.hiddenPids||[]),gone.pid])];CLIENTS.splice(+cld.dataset.cldel,1);openCl=null;render();return}
  if(e.target.closest('[data-clclose]')){openCl=null;render();return}
  if(e.target.closest('[data-clnew]')){CLIENTS.push({name:'Новый клиент',tg:'',start:NOW,status:'Активен',left:'',reason:'',note:'',first:50000,renew:25000,pays:{}});openCl=CLIENTS.length-1;render();const i=document.querySelector('[data-cf="name"]');if(i){i.focus();i.select()}return}
  const clr=e.target.closest('tr[data-cl]');if(clr&&!e.target.closest('[data-cal],.info')){const i=+clr.dataset.cl;openCl=openCl===i?null:i;render();return}
  if(e.target.closest('[data-addmonth]')){addMonth();return}
  if(e.target.closest('[data-clearcat]')){opsFilter.cat='';opsFilter.am='';render();return}
  if(e.target.closest('[data-actall]')){const l=window._noActList||[];l.forEach(o=>{o.act=o.d});recalc();render();return}
  const fe=e.target.closest('.fe');if(fe){opsFilter=fe.dataset.fact?{q:'',kind:'',acc:'',m:'',am:fe.dataset.fm,cat:fe.dataset.fc}:{q:'',kind:'',acc:'',m:fe.dataset.fm,cat:fe.dataset.fc};tab='ops';render();window.scrollTo(0,0);return}
  const pe=e.target.closest('.pe');if(pe){const num=v=>Math.abs(+String(v).replace(/[^\d-]/g,'')||0),cur=pe.textContent==='—'?'':String(num(pe.textContent));
    if(pe.dataset.pm){const {pm:m,pg:g,pk:k}=pe.dataset;inlineInput(pe,cur,v=>{PLAN[m]=PLAN[m]||{rev:{},cogs:{},opex:{}};PLAN[m][g]=PLAN[m][g]||{};PLAN[m][g][k]=num(v);PP[m]=planPnl(m);render()})}
    else{const {cpm:m,cs:s,ck:k}=pe.dataset;inlineInput(pe,cur,v=>{CFP[m]=CFP[m]||{in:{},out:{}};CFP[m][s][k]=num(v);render()})}
    const i=document.querySelector('.rl-in');if(i)i.classList.add('pe-in');return}
  const rl=e.target.closest('.rl');if(rl){renameRow(rl);return}
  const ac=e.target.closest('[data-addcat]');if(ac){addCat(ac);return}
  const cg=e.target.closest('[data-opcfg]');if(cg){const was=cg.classList.contains('on');closeTS();if(!was)openCfg(cg);return}
  const g=e.target.closest('[data-gear]');if(g){const was=g.classList.contains('on');closeTS();if(!was)openTS(g);return}
  if(!e.target.closest('.tsp'))closeTS();
  const t=e.target.closest('[data-tab],[data-go]');if(!t)return;
  tab=t.dataset.tab||t.dataset.go;try{localStorage.setItem('fin.tab',tab)}catch(e){}render();window.scrollTo(0,0)
});
document.getElementById('theme').addEventListener('click',()=>{const r=document.documentElement,dark=r.dataset.theme?r.dataset.theme==='dark':matchMedia('(prefers-color-scheme: dark)').matches;r.dataset.theme=dark?'light':'dark';lsSet('avitoTasks.theme',r.dataset.theme);markCur()});
// ── сохранение ──
// Весь дашборд — один документ на сервере. После каждого изменения (render) он уходит на сервер,
// если поменялся; rev защищает от перезаписи из второй вкладки.
let REV=0, lastSaved='', saveTimer=null, saving=false, loaded=false;
const snapshot=()=>JSON.stringify({ops:OPS,plan:PLAN,cfp:CFP,snaps:SNAPS,staff:STAFF,clients:CLIENTS,months:MONTHS,lbl:LBL,extra:EXTRA,cfg:CFG});
function applyData(d){
  OPS=d.ops||[];PLAN=d.plan||{};CFP=d.cfp||{};SNAPS=d.snaps||[];STAFF=d.staff||[];CLIENTS=d.clients||[];MONTHS=(d.months||[]).slice();
  LBL=d.lbl||{};EXTRA=Object.assign({rev:[],cogs:[],opex:[]},d.extra||{});CFG=d.cfg&&d.cfg.accs?d.cfg:{accs:{off:[],extra:[]},cats:{off:[],extra:[]}};
  REV=d.rev||0;recalc();lastSaved=snapshot()
}
function persist(){if(!loaded)return;clearTimeout(saveTimer);saveTimer=setTimeout(doSave,700)}
async function doSave(){
  const snap=snapshot();if(snap===lastSaved||saving)return;saving=true;
  try{const r=await api('save',{data:JSON.parse(snap),rev:REV});
    if(r.ok){REV=r.data.rev;lastSaved=snap}
    else if(r.status===409){toast('Данные изменились в другой вкладке — открыта свежая версия');if(r.data.data)applyData(r.data.data);render()}
    else if(r.status===401||r.status===403){toast('Сессия закончилась — войдите заново');showGate()}
    else toast('Не удалось сохранить — попробую ещё раз');
  }catch(e){toast('Нет связи — изменения сохранятся, когда она появится')}
  saving=false;if(loaded&&snapshot()!==lastSaved)persist()
}
window.addEventListener('beforeunload',e=>{if(loaded&&snapshot()!==lastSaved){e.preventDefault();e.returnValue=''}});
function toast(msg){let t=document.getElementById('toast');if(!t){t=document.createElement('div');t.id='toast';t.className='toast';document.body.appendChild(t)}
  t.textContent=msg;t.hidden=false;clearTimeout(t._h);t._h=setTimeout(()=>{t.hidden=true},4000)}
document.getElementById('exportBtn').addEventListener('click',()=>{
  const blob=new Blob([snapshot()],{type:'application/json'}),a=document.createElement('a');
  a.href=URL.createObjectURL(blob);a.download=`cantor-finance-${NOW}.json`;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),1000)});

// ── вход и загрузка ──
function gateShell(inner){document.getElementById('tabs').innerHTML='';document.getElementById('exportBtn').hidden=true;
  document.getElementById('app').innerHTML=`<div class="gate"><div class="gate-ic"><svg class="ic" viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></div>${inner}</div>`}
function showGate(err){
  loaded=false;TOKEN=null;
  gateShell(`<h1>Финансы</h1><p>Раздел доступен только руководителю. Код для входа придёт в Telegram от бота агентства.</p>
    ${err?`<p class="gate-err">${esc(err)}</p>`:''}<button class="btn btn-primary btn-block" id="gCode">Получить код</button>`);
  document.getElementById('gCode').addEventListener('click',sendCode)
}
async function sendCode(){
  const b=document.getElementById('gCode');b.disabled=true;
  try{const r=await api('login-code',{});
    if(!r.ok){const e=r.data.error;showGate(e==='too_soon'?`Код уже отправлен, новый можно запросить через ${r.data.wait} с`:e==='no_telegram'?'Бот не может вам написать: подключите Telegram в Avito Tasks':'Не удалось отправить код');return}
    const ch=r.data.challenge;
    gateShell(`<h1>Код из Telegram</h1><p>Бот прислал 6 цифр, код действует 10 минут.</p>
      <input class="input gate-code" id="gIn" inputmode="numeric" maxlength="6" autocomplete="one-time-code" aria-label="Код">
      <p class="gate-err" id="gErr"></p><button class="btn btn-primary btn-block" id="gGo">Войти</button>`);
    const inp=document.getElementById('gIn');inp.focus();
    const go=async()=>{const code=inp.value.replace(/\D/g,'');if(code.length!==6)return;
      const v=await api('login-verify',{challenge:ch,code});
      if(v.ok&&v.data.token){TOKEN=v.data.token;lsSet(K_TOKEN,TOKEN);load()}
      else document.getElementById('gErr').textContent=v.data.error==='wrong_code'?`Неверный код, осталось попыток: ${v.data.left}`:v.data.error==='expired'?'Код устарел — запросите новый':'Не получилось войти'};
    document.getElementById('gGo').addEventListener('click',go);inp.addEventListener('input',()=>{if(inp.value.replace(/\D/g,'').length===6)go()});
  }catch(e){showGate('Нет связи с сервером')}
}
function showImport(){
  gateShell(`<h1>Данных пока нет</h1><p>Загрузите файл с данными (cantor-finance-data.json) — с него начнётся дашборд.</p>
    <label class="btn btn-primary btn-block" style="cursor:pointer">Выбрать файл<input type="file" id="gFile" accept="application/json,.json" hidden></label><p class="gate-err" id="gErr"></p>`);
  document.getElementById('gFile').addEventListener('change',async e=>{const f=e.target.files[0];if(!f)return;
    try{const d=JSON.parse(await f.text());if(!Array.isArray(d.ops))throw new Error('bad');
      applyData(Object.assign(d,{rev:0}));lastSaved='';loaded=true;document.getElementById('exportBtn').hidden=false;render();await doSave()}
    catch(err){document.getElementById('gErr').textContent='Это не тот файл'}})
}
async function load(){
  gateShell('<div class="spinner"></div>');
  try{const r=await api('load',{});
    if(r.status===401||r.status===403){
      // Токен трекера не подошёл (не руководитель или вышел) — пробуем свой, иначе вход по коду.
      const own=lsGet(K_TOKEN);
      if(TOKEN===own)lsDel(K_TOKEN);else if(own){TOKEN=own;return load()}
      return showGate(r.data.error==='forbidden'?'Этот раздел только для руководителя':'')}
    if(!r.ok)return showGate('Сервер не ответил, попробуйте ещё раз');
    if(!r.data.data)return showImport();
    applyData(r.data.data);const synced=syncClients(r.data.projects,r.data.crm);loaded=true;if(synced)lastSaved='';document.getElementById('exportBtn').hidden=false;
    const t=lsGet('fin.tab');if(t&&TABS.some(x=>x[0]===t))tab=t;
    render()
  }catch(e){showGate('Нет связи с сервером')}
}
TOKEN=lsGet(K_AT_TOKEN)||lsGet(K_TOKEN);
if(TOKEN)load();else showGate();
</script>
