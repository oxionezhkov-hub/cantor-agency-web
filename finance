    <tr class="tot"><td>Остаток на конец</td>${cols.map(m=>pair(bal[m].fe,bal[m].pe,m===CUR?' cur':'')).join('')}${pair(bal[CUR].fe,fcEnd)}</tr>
  </tbody></table></div></section>`
