function openTS(btn){
  const key=btn.dataset.gear, tb=document.querySelector(`table[data-tk="${key}"]`), st=tsOf(key);
  const cols=colNames(tb).slice(1).filter(Boolean), rows=tb.dataset.rows==='0'?[]:[...new Set([...tb.tBodies[0].rows].filter(r=>!r.classList.contains('grp')).map(rowKey))];
  const chk=(t,n)=>`<label class="tsp-i"><input type="checkbox" data-t="${t}" value="${esc(n)}"${st[t].includes(n)?'':' checked'}>${esc(n)}</label>`;
  const pop=document.createElement('div');pop.className='tsp';
