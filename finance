function inlineInput(host,val,onSave){
  const inp=document.createElement('input');inp.className='input rl-in';inp.value=val;host.replaceWith(inp);inp.focus();inp.select();
  let done=false;const fin=save=>{if(done)return;done=true;const v=inp.value.trim();if(save&&v)onSave(v);else render()};
  inp.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();fin(true)}if(e.key==='Escape')fin(false)});
  inp.addEventListener('blur',()=>fin(true));
}
