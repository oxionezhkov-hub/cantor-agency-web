// ── клиенты ↔ операции и проекты трекера ──
// Оплаты клиента берутся из операций по его Telegram (@ник в назначении платежа: «Авито - @ник СБП»).
// Пока ник не указан — из старого реестра (c.pays).
const handlesOf=c=>String(c.tg||'').split(/[\s,;]+/).map(h=>h.trim().toLowerCase()).filter(h=>h.startsWith('@'));
const clientOps=c=>{const hs=handlesOf(c);return hs.length?OPS.filter(o=>o.kind==='rev'&&o.client&&hs.includes(o.client.toLowerCase())):[]};
function clientPays(c){const ops=clientOps(c);if(!handlesOf(c).length)return c.pays||{};const p={};ops.forEach(o=>{const m=mOf(o);p[m]=(p[m]||0)+o.amt});return p}
// Ник в платеже похож на фамилию: «@OkunevaElena10» ↔ «Елена Окунева».
const TR={а:'a',б:'b',в:'(v|w)',г:'g',д:'d',е:'e',ё:'(e|yo)',ж:'(zh|j)',з:'z',и:'(i|y)',й:'(y|i|j)',к:'(k|c)',л:'l',м:'m',н:'n',о:'o',п:'p',р:'r',с:'s',т:'t',у:'(u|ou)',ф:'f',х:'(h|kh)',ц:'(ts|c)',ч:'ch',ш:'sh',щ:'(sch|shch)',ъ:'',ы:'(y|i)',ь:'',э:'e',ю:'(yu|iu|u)',я:'(ya|ia|a)'};
const nameRe=w=>new RegExp([...w.toLowerCase()].map(ch=>TR[ch]!=null?TR[ch]:ch.replace(/[^a-z0-9]/g,'')).join(''));
function guessHandle(c,free){const words=String(c.name).split(/\s+/).filter(w=>w.length>=4);if(!words.length)return null;
  const sur=nameRe(words[words.length-1]);return free.find(h=>sur.test(h.slice(1)))||null}
const normName=s=>String(s||'').toLowerCase().replace(/ё/g,'е').replace(/\(.*?\)|\|.*$/g,' ').replace(/[^a-zа-я ]+/g,' ').split(/\s+/).filter(Boolean);
// Ник из CRM продаж: строка, где есть все слова имени клиента (сначала со статусом «Продажа»),
// или «Продажа» с одним именем, совпавшим с именем клиента, если такая одна.
function crmHandle(c,crm,taken){
  const words=normName(c.name);if(!words.length)return null;
  const free=crm.filter(r=>r.telegram&&!taken.has('@'+r.telegram));
  const full=free.filter(r=>{const rw=normName(r.name);return words.every(w=>rw.includes(w))});
  const pick=full.find(r=>r.status==='Продажа')||full[0];if(pick)return '@'+pick.telegram;
  const first=free.filter(r=>r.status==='Продажа'&&normName(r.name).length===1&&normName(r.name)[0]===words[0]);
  return first.length===1?'@'+first[0].telegram:null
}
// Одно имя с точностью до опечатки: слова совпадают попарно (в любом порядке), расстояние Левенштейна ≤ 2 на всё имя.
function lev(a,b){const d=[...Array(b.length+1).keys()];for(let i=1;i<=a.length;i++){let p=d[0];d[0]=i;for(let j=1;j<=b.length;j++){const t=d[j];d[j]=Math.min(d[j]+1,d[j-1]+1,p+(a[i-1]===b[j-1]?0:1));p=t}}return d[b.length]}
function similarName(x,y){const a=normName(x),b=normName(y);if(!a.length||a.length!==b.length)return false;
  const rest=[...b];let dist=0;
  for(const w of a){let bi=-1,bd=99;rest.forEach((v,k)=>{const dd=lev(w,v);if(dd<bd){bd=dd;bi=k}});if(bd>Math.min(2,Math.floor(w.length/4)))return false;dist+=bd;rest.splice(bi,1)}
  return dist<=2}
function sameClient(a,b){if(a.pid&&b.pid)return a.pid===b.pid;
  if(a.tg&&b.tg&&a.tg.toLowerCase()!==b.tg.toLowerCase())return false;
  return similarName(a.name,b.name)}
function syncClients(projects,crm){
  let changed=false;
  // Склеиваем дубли: клиент, заведённый вручную, и тот же проект из трекера с опечаткой в имени.
  for(let i=CLIENTS.length-1;i>=0;i--){const b=CLIENTS[i];
    const a=CLIENTS.find((x,j)=>j!==i&&sameClient(x,b));if(!a)continue;
    const keep=CLIENTS.indexOf(a)<i?a:b,drop=keep===a?b:a;
    keep.pid=keep.pid||drop.pid;keep.tg=keep.tg||drop.tg;
    if(drop.note&&drop.note!==keep.note)keep.note=[keep.note,drop.note].filter(Boolean).join('\n');
    if(drop.start&&(!keep.start||drop.start<keep.start))keep.start=drop.start;
    keep.pays=Object.assign({},drop.pays||{},keep.pays||{});
    ['next','first','renew','reason'].forEach(k=>{if(keep[k]==null||keep[k]==='')keep[k]=drop[k]});
    if(drop.status==='Активен'&&!keep.manualStatus){keep.status='Активен';keep.left=''}
    CLIENTS.splice(CLIENTS.indexOf(drop),1);changed=true;i=CLIENTS.length}
  const hidden=new Set(CFG.hiddenPids||[]);
  (projects||[]).forEach(p=>{if(hidden.has(p.id))return;
    let c=CLIENTS.find(x=>x.pid===p.id)||CLIENTS.find(x=>!x.pid&&similarName(x.name,p.name));
    if(c){if(!c.pid){c.pid=p.id;changed=true}
      if(p.inactive&&c.status==='Активен'&&!c.manualStatus){c.status='Ушёл';c.left=c.left||NOW;c.reason=c.reason||'Отключён в трекере';changed=true}
      return}
    CLIENTS.push({pid:p.id,name:p.name,tg:'',start:(p.createdAt||NOW).slice(0,10),status:p.inactive?'Ушёл':'Активен',left:p.inactive?NOW:'',reason:'',note:'',first:50000,renew:25000,pays:{}});changed=true});
  // Ники из операций, которые ещё ни к кому не привязаны, — к клиенту с похожей фамилией.
  const taken=new Set(CLIENTS.flatMap(handlesOf));
  const free=[...new Set(OPS.filter(o=>o.kind==='rev'&&o.client&&o.client.startsWith('@')).map(o=>o.client.toLowerCase()))].filter(h=>!taken.has(h));
  CLIENTS.forEach(c=>{if(c.tg)return;const h=crmHandle(c,crm||[],taken);if(h){c.tg=h;taken.add(h);const i=free.indexOf(h);if(i>=0)free.splice(i,1);changed=true}});
  CLIENTS.forEach(c=>{if(c.tg)return;const h=guessHandle(c,free);if(h){c.tg=h;free.splice(free.indexOf(h),1);changed=true;
    const first=clientOps(c).map(o=>o.d).sort()[0];if(first&&(c.pid&&!c.startSet)&&first<c.start)c.start=first}});
  return changed
}
