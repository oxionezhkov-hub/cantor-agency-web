    return `<td class="n${cls}"><div class="pf"><span class="${a!=null&&Math.round(a)===0?'zero ':''}${fa?'fe':''}"${fa}>${fm(a)}</span><span class="p${pa?' pe':''}"${pa}>${fm(p)}</span></div></td>`};
  const row=(label,g,cls='',sign=1,ed)=>`<tr class="${cls}"><td>${label}</td>${cols.map(m=>pair(F[m]?sign*(g(F[m])||0):null,PL[m]||ed?sign*(PL[m]?g(PL[m])||0:0):null,m===CUR?' cur':'',m,ed)).join('')}${pair(sign*fc(g),sign*pt(g))}</tr>`;
  const used=(side,c)=>cols.some(m=>(F[m]&&F[m][side][c])||(PL[m]&&PL[m][side][c]));
