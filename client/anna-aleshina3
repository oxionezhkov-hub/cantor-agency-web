<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="robots" content="noindex, nofollow">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Анна Алёшина · Учебник</title>
<meta name="description" content="Анна Алёшина — кандидат экономических наук, доцент МГУ, основатель онлайн-школы «Будет 100 баллов», руководитель научного департамента ИЭЭФ МГУ.">
<meta name="theme-color" content="#2446E0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;900&family=Golos+Text:wght@400;500;600;700&family=Caveat:wght@700&display=swap" rel="stylesheet">
<style>
/* Layout: страница как школьный учебник — кобальт и жёлтый с обложек её УМК, параграфы «§», подписи «Рис.», оценки красной ручкой */
:root {
  --white:   #FFFFFF;
  --paper:   #F3F5FB;
  --ink:     #0E1330;
  --ink-2:   #4A5173;
  --ink-3:   #858BA6;
  --cobalt:  #2446E0;
  --cobalt-d:#1831A8;
  --cobalt-l:#E4E9FD;
  --yellow:  #FFD53D;
  --yellow-d:#F2C200;
  --pen:     #E0352B;
  --line:    #DCE1F0;

  --f-display: 'Unbounded', 'Golos Text', system-ui, sans-serif;
  --f-body:    'Golos Text', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --f-hand:    'Caveat', 'Segoe Print', cursive;

  --r: 24px;
  --r-l: 40px;
  --wrap: 1240px;
  --gut: clamp(16px, 4vw, 40px);
  --spring: cubic-bezier(.34, 1.56, .64, 1);
  --ease: cubic-bezier(.2, .8, .2, 1);
  color-scheme: light;
}

*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body { margin: 0; font-family: var(--f-body); font-size: 17px; line-height: 1.6; color: var(--ink); background: var(--white); overflow-x: hidden; -webkit-font-smoothing: antialiased; }
body.menu-open, body.lb-open { overflow: hidden; }
img { display: block; max-width: 100%; height: auto; }
a { color: inherit; text-decoration: none; }
button { font: inherit; color: inherit; cursor: pointer; border: 0; background: none; padding: 0; }
[hidden] { display: none !important; }
:focus-visible { outline: 3px solid var(--yellow-d); outline-offset: 3px; border-radius: 8px; }
h1, h2, h3 { font-family: var(--f-display); margin: 0; text-wrap: balance; }
p { margin: 0; }
::selection { background: var(--yellow); color: var(--ink); }

.wrap { width: 100%; max-width: var(--wrap); margin-inline: auto; padding-inline: var(--gut); }
.sec { padding-block: clamp(64px, 9vw, 120px); }
.kicker { display: inline-flex; align-items: center; gap: 10px; padding: 6px 14px 6px 6px; border-radius: 100px; background: var(--cobalt-l); color: var(--cobalt-d); font-weight: 600; font-size: 14px; margin-bottom: 18px; }
.kicker b { display: grid; place-items: center; min-width: 28px; height: 28px; padding-inline: 6px; border-radius: 100px; background: var(--cobalt); color: var(--white); font-family: var(--f-display); font-size: 12px; font-weight: 700; }
.sec-title { font-size: clamp(30px, 4.6vw, 58px); font-weight: 700; line-height: 1.05; letter-spacing: -.03em; }
.sec-title mark { background: none; color: var(--cobalt); }
.sec-lead { color: var(--ink-2); max-width: 50ch; margin-top: 16px; font-size: 18px; }

@supports (animation-timeline: view()) {
  @media (prefers-reduced-motion: no-preference) {
    .rv { animation: rv linear both; animation-timeline: view(); animation-range: entry 5% cover 28%; }
    @keyframes rv { from { transform: translateY(40px) rotate(1.5deg); } to { transform: none; } }
    .pop { animation: pop linear both; animation-timeline: view(); animation-range: entry 10% cover 30%; }
    @keyframes pop { from { transform: scale(1.8) rotate(-30deg); } to { transform: rotate(var(--rot, -8deg)); } }
  }
}

/* ── Buttons ── */
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; padding: 0 28px; border-radius: 100px; font-weight: 600; font-size: 17px; white-space: nowrap; transition: transform .35s var(--spring), background-color .25s, color .25s, box-shadow .25s; }
.btn svg { transition: transform .35s var(--spring); }
.btn:hover svg { transform: translateX(4px); }
.btn:active { transform: scale(.97); }
.btn-yellow { background: var(--yellow); color: var(--ink); box-shadow: 0 5px 0 var(--yellow-d); }
.btn-yellow:hover { transform: translateY(-3px); box-shadow: 0 8px 0 var(--yellow-d); }
.btn-ghost { color: var(--white); box-shadow: inset 0 0 0 2px rgba(255, 255, 255, .45); }
.btn-ghost:hover { box-shadow: inset 0 0 0 2px var(--white); transform: translateY(-3px); }
.btn-blue { background: var(--cobalt); color: var(--white); box-shadow: 0 5px 0 var(--cobalt-d); }
.btn-blue:hover { transform: translateY(-3px); box-shadow: 0 8px 0 var(--cobalt-d); }

/* ── Header ── */
.progress { position: fixed; inset: 0 0 auto 0; height: 4px; background: var(--yellow); transform-origin: 0 50%; transform: scaleX(0); z-index: 320; }
.hdr { position: fixed; inset: 0 0 auto 0; z-index: 300; padding-top: env(safe-area-inset-top, 0px); color: var(--white); transition: transform .45s var(--ease), background-color .3s, color .3s, box-shadow .3s; }
.hdr.is-solid { background: rgba(255, 255, 255, .92); color: var(--ink); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); box-shadow: 0 1px 0 var(--line); }
.hdr.is-hidden { transform: translateY(-110%); }
.hdr-in { display: flex; align-items: center; gap: 20px; height: 76px; }
.logo { display: flex; align-items: center; gap: 10px; font-family: var(--f-display); font-weight: 700; font-size: 16px; letter-spacing: -.02em; }
.logo-mark { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--yellow); color: var(--ink); font-size: 13px; font-weight: 900; transition: transform .5s var(--spring); }
.logo:hover .logo-mark { transform: rotate(-20deg) scale(1.08); }
.nav { display: flex; gap: 2px; margin-left: auto; padding: 5px; border-radius: 100px; background: rgba(255, 255, 255, .12); }
.hdr.is-solid .nav { background: var(--paper); }
.nav a { padding: 8px 14px; border-radius: 100px; font-size: 15px; font-weight: 500; opacity: .85; transition: background-color .25s, color .25s, opacity .25s; }
.nav a:hover { opacity: 1; }
.nav a.is-active { opacity: 1; background: var(--yellow); color: var(--ink); }
.hdr-cta { min-height: 46px; padding: 0 20px; font-size: 15px; box-shadow: 0 4px 0 var(--yellow-d); }
.burger { display: none; margin-left: auto; width: 48px; height: 48px; border-radius: 50%; background: var(--yellow); position: relative; }
.burger span { position: absolute; left: 14px; right: 14px; height: 2.5px; border-radius: 2px; background: var(--ink); transition: transform .4s var(--spring), opacity .2s; }
.burger span:nth-child(1) { top: 17px; }
.burger span:nth-child(2) { top: 23px; }
.burger span:nth-child(3) { top: 29px; }
.burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
.burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
.burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
.mnav { position: fixed; inset: 0; z-index: 290; background: var(--cobalt); color: var(--white); padding: calc(104px + env(safe-area-inset-top, 0px)) var(--gut) calc(28px + env(safe-area-inset-bottom, 0px)); display: flex; flex-direction: column; gap: 4px; clip-path: circle(0 at calc(100% - 44px) 40px); visibility: hidden; transition: clip-path .6s var(--ease), visibility .6s; }
.mnav.is-open { clip-path: circle(150% at calc(100% - 44px) 40px); visibility: visible; }
.mnav a:not(.btn) { font-family: var(--f-display); font-weight: 700; font-size: clamp(28px, 8vw, 40px); letter-spacing: -.03em; padding-block: 8px; }
.mnav a:not(.btn):hover { color: var(--yellow); }
.mnav .btn { margin-top: auto; }
.hdr:has(+ .mnav.is-open) { color: var(--white); background: transparent; box-shadow: none; -webkit-backdrop-filter: none; backdrop-filter: none; }

/* ── Hero ── */
.hero { position: relative; overflow: hidden; background: var(--cobalt); color: var(--white); padding-top: calc(112px + env(safe-area-inset-top, 0px)); padding-bottom: clamp(48px, 7vw, 96px); border-radius: 0 0 var(--r-l) var(--r-l); }
.hero::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(rgba(255, 255, 255, .14) 1.2px, transparent 1.3px); background-size: 22px 22px; -webkit-mask-image: linear-gradient(120deg, #000 10%, transparent 60%); mask-image: linear-gradient(120deg, #000 10%, transparent 60%); pointer-events: none; }
.hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
.hero-tags { display: flex; flex-wrap: wrap; gap: 8px; animation: up .8s .1s var(--ease) both; }
.htag { padding: 7px 14px; border-radius: 100px; background: rgba(255, 255, 255, .14); font-size: 14px; font-weight: 500; }
.htag:first-child { background: var(--yellow); color: var(--ink); font-weight: 700; }
.hero-name { margin-top: 24px; font-size: clamp(46px, 6.8vw, 100px); font-weight: 900; line-height: .92; letter-spacing: -.045em; }
.hero-name span { display: block; animation: up 1s var(--ease) both; }
.hero-name span:nth-child(1) { animation-delay: .15s; }
.hero-name span:nth-child(2) { animation-delay: .25s; color: var(--yellow); }
.hero-desc { margin-top: 28px; max-width: 46ch; font-size: clamp(17px, 1.5vw, 20px); color: rgba(255, 255, 255, .86); animation: up .9s .35s var(--ease) both; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 36px; animation: up .9s .45s var(--ease) both; }
.hero-visual { position: relative; animation: up 1.1s .2s var(--ease) both; }
.cover { position: relative; border-radius: 28px 28px 20px 20px; overflow: hidden; background: var(--cobalt-d); box-shadow: 0 40px 80px -30px rgba(10, 20, 80, .7); aspect-ratio: 4 / 5; transform: rotate(2.5deg); transition: transform .8s var(--spring); }
.hero-visual:hover .cover { transform: rotate(0); }
.cover img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; }
.cover-band { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 20px; background: var(--yellow); color: var(--ink); font-weight: 700; font-size: 15px; }
.cover-band span:last-child { font-family: var(--f-display); font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 100px; background: var(--ink); color: var(--yellow); }
.seal { position: absolute; left: -44px; top: 28px; width: 136px; height: 136px; border-radius: 50%; background: var(--white); color: var(--ink); display: grid; place-items: center; box-shadow: 0 18px 40px -16px rgba(10, 20, 80, .6); }
.seal svg { position: absolute; inset: 0; width: 100%; height: 100%; animation: spin 18s linear infinite; }
.seal text { font-family: var(--f-display); font-size: 10.5px; font-weight: 700; letter-spacing: .12em; fill: var(--cobalt); }
.seal b { font-family: var(--f-display); font-size: 34px; font-weight: 900; letter-spacing: -.04em; color: var(--pen); }
.sticker { position: absolute; right: -14px; bottom: 76px; padding: 12px 16px; border-radius: 16px; background: var(--white); color: var(--ink); box-shadow: 0 18px 40px -16px rgba(10, 20, 80, .6); transform: rotate(-6deg); font-size: 14px; line-height: 1.3; }
.sticker strong { display: block; font-family: var(--f-display); font-size: 22px; font-weight: 900; color: var(--cobalt); letter-spacing: -.03em; }

/* ── Ticker ── */
.ticker-wrap { position: relative; z-index: 2; overflow: hidden; margin-top: -40px; padding-block: 18px 26px; }
.ticker { overflow: hidden; background: var(--yellow); transform: rotate(-1.5deg); margin-inline: -24px; box-shadow: 0 8px 0 var(--yellow-d); }
.ticker-track { display: flex; width: max-content; animation: marquee 32s linear infinite; }
.ticker:hover .ticker-track { animation-play-state: paused; }
.ticker-group { display: flex; }
.ticker-item { display: inline-flex; align-items: center; gap: 12px; padding: 18px 28px; font-family: var(--f-display); font-size: clamp(16px, 1.8vw, 22px); font-weight: 700; letter-spacing: -.02em; white-space: nowrap; }
.ticker-item b { color: var(--cobalt); }
.ticker-item::after { content: '●'; margin-left: 28px; font-size: .5em; color: var(--ink); }

/* ── Projects ── */
.projects { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: clamp(32px, 4vw, 48px); }
.proj { position: relative; display: flex; flex-direction: column; gap: 22px; padding: clamp(28px, 3.6vw, 48px); border-radius: var(--r-l); min-width: 0; transition: transform .5s var(--spring); }
.proj:hover { transform: translateY(-6px) rotate(-.6deg); }
.proj:nth-child(2):hover { transform: translateY(-6px) rotate(.6deg); }
.proj-y { background: var(--yellow); }
.proj-b { background: var(--ink); color: var(--white); }
.proj-label { display: inline-flex; align-self: flex-start; padding: 6px 12px; border-radius: 100px; background: var(--ink); color: var(--yellow); font-size: 13px; font-weight: 600; }
.proj-b .proj-label { background: var(--cobalt); color: var(--white); }
.proj h3 { font-size: clamp(24px, 2.6vw, 34px); font-weight: 700; line-height: 1.08; letter-spacing: -.03em; }
.proj p { font-size: 16px; color: rgba(14, 19, 48, .78); }
.proj-b p { color: rgba(255, 255, 255, .72); }
.proj-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-top: auto; }
.pst { padding: 16px; border-radius: 18px; background: rgba(255, 255, 255, .55); }
.proj-b .pst { background: rgba(255, 255, 255, .07); }
.pst-v { font-family: var(--f-display); font-size: clamp(24px, 2.6vw, 34px); font-weight: 900; line-height: 1; letter-spacing: -.04em; font-variant-numeric: tabular-nums; }
.proj-b .pst-v { color: var(--yellow); }
.pst-l { margin-top: 6px; font-size: 13px; line-height: 1.3; opacity: .75; }
.proj-link { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 16px; }
.proj-link span { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--ink); color: var(--yellow); transition: transform .4s var(--spring); }
.proj-b .proj-link span { background: var(--yellow); color: var(--ink); }
.proj-link:hover span { transform: rotate(45deg) scale(1.1); }

/* ── About (textbook page) ── */
.about { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
.fig { margin: 0; position: sticky; top: 100px; }
.fig-img { position: relative; border-radius: var(--r); overflow: hidden; }
.fig-img img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 62% 50%; }
.fig figcaption { margin-top: 12px; font-size: 14px; color: var(--ink-3); }
.fig figcaption b { color: var(--ink); font-weight: 600; }
.fig .mark { --rot: -8deg; position: absolute; right: 18px; top: 18px; }
.mark { display: grid; place-items: center; width: 78px; height: 78px; border: 3px solid var(--pen); border-radius: 50%; color: var(--pen); font-family: var(--f-hand); font-size: 50px; line-height: 1; transform: rotate(var(--rot, -8deg)); background: rgba(255, 255, 255, .85); }
.paras { display: grid; gap: 0; margin-top: 36px; }
.para { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 16px; padding-block: 24px; border-top: 2px solid var(--ink); }
.para-n { font-family: var(--f-display); font-weight: 900; font-size: 22px; color: var(--cobalt); letter-spacing: -.03em; }
.para h3 { font-size: 20px; font-weight: 700; letter-spacing: -.02em; line-height: 1.2; }
.para p { margin-top: 8px; color: var(--ink-2); }
.para em { font-style: normal; background: linear-gradient(transparent 60%, rgba(255, 213, 61, .7) 60%); padding-inline: 2px; }
.about-lead { font-size: clamp(22px, 2.3vw, 28px); line-height: 1.35; font-weight: 500; letter-spacing: -.01em; }

/* ── Results ── */
.results-bg { background: var(--paper); border-radius: var(--r-l); padding: clamp(28px, 5vw, 72px); }
.results { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; margin-top: clamp(32px, 4vw, 48px); }
.rbox { border-radius: var(--r); padding: 28px; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.rbox-v { font-family: var(--f-display); font-weight: 900; font-size: clamp(44px, 5.4vw, 80px); line-height: .9; letter-spacing: -.05em; font-variant-numeric: tabular-nums; }
.rbox p { font-size: 16px; line-height: 1.45; }
.r1 { grid-column: span 4; background: var(--yellow); }
.r2 { grid-column: span 4; background: var(--cobalt); color: var(--white); }
.r2 p { color: rgba(255, 255, 255, .8); }
.r3 { grid-column: span 4; background: var(--white); box-shadow: inset 0 0 0 2px var(--line); }
.r3 .rbox-v { color: var(--pen); }
.chart { grid-column: 1 / -1; background: var(--white); border-radius: var(--r); padding: clamp(24px, 3vw, 36px); box-shadow: inset 0 0 0 2px var(--line); }
.chart-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px 20px; margin-bottom: 24px; }
.chart-head h3 { font-size: 20px; font-weight: 700; letter-spacing: -.02em; }
.chart-head span { color: var(--ink-3); font-size: 14px; }
.bars { display: grid; gap: 16px; }
.bar { display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: 16px; align-items: center; }
.bar-name { font-family: var(--f-display); font-weight: 700; font-size: 15px; }
.bar-track { position: relative; height: 48px; }
.bar-fill { position: relative; height: 100%; width: calc(var(--w) * var(--p)); min-width: 64px; border-radius: 14px; background: var(--c, var(--cobalt)); color: var(--white); display: flex; align-items: center; justify-content: flex-end; padding-right: 16px; font-family: var(--f-display); font-weight: 900; font-size: 18px; transform-origin: 0 50%; }
.bar:nth-child(2) .bar-fill { --c: #4D6BF0; }
.bar:nth-child(3) .bar-fill { --c: var(--yellow); color: var(--ink); }
@supports (animation-timeline: view()) {
  @media (prefers-reduced-motion: no-preference) {
    .bar-fill { animation: grow linear both; animation-timeline: view(); animation-range: entry 10% cover 40%; }
  }
}

/* ── Reviews ── */
.sec-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px; align-items: end; }
.car-ctrl { display: flex; gap: 10px; }
.car-btn { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: var(--ink); color: var(--white); transition: transform .35s var(--spring), background-color .2s, opacity .2s; }
.car-btn:hover:not(:disabled) { background: var(--cobalt); transform: scale(1.08); }
.car-btn:disabled { opacity: .25; cursor: default; }
.is-static .car-ctrl, .is-static .car-bar { display: none; }
.car-track { display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: max(var(--gut), calc((100vw - var(--wrap)) / 2 + var(--gut))); padding-inline: max(var(--gut), calc((100vw - var(--wrap)) / 2 + var(--gut))); padding-block: 40px 28px; scrollbar-width: none; overscroll-behavior-x: contain; cursor: grab; }
.car-track::-webkit-scrollbar { display: none; }
.car-track.is-dragging { cursor: grabbing; scroll-snap-type: none; }
.car-track.is-dragging * { pointer-events: none; }
.car-bar { max-width: var(--wrap); margin-inline: auto; padding-inline: var(--gut); }
.car-bar > div { height: 6px; border-radius: 6px; background: var(--paper); overflow: hidden; }
.car-thumb { display: block; height: 100%; border-radius: 6px; background: var(--cobalt); transition: transform .12s linear; }
.rev { position: relative; scroll-snap-align: start; flex: 0 0 min(390px, 84vw); display: flex; flex-direction: column; gap: 18px; padding: 30px 28px 26px; border-radius: var(--r); background: var(--white); box-shadow: inset 0 0 0 2px var(--line); background-image: linear-gradient(var(--line) 1px, transparent 1px); background-size: 100% 32px; background-position: 0 14px; transition: transform .45s var(--spring), box-shadow .3s; }
.rev:nth-child(odd) { transform: rotate(-.8deg); }
.rev:nth-child(even) { transform: rotate(.8deg); }
.rev:hover { transform: translateY(-6px) rotate(0); box-shadow: inset 0 0 0 2px var(--cobalt), 0 24px 40px -24px rgba(24, 49, 168, .45); }
.rev::before { content: ''; position: absolute; left: 44px; top: 0; bottom: 0; width: 2px; background: rgba(224, 53, 43, .35); }
.rev > * { position: relative; padding-left: 36px; }
.rev-who strong { display: block; font-family: var(--f-display); font-size: 17px; font-weight: 700; letter-spacing: -.02em; line-height: 1.2; }
.rev-who span { font-size: 14px; color: var(--ink-3); }
.rev blockquote { margin: 0; font-size: 16px; line-height: 2; }
.rev-foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.rev .mark { --rot: -10deg; width: 64px; height: 64px; font-size: 40px; position: absolute; right: 16px; top: 16px; padding: 0; }
.rev .mark small { font-family: var(--f-body); font-size: 11px; position: absolute; bottom: -20px; white-space: nowrap; font-weight: 600; }
.rev-who { padding-right: 76px; }
.orig { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 14px; color: var(--cobalt); }
.orig:hover { text-decoration: underline; text-underline-offset: 3px; }
.score-note { font-size: 14px; font-weight: 600; color: var(--pen); }

/* ── Books (shelf) ── */
