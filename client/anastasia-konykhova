<script>
(function () {
  const nav = document.getElementById('nav');
  const burger = document.getElementById('burger');
  window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 10), { passive: true });
  burger.addEventListener('click', () => {
    const open = nav.classList.toggle('open');
    burger.setAttribute('aria-expanded', open);
  });
  document.querySelectorAll('#navLinks a').forEach(a => a.addEventListener('click', () => {
    nav.classList.remove('open');
    burger.setAttribute('aria-expanded', 'false');
  }));

  document.getElementById('yr').textContent = new Date().getFullYear();
  document.querySelectorAll('a[href="#policy"]').forEach(a => a.addEventListener('click', () => {
    document.getElementById('policy').open = true;
  }));

  // Reveal on scroll
  const items = document.querySelectorAll('.rv');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(entries => entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }), { rootMargin: '0px 0px -8% 0px' });
    items.forEach(el => io.observe(el));
  } else {
    items.forEach(el => el.classList.add('in'));
  }

  // Lead form → mainweb worker /api/leads/notify (source "anastasia-konykhova")
  const API_URL = 'https://mainweb.oxion-ezhkov.workers.dev/api/leads/notify';
  const form = document.getElementById('leadForm');
  const msg = document.getElementById('formMsg');
  form.addEventListener('submit', e => {
    e.preventDefault();
    const f = form.elements;
    if (!f.name.value.trim() || !f.phone.value.trim()) {
      msg.className = 'form-msg err'; msg.textContent = 'Пожалуйста, укажите имя и телефон или Telegram.'; return;
    }
    if (!f.consent.checked) {
      msg.className = 'form-msg err'; msg.textContent = 'Нужно согласие на обработку персональных данных.'; return;
    }
    const btn = form.querySelector('button[type="submit"]');
    btn.disabled = true;
    msg.className = 'form-msg'; msg.textContent = 'Отправляем…';
    fetch(API_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        source: 'anastasia-konykhova',
        fields: {
          'Имя': f.name.value.trim(),
          'Телефон / Telegram': f.phone.value.trim(),
          'Тема': f.topic.value,
          'Комментарий': f.comment.value.trim(),
        },
      }),
    })
      .then(res => {
        if (!res.ok) throw new Error('request_failed');
        form.reset();
        msg.className = 'form-msg ok'; msg.textContent = 'Спасибо! Заявка отправлена, я свяжусь с вами.';
      })
      .catch(() => {
        msg.className = 'form-msg err';
        msg.innerHTML = 'Не удалось отправить. Напишите, пожалуйста, в <a href="https://t.me/assakonikhova" target="_blank" rel="noopener">Telegram</a> или <a href="https://wa.me/79150395677" target="_blank" rel="noopener">WhatsApp</a>.';
      })
      .finally(() => { btn.disabled = false; });
  });
})();
</script>
