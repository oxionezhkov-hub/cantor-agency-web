<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="robots" content="noindex, nofollow">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Анастасия Коныхова — образование, перевод, культура</title>
<meta name="description" content="Анастасия Коныхова — основатель онлайн-школы «Высшая Лига Знаний», сооснователь агентства «Переводы Про», синхронный переводчик, психолог и культуролог.">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='8' fill='%238D2342'/%3E%3Ctext x='32' y='42' font-family='Georgia,serif' font-size='28' fill='%23F6F1E8' text-anchor='middle'%3EАК%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --ivory: #F6F1E8;
  --ivory-deep: #EDE4D6;
  --wine: #8D2342;
  --wine-dark: #6E1A33;
  --ink: #292727;
  --ink-soft: #5B5552;
  --green: #263C36;
  --gold: #B69A64;
  --powder: #D8B9B7;
  --line: #DDD2C1;
  --white: #FFFDF9;

  --serif: 'Cormorant Garamond', Georgia, serif;
  --sans: 'Manrope', system-ui, sans-serif;

  --max: 1200px;
  --pad: clamp(16px, 5vw, 64px);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--sans);
  font-size: 16px;
  line-height: 1.65;
  color: var(--ink);
  background: var(--ivory);
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
img { display: block; max-width: 100%; }
a { color: inherit; }
.wrap { max-width: var(--max); margin: 0 auto; padding: 0 var(--pad); }

/* ── type ── */
h1, h2, h3 { font-family: var(--serif); font-weight: 500; line-height: 1.08; letter-spacing: -0.01em; }
h2 { font-size: clamp(36px, 5vw, 60px); }
h3 { font-size: clamp(24px, 2.6vw, 32px); }
.eyebrow {
  font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--wine); font-weight: 600;
  display: inline-flex; align-items: center; gap: 12px;
}
.eyebrow::before { content: ""; width: 28px; height: 1px; background: var(--gold); }
.lead { font-family: var(--serif); font-size: clamp(22px, 2.3vw, 28px); line-height: 1.35; color: var(--ink); }
.muted { color: var(--ink-soft); }
section { padding: clamp(72px, 10vw, 130px) 0; }
.sec-head { max-width: 760px; margin-bottom: clamp(40px, 5vw, 64px); }
.sec-head h2 { margin: 18px 0 18px; }

/* ── buttons ── */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  padding: 15px 28px; border-radius: 999px; font: 500 15px var(--sans);
  text-decoration: none; cursor: pointer; border: 1px solid var(--wine);
  transition: background .25s, color .25s, transform .25s;
}
.btn:hover { transform: translateY(-1px); }
.btn-primary { background: var(--wine); color: var(--ivory); }
.btn-primary:hover { background: var(--wine-dark); }
.btn-ghost { background: transparent; color: var(--wine); }
.btn-ghost:hover { background: var(--wine); color: var(--ivory); }
.link-arrow {
  display: inline-flex; align-items: center; gap: 8px; font-weight: 500; font-size: 15px;
  color: var(--wine); text-decoration: none; border-bottom: 1px solid rgba(141,35,66,.3);
  padding-bottom: 2px; transition: border-color .2s;
}
.link-arrow:hover { border-color: var(--wine); }
.link-arrow::after { content: "→"; }

/* ── nav ── */
.nav {
  position: sticky; top: 0; z-index: 50;
  background: rgba(246,241,232,.9); backdrop-filter: blur(10px);
  border-bottom: 1px solid transparent; transition: border-color .3s;
}
.nav.scrolled { border-color: var(--line); }
.nav-inner { display: flex; align-items: center; justify-content: space-between; height: 72px; }
.mono { font-family: var(--serif); font-size: 22px; font-weight: 600; color: var(--wine); text-decoration: none; letter-spacing: .04em; }
.mono span { color: var(--ink); font-weight: 500; font-size: 18px; margin-left: 10px; letter-spacing: 0; }
.nav-links { display: flex; gap: 28px; list-style: none; }
.nav-links a { text-decoration: none; font-size: 14px; color: var(--ink-soft); transition: color .2s; }
.nav-links a:hover { color: var(--wine); }
.nav-cta { padding: 10px 20px; font-size: 14px; }
.burger { display: none; background: none; border: 0; width: 40px; height: 40px; cursor: pointer; }
.burger span { display: block; width: 22px; height: 1.5px; background: var(--ink); margin: 5px auto; transition: transform .3s, opacity .3s; }

/* ── hero ── */
.hero { padding: clamp(40px, 6vw, 80px) 0 clamp(72px, 8vw, 110px); }
.hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(32px, 6vw, 88px); align-items: center; }
.hero h1 { font-size: clamp(54px, 8.4vw, 116px); line-height: .95; margin: 22px 0 28px; }
.hero h1 em { font-style: italic; color: var(--wine); }
.hero .lead { max-width: 600px; }
.roles { list-style: none; margin: 28px 0 36px; border-top: 1px solid var(--line); }
.roles li {
  display: flex; gap: 14px; padding: 11px 0; border-bottom: 1px solid var(--line);
  font-size: 15px; color: var(--ink-soft);
}
.roles li::before { content: "✦"; color: var(--gold); font-size: 11px; line-height: 2.2; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 14px; }
.hero-photo { position: relative; }
.hero-photo .frame { position: relative; border-radius: 300px 300px 6px 6px; overflow: hidden; aspect-ratio: 4/5.4; box-shadow: 0 30px 60px -30px rgba(41,39,39,.45); }
.hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }
.hero-photo::before {
  content: ""; position: absolute; inset: -14px -14px 14px 14px;
  border: 1px solid var(--gold); border-radius: 300px 300px 6px 6px; z-index: -1;
}
.hero-quote {
  position: absolute; left: -36px; bottom: 34px; max-width: 250px;
  background: var(--white); padding: 18px 22px; border-radius: 4px;
  font-family: var(--serif); font-style: italic; font-size: 19px; line-height: 1.3;
  box-shadow: 0 20px 40px -24px rgba(41,39,39,.4); border-left: 2px solid var(--wine);
}
.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin-top: clamp(56px, 7vw, 90px); border-top: 1px solid var(--line); }
.stat { padding: 28px 28px 0 0; }
.stat + .stat { padding-left: 28px; border-left: 1px solid var(--line); }
.stat b { display: block; font-family: var(--serif); font-weight: 500; font-size: clamp(40px, 4.6vw, 60px); line-height: 1; color: var(--wine); }
.stat span { display: block; margin-top: 10px; font-size: 14px; color: var(--ink-soft); max-width: 260px; }

/* ── projects ── */
.projects { background: var(--white); }
.proj-main {
  display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 72px); align-items: center;
  padding-bottom: clamp(56px, 7vw, 90px); border-bottom: 1px solid var(--line); margin-bottom: clamp(56px, 7vw, 90px);
}
.proj-main .logo-box { background: #000; border-radius: 6px; aspect-ratio: 1/1; display: grid; place-items: center; overflow: hidden; }
.proj-main .logo-box img { width: 78%; }
.tag { display: inline-block; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--gold); font-weight: 600; margin-bottom: 14px; }
.proj-main h3 { font-size: clamp(32px, 3.6vw, 46px); margin-bottom: 18px; }
.proj-main p { color: var(--ink-soft); margin-bottom: 22px; }
.mini-stats { display: flex; flex-wrap: wrap; gap: 28px; margin: 26px 0 30px; }
.mini-stats div b { display: block; font-family: var(--serif); font-size: 34px; font-weight: 500; color: var(--wine); line-height: 1; }
.mini-stats div span { font-size: 13px; color: var(--ink-soft); }

.proj-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
.proj {
  display: flex; flex-direction: column; background: var(--ivory); border: 1px solid var(--line);
  border-radius: 6px; overflow: hidden; transition: transform .35s, box-shadow .35s;
}
.proj:hover { transform: translateY(-4px); box-shadow: 0 24px 40px -28px rgba(41,39,39,.45); }
.proj-media { aspect-ratio: 16/11; overflow: hidden; background: var(--ivory-deep); }
.proj-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s; }
.proj:hover .proj-media img { transform: scale(1.04); }
.proj-media.logo { display: grid; place-items: center; }
.proj-media.logo.dark { background: #000; }
.proj-media.logo img { width: auto; height: 74%; object-fit: contain; }
.proj-media.logo.ethos img { height: auto; width: 100%; }
.proj-media.type { display: grid; place-items: center; background: var(--green); color: var(--ivory); font-family: var(--serif); font-size: 34px; font-style: italic; text-align: center; padding: 24px; line-height: 1.1; }
.proj-media.type.wine { background: var(--wine); }
.proj-media.type.powder { background: var(--powder); color: var(--ink); }
.proj-body { padding: 26px 26px 28px; display: flex; flex-direction: column; flex: 1; }
.proj-body .tag { margin-bottom: 10px; }
.proj-body h3 { font-size: 27px; margin-bottom: 12px; }
.proj-body p { font-size: 15px; color: var(--ink-soft); margin-bottom: 20px; flex: 1; }
.proj-links { display: flex; flex-wrap: wrap; gap: 10px 22px; }

/* ── about ── */
.about-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(32px, 6vw, 90px); align-items: start; }
.about-photo { position: sticky; top: 100px; }
.about-photo img { border-radius: 6px; aspect-ratio: 3/4; object-fit: cover; width: 100%; }
.about-photo figcaption { margin-top: 12px; font-size: 13px; color: var(--ink-soft); font-style: italic; }
.about-text p { margin-bottom: 18px; color: var(--ink-soft); }
.about-text .lead { margin-bottom: 26px; }
.quote {
  margin: 44px 0; padding: 34px 0; border-top: 1px solid var(--gold); border-bottom: 1px solid var(--gold);
  font-family: var(--serif); font-style: italic; font-size: clamp(28px, 3.4vw, 42px); line-height: 1.2; color: var(--wine);
}
.quote small { display: block; margin-top: 14px; font: 500 13px var(--sans); font-style: normal; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-soft); }
.timeline { list-style: none; margin-top: 46px; position: relative; }
.timeline::before { content: ""; position: absolute; left: 92px; top: 8px; bottom: 8px; width: 1px; background: var(--line); }
.timeline li { display: grid; grid-template-columns: 92px 1fr; gap: 0 30px; padding: 0 0 26px; position: relative; }
.timeline li::after { content: ""; position: absolute; left: 88px; top: 9px; width: 9px; height: 9px; border-radius: 50%; background: var(--ivory); border: 1px solid var(--wine); }
.timeline li.teach::after { background: var(--wine); }
.timeline .yr { font-family: var(--serif); font-size: 22px; color: var(--wine); line-height: 1.2; }
.timeline .tl-body { padding-left: 4px; }
.timeline b { display: block; font-weight: 600; font-size: 15px; }
.timeline span { font-size: 14px; color: var(--ink-soft); }

/* ── credentials ── */
.creds { background: var(--green); color: var(--ivory); }
.creds .eyebrow { color: var(--gold); }
.creds h2 { color: var(--ivory); }
.creds .muted { color: rgba(246,241,232,.7); }
.cred-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 56px; }
.cred { display: grid; grid-template-columns: 110px 1fr; gap: 20px; padding: 20px 0; border-bottom: 1px solid rgba(246,241,232,.15); }
.cred .yr { font-family: var(--serif); font-size: 20px; color: var(--gold); }
.cred p { font-size: 15px; color: rgba(246,241,232,.88); }
.cred p b { color: var(--ivory); font-weight: 600; }
.registry { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 44px; }
.registry a {
  display: inline-flex; align-items: center; gap: 10px; padding: 14px 22px; border-radius: 999px;
  border: 1px solid rgba(182,154,100,.6); color: var(--ivory); text-decoration: none; font-size: 14px; transition: background .25s;
}
.registry a:hover { background: rgba(182,154,100,.18); }

/* ── approach ── */
.approach-top { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(32px, 6vw, 80px); align-items: center; margin-bottom: clamp(56px, 7vw, 90px); }
.approach-top img { border-radius: 6px; aspect-ratio: 1/1; object-fit: cover; width: 100%; }
.approach-top p { color: var(--ink-soft); margin-top: 22px; }
.steps { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; border-top: 1px solid var(--line); counter-reset: step; margin-bottom: 56px; }
.step { padding: 26px 22px 0 0; counter-increment: step; }
.step + .step { padding-left: 22px; border-left: 1px solid var(--line); }
.step::before { content: "0" counter(step); display: block; font-family: var(--serif); font-size: 40px; color: var(--powder); line-height: 1; margin-bottom: 14px; }
.step b { display: block; font-family: var(--serif); font-size: 23px; font-weight: 500; margin-bottom: 8px; }
.step span { font-size: 14px; color: var(--ink-soft); }
.principles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
.principle { background: var(--white); border-radius: 6px; padding: 26px 24px; border-top: 2px solid var(--wine); }
.principle b { display: block; font-family: var(--serif); font-size: 23px; font-weight: 500; margin-bottom: 10px; }
.principle span { font-size: 14px; color: var(--ink-soft); }

/* ── results ── */
.results { background: var(--white); }
.res-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-bottom: 44px; }
.res-stat { background: var(--wine); color: var(--ivory); border-radius: 6px; padding: 30px 28px; }
.res-stat b { display: block; font-family: var(--serif); font-size: clamp(40px, 4.4vw, 56px); font-weight: 500; line-height: 1; }
.res-stat span { display: block; margin-top: 12px; font-size: 14px; color: rgba(246,241,232,.85); }
.cases { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
.case { border: 1px solid var(--line); border-radius: 6px; padding: 30px 30px 26px; background: var(--ivory); display: flex; flex-direction: column; }
.case .meta { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--gold); font-weight: 600; }
.case h3 { font-size: 27px; margin: 12px 0 12px; }
.case p { font-size: 15px; color: var(--ink-soft); flex: 1; }
.case .res { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 15px; font-weight: 500; color: var(--green); display: flex; gap: 10px; }
.case .res::before { content: "→"; color: var(--wine); }
.case.wide { grid-column: span 2; }
.more-res { margin-top: 36px; list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
.more-res li { padding-top: 16px; border-top: 1px solid var(--wine); font-size: 15px; }
.reviews-cta { margin-top: 56px; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; padding: 30px; border-radius: 6px; background: var(--ivory-deep); }
.reviews-cta p { font-family: var(--serif); font-size: 26px; flex: 1 1 280px; line-height: 1.2; }

/* ── books ── */
.books-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
.book { border-radius: 6px; padding: 34px 30px; min-height: 260px; display: flex; flex-direction: column; justify-content: space-between; }
.book:nth-child(1) { background: var(--wine); color: var(--ivory); }
.book:nth-child(2) { background: var(--green); color: var(--ivory); }
.book:nth-child(3) { background: var(--powder); }
.book h3 { font-size: 30px; margin: 14px 0 12px; }
.book p { font-size: 15px; opacity: .85; }
.book .tag { color: inherit; opacity: .7; margin: 0; }
.book .soon { margin-top: 24px; font-size: 13px; letter-spacing: .1em; text-transform: uppercase; opacity: .7; }

/* ── press ── */
.press-list { list-style: none; border-top: 1px solid var(--line); }
.press-list a {
  display: grid; grid-template-columns: 220px 1fr 40px; gap: 24px; align-items: baseline;
  padding: 22px 0; border-bottom: 1px solid var(--line); text-decoration: none; transition: padding .3s, color .3s;
}
.press-list a:hover { padding-left: 12px; color: var(--wine); }
.press-list .src { font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--gold); font-weight: 600; }
.press-list .ttl { font-family: var(--serif); font-size: 24px; line-height: 1.25; }
.press-list .arr { text-align: right; color: var(--wine); }

/* ── media ── */
.media { background: var(--ivory-deep); }
.pods { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
.pod { border-radius: 6px; overflow: hidden; background: var(--white); }
.pod-video { position: relative; aspect-ratio: 16/9; background: var(--green); display: grid; place-items: center; }
.pod-video img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .45; filter: grayscale(.3); }
.pod-video .soon-badge { position: relative; padding: 8px 16px; border-radius: 999px; background: rgba(246,241,232,.92); font-size: 13px; color: var(--ink); }
.pod-body { padding: 22px 24px 26px; }
.pod-body .tag { margin-bottom: 6px; }
.pod-body h3 { font-size: 24px; margin-bottom: 8px; }
.pod-body p { font-size: 14px; color: var(--ink-soft); }
.socials { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 44px; }
.socials a {
  padding: 13px 22px; border-radius: 999px; border: 1px solid var(--line); background: var(--white);
  text-decoration: none; font-size: 14px; transition: border-color .25s, color .25s;
}
.socials a:hover { border-color: var(--wine); color: var(--wine); }

/* ── gallery ── */
.gallery { padding: 0; }
.gallery-strip { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }
.gallery-strip img { width: 100%; aspect-ratio: 3/4; object-fit: cover; }

/* ── contact ── */
.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 88px); align-items: start; }
.contact-photo img { border-radius: 300px 300px 6px 6px; aspect-ratio: 3/4; object-fit: cover; width: 100%; }
.contact-direct { margin-top: 26px; display: grid; gap: 10px; }
.contact-direct a { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); text-decoration: none; font-size: 15px; }
.contact-direct a span:first-child { color: var(--ink-soft); }
.contact-direct a span:last-child { color: var(--wine); font-weight: 500; }
form { margin-top: 30px; display: grid; gap: 14px; }
label.fld { display: grid; gap: 6px; font-size: 13px; color: var(--ink-soft); }
input, select, textarea {
  font: 400 16px var(--sans); color: var(--ink); background: var(--white);
  border: 1px solid var(--line); border-radius: 4px; padding: 14px 16px; width: 100%;
  transition: border-color .2s;
}
input:focus, select:focus, textarea:focus { outline: none; border-color: var(--wine); }
textarea { min-height: 110px; resize: vertical; }
.consent { display: flex; gap: 10px; align-items: flex-start; font-size: 13px; color: var(--ink-soft); }
.consent input { width: auto; margin-top: 4px; accent-color: var(--wine); }
.form-msg { font-size: 14px; min-height: 20px; }
.form-msg.ok { color: var(--green); }
.form-msg.err { color: var(--wine); }

/* ── footer ── */
footer { background: var(--ink); color: rgba(246,241,232,.75); padding: 56px 0 40px; font-size: 14px; }
.foot-grid { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 28px; }
footer .mono { color: var(--ivory); }
footer a { color: rgba(246,241,232,.85); text-decoration: none; }
footer a:hover { color: var(--gold); }
.foot-links { display: flex; flex-wrap: wrap; gap: 10px 22px; }
footer details { margin-top: 30px; border-top: 1px solid rgba(246,241,232,.12); padding-top: 22px; }
footer summary { cursor: pointer; color: rgba(246,241,232,.85); }
footer details p { margin-top: 12px; font-size: 13px; max-width: 900px; line-height: 1.6; }

/* ── reveal ── */
.rv { opacity: 0; transform: translateY(24px); transition: opacity .9s ease, transform .9s ease; }
.rv.in { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) { .rv { opacity: 1; transform: none; transition: none; } html { scroll-behavior: auto; } }

/* ── responsive ── */
@media (max-width: 1080px) {
  .nav-links { gap: 18px; }
  .proj-grid { grid-template-columns: repeat(2, 1fr); }
  .steps { grid-template-columns: repeat(2, 1fr); }
  .step, .step + .step { padding: 24px 0 0; border-left: 0; }
  .principles { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 900px) {
  .nav-links, .nav-cta { display: none; }
  .burger { display: block; }
  .nav.open .nav-links {
    display: flex; flex-direction: column; gap: 0; position: absolute; top: 72px; left: 0; right: 0;
    background: var(--ivory); border-bottom: 1px solid var(--line); padding: 8px var(--pad) 20px;
  }
  .nav.open .nav-links a { display: block; padding: 12px 0; font-size: 17px; border-bottom: 1px solid var(--line); }
