<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="robots" content="noindex, nofollow">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Анна Алёшина · Бланк</title>
<meta name="description" content="Анна Алёшина — кандидат экономических наук, доцент МГУ, основатель онлайн-школы «Будет 100 баллов», руководитель научного департамента ИЭЭФ МГУ.">
<meta name="theme-color" content="#F2F5EE">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geologica:wght@300;400;500;600;700;800&family=Onest:wght@400;500;600&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
/* Layout: светлый бенто на миллиметровке — плитки как поля экзаменационного бланка, зелёный из фирменного цвета школы */
:root {
  --paper:      #F2F5EE;
  --tile:       #FFFFFF;
  --ink:        #13201A;
  --ink-2:      #47554C;
  --ink-3:      #7F8B83;
  --green:      #6BC043;
  --green-ink:  #2B6B16;
  --green-soft: #E2F1D6;
  --night:      #14201A;
  --night-2:    #1E2D24;
  --line:       #DAE2D4;
  --grid:       rgba(19, 32, 26, .055);
  --danger:     #B3372B;

  --f-display: 'Geologica', 'Onest', system-ui, sans-serif;
  --f-body:    'Onest', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --f-mono:    'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;

  --r-s: 12px;
  --r:   22px;
  --r-l: 32px;
  --wrap: 1240px;
  --gut: clamp(16px, 4vw, 40px);
  --ease: cubic-bezier(.2, .8, .2, 1);
  color-scheme: light;
}

*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  font-family: var(--f-body);
  font-size: 17px;
  line-height: 1.6;
  color: var(--ink);
  background: var(--paper);
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}
body.menu-open, body.lb-open { overflow: hidden; }
img { display: block; max-width: 100%; height: auto; }
a { color: inherit; text-decoration: none; }
button { font: inherit; color: inherit; cursor: pointer; border: 0; background: none; padding: 0; }
[hidden] { display: none !important; }
:focus-visible { outline: 2.5px solid var(--green-ink); outline-offset: 3px; border-radius: 6px; }
h1, h2, h3 { font-family: var(--f-display); margin: 0; text-wrap: balance; letter-spacing: -.02em; }
p { margin: 0; }

.wrap { width: 100%; max-width: var(--wrap); margin-inline: auto; padding-inline: var(--gut); }
.mono { font-family: var(--f-mono); font-size: 12px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; }
.sec { padding-block: clamp(64px, 9vw, 120px); }
.sec-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 24px; margin-bottom: clamp(32px, 4vw, 48px); }
.sec-label { display: inline-flex; align-items: center; gap: 10px; color: var(--green-ink); margin-bottom: 14px; }
.sec-label::before { content: ''; width: 18px; height: 18px; border: 1.5px solid currentColor; border-radius: 4px; background: linear-gradient(currentColor, currentColor) center / 8px 8px no-repeat; }
.sec-title { font-size: clamp(34px, 5vw, 60px); font-weight: 700; line-height: 1.02; }
.sec-lead { color: var(--ink-2); max-width: 46ch; margin-top: 16px; }

/* ── Scroll-linked reveal (content is fully visible where unsupported) ── */
@supports (animation-timeline: view()) {
  @media (prefers-reduced-motion: no-preference) {
    .rv { animation: rv linear both; animation-timeline: view(); animation-range: entry 5% cover 28%; }
    @keyframes rv { from { transform: translateY(40px) scale(.97); } to { transform: none; } }
  }
}

/* ── Buttons ── */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  min-height: 52px; padding: 0 26px; border-radius: 100px;
  font-family: var(--f-display); font-size: 16px; font-weight: 600; letter-spacing: -.01em;
  transition: transform .25s var(--ease), background-color .25s, box-shadow .25s, color .25s;
  white-space: nowrap;
}
.btn svg { transition: transform .3s var(--ease); }
.btn:hover svg { transform: translateX(4px); }
.btn-primary { background: var(--ink); color: var(--paper); box-shadow: 0 10px 24px -12px rgba(19, 32, 26, .6); }
.btn-primary:hover { background: var(--green-ink); transform: translateY(-2px); }
.btn-green { background: var(--green); color: var(--ink); }
.btn-green:hover { background: #7ed156; transform: translateY(-2px); box-shadow: 0 14px 28px -14px rgba(43, 107, 22, .7); }
.btn-line { border: 1.5px solid var(--line); background: var(--tile); color: var(--ink); }
.btn-line:hover { border-color: var(--ink); transform: translateY(-2px); }

/* ── Header ── */
.progress { position: fixed; inset: 0 0 auto 0; height: 3px; background: var(--green); transform-origin: 0 50%; transform: scaleX(0); z-index: 320; }
.hdr {
  position: fixed; inset: 0 0 auto 0; z-index: 300;
  padding-top: env(safe-area-inset-top, 0px);
  transition: transform .45s var(--ease), background-color .3s, box-shadow .3s;
}
.hdr.is-solid { background: rgba(242, 245, 238, .86); -webkit-backdrop-filter: saturate(1.4) blur(16px); backdrop-filter: saturate(1.4) blur(16px); box-shadow: 0 1px 0 var(--line); }
.hdr.is-hidden { transform: translateY(-110%); }
.hdr-in { display: flex; align-items: center; gap: 24px; height: 72px; }
.logo { display: inline-flex; align-items: center; gap: 12px; font-family: var(--f-display); font-weight: 700; font-size: 17px; letter-spacing: -.02em; }
.logo-mark { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 11px; background: var(--ink); color: var(--green); font-family: var(--f-mono); font-size: 13px; font-weight: 700; letter-spacing: 0; }
.nav { display: flex; gap: 4px; margin-left: auto; }
.nav a { position: relative; padding: 8px 14px; border-radius: 100px; font-size: 15px; font-weight: 500; color: var(--ink-2); transition: color .2s, background-color .2s; }
.nav a:hover { color: var(--ink); background: rgba(19, 32, 26, .05); }
.nav a.is-active { color: var(--ink); background: var(--tile); box-shadow: 0 0 0 1px var(--line); }
.hdr-cta { min-height: 44px; padding: 0 20px; font-size: 15px; }
.burger { display: none; margin-left: auto; width: 46px; height: 46px; border-radius: 14px; background: var(--ink); position: relative; }
.burger span { position: absolute; left: 13px; right: 13px; height: 2px; border-radius: 2px; background: var(--paper); transition: transform .35s var(--ease), opacity .2s; }
.burger span:nth-child(1) { top: 16px; }
.burger span:nth-child(2) { top: 22px; }
.burger span:nth-child(3) { top: 28px; }
.burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
.burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
.burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

.mnav {
  position: fixed; inset: 0; z-index: 290; background: var(--paper);
  padding: calc(96px + env(safe-area-inset-top, 0px)) var(--gut) calc(32px + env(safe-area-inset-bottom, 0px));
  display: flex; flex-direction: column; gap: 6px;
  visibility: hidden; opacity: 0; transition: opacity .3s, visibility .3s;
  background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
  background-size: 24px 24px;
}
.mnav.is-open { visibility: visible; opacity: 1; }
.mnav a:not(.btn) { display: flex; justify-content: space-between; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--line); font-family: var(--f-display); font-size: clamp(28px, 8vw, 40px); font-weight: 700; letter-spacing: -.03em; opacity: 0; transform: translateY(16px); transition: opacity .4s var(--ease), transform .4s var(--ease); }
.mnav a:not(.btn) small { font-family: var(--f-mono); font-size: 12px; font-weight: 500; color: var(--ink-3); letter-spacing: .06em; }
.mnav.is-open a:not(.btn) { opacity: 1; transform: none; }
.mnav.is-open a:nth-child(2) { transition-delay: .04s; }
.mnav.is-open a:nth-child(3) { transition-delay: .08s; }
.mnav.is-open a:nth-child(4) { transition-delay: .12s; }
.mnav.is-open a:nth-child(5) { transition-delay: .16s; }
.mnav .btn { margin-top: auto; }

/* ── Hero ── */
.hero {
  position: relative;
  padding-top: calc(96px + env(safe-area-inset-top, 0px));
  padding-bottom: clamp(24px, 4vw, 48px);
  background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
  background-size: 24px 24px;
  background-position: -1px -1px;
}
.hero::after { content: ''; position: absolute; inset: auto 0 0 0; height: 140px; background: linear-gradient(transparent, var(--paper)); pointer-events: none; }
.hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; }
.tile { background: var(--tile); border-radius: var(--r-l); box-shadow: 0 0 0 1px var(--line), 0 24px 48px -32px rgba(19, 32, 26, .25); }
.h-intro { grid-column: span 7; grid-row: span 2; padding: clamp(28px, 4vw, 56px); display: flex; flex-direction: column; gap: 28px; min-width: 0; }
.h-kicker { display: flex; flex-wrap: wrap; gap: 8px; }
.chip { display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; border-radius: 8px; background: var(--paper); box-shadow: inset 0 0 0 1px var(--line); color: var(--ink-2); }
.chip b { width: 7px; height: 7px; border-radius: 50%; background: var(--green); }
.h-name { font-size: clamp(52px, 8.2vw, 116px); font-weight: 800; line-height: .9; letter-spacing: -.05em; }
.h-name span { display: block; }
.h-name .ln { overflow: hidden; padding-bottom: .06em; }
.h-name .ln > span { animation: rise 1s var(--ease) both; }
.h-name .ln:nth-child(2) > span { animation-delay: .08s; color: var(--green-ink); }
.h-desc { font-size: clamp(17px, 1.5vw, 19px); color: var(--ink-2); max-width: 44ch; animation: fade .9s .25s var(--ease) both; }
.h-actions { display: flex; flex-wrap: wrap; gap: 12px; animation: fade .9s .35s var(--ease) both; }
.score { margin-top: auto; display: flex; align-items: center; gap: 18px; padding-top: 24px; border-top: 1.5px dashed var(--line); }
.cells { display: flex; gap: 6px; flex-shrink: 0; }
.cell { position: relative; width: 50px; height: 62px; border: 1.5px solid var(--ink); border-radius: 6px; overflow: hidden; display: grid; place-items: center; font-family: var(--f-mono); font-size: 34px; font-weight: 700; color: var(--green-ink); background: var(--tile); }
.cell span { display: block; animation: roll 1.2s var(--ease) both; }
.cell:nth-child(1) span { animation-delay: .5s; }
.cell:nth-child(2) span { animation-delay: .62s; }
.cell:nth-child(3) span { animation-delay: .74s; }
.score p { font-size: 15px; line-height: 1.45; color: var(--ink-2); }
.score strong { color: var(--ink); font-weight: 600; }

.h-photo { grid-column: span 5; grid-row: span 2; position: relative; overflow: hidden; min-height: 560px; background: var(--night); }
.h-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%; animation: zoom 1.6s var(--ease) both; }
.h-photo figcaption { position: absolute; left: 16px; right: 16px; bottom: 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 16px; border-radius: 18px; background: rgba(255, 255, 255, .86); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); font-size: 14px; line-height: 1.35; animation: fade .9s .6s var(--ease) both; }
.h-photo figcaption strong { font-family: var(--f-display); font-size: 15px; display: block; }
.live { display: inline-flex; align-items: center; gap: 8px; color: var(--green-ink); white-space: nowrap; }
.live::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 0 rgba(107, 192, 67, .6); animation: pulse 2s infinite; }

.h-facts { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.fact { padding: 22px 24px; display: flex; align-items: center; gap: 18px; transition: transform .35s var(--ease), box-shadow .35s; }
.fact:hover { transform: translateY(-4px); box-shadow: 0 0 0 1px var(--line), 0 30px 50px -30px rgba(19, 32, 26, .35); }
.fact-num { flex-shrink: 0; font-family: var(--f-display); font-weight: 800; font-size: clamp(30px, 3.2vw, 42px); letter-spacing: -.04em; line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; }
.fact p { font-size: 15px; line-height: 1.4; color: var(--ink-2); }

/* ── Marquee ── */
.ticker { border-block: 1.5px solid var(--ink); background: var(--green); overflow: hidden; }
.ticker-track { display: flex; width: max-content; animation: marquee 38s linear infinite; }
.ticker:hover .ticker-track { animation-play-state: paused; }
.ticker-group { display: flex; align-items: center; }
.ticker-item { display: inline-flex; align-items: center; gap: 14px; padding: 16px 28px; font-family: var(--f-display); font-weight: 600; font-size: 18px; white-space: nowrap; }
.ticker-item b { font-family: var(--f-mono); font-size: 15px; padding: 4px 8px; border-radius: 6px; background: var(--ink); color: var(--green); }
.ticker-item::after { content: '✳'; margin-left: 28px; color: var(--green-ink); }

/* ── Projects ── */
.projects { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.proj { position: relative; display: flex; flex-direction: column; gap: 24px; padding: clamp(28px, 3.6vw, 48px); border-radius: var(--r-l); overflow: hidden; min-width: 0; transition: transform .4s var(--ease); }
.proj:hover { transform: translateY(-6px); }
.proj-school { background: var(--green-soft); box-shadow: 0 0 0 1px #cfe5bf; }
.proj-science { background: var(--night); color: #E9F0E6; }
.proj-top { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; }
.proj-tag { color: var(--green-ink); }
.proj-science .proj-tag { color: var(--green); }
.proj h3 { font-size: clamp(26px, 2.8vw, 36px); font-weight: 700; line-height: 1.05; margin-top: 10px; }
.proj-desc { color: var(--ink-2); font-size: 16px; }
.proj-science .proj-desc { color: rgba(233, 240, 230, .72); }
.arrow { flex-shrink: 0; display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: var(--ink); color: var(--paper); transition: transform .35s var(--ease), background-color .25s; }
.proj-science .arrow { background: var(--green); color: var(--ink); }
.proj:hover .arrow, .arrow:hover { transform: rotate(45deg); }
.tags { display: flex; flex-wrap: wrap; gap: 8px; }
.tag { padding: 6px 12px; border-radius: 100px; font-size: 14px; background: rgba(255, 255, 255, .7); box-shadow: inset 0 0 0 1px #cfe5bf; }
.proj-science .tag { background: rgba(255, 255, 255, .06); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .14); color: rgba(233, 240, 230, .85); }
.proj-stats { margin-top: auto; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; padding-top: 24px; border-top: 1.5px dashed rgba(19, 32, 26, .18); }
.proj-science .proj-stats { border-top-color: rgba(255, 255, 255, .16); }
.ps-num { font-family: var(--f-display); font-weight: 800; font-size: clamp(28px, 3vw, 40px); letter-spacing: -.04em; line-height: 1; font-variant-numeric: tabular-nums; }
.ps-label { margin-top: 6px; font-size: 13px; line-height: 1.35; color: var(--ink-2); }
.proj-science .ps-label { color: rgba(233, 240, 230, .6); }

/* ── About ── */
.about { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
.about-photo { position: sticky; top: 96px; }
.about-photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; border-radius: var(--r-l); }
.about-sticker { position: absolute; right: -12px; top: 28px; transform: rotate(4deg); padding: 14px 18px; border-radius: 16px; background: var(--ink); color: var(--paper); font-family: var(--f-display); font-weight: 600; font-size: 15px; line-height: 1.3; box-shadow: 0 20px 40px -20px rgba(19, 32, 26, .6); }
.about-sticker span { color: var(--green); }
.about-lead { font-family: var(--f-display); font-size: clamp(26px, 3vw, 38px); font-weight: 600; line-height: 1.15; letter-spacing: -.025em; }
.about-lead em { font-style: normal; color: var(--green-ink); }
.about-body { margin-top: 20px; color: var(--ink-2); max-width: 60ch; }
.timeline { list-style: none; margin: 40px 0 0; padding: 0; display: grid; gap: 0; }
.tl { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 20px; padding: 20px 0; border-top: 1px solid var(--line); transition: background-color .25s; }
.tl:last-child { border-bottom: 1px solid var(--line); }
.tl-year { font-family: var(--f-mono); font-weight: 700; font-size: 15px; color: var(--green-ink); padding-top: 3px; }
.tl h3 { font-family: var(--f-display); font-size: 19px; font-weight: 600; letter-spacing: -.01em; }
.tl p { color: var(--ink-2); font-size: 15px; margin-top: 4px; }
.tl-now .tl-year { display: inline-flex; align-items: center; gap: 6px; }

/* ── Results ── */
.results { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; }
.big { grid-column: span 3; padding: 28px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
.big-num { font-family: var(--f-display); font-weight: 800; font-size: clamp(44px, 5vw, 72px); letter-spacing: -.05em; line-height: .9; font-variant-numeric: tabular-nums; }
.big p { color: var(--ink-2); font-size: 15px; line-height: 1.45; }
.big-dark { background: var(--night); color: #E9F0E6; box-shadow: none; }
.big-dark .big-num { color: var(--green); }
.big-dark p { color: rgba(233, 240, 230, .7); }
.chart { grid-column: span 6; padding: 28px clamp(24px, 3vw, 36px); display: flex; flex-direction: column; gap: 20px; min-width: 0; }
.chart-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
.chart-head h3 { font-size: 22px; font-weight: 700; }
.chart-head span { color: var(--ink-3); }
.bars { display: grid; gap: 14px; }
.bar { display: grid; grid-template-columns: 76px minmax(0, 1fr) 56px; align-items: center; gap: 14px; }
.bar-name { font-family: var(--f-display); font-weight: 600; font-size: 16px; }
.bar-track { height: 36px; border-radius: 8px; background: var(--paper); box-shadow: inset 0 0 0 1px var(--line); overflow: hidden; }
.bar-fill { height: 100%; width: calc(var(--w) * var(--p)); border-radius: 8px; background: repeating-linear-gradient(90deg, var(--green) 0 22px, #5fb336 22px 24px); transform-origin: 0 50%; }
.bar-val { font-family: var(--f-mono); font-weight: 700; font-size: 16px; text-align: right; font-variant-numeric: tabular-nums; }
.chart-note { font-size: 13px; color: var(--ink-3); }
@supports (animation-timeline: view()) {
  @media (prefers-reduced-motion: no-preference) {
    .bar-fill { animation: grow linear both; animation-timeline: view(); animation-range: entry 10% cover 40%; }
  }
}

/* ── Reviews ── */
.car-ctrl { display: flex; align-items: center; gap: 10px; }
.car-btn { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--tile); box-shadow: 0 0 0 1px var(--line); transition: background-color .2s, color .2s, transform .2s, opacity .2s; }
.car-btn:hover:not(:disabled) { background: var(--ink); color: var(--paper); }
.car-btn:disabled { opacity: .35; cursor: default; }
.is-static .car-ctrl, .is-static .car-bar { display: none; }
.car-track { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gut); padding-inline: var(--gut); padding-block: 8px 24px; scrollbar-width: none; overscroll-behavior-x: contain; cursor: grab; }
.car-track::-webkit-scrollbar { display: none; }
.car-track.is-dragging { cursor: grabbing; scroll-snap-type: none; }
.car-track.is-dragging * { pointer-events: none; }
.car-viewport { max-width: calc(var(--wrap) + 2 * 0px); margin-inline: auto; }
.car-bar { max-width: var(--wrap); margin: 8px auto 0; padding-inline: var(--gut); }
.car-bar > div { height: 3px; border-radius: 3px; background: var(--line); overflow: hidden; }
.car-thumb { display: block; height: 100%; border-radius: 3px; background: var(--ink); transition: transform .12s linear; }
.rev { scroll-snap-align: start; flex: 0 0 min(400px, 84vw); display: flex; flex-direction: column; gap: 18px; padding: 28px; border-radius: var(--r-l); background: var(--tile); box-shadow: 0 0 0 1px var(--line); transition: transform .35s var(--ease), box-shadow .35s; }
.rev:hover { transform: translateY(-4px); box-shadow: 0 0 0 1px var(--line), 0 30px 50px -34px rgba(19, 32, 26, .45); }
.rev-who { display: flex; align-items: center; gap: 14px; }
.ava { flex-shrink: 0; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: var(--green-soft); color: var(--green-ink); font-family: var(--f-display); font-weight: 700; font-size: 18px; }
.rev-who strong { display: block; font-family: var(--f-display); font-weight: 600; font-size: 17px; line-height: 1.2; }
.rev-who span { font-size: 14px; color: var(--ink-3); }
