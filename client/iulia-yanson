    max-width: 320px;
    margin: 0 auto;
  }
  .form-success-actions a,
  .form-success-actions button {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.9rem 1.5rem;
    border-radius: 40px;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.2s, background 0.2s;
  }
  .form-success-actions .btn-max {
    background: var(--teal-400);
    color: white;
    border: none;
    box-shadow: 0 4px 20px rgba(29,158,117,0.28);
  }
  .form-success-actions .btn-max:hover { background: var(--teal-600); transform: translateY(-2px); }
  .form-success-actions .btn-again {
