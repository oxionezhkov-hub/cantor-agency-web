  // Form submit
  function showFormError(message) {
    const errorBox = document.getElementById('formError');
    errorBox.textContent = message;
    errorBox.classList.add('show');
  }
  function hideFormError() {
    document.getElementById('formError').classList.remove('show');
  }

  function resetFormView() {
    document.getElementById('formFields').style.display = '';
    document.getElementById('formSuccess').classList.remove('show');
  }

  function submitForm() {
    hideFormError();
    const fields = ['student_name','student_last','grade','subject','parent_name','phone'];
    let valid = true;
    fields.forEach(id => {
      const el = document.getElementById(id);
      const trigger = el.closest('.select-wrap')?.querySelector('.select-trigger');
      if (!el.value.trim()) {
        if (trigger) trigger.classList.add('error');
        else el.style.borderColor = '#E24B4A';
        valid = false;
      } else {
        if (trigger) trigger.classList.remove('error');
        else el.style.borderColor = '';
      }
    });
    const consent = document.getElementById('consent');
    const consentRow = consent.closest('.consent-row');
    if (!consent.checked) {
      consentRow.classList.add('error');
      valid = false;
    } else {
      consentRow.classList.remove('error');
    }
    if (!valid) {
      showFormError('Пожалуйста, заполните все обязательные поля и подтвердите согласие на обработку данных.');
      return;
    }

    const adConsent = document.getElementById('adConsent');
    const submitBtn = document.querySelector('#form .form-submit button');
    const payload = {
      source: 'iulia-yanson',
      fields: {
        'Имя ученика': document.getElementById('student_name').value.trim(),
        'Фамилия ученика': document.getElementById('student_last').value.trim(),
        'Класс': document.getElementById('grade').value,
        'Предмет': document.getElementById('subject').selectedOptions[0]?.textContent || document.getElementById('subject').value,
        'Цель и описание ситуации': document.getElementById('goal').value.trim(),
        'Имя и отчество родителя': document.getElementById('parent_name').value.trim(),
        'Телефон': document.getElementById('phone').value.trim(),
        'Email': document.getElementById('email').value.trim(),
        'Согласие на рекламную рассылку': adConsent.checked ? 'да' : 'нет',
      },
    };

    if (submitBtn) submitBtn.disabled = true;

    fetch(API_BASE + '/api/leads/notify', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
      .then((res) => {
        if (!res.ok) throw new Error('request_failed');
        // Reset fields for next time, then show the success screen
        document.querySelectorAll('#form input, #form textarea').forEach(el => el.value = '');
        document.querySelectorAll('#form select').forEach(resetCustomSelect);
        consent.checked = false;
        adConsent.checked = false;
        document.getElementById('formFields').style.display = 'none';
        document.getElementById('formSuccess').classList.add('show');
      })
      .catch(() => {
        showFormError('Не удалось отправить заявку. Попробуйте ещё раз, пожалуйста.');
      })
      .finally(() => {
        if (submitBtn) submitBtn.disabled = false;
      });
  }
// Toggle reviews — показать все / свернуть
const toggleBtn = document.getElementById('reviewsToggleBtn');
const photoGrid = document.getElementById('reviewsPhotoGrid');
const ctaWrapper = document.getElementById('reviewsCtaWrapper');
let expanded = false;

if (toggleBtn && photoGrid && ctaWrapper) {
  toggleBtn.addEventListener('click', function() {
    expanded = !expanded;
    photoGrid.classList.toggle('expanded', expanded);

    if (expanded) {
      // Развернуто — скрываем кнопку
      ctaWrapper.classList.add('hidden');
    } else {
      // Свернуто — показываем кнопку (по сути никогда не сработает, т.к. кнопка скрыта)
      ctaWrapper.classList.remove('hidden');
    }
  });
}
