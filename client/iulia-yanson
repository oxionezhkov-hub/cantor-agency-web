  text-align: center;
  margin-top: 0.25rem; /* было 0.5rem — теперь ещё ближе */
}

.reviews-cta .btn-outline {
  border-color: var(--teal-400);
  color: var(--teal-400);
  background: rgba(255, 255, 255, 0.85); /* лёгкий белый фон, чтобы кнопка читалась на фоне картинок */
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  font-weight: 500;
  cursor: pointer;
  padding: 0.7rem 1.8rem;
  border-radius: 40px;
  font-size: 0.95rem;
  transition: all 0.2s;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
