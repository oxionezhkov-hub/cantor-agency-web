  }
  .policy-requisites {
    margin-top: 1.2rem;
    padding: 1rem 1.1rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .policy-requisites-title {
    font-size: 0.75rem;
