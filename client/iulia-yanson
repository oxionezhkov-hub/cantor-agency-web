    /* REVIEWS */
    .reviews-grid { grid-template-columns: 1fr; }

    .form-title em { display: block; }

    /* FORM */
    .form-section { padding: 2rem 1.25rem; border-radius: 16px; }
    .form-grid { grid-template-columns: 1fr; }
    .form-group.full { grid-column: 1; }
    .form-submit button {
      max-width: 100%;
      padding: 1.1rem 1.5rem;
      font-size: 1rem;
    }
    .select-trigger { font-size: 16px; }

    /* FOOTER */
    .footer-inner { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
    .footer-links { gap: 1rem; }

    /* HOW-IT-WORKS section */
    section.lessons-section {
      border-radius: 16px;
      max-width: none;
      margin-left: 1vw;
      margin-right: 1vw;
      width: auto;
    }
  }

  /* EXTRA SMALL < 400px */
  @media (max-width: 400px) {
    .hero h1 { font-size: 1.9rem; }
    .stats-grid { grid-template-columns: 1fr 1fr; }
    .hero-stats-mobile { grid-template-columns: 1fr 1fr; }
  }

  /* REVIEWS — колонки, картинки прижаты друг к другу сверху, с затемнением внизу */
/* REVIEWS — колонки, картинки прижаты друг к другу сверху, с затемнением внизу */
.reviews-photos-wrapper {
  position: relative;
  margin-bottom: 0; /* убираем отступ снизу, чтобы кнопка была ближе */
}

.reviews-photos-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.25rem;
  align-items: start;
  max-height: 380px; /* было 580 — теперь видно меньше (~1–1,5 ряда) */
  overflow: hidden;
  transition: max-height 0.5s ease;
}

.reviews-photos-grid.expanded {
  max-height: 6000px;
}

/* Полупрозрачный градиент — теперь начинается выше и короче */
.reviews-fade-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100px; /* было 120 — короче, затемнение начинается выше */
  background: linear-gradient(to bottom, rgba(245, 251, 250, 0) 0%, var(--bg) 85%);
  pointer-events: none;
  transition: opacity 0.4s ease;
  z-index: 2;
}

/* Когда развернуто — затемнение исчезает */
.reviews-photos-grid.expanded ~ .reviews-fade-overlay {
  opacity: 0;
  pointer-events: none;
}

.review-col {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.review-photo-item {
