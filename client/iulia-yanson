  /* VIDEO REVIEWS */
  .video-reviews-section {
    margin-top: 3rem;
  }
  .video-reviews-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--text);
    margin-bottom: 1.5rem;
  }
  .video-reviews-grid {
