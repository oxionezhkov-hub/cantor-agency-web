  .policy-req-row:last-child { border-bottom: none; }
  .policy-req-label { min-width: 130px; flex-shrink: 0; color: var(--text-muted); }
  .policy-req-val { color: var(--text-soft); }

  /* FOOTER */
  footer {
    background: var(--text);
    color: rgba(255,255,255,0.7);
    padding: 3rem var(--page-padding);
  }
  .footer-inner {
    display: flex;
