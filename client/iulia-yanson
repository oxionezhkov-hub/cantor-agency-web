    color: var(--teal-600);
    border: 1.5px solid var(--border);
  }
  .form-success-actions .btn-again:hover { border-color: var(--teal-400); transform: translateY(-2px); }

  /* POLICY MODAL */
  .policy-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
  }
  .policy-modal.open {
    display: block;
  }
  .policy-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 20, 18, 0.55);
    backdrop-filter: blur(2px);
  }
  .policy-modal-dialog {
    position: relative;
    max-width: 640px;
    width: calc(100% - 2.4rem);
    max-height: calc(100vh - 4rem);
    margin: 2rem auto;
    background: var(--bg, #fff);
