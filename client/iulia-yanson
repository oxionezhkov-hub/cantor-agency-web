  }
  .policy-modal-body a {
    color: var(--teal-600);
    text-decoration: underline;
  }
  .policy-modal-body h4 {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    margin: 1.3rem 0 0.5rem;
  }
  .policy-modal-body h4:first-child {
    margin-top: 0;
  }
  .policy-modal-body ul {
    margin: -0.3rem 0 0.9rem;
    padding-left: 1.2rem;
  }
  .policy-modal-body li {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-soft);
    margin-bottom: 0.35rem;
  }
  .policy-modal-dialog--wide {
    max-width: 720px;
  }
  .policy-modal-close {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--text-soft);
