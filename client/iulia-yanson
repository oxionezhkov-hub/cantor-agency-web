  /* STICKY CTA - glass */
  .sticky-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 95;
    padding: 0.75rem var(--page-padding) calc(0.75rem + env(safe-area-inset-bottom, 0px));
    background: rgba(245,251,250,0.82);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    border-top: 1px solid rgba(15,110,86,0.12);
    box-shadow: 0 -4px 24px rgba(15,110,86,0.08);
    transform: translateY(110%);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .sticky-cta.visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  .sticky-cta-btn {
    display: block;
    width: 100%;
    background: var(--teal-400);
    color: white;
    text-align: center;
    text-decoration: none;
    padding: 0.95rem 1.5rem;
    border-radius: 40px;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    box-shadow: 0 4px 20px rgba(29,158,117,0.28);
  }
  .sticky-cta-btn:hover { background: var(--teal-600); }

  /* BURGER MENU */
  .nav-burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 6px;
    border: none;
    background: none;
    z-index: 200;
  }
  .nav-burger span {
    display: block;
    width: 24px; height: 2px;
    background: var(--teal-600);
    border-radius: 2px;
    transition: transform 0.3s, opacity 0.3s;
  }
  .nav-burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-burger.open span:nth-child(2) { opacity: 0; }
  .nav-burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-menu {
    display: none;
    position: fixed;
    top: 64px; left: 0; right: 0;
    background: rgba(245,251,250,0.92);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    border-bottom: 1px solid rgba(15,110,86,0.10);
    box-shadow: 0 8px 24px rgba(15,110,86,0.08);
    padding: 1.5rem var(--page-padding) 2rem;
    z-index: 99;
    flex-direction: column;
    gap: 0;
  }
  .mobile-menu.open { display: flex; }
  .mobile-menu a {
    text-decoration: none;
    color: var(--text-soft);
    font-size: 1.1rem;
    font-weight: 400;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
    transition: color 0.2s;
  }
  .mobile-menu a:hover { color: var(--teal-400); }

  /* TABLET 900–1100px */
  @media (max-width: 1100px) {
    .hero { gap: 2rem; padding: 96px 4vw 64px; }
    .avatar-frame { width: 300px; height: 360px; }
    .stat-badges.left { left: -10px; }
    .stat-badges.right { right: -10px; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
    .steps-grid { grid-template-columns: repeat(2, 1fr); }
    .steps-grid::before { display: none; }
  }

  /* MOBILE < 768px */
  @media (max-width: 768px) {
    section { padding: 64px var(--page-padding); }

    /* NAV */
    .nav-links { display: none; }
    .nav-burger { display: flex; }
    /* mobile-menu uses glass too */

    body.has-sticky-cta { padding-bottom: calc(76px + env(safe-area-inset-bottom, 0px)); }

    /* HERO */
    .hero-content {
      display: flex;
      flex-direction: column;
    }
    .hero-tag { display: none; }
    .hero h1 { order: 2; margin-bottom: 1rem; }
    .hero-desc { order: 3; margin-bottom: 1rem; font-size: 0.92rem; line-height: 1.65; }
    .hero-photo-mobile { order: 4; margin-bottom: 1.25rem; }
    .hero-btns { order: 5; margin-bottom: 1.25rem; }
    .hero-stats-mobile { order: 6; }
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding: 80px var(--page-padding) 40px;
      gap: 0;
    }
    .hero::before { display: none; }
    .hero-photo-mobile { display: block; }
    .hero-visual { display: none; }
    .hero h1 { font-size: clamp(2rem, 8vw, 2.8rem); }
    .hero-desc { font-size: 0.98rem; max-width: 100%; }
    .hero-btns { flex-direction: column; }
    .btn-primary, .btn-outline { text-align: center; width: 100%; }

    /* mobile stats strip after hero text */
    .hero-stats-mobile {
      display: grid !important;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
      margin-top: 0.5rem;
    }
    .hero-stat-m {
      background: white;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 0.9rem 1rem;
      text-align: center;
    }
    .hero-stat-m strong {
      display: block;
      font-family: var(--font-body);
      font-size: 1.6rem;
      color: var(--teal-400);
      font-weight: 600;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }
    .hero-stat-m span {
      font-size: 0.72rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    /* ABOUT */
    .about-grid {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    .about-text { order: 1; }
    .about-photo-wrap { order: 2; max-width: 320px; margin: 0 auto; width: 100%; }

    /* STATS */
    .stats-bg { padding: 56px var(--page-padding); }
    .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
    .stat-num { font-size: 2.2rem; height: 2.75rem; margin-bottom: 1rem; }
    .stat-card { padding: 1.25rem 1rem; }

    /* SERVICES */
    .services-grid { grid-template-columns: 1fr; }

    /* STEPS — vertical timeline on mobile */
    .steps-block { display: block; margin-top: 2.5rem; }
    .steps-grid {
      display: flex;
      flex-direction: column;
      gap: 0;
      max-width: 100%;
      margin: 0;
    }
    .steps-grid::before {
      display: block;
      left: 27px;
      right: auto;
      top: 28px;
      bottom: 28px;
      width: 2px;
      height: auto;
      transform: none;
      background: linear-gradient(to bottom, var(--teal-100), var(--teal-200), var(--teal-100));
    }
    .step-item {
      display: flex;
      gap: 1.25rem;
      align-items: flex-start;
      text-align: left;
      padding: 1rem 0;
    }
    .step-num {
      width: 56px;
      height: 56px;
      min-width: 56px;
