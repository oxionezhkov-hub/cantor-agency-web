  }

  /* ── Active section in the nav ── */
  const navLinks = $$('.nav a[href^="#"]');
  if ('IntersectionObserver' in window && navLinks.length) {
    const map = new Map();
    navLinks.forEach(a => {
      const s = document.getElementById(a.getAttribute('href').slice(1));
