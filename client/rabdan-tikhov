    map.forEach((a, s) => io.observe(s));
  }

  /* ── Count-up numbers (the final value is in the markup, so the page reads right without JS) ── */
  const fmt = n => n.toLocaleString('ru-RU');
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(entries => entries.forEach(e => {
      if (!e.isIntersecting) return;
      io.unobserve(e.target);
      const el = e.target;
      const to = Number(el.dataset.count);
      const t0 = performance.now();
      const dur = 1500;
      const step = now => {
        const p = Math.min(1, (now - t0) / dur);
        el.textContent = fmt(Math.round(to * (1 - Math.pow(1 - p, 4))));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }), { threshold: 0.5 });
    $$('[data-count]').forEach(el => io.observe(el));
  }

  /* ── Carousels: scroll-snap track + arrows + progress thumb + mouse drag ── */
