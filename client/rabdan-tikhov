-4.4 3.6zm1.8-5.6a16.5 16.5 0 0 0 0-4h3.4a8.2 8.2 0 0 1 0 4h-3.4z"/></svg></span><span><strong>Статья</strong><span>Organic Letters, doi:10.1021/acs.orglett.8b01317</span></span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 17L17 7M8 7h9v9"/></svg></a><a class="social" href="https://rusneb.ru/catalog/000224_000128_0002678208_20190124_C1_RU/" target="_blank" rel="noopener"><span class="social-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.9 6h-3a15.7 15.7 0 0 0-1.4-3.6A8 8 0 0 1 18.9 8zM12 4c.8 1.2 1.5 2.5 1.9 4h-3.8c.4-1.5 1.1-2.8 1.9-4zM4.3 14a8.2 8.2 0 0 1 0-4h3.4a16.5 16.5 0 0 0 0 4H4.3zm.8 2h3a15.7 15.7 0 0 0 1.4 3.6A8 8 0 0 1 5.1 16zm3-8h-3a8 8 0 0 1 4.4-3.6C8.9 5.5 8.4 6.7 8.1 8zM12 20c-.8-1.2-1.5-2.5-1.9-4h3.8c-.4 1.5-1.1 2.8-1.9 4zm2.3-6H9.7a14.7 14.7 0 0 1 0-4h4.6a14.7 14.7 0 0 1 0 4zm.2 5.6c.6-1.1 1.1-2.3 1.4-3.6h3a8 8 0 0 1-4.4 3.6zm1.8-5.6a16.5 16.5 0 0 0 0-4h3.4a8.2 8.2 0 0 1 0 4h-3.4z"/></svg></span><span><strong>Патент</strong><span>RU 2678208 C1</span></span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 17L17 7M8 7h9v9"/></svg></a></div><div class="x-gallery x-docs"><a class="x-shot rv" href="images/rabdan-tikhov/diplomas-1.jpg" data-lb="certificates" data-caption="Диплом кандидата химических наук"><img src="images/rabdan-tikhov/diplomas-1.jpg" alt="Диплом кандидата химических наук" loading="lazy"><span>Диплом кандидата химических наук</span></a><a class="x-shot rv" href="images/rabdan-tikhov/diplomas-2.jpg" data-lb="certificates" data-caption="Диплом специалиста РХТУ им. Д. И. Менделеева"><img src="images/rabdan-tikhov/diplomas-2.jpg" alt="Диплом специалиста РХТУ им. Д. И. Менделеева" loading="lazy"><span>Диплом специалиста РХТУ им. Д. И. Менделеева</span></a><a class="x-shot rv" hr