    let group = [], idx = 0, lastFocus = null;

    function show(i) {
      idx = (i + group.length) % group.length;
      const a = group[idx];
      img.classList.remove('is-in');
      img.src = a.getAttribute('href');
      img.alt = a.dataset.caption || '';
      cap.textContent = a.dataset.caption || '';
      count.textContent = group.length > 1 ? (idx + 1) + ' / ' + group.length : '';
      bPrev.hidden = bNext.hidden = group.length < 2;
    }
    img.addEventListener('load', () => img.classList.add('is-in'));
    function open(a) {
      group = lbLinks.filter(x => x.dataset.lb === a.dataset.lb);
      lastFocus = document.activeElement;
      show(group.indexOf(a));
