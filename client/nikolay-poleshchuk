      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1, true); }
      else if (e.key === 'Home') { e.preventDefault(); setActive(0, true); }
      else if (e.key === 'End') { e.preventDefault(); setActive(opts.length - 1, true); }
      else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); choose(active); }
      else if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); close(true); }
      else if (e.key === 'Tab') close(false);
    });
    document.addEventListener('click', e => { if (!dd.contains(e.target)) close(false); });
  });

  /* ── Privacy policy dialog ── */
  $$('[data-dialog]').forEach(a => a.addEventListener('click', e => {
    const d = document.getElementById(a.dataset.dialog);
    if (!d || typeof d.showModal !== 'function') return;
    e.preventDefault();
    d.showModal();
    document.body.classList.add('lb-open');
  }));
  $$('dialog').forEach(d => {
    d.addEventListener('close', () => document.body.classList.remove('lb-open'));
    d.addEventListener('click', e => { if (e.target === d) d.close(); });
  });

  /* ── Contact form ── */
  const form = $('#contactForm');
  if (form) {
    const phone = $('#inp-phone');
    const name = $('#inp-name');
    const success = $('#formSuccess');
    phone.addEventListener('input', e => {
      if (e.inputType && e.inputType.indexOf('delete') === 0) return;
      let d = phone.value.replace(/\D/g, '');
      if (!d) { phone.value = ''; return; }
      if (d[0] === '8') d = '7' + d.slice(1);
      if (d[0] !== '7') d = '7' + d;
      d = d.slice(0, 11);
      let out = '+7';
      if (d.length > 1) out += ' (' + d.slice(1, 4);
      if (d.length >= 4) out += ')';
      if (d.length > 4) out += ' ' + d.slice(4, 7);
      if (d.length > 7) out += '-' + d.slice(7, 9);
      if (d.length > 9) out += '-' + d.slice(9, 11);
      phone.value = out;
    });
    const mark = (input, bad) => {
      input.closest('.field').classList.toggle('is-error', bad);
      input.setAttribute('aria-invalid', String(bad));
    };
    name.addEventListener('input', () => mark(name, false));
    phone.addEventListener('input', () => mark(phone, false));
    form.addEventListener('submit', e => {
      e.preventDefault();
      const badName = !name.value.trim();
      const badPhone = phone.value.replace(/\D/g, '').length < 11;
      mark(name, badName);
      mark(phone, badPhone);
      if (badName || badPhone) { (badName ? name : phone).focus(); return; }
      const btn = $('button[type="submit"]', form);
      btn.disabled = true;
      btn.classList.add('is-loading');
      setTimeout(() => {
        form.hidden = true;
        success.hidden = false;
        success.focus();
      }, 700);
    });
  }
})();
</script>
</body>
</html>
