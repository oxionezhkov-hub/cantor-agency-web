{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mainweb",
  "main": "_worker.js",
  "compatibility_date": "2026-07-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // RESEND_API_KEY and TELEGRAM_BOT_TOKEN are secrets and must NOT be set here —
  // this file is committed to a public repo, and GitHub secret scanning already
  // caused a prior key (and, separately, a Telegram bot token) to be revoked/abused
  // after being exposed this way. Set them instead via the Cloudflare dashboard:
  // Workers & Pages -> mainweb -> Settings -> Variables and Secrets -> Add
  // variable -> toggle "Encrypt". They're still available as env.RESEND_API_KEY /
  // env.TELEGRAM_BOT_TOKEN at runtime, just never stored in this file or in git.
  "vars": {
    "ADMIN_EMAIL": "oxion.ezhkov@gmail.com,yuliayanson-27@yandex.ru",
    "OPS_ALERT_EMAIL": "oxion.ezhkov@gmail.com",
    "TELEGRAM_CHAT_ID": ""
  },
  "kv_namespaces": [
    {
      "binding": "MBA_MYBRAND_KV",
      "id": "d6de16be80b74e07a8d2ebe1e0aae5cc"
    },
    {
      "binding": "UTM_LINKS_KV",
      "id": "4a97c8981af14ebebcc85a162af66f4f"
    },
    {
      "binding": "SERP_ANALYSIS_KV",
      "id": "1855e8b4041049c68bbc31a5d75703b8"
    },
    {
      "binding": "AVITO_KV",
      "id": "ad6fea8159ef48c4b2833620e72c52af"
    }
  ]
}
