{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mainweb",
  "main": "_worker.js",
  "compatibility_date": "2026-07-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // RESEND_API_KEY and the per-landing-page TELEGRAM_BOT_TOKEN_<CLIENT> secrets
  // (e.g. TELEGRAM_BOT_TOKEN_KARLOVA — see LEAD_TELEGRAM_CONFIG in _worker.js)
  // must NOT be set here — this file is committed to a public repo, and GitHub
  // secret scanning already caused a prior key (and, separately, a Telegram bot
  // token) to be revoked/abused after being exposed this way. Set them instead
  // via the Cloudflare dashboard: Workers & Pages -> mainweb -> Settings ->
  // Variables and Secrets -> Add variable -> toggle "Encrypt". They're still
  // available as env.RESEND_API_KEY / env.TELEGRAM_BOT_TOKEN_KARLOVA at runtime,
  // just never stored in this file or in git. Chat ids aren't secret and live
  // in plain "vars" below, one comma-separated TELEGRAM_CHAT_IDS_<CLIENT> var
  // per landing page.
  "vars": {
    "ADMIN_EMAIL": "oxion.ezhkov@gmail.com,yuliayanson-27@yandex.ru",
    "OPS_ALERT_EMAIL": "oxion.ezhkov@gmail.com",
    "TELEGRAM_CHAT_IDS_KARLOVA": "6295628819,1326867567",
    // «Отчёт», «База знаний», «Итоги встречи» and «ИИ-помощник» run on Workers AI (the "ai" binding
    // below, see "Workers AI jobs" in _worker.js). Knowledge-base edits are committed to main through
    // the GitHub API: a fine-grained token (github.com/settings/personal-access-tokens -> this repo
    // only -> Contents: Read and write) goes in as the encrypted secret GITHUB_TOKEN, same as above.
    // Optional plain var WORKERS_AI_MODEL overrides the model (default: the control bot's), and
    // ASSISTANT_AI_MODEL — only «ИИ-помощник»'s (e.g. "@cf/openai/gpt-oss-120b": answers better, costs
    // ~5× more of the daily free allocation per answer).
    // Control bot (see "Control bot" in _worker.js): who gets its messages. Its token lives in
    // the CONTROL_BOT_TOKEN secret (dashboard -> Variables and Secrets, "Encrypt"), never here.
    "CONTROL_BOT_OWNER_IDS": "1326867567"
    // Avito → Telegram notifier bots (AVITO_NOTIFY_BOTS in _worker.js): one token secret per bot,
    // e.g. AVITO_BOT_TOKEN_ROMASHOVA (dashboard -> Variables and Secrets, "Encrypt"); one bot can
    // serve several cabinets.
    // /sales-crm ⇄ owner's personal Telegram (handleSalesCrmTgSync in _worker.js): secret
    // SALESCRM_SYNC_SECRET, the same value as CRM_SYNC_SECRET on the MyBrand "tasktracker" worker.
  },
  // Workers AI (free daily allocation) — the control bot's task extraction and Q&A, the daily report's
  // observations, knowledge-base updates, meeting summaries and the tracker's «ИИ-помощник».
  "ai": {
    "binding": "AI"
  },
  // Control bot: AI queue, deadline checks and the 10:00 / 11:00 / 13:05 MSK summaries.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "MBA_MYBRAND_KV",
      "id": "d6de16be80b74e07a8d2ebe1e0aae5cc"
    },
    {
      "binding": "UTM_LINKS_KV",
      "id": "4a97c8981af14ebebcc85a162af66f4f"
    },
    {
      "binding": "SERP_ANALYSIS_KV",
      "id": "1855e8b4041049c68bbc31a5d75703b8"
    },
    {
      "binding": "AVITO_KV",
      "id": "ad6fea8159ef48c4b2833620e72c52af"
    },
    {
      "binding": "AGENCY_DASHBOARD_KV",
      "id": "b0921ad0182347b091c7fe4947d91cba"
    }
  ]
}
