    });
  }).catch(function(e){ if (e.message !== 'unauthorized') adminError('queue', e); });
}

// ── Router ──
function go(hash){ if (location.hash === hash) route(); else location.hash = hash; }
var lastHash = null;
function route(keepScroll){
  var hash = location.hash || '#/';
  var parts = hash.replace(/^#\/?/, '').split('/').map(decodeURIComponent);
  var scrollY = window.scrollY;
  if (!state.session) return renderAuth('register');
  if (state.session.role === 'admin'){
    if (parts[0] === 'admin' && parts[1] === 'users') renderUsers();
    else if (parts[0] === 'admin' && parts[1] === 'u' && parts[2] && parts[3]) renderReview(parts[2], Number(parts[3]));
    else if (parts[0] === 'admin' && parts[1] === 'u' && parts[2]) renderAdminUser(parts[2]);
    else if (parts[0] === 'module' && parts[1]) renderModule(Number(parts[1]));
    else if (parts[0] === 'admin') renderQueue();
    else renderHome();
  } else {
    if (!state.user) return;
    if (parts[0] === 'module' && parts[1]) renderModule(Number(parts[1]));
    else if (parts[0] === 'tasks') renderTasks();
    else if (parts[0] === 'feedback') renderFeedback();
    else renderHome();
  }
  if (keepScroll === true && hash === lastHash) window.scrollTo(0, scrollY);
  else if (hash !== lastHash) window.scrollTo(0, 0);
  lastHash = hash;
}
window.addEventListener('hashchange', function(){ route(); });

// ── Boot ──
function boot(){
  var s = state.session;
  if (!s || (s.role === 'trainee' && !s.tg) || (s.role === 'admin' && !s.token)){ state.session = null; return renderAuth('register'); }
  if (s.role === 'admin'){ if (!location.hash || location.hash === '#/') location.hash = '#/admin'; return route(); }
  var cached = lsGet(USER_KEY);
  if (cached && cached.tg === s.tg){ state.user = cached; route(); }
  api('me', {tg: s.tg}).then(function(r){
    if (r.ok && r.data.user){ state.user = r.data.user; state.offline = false; lsSet(USER_KEY, state.user); route(true); return; }
    var err = r.data && r.data.error;
    if (err === 'blocked') return renderBlocked();
    if (err === 'not_found'){ lsDel(SESSION_KEY); lsDel(USER_KEY); state.session = null; state.user = null; return renderAuth('register', 'Профиль не найден — возможно, его удалили. Зарегистрируйтесь заново или напишите ' + supportLink + '.'); }
    throw new Error(err || r.status);
  }).catch(function(){
    if (state.user){ state.offline = true; route(true); }
    else app.innerHTML = '<div class="auth"><div class="auth-card"><h1 class="auth-title">Нет связи с сервером</h1><p class="auth-sub">Проверьте интернет и обновите страницу. Если не помогает — напишите ' + supportLink + '.</p><button class="btn btn-primary btn-block" type="button" onclick="location.reload()">Обновить</button></div></div>';
  });
}
boot();
})();
</script>
