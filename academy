// ── Admin ──
function adminApi(action, body){
  body = body || {}; body.token = state.session.token;
  return api(action, body).then(function(r){
    if (r.status === 401){ lsDel(SESSION_KEY); state.session = null; renderAuth('register', 'Сессия админа истекла — войдите снова.'); throw new Error('unauthorized'); }
    return r;
  });
}
function summarize(user){
  var subs = subsOf(user), ids = Object.keys(subs);
  var pending = ids.filter(function(id){ return subs[id].status === 'pending'; }).map(Number);
  return {tg: user.tg, name: user.name, blocked: !!user.blocked, submitted: ids.length,
    accepted: ids.filter(function(id){ return subs[id].status === 'accepted'; }).length,
    revise: ids.filter(function(id){ return subs[id].status === 'revise'; }).length,
    pending: pending, pendingSince: pending.map(function(id){ return subs[id].submittedAt; }).sort()[0] || null,
    createdAt: user.createdAt, lastSeenAt: user.lastSeenAt};
}
function pendingTotal(){ return (state.admin.users || []).reduce(function(n, u){ return n + (u.blocked ? 0 : (u.pending || []).length); }, 0); }
function loadUsers(force){
  if (state.admin.users && !force) return Promise.resolve(state.admin.users);
  return adminApi('admin/users').then(function(r){
    if (!r.ok) throw new Error(r.data.error || r.status);
    state.admin.users = r.data.users;
    return state.admin.users;
  });
}
function loadUser(tg, force){
  if (state.admin.full[tg] && !force) return Promise.resolve(state.admin.full[tg]);
  return adminApi('admin/user', {tg: tg}).then(function(r){
