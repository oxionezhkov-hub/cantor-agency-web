<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="robots" content="noindex, nofollow">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#F6F5F2">
<title>Стажировка Авито — Cantor Agency</title>
<link rel="preload" href="/fonts/geologica-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/unbounded-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="icon" type="image/svg+xml" href="/images/brand/favicon.svg">
<link rel="apple-touch-icon" href="/images/brand/favicon.svg">
<style>
/* Tokens — те же, что на главной и в базе знаний */
:root{
  --red:#E8391D;--red-dark:#C42D13;--red-light:#FF6347;--red-bg:#FFF1EC;
  --ink:#141414;--text:#1C1C1C;--muted:#6F6B66;--bg:#F6F5F2;--paper:#EFEDE8;--white:#fff;
  --line:#E2E0DC;--dark:#0F0F0F;--dark2:#1A1A1A;
  --green:#1F8A4C;--green-bg:#E9F6EE;--amber:#B26A00;--amber-bg:#FFF5E0;--blue:#2459C7;--blue-bg:#EAF0FC;
  --font-display:'Unbounded','Arial Black',sans-serif;
  --font-body:'Geologica',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --r-sm:8px;--r-md:12px;--r-lg:16px;--r-xl:22px;
  --shadow-sm:0 2px 8px rgba(0,0,0,.05);--shadow-md:0 14px 40px rgba(0,0,0,.08);
  --header-h:64px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%;scroll-padding-top:calc(var(--header-h) + 16px)}
body{font-family:var(--font-body);font-size:16px;line-height:1.65;color:var(--text);background:var(--bg);-webkit-font-smoothing:antialiased;overflow-x:hidden;min-height:100vh}
a{color:var(--red-dark)}
button,input,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2.5px solid var(--red);outline-offset:2px;border-radius:6px}
[hidden]{display:none!important}
.wrap{max-width:920px;margin:0 auto;padding:32px 20px 96px}
.muted{color:var(--muted)}

/* ───────── Buttons & fields ───────── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 22px;border-radius:999px;border:1px solid transparent;font-weight:700;font-size:15px;text-decoration:none;transition:background .15s,border-color .15s,transform .1s,opacity .15s;white-space:nowrap;-webkit-tap-highlight-color:transparent}
.btn:active{transform:scale(.98)}
.btn-primary{background:var(--red);color:#fff}
.btn-primary:hover{background:var(--red-dark)}
.btn-ghost{background:var(--white);border-color:var(--line);color:var(--ink)}
.btn-ghost:hover{border-color:var(--red);color:var(--red-dark)}
.btn-green{background:var(--green);color:#fff}
.btn-green:hover{background:#176b3a}
.btn-amber{background:var(--white);border-color:#E9B45A;color:var(--amber)}
.btn-amber:hover{background:var(--amber-bg)}
.btn-danger{background:var(--white);border-color:#F1B5A9;color:var(--red-dark)}
.btn-danger:hover{background:var(--red-bg)}
.btn-sm{min-height:38px;padding:0 16px;font-size:14px}
.btn[disabled]{opacity:.5;cursor:not-allowed;transform:none}
.btn-block{width:100%}
.field{display:block;margin-bottom:14px}
.field-label{display:block;font-size:13px;font-weight:600;color:var(--muted);margin-bottom:6px}
.input,.textarea{width:100%;background:var(--white);border:1.5px solid var(--line);border-radius:var(--r-md);padding:12px 14px;font-size:16px;line-height:1.5;transition:border-color .15s,box-shadow .15s}
.input:focus,.textarea:focus{outline:none;border-color:var(--red);box-shadow:0 0 0 4px rgba(232,57,29,.1)}
.textarea{min-height:130px;resize:vertical}
.textarea[readonly]{background:var(--paper);border-color:transparent;resize:none}
.form-error{background:var(--red-bg);color:var(--red-dark);border-radius:var(--r-md);padding:10px 14px;font-size:14px;margin-bottom:14px}
.form-error a{font-weight:700}

/* ───────── Auth ───────── */
.auth{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:32px 16px;background:radial-gradient(1200px 500px at 110% -10%,#FFE3DA 0%,transparent 60%),radial-gradient(900px 500px at -20% 110%,#F1E9FF 0%,transparent 55%),var(--bg)}
.auth-card{width:100%;max-width:440px;background:var(--white);border:1px solid var(--line);border-radius:var(--r-xl);box-shadow:var(--shadow-md);padding:30px 28px}
.auth-logo{display:flex;align-items:center;gap:10px;margin-bottom:22px;text-decoration:none;color:var(--ink)}
.auth-logo img{height:30px;width:auto}
.auth-logo span{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);border-left:1px solid var(--line);padding-left:10px}
.auth-title{font-family:var(--font-display);font-weight:800;font-size:24px;line-height:1.2;letter-spacing:-.02em;color:var(--ink);margin-bottom:8px}
.auth-sub{font-size:14.5px;color:var(--muted);margin-bottom:22px}
.auth-points{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:22px}
.auth-points span{font-size:12.5px;font-weight:600;background:var(--paper);border-radius:999px;padding:5px 11px;color:var(--text)}
.seg{display:flex;background:var(--paper);border-radius:999px;padding:4px;margin-bottom:20px}
.seg button{flex:1;border:none;background:none;border-radius:999px;min-height:40px;font-weight:700;font-size:14px;color:var(--muted)}
.seg button.on{background:var(--white);color:var(--ink);box-shadow:var(--shadow-sm)}
.auth-help{font-size:13px;color:var(--muted);margin-top:16px;text-align:center}

/* ───────── App header & nav ───────── */
.topbar{position:sticky;top:0;z-index:50;background:rgba(246,245,242,.92);backdrop-filter:saturate(1.4) blur(10px);-webkit-backdrop-filter:saturate(1.4) blur(10px);border-bottom:1px solid var(--line)}
.topbar-in{max-width:1120px;margin:0 auto;height:var(--header-h);padding:0 20px;display:flex;align-items:center;gap:16px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink);flex:0 0 auto}
.brand img{height:26px;width:auto}
.brand span{font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);border-left:1px solid var(--line);padding-left:10px}
.nav{display:flex;gap:4px;margin:0 auto}
.nav a{position:relative;display:flex;align-items:center;gap:7px;padding:9px 16px;white-space:nowrap;border-radius:999px;text-decoration:none;font-weight:700;font-size:14.5px;color:var(--muted)}
.nav a svg{width:18px;height:18px;flex:0 0 auto}
.nav a:hover{color:var(--ink)}
.nav a.on{background:var(--white);color:var(--ink);box-shadow:var(--shadow-sm)}
.badge{display:inline-flex;align-items:center;justify-content:center;min-width:20px;height:20px;padding:0 6px;border-radius:999px;background:var(--red);color:#fff;font-size:11.5px;font-weight:700;line-height:1}
.me{display:flex;align-items:center;gap:10px;flex:0 0 auto;margin-left:auto}
.me-name{font-size:13.5px;font-weight:600;color:var(--ink);max-width:170px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:right;line-height:1.25}
.me-name small{display:block;font-weight:500;color:var(--muted);font-size:12px}
.icon-btn{width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:var(--white);display:flex;align-items:center;justify-content:center;color:var(--muted)}
.icon-btn:hover{color:var(--red-dark);border-color:var(--red)}
.icon-btn svg{width:18px;height:18px}
@media(max-width:1060px){.brand span,.me-name{display:none}.nav a{padding:9px 13px}}
@media(max-width:760px){
  .me-name{display:block}
  :root{--header-h:56px}
  /* backdrop-filter делает шапку контейнером для position:fixed — иначе нижнее меню «прилипает» к шапке */
  .topbar{backdrop-filter:none;-webkit-backdrop-filter:none;background:var(--bg)}
  .topbar-in{padding:0 16px}
  .brand span{display:none}
  .me-name{max-width:120px}
  .nav{position:fixed;left:0;right:0;bottom:0;z-index:60;margin:0;gap:0;background:rgba(255,255,255,.97);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-top:1px solid var(--line);padding:6px 8px calc(6px + env(safe-area-inset-bottom))}
  .nav a{flex:1;flex-direction:column;gap:2px;padding:6px 4px;font-size:11.5px;border-radius:12px;min-height:52px;justify-content:center}
  .nav a svg{width:22px;height:22px}
  .nav a.on{box-shadow:none;background:var(--red-bg);color:var(--red-dark)}
  .nav a .badge{position:absolute;top:2px;left:calc(50% + 6px);min-width:18px;height:18px;font-size:10.5px}
  body.has-nav .wrap{padding-bottom:calc(110px + env(safe-area-inset-bottom))}
  .wrap{padding:22px 16px 80px}
}

/* ───────── Page titles (как в базе знаний) ───────── */
.crumbs{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:13.5px;margin-bottom:18px}
.crumbs a{color:var(--muted);text-decoration:none;font-weight:600}
.crumbs a:hover{color:var(--red-dark)}
.day-chip{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--red-dark);background:var(--red-bg);border-radius:999px;padding:5px 11px;margin-bottom:12px}
.doc-title{font-family:var(--font-display);font-size:clamp(23px,4vw,32px);font-weight:800;color:var(--dark);margin-bottom:10px;letter-spacing:-.02em;line-height:1.22;overflow-wrap:break-word}
.doc-meta{font-size:15px;color:var(--muted);margin-bottom:26px;max-width:680px}
.section-label{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--red-dark);margin:0 0 14px}
.toc{background:var(--white);border:1px solid var(--line);border-radius:var(--r-lg);padding:18px 20px;margin-bottom:22px}
.toc-label{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:10px}
.toc-links{display:flex;flex-wrap:wrap;gap:8px}
.toc-links a{font-size:13.5px;font-weight:600;color:var(--text);background:var(--bg);border-radius:999px;padding:6px 12px;text-decoration:none;border:1px solid transparent}
.toc-links a:hover{border-color:var(--red);color:var(--red-dark)}
.toc-links a.toc-task{background:var(--red-bg);color:var(--red-dark)}
.reg-card{background:var(--white);border:1px solid var(--line);border-radius:var(--r-xl);padding:30px 32px;box-shadow:var(--shadow-sm);margin-bottom:22px}
@media(max-width:640px){.reg-card{padding:22px 18px;border-radius:var(--r-lg)}}

/* ───────── Lesson content ───────── */
.lesson{counter-reset:ls}
.lesson .ls{border-top:1px solid var(--line);padding:26px 0}
.lesson .ls:first-child{border-top:none;padding-top:0}
.lesson .ls:last-child{padding-bottom:0}
.lesson h2{font-size:19px;font-weight:700;color:var(--dark);letter-spacing:-.01em;line-height:1.35;margin-bottom:12px;display:flex;gap:12px;align-items:baseline}
.lesson h2::before{counter-increment:ls;content:counter(ls,decimal-leading-zero);font-family:var(--font-display);font-size:13px;font-weight:700;color:var(--red);flex:0 0 auto}
.lesson h3{font-size:13px;font-weight:700;color:var(--red-dark);text-transform:uppercase;letter-spacing:.03em;margin:20px 0 10px}
.lesson p{margin-bottom:12px}
.lesson p:last-child{margin-bottom:0}
.lesson ul,.lesson ol{padding-left:22px;margin-bottom:12px}
.lesson li{margin-bottom:6px}
.lesson li:last-child{margin-bottom:0}
.lesson > .ls > *:last-child{margin-bottom:0}
.lead{font-size:17px;color:var(--ink);line-height:1.6}
.hl{background:linear-gradient(transparent 58%,#FFD9CE 58%);padding:0 2px}
.learn{background:var(--dark);color:#fff;border-radius:var(--r-lg);padding:20px 22px;margin:4px 0 0}
.learn-t{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--red-light);margin-bottom:10px}
.learn ul{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:8px 18px}
.learn li{position:relative;padding-left:22px;font-size:14.5px;line-height:1.5;margin:0}
.learn li::before{content:"→";position:absolute;left:0;color:var(--red-light);font-weight:700}

/* callouts */
.callout{border-radius:var(--r-md);padding:14px 16px 14px 50px;position:relative;margin:14px 0;font-size:15px;line-height:1.6}
.callout::before{position:absolute;left:15px;top:13px;font-size:20px;line-height:1}
.callout b.ct{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.05em;margin-bottom:3px}
.callout p{margin-bottom:6px}
.callout.secret{background:#1A1A1A;color:#F3F1EE}
.callout.secret::before{content:"🔑"}
.callout.secret b.ct{color:var(--red-light)}
.callout.norm{background:var(--red-bg);color:var(--dark2)}
.callout.norm::before{content:"📌"}
.callout.norm b.ct{color:var(--red-dark)}
.callout.warn{background:var(--amber-bg);color:#4A3200}
.callout.warn::before{content:"⚠️"}
.callout.warn b.ct{color:var(--amber)}
.callout.tip{background:var(--green-bg);color:#123D24}
.callout.tip::before{content:"💡"}
.callout.tip b.ct{color:var(--green)}
.callout.info{background:var(--blue-bg);color:#14306B}
.callout.info::before{content:"ℹ️"}
.callout.info b.ct{color:var(--blue)}

/* stat tiles */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin:14px 0}
.stat{background:var(--bg);border-radius:var(--r-md);padding:14px 14px 12px;border:1px solid var(--line)}
.stat b{display:block;font-family:var(--font-display);font-size:22px;font-weight:800;color:var(--red-dark);letter-spacing:-.02em;line-height:1.15;margin-bottom:4px}
.stat span{display:block;font-size:13px;color:var(--muted);line-height:1.4}
.stats.ten{grid-template-columns:repeat(5,1fr)}
@media(max-width:640px){.stats.ten{grid-template-columns:repeat(2,1fr)}}
.stat.dark{background:var(--dark);border-color:var(--dark)}
.stat.dark b{color:var(--red-light)}
.stat.dark span{color:#C9C5BF}

/* funnel */
.funnel{margin:16px 0;display:flex;flex-direction:column;gap:6px;align-items:center}
.fn{width:var(--w,100%);min-width:210px;max-width:100%;background:linear-gradient(90deg,var(--red),var(--red-light));color:#fff;border-radius:10px;padding:10px 14px;display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:14px;font-weight:600}
.fn b{font-family:var(--font-display);font-size:14px;white-space:nowrap}
.fn span{line-height:1.3}
.fn:nth-child(2){opacity:.93}.fn:nth-child(3){opacity:.86}.fn:nth-child(4){opacity:.8}.fn:nth-child(5){opacity:.74}.fn:nth-child(6){opacity:.68}
.fn-conv{font-size:12px;font-weight:700;color:var(--muted);display:flex;align-items:center;justify-content:center;text-align:center;gap:6px;line-height:1.35}
.fn-conv::before{content:"↓";color:var(--red)}

/* flow (steps with arrows) */
.flow{display:grid;grid-template-columns:repeat(auto-fit,minmax(128px,1fr));gap:8px;margin:14px 0}
.flow-step{background:var(--white);border:1.5px solid var(--line);border-radius:var(--r-md);padding:12px;position:relative;font-size:13.5px;line-height:1.45}
.flow-step b{display:block;font-size:14px;color:var(--ink);margin-bottom:3px}
.flow-step small{display:block;font-size:12px;color:var(--muted)}
.flow-step .n{display:inline-flex;width:24px;height:24px;border-radius:50%;background:var(--red);color:#fff;font-size:12px;font-weight:700;align-items:center;justify-content:center;margin-bottom:6px}
.flow-step.accent{border-color:var(--red);background:var(--red-bg)}

/* timeline */
.timeline{position:relative;margin:16px 0;padding-left:28px}
.timeline::before{content:"";position:absolute;left:8px;top:6px;bottom:6px;width:2px;background:linear-gradient(var(--red),var(--line))}
.tl{position:relative;padding-bottom:16px}
.tl:last-child{padding-bottom:0}
.tl::before{content:"";position:absolute;left:-26px;top:5px;width:14px;height:14px;border-radius:50%;background:var(--white);border:3px solid var(--red)}
.tl-time{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--red-dark)}
.tl-title{font-weight:700;color:var(--ink);margin:1px 0 3px}
.tl-body{font-size:14.5px;color:var(--text)}
.tl-body ul{margin:4px 0 0}

/* do / don't */
.dd{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0}
.dd-col{border-radius:var(--r-md);padding:14px 16px;font-size:14.5px}
.dd-col h4{font-size:12.5px;text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px}
.dd-col ul{list-style:none;padding:0;margin:0}
.dd-col li{position:relative;padding-left:22px;margin-bottom:6px;line-height:1.5}
.dd-col.do{background:var(--green-bg)}
.dd-col.do h4{color:var(--green)}
.dd-col.do li::before{content:"✓";position:absolute;left:0;color:var(--green);font-weight:800}
.dd-col.dont{background:var(--red-bg)}
.dd-col.dont h4{color:var(--red-dark)}
.dd-col.dont li::before{content:"✕";position:absolute;left:0;color:var(--red-dark);font-weight:800}
@media(max-width:600px){.dd{grid-template-columns:1fr}}

/* scale / range bar */
.scale{margin:18px 0 8px}
.scale-t{font-size:13px;font-weight:700;color:var(--ink);margin-bottom:8px}
.scale-track{position:relative;height:30px;border-radius:999px;background:var(--paper);overflow:hidden}
.scale-zone{position:absolute;top:0;bottom:0;display:flex;align-items:center;justify-content:center;text-align:center;font-size:11.5px;line-height:1.15;font-weight:700;color:#fff;overflow:hidden;padding:0 4px}
@media(max-width:600px){.scale-track{height:42px;border-radius:12px}.scale-zone{font-size:10.5px}}
.z-bad{background:#E6A08F}.z-mid{background:#E9B45A}.z-good{background:var(--green)}.z-top{background:var(--red)}
.scale-ticks{position:relative;height:18px;font-size:11.5px;color:var(--muted);margin-top:4px}
.scale-ticks span{position:absolute;transform:translateX(-50%);white-space:nowrap}
.scale-ticks span:first-child{transform:none}
.scale-ticks span:last-child{transform:translateX(-100%)}

/* bars */
.bars{margin:14px 0;display:flex;flex-direction:column;gap:8px}
.bar{display:grid;grid-template-columns:minmax(90px,170px) 1fr auto;gap:10px;align-items:center;font-size:13.5px}
.bar-l{color:var(--text);font-weight:600;line-height:1.3}
.bar-track{height:14px;background:var(--paper);border-radius:999px;overflow:hidden}
.bar-fill{height:100%;width:var(--v,50%);background:var(--red);border-radius:999px}
.bar-fill.g{background:var(--green)}.bar-fill.a{background:#E9B45A}.bar-fill.m{background:#B9B4AD}
.bar-v{font-weight:700;color:var(--ink);font-size:13px;white-space:nowrap}
@media(max-width:520px){.bar{grid-template-columns:1fr auto}.bar-track{grid-column:1/-1;grid-row:2}}

/* chat */
.chat{background:#EDE9E3;border-radius:var(--r-lg);padding:14px;margin:14px 0;display:flex;flex-direction:column;gap:8px}
.chat-h{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:2px;display:flex;align-items:center;gap:8px}
.chat-h.bad{color:var(--red-dark)}.chat-h.good{color:var(--green)}
.msg{max-width:86%;padding:9px 13px;border-radius:16px;font-size:14.5px;line-height:1.45;position:relative}
.msg small{display:block;font-size:11px;color:var(--muted);margin-top:3px;text-align:right}
.msg.in{background:var(--white);align-self:flex-start;border-bottom-left-radius:5px}
.msg.out{background:#DCF3D8;align-self:flex-end;border-bottom-right-radius:5px}
.msg.out.bad{background:#FBE0DA}
.chat-note{font-size:12.5px;color:var(--muted);text-align:center;font-style:italic}
.chat-pair{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.chat-pair .chat{margin:14px 0 0}
@media(max-width:640px){.chat-pair{grid-template-columns:1fr}.chat-pair .chat{margin:6px 0}}

/* Avito ad mock */
.ad{display:grid;grid-template-columns:190px 1fr;gap:16px;background:var(--white);border:1px solid var(--line);border-radius:var(--r-lg);padding:14px;margin:14px 0;box-shadow:var(--shadow-sm)}
.ad-cover{aspect-ratio:1/1;border-radius:12px;background:linear-gradient(150deg,#2B3A67 0%,#5563A8 55%,#E8391D 140%);color:#fff;padding:12px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;position:relative}
.ad-cover .ph{position:absolute;right:-12px;bottom:-8px;font-size:92px;line-height:1;opacity:.95}
.ad-cover .c1{font-family:var(--font-display);font-weight:800;font-size:15px;line-height:1.15;max-width:75%;position:relative}
.ad-cover .c2{font-size:11.5px;font-weight:600;background:rgba(255,255,255,.18);border-radius:8px;padding:5px 8px;max-width:72%;position:relative;line-height:1.3}
.ad-title{font-weight:700;color:#0A58CA;font-size:16px;line-height:1.3;margin-bottom:4px}
.ad-price{font-weight:800;font-size:18px;color:var(--ink);margin-bottom:6px}
.ad-text{font-size:13.5px;color:var(--text);line-height:1.5}
.ad-meta{font-size:12px;color:var(--muted);margin-top:8px;display:flex;gap:10px;flex-wrap:wrap}
@media(max-width:560px){.ad{grid-template-columns:1fr}.ad-cover{max-width:230px}}

/* pyramid / priority stack */
.stack{margin:14px 0;display:flex;flex-direction:column;gap:6px}
.stack-i{display:flex;gap:12px;align-items:center;border-radius:var(--r-md);padding:11px 14px;background:var(--bg);border:1px solid var(--line);width:var(--w,100%);max-width:100%}
.stack-i .n{flex:0 0 30px;height:30px;border-radius:50%;background:var(--red);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px}
.stack-i:nth-child(2) .n{background:#EE5A3F}.stack-i:nth-child(3) .n{background:#F07E67}.stack-i:nth-child(4) .n{background:#F2A291}.stack-i:nth-child(5) .n{background:#C9C3BC}
.stack-i div{font-size:14.5px;line-height:1.45}
.stack-i b{color:var(--ink)}
@media(max-width:600px){.stack-i{width:100%!important}}

/* decision rules */
.rules{margin:14px 0;border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden}
.rule{display:grid;grid-template-columns:1fr 36px 1fr;align-items:center;border-top:1px solid var(--line);font-size:14.5px}
.rule:first-child{border-top:none}
.rule .if{padding:12px 14px;background:var(--bg);height:100%;display:flex;align-items:center}
.rule .ar{text-align:center;color:var(--red);font-weight:800}
.rule .then{padding:12px 14px;font-weight:600;color:var(--ink)}
@media(max-width:560px){.rule{grid-template-columns:1fr}.rule .ar{display:none}.rule .then{padding-top:6px;padding-left:14px;position:relative}.rule .then::before{content:"→ ";color:var(--red)}}

/* checklist */
.check{list-style:none;padding:0!important;margin:12px 0}
.check li{position:relative;padding:9px 12px 9px 42px;border:1px solid var(--line);border-radius:var(--r-md);margin-bottom:6px!important;background:var(--white);line-height:1.5}
.check li::before{content:"";position:absolute;left:12px;top:11px;width:18px;height:18px;border-radius:5px;border:2px solid var(--red);background:var(--white)}
.check li::after{content:"";position:absolute;left:18px;top:14px;width:5px;height:9px;border:solid var(--red);border-width:0 2.5px 2.5px 0;transform:rotate(45deg)}

/* formula */
.formula{background:var(--dark);color:#fff;border-radius:var(--r-md);padding:14px 18px;margin:14px 0;font-size:15px;line-height:1.6;overflow-x:auto}
.formula b{color:var(--red-light)}
.formula small{display:block;color:#A3A09B;font-size:13px;margin-top:4px}

/* tables */
.tbl-wrap{overflow-x:auto;margin:14px 0;border:1px solid var(--line);border-radius:var(--r-md);-webkit-overflow-scrolling:touch}
.tbl{width:100%;border-collapse:collapse;font-size:14px;min-width:460px}
.tbl th{background:var(--bg);text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.03em;color:var(--muted);padding:10px 12px;font-weight:700}
.tbl td{padding:10px 12px;border-top:1px solid var(--line);vertical-align:top;line-height:1.5}
.tbl td.num{font-variant-numeric:tabular-nums;white-space:nowrap}
.tbl tr.hot td{background:#FFF7F4}

/* cheat sheet */
.cheat{background:linear-gradient(135deg,#1A1A1A,#2A2522);color:#fff;border-radius:var(--r-lg);padding:20px 22px;margin:4px 0 0}
.cheat-t{font-family:var(--font-display);font-size:15px;font-weight:700;margin-bottom:12px;color:#fff}
.cheat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px}
.cheat-i{background:rgba(255,255,255,.07);border-radius:10px;padding:10px 12px;font-size:13.5px;line-height:1.45;color:#DAD6D0}
.cheat-i b{display:block;color:var(--red-light);font-size:16px;margin-bottom:2px}

.tags{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}
.tags span{font-size:13px;font-weight:600;border-radius:999px;padding:5px 11px;background:var(--paper)}
.tags span.r{background:var(--red-bg);color:var(--red-dark)}
.tags span.g{background:var(--green-bg);color:var(--green)}

/* ───────── Tasks ───────── */
.task-zone{margin-top:8px}
.task-card{background:var(--white);border:1.5px solid var(--line);border-radius:var(--r-xl);padding:26px 28px;margin-bottom:18px;box-shadow:var(--shadow-sm)}
.task-card.is-accepted{border-color:#A9D8BB}
.task-card.is-revise{border-color:#E9B45A}
.task-head{display:flex;gap:12px;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;margin-bottom:12px}
.task-kicker{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--red-dark);margin-bottom:3px}
.task-title{font-size:18px;font-weight:700;color:var(--ink);line-height:1.35}
.task-case{background:var(--bg);border-radius:var(--r-md);padding:16px 18px;margin-bottom:18px;font-size:15px}
.task-case > *:last-child{margin-bottom:0}
.task-case p{margin-bottom:10px}
.task-case ul,.task-case ol{padding-left:20px;margin-bottom:10px}
.task-case .tbl-wrap{background:var(--white)}
.q-block{margin-bottom:18px}
.q-text{display:flex;gap:10px;font-weight:600;color:var(--ink);margin-bottom:8px;line-height:1.5}
.q-num{flex:0 0 26px;height:26px;border-radius:50%;background:var(--red-bg);color:var(--red-dark);font-size:13px;font-weight:800;display:flex;align-items:center;justify-content:center;margin-top:1px}
.q-foot{display:flex;justify-content:space-between;gap:10px;font-size:12px;color:var(--muted);margin-top:4px}
.q-foot .ok{color:var(--green);font-weight:600}
.answer-view{background:var(--paper);border-radius:var(--r-md);padding:12px 14px;white-space:pre-wrap;overflow-wrap:anywhere;font-size:15px;line-height:1.55}
.task-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding-top:4px}
.task-note{font-size:13px;color:var(--muted)}
.task-key{background:var(--blue-bg);color:#14306B;border-radius:var(--r-md);padding:12px 14px;font-size:14px;margin:10px 0 16px}
.task-key b{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--blue);margin-bottom:3px}
.chip{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:700;border-radius:999px;padding:5px 11px;white-space:nowrap}
.chip::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor}
.chip-none{background:var(--paper);color:var(--muted)}
.chip-pending{background:var(--blue-bg);color:var(--blue)}
.chip-accepted{background:var(--green-bg);color:var(--green)}
.chip-revise{background:var(--amber-bg);color:var(--amber)}
.chip-locked{background:var(--paper);color:#9A958F}
.chip-blocked{background:var(--red-bg);color:var(--red-dark)}

/* feedback box */
.fb{border-radius:var(--r-lg);padding:18px 20px;margin-bottom:14px;border:1px solid var(--line);background:var(--white)}
.fb-head{display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-bottom:8px}
.fb-title{font-weight:700;color:var(--ink);font-size:15.5px;line-height:1.35}
.fb-title a{color:inherit;text-decoration:none}
.fb-title a:hover{color:var(--red-dark)}
.fb-text{white-space:pre-wrap;overflow-wrap:anywhere;font-size:15px;line-height:1.6}
.fb-meta{font-size:12.5px;color:var(--muted);margin-top:8px}
.fb.accepted{background:linear-gradient(0deg,var(--white),var(--white)) padding-box;border-color:#A9D8BB;border-left:5px solid var(--green)}
.fb.revise{border-color:#EFCB8A;border-left:5px solid #E9B45A}
.fb.pending{border-left:5px solid #9DB4E8}
.fb-empty{font-size:14.5px;color:var(--muted)}
.fb-history{margin-top:10px;font-size:13.5px}
.fb-history summary{cursor:pointer;color:var(--muted);font-weight:600}
.fb-history .fb-old{border-left:3px solid var(--line);padding:6px 0 6px 12px;margin-top:8px;white-space:pre-wrap;color:var(--muted)}

/* ───────── Dashboard / roadmap ───────── */
.hero{background:var(--dark);color:#fff;border-radius:var(--r-xl);padding:28px 30px;margin-bottom:24px;position:relative;overflow:hidden}
.hero::after{content:"";position:absolute;right:-80px;top:-80px;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,rgba(255,99,71,.45),transparent 70%)}
.hero-kicker{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--red-light);margin-bottom:8px;position:relative}
.hero-title{font-family:var(--font-display);font-size:clamp(21px,3.6vw,28px);font-weight:800;letter-spacing:-.02em;line-height:1.2;margin-bottom:8px;position:relative;overflow-wrap:break-word}
.hero-sub{color:#C9C5BF;font-size:15px;max-width:560px;margin-bottom:20px;position:relative}
.hero-row{display:flex;gap:22px;align-items:center;flex-wrap:wrap;position:relative}
.hero-stats{display:flex;gap:22px;flex-wrap:wrap}
.hero-stat b{display:block;font-family:var(--font-display);font-size:22px;font-weight:800;color:#fff}
.hero-stat span{font-size:12.5px;color:#A3A09B}
.progress{height:8px;border-radius:999px;background:rgba(255,255,255,.12);overflow:hidden;margin:0 0 20px;position:relative}
.progress i{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,var(--red),var(--red-light));width:0;transition:width .6s ease}
.progress.light{background:var(--paper);margin:0}
.road{display:flex;flex-direction:column;gap:10px;position:relative}
.road-i{display:grid;grid-template-columns:52px 1fr auto;gap:14px;align-items:center;background:var(--white);border:1.5px solid var(--line);border-radius:var(--r-lg);padding:14px 16px;text-decoration:none;color:inherit;transition:border-color .15s,transform .15s;position:relative}
a.road-i:hover{border-color:var(--red);transform:translateY(-1px)}
.road-n{width:52px;height:52px;border-radius:14px;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1}
.road-n small{font-size:9.5px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}
.road-n b{font-family:var(--font-display);font-size:19px;font-weight:800;color:var(--ink);margin-top:2px}
.road-t{font-weight:700;color:var(--ink);font-size:15.5px;line-height:1.35}
.road-d{font-size:13.5px;color:var(--muted);line-height:1.45;margin-top:2px}
.road-i.current{border-color:var(--red);box-shadow:0 8px 24px rgba(232,57,29,.12)}
.road-i.current .road-n{background:var(--red)}
.road-i.current .road-n small,.road-i.current .road-n b{color:#fff}
.road-i.done .road-n{background:var(--green-bg)}
.road-i.done .road-n b{color:var(--green)}
.road-i.locked{opacity:.62;cursor:not-allowed;background:transparent;border-style:dashed}
.road-i.locked .road-t{color:var(--muted)}
@media(max-width:560px){.road-i{grid-template-columns:44px 1fr;gap:12px;padding:12px 14px}.road-n{width:44px;height:44px}.road-i .chip{grid-column:2;justify-self:start;margin-top:-4px}}

.doc-nav{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:22px;flex-wrap:wrap}
.empty{text-align:center;padding:40px 20px;color:var(--muted);background:var(--white);border:1px dashed var(--line);border-radius:var(--r-lg)}
.empty b{display:block;color:var(--ink);font-size:17px;margin-bottom:6px}
.acc{background:var(--white);border:1.5px solid var(--line);border-radius:var(--r-lg);margin-bottom:12px;overflow:hidden}
.acc > summary{list-style:none;cursor:pointer;padding:16px 18px;display:flex;gap:12px;align-items:center;justify-content:space-between}
.acc > summary::-webkit-details-marker{display:none}
.acc > summary .acc-t{font-weight:700;color:var(--ink);line-height:1.35}
.acc > summary .acc-t small{display:block;font-size:12px;font-weight:700;color:var(--red-dark);text-transform:uppercase;letter-spacing:.05em;margin-bottom:2px}
.acc > summary .acc-r{display:flex;align-items:center;gap:10px;flex:0 0 auto}
.acc > summary .acc-r::after{content:"";width:9px;height:9px;border-right:2px solid var(--muted);border-bottom:2px solid var(--muted);transform:rotate(45deg);margin:-4px 4px 0}
.acc[open] > summary .acc-r::after{transform:rotate(-135deg);margin-top:4px}
.acc-body{padding:0 18px 4px}
.acc-body .task-card{box-shadow:none;border-width:1px;padding:20px}
@media(max-width:560px){.acc > summary{flex-wrap:wrap}.task-card{padding:20px 16px}}

/* toast */
.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);background:var(--dark);color:#fff;border-radius:14px;padding:12px 18px;font-size:14.5px;box-shadow:var(--shadow-md);opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;z-index:100;max-width:calc(100vw - 32px);display:flex;gap:12px;align-items:center}
.toast.show{opacity:1;transform:translate(-50%,0);pointer-events:auto}
.toast a{color:var(--red-light);font-weight:700;white-space:nowrap}
@media(max-width:760px){body.has-nav .toast{bottom:calc(84px + env(safe-area-inset-bottom))}}
.banner{background:var(--amber-bg);color:#4A3200;border-radius:var(--r-md);padding:10px 14px;font-size:14px;margin-bottom:16px}
.loading{display:flex;align-items:center;justify-content:center;min-height:60vh;color:var(--muted);gap:10px}
.spin{width:22px;height:22px;border-radius:50%;border:3px solid var(--line);border-top-color:var(--red);animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* ───────── Admin ───────── */
.adm-tools{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;align-items:center}
.adm-tools .input{flex:1 1 220px;min-height:44px;padding:9px 14px}
.filters{display:flex;gap:6px;flex-wrap:wrap}
.filters button{border:1px solid var(--line);background:var(--white);border-radius:999px;padding:7px 13px;font-size:13.5px;font-weight:600;color:var(--muted);min-height:38px}
.filters button.on{background:var(--ink);border-color:var(--ink);color:#fff}
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:20px}
@media(max-width:640px){.kpis{grid-template-columns:repeat(2,1fr)}}
.kpi{background:var(--white);border:1px solid var(--line);border-radius:var(--r-lg);padding:14px 16px}
.kpi b{display:block;font-family:var(--font-display);font-size:24px;font-weight:800;color:var(--ink)}
.kpi span{font-size:12.5px;color:var(--muted)}
.ulist{display:flex;flex-direction:column;gap:8px}
.urow{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1.3fr) auto;gap:14px;align-items:center;background:var(--white);border:1.5px solid var(--line);border-radius:var(--r-lg);padding:14px 16px;text-decoration:none;color:inherit;transition:border-color .15s}
.urow:hover{border-color:var(--red)}
.urow.is-blocked{opacity:.65}
.u-name{font-weight:700;color:var(--ink);line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.u-tg{font-size:13px;color:var(--muted)}
.u-prog{font-size:12.5px;color:var(--muted)}
.u-prog .progress{margin:6px 0 0;height:6px}
.u-right{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
@media(max-width:640px){.urow{grid-template-columns:1fr;gap:8px}.u-right{justify-content:flex-start}}
.qrow{display:flex;gap:14px;align-items:center;justify-content:space-between;background:var(--white);border:1.5px solid var(--line);border-radius:var(--r-lg);padding:14px 16px;text-decoration:none;color:inherit}
.qrow:hover{border-color:var(--red)}
.qrow b{color:var(--ink)}
.qrow small{display:block;color:var(--muted);font-size:13px;margin-top:2px}
.mod-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:8px;margin-bottom:22px}
.mod-cell{display:flex;gap:10px;align-items:center;justify-content:space-between;background:var(--white);border:1.5px solid var(--line);border-radius:var(--r-md);padding:10px 12px;text-decoration:none;color:inherit;font-size:14px}
a.mod-cell:hover{border-color:var(--red)}
.mod-cell span{font-weight:600;color:var(--ink);line-height:1.3}
.mod-cell span small{display:block;font-size:11.5px;color:var(--muted);font-weight:600}
.profile-card{background:var(--white);border:1px solid var(--line);border-radius:var(--r-xl);padding:22px 24px;margin-bottom:20px;display:flex;gap:16px;justify-content:space-between;flex-wrap:wrap;align-items:center}
.profile-card .pc-name{font-family:var(--font-display);font-size:21px;font-weight:800;color:var(--ink);letter-spacing:-.02em;overflow-wrap:anywhere}
.profile-card .pc-meta{font-size:13.5px;color:var(--muted);margin-top:4px}
.profile-card .pc-actions{display:flex;gap:8px;flex-wrap:wrap}
.review-box{background:var(--white);border:2px solid var(--ink);border-radius:var(--r-xl);padding:22px 24px;margin-top:6px}
@media(max-width:560px){.review-box,.profile-card{padding:18px 16px}}

@media print{.topbar,.nav,.toast{display:none}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
