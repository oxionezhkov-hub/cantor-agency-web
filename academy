function modById(id){ return MODULES[id - 1]; }

var partsCache = {};
function moduleParts(id){
  if (partsCache[id]) return partsCache[id];
  var tpl = document.getElementById('mod-' + id);
  var frag = tpl.content.cloneNode(true);
  var tasks = $all('.task-def', frag).map(function(el, ti){
    var taskId = el.getAttribute('data-id') || ('t' + (ti + 1));
    var caseEl = $('.task-case', el);
    var keyEl = $('.task-key', el);
    return {
      id: taskId,
      title: el.getAttribute('data-title') || ('Задание ' + (ti + 1)),
      caseHtml: caseEl ? caseEl.innerHTML : '',
      keyHtml: keyEl ? keyEl.innerHTML : '',
      questions: $all('.q', el).map(function(q, qi){ return {key: taskId + '.q' + (qi + 1), html: q.innerHTML}; })
    };
  });
  $all('.task-def', frag).forEach(function(el){ el.remove(); });
  var holder = document.createElement('div');
  holder.appendChild(frag);
  partsCache[id] = {lessonHtml: holder.innerHTML, tasks: tasks};
  return partsCache[id];
}
function questionKeys(id){
  var keys = [];
  moduleParts(id).tasks.forEach(function(t){ t.questions.forEach(function(q){ keys.push(q.key); }); });
  return keys;
}

// ── State ──
var state = {session: lsGet(SESSION_KEY), user: null, offline: false, admin: {users: null, full: {}}};

function subsOf(user){ return (user && user.submissions) || {}; }
function isUnlocked(user, id){ return id === 1 || !!subsOf(user)[id - 1]; }
function moduleStatus(user, id){
  var s = subsOf(user)[id];
  if (s) return s.status;
  return isUnlocked(user, id) ? 'none' : 'locked';
}
function currentModule(user){
  for (var i = 1; i <= TOTAL; i++) if (!subsOf(user)[i]) return i;
  return 0;
}
var STATUS_LABEL = {none: 'Не сдано', locked: 'Закрыт', pending: 'На проверке', accepted: 'Принято', revise: 'На доработку'};
function chip(status, label){ return '<span class="chip chip-' + status + '">' + esc(label || STATUS_LABEL[status]) + '</span>'; }

function seenKey(){ return 'cantor-academy:seen:' + (state.user ? state.user.tg : ''); }
function unseenFeedback(user){
  var seen = lsGet(seenKey()) || {};
  var subs = subsOf(user), n = 0;
  Object.keys(subs).forEach(function(id){ var s = subs[id]; if (s.reviewedAt && s.status !== 'pending' && seen[id] !== s.reviewedAt) n++; });
  return n;
}
function markFeedbackSeen(user){
  var seen = {}, subs = subsOf(user);
  Object.keys(subs).forEach(function(id){ if (subs[id].reviewedAt) seen[id] = subs[id].reviewedAt; });
  lsSet(seenKey(), seen);
}
function todoCount(user){
  var n = 0;
  for (var i = 1; i <= TOTAL; i++){ var st = moduleStatus(user, i); if (st === 'none' || st === 'revise') n++; }
  return n;
}

