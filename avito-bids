  const rows = d.by === 'hour' ? d.data.hours : d.data.days;
  const tot = rows.reduce((a, r) => ({ i: a.i + r.i, v: a.v + r.v, c: a.c + r.c, s: a.s + r.s }), { i: 0, v: 0, c: 0, s: 0 });
