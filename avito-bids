async function update(keys, set, note, extra = {}) {
  const r = await post('/api/dashboard/mbids/items/update', { refs: keys, set, note, ...extra });
  if (!r.ok) { toast(r.data.error || 'Не сохранилось'); return null; }
  keys.forEach((k) => {
    const x = B.items.find((i) => i.key === k);
    if (!x) return;
    if (set.on !== undefined) { x.on = !!set.on; x.status = x.on ? 'pending' : 'off'; x.reason = ''; }
    if (set.bid !== undefined && (set.bid === null || typeof set.bid !== 'object')) x.bid = set.bid;
    if (set.hours !== undefined) x.hours = set.hours && set.hours.length < 24 ? set.hours : null;
    if (set.days !== undefined) x.days = set.days && set.days.length < 7 ? set.days : null;
  });
  render();
  setTimeout(bidsLoad, 7000); setTimeout(bidsLoad, 25000); // движок применяет правки в фоне
  return r.data;
}

