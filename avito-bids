  }
  const notes = d.data.notes || [];
  if (notes.length) html += `<div class="notes"><b class="small">Заметки</b>${notes.slice().reverse().map((n) => `<div class="n"><time>${fmtAt(n.at)}</time><span>${esc(n.text)}</span><button class="icon-btn sm" type="button" data-delnote="${esc(x.key)}|${n.at}" aria-label="Удалить заметку" data-tip="Удалить заметку">${I('x', 'ic-sm')}</button></div>`).join('')}</div>`;
  return html;
}
function chartHtml(key, rows, d) {
  const W = 1000, H = 210, P = 26;
  const pts = rows.map((r) => ({ ...r, cpa: div(r.s, r.c) }));
  const xs = (k) => P + (pts.length === 1 ? (W - 2 * P) / 2 : (k * (W - 2 * P)) / (pts.length - 1));
  const lines = MET.filter((m) => d.metrics.includes(m.id)).map((m) => {
    const vals = pts.map((r) => r[m.id]);
    const mx = Math.max(...vals.filter((v) => v != null), 0) || 1;
    const y = (v) => (H - P - (v / mx) * (H - 2 * P)).toFixed(1);
    let path = '';
    vals.forEach((v, k) => { if (v != null) path += `${path ? 'L' : 'M'}${xs(k).toFixed(1)},${y(v)}`; });
    return `<path d="${path}" fill="none" stroke="${m.c}" stroke-width="2" vector-effect="non-scaling-stroke"/>${vals.map((v, k) => v == null ? '' : `<circle cx="${xs(k).toFixed(1)}" cy="${y(v)}" r="3" fill="${m.c}"><title>${esc(pts[k].at || pts[k].date)} · ${m.t}: ${v}</title></circle>`).join('')}`;
  }).join('');
  const step = Math.max(1, Math.ceil(pts.length / 8));
  const xl = pts.map((r, k) => k % step ? '' : `<text x="${xs(k)}" y="${H - 6}" font-size="11" text-anchor="middle" fill="currentColor" opacity=".6">${esc((r.at || r.date || '').slice(5))}</text>`).join('');
  const notes = (det[key].data.notes || []).map((n) => {
    const day = new Date(n.at + 3 * 3600e3).toISOString().slice(0, 10);
    const k = pts.findIndex((r) => (r.date || r.at || '').startsWith(day));
    return k < 0 ? '' : `<line x1="${xs(k)}" x2="${xs(k)}" y1="6" y2="${H - P}" stroke="currentColor" stroke-dasharray="3 3" opacity=".35"><title>${esc(n.text)}</title></line>`;
  }).join('');
  return `<div class="chart"><div class="legend">${MET.map((m) => `<button type="button" class="${d.metrics.includes(m.id) ? '' : 'off'}" data-met="${esc(key)}|${m.id}"><i style="background:${m.c}"></i>${m.t}</button>`).join('')}</div><svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" style="color:var(--muted)" role="img" aria-label="График объявления">${notes}${lines}${xl}</svg><div class="small faint">Каждая линия в своём масштабе. Наведите на точку — значение; пунктир — заметка.</div></div>`;
}
