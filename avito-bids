<!-- инструкция -->
<div class="modal" id="mHelp" role="dialog" aria-modal="true" aria-labelledby="hTitle" hidden>
  <div class="m-h"><h2 id="hTitle">Как работает раздел</h2><button class="btn" type="button" data-close>Закрыть</button></div>
  <div class="m-b help">
    <h3>Запуск за 3 шага</h3>
    <ol>
      <li>«Добавить объявления» — выберите кабинет и отметьте объявления (или вставьте номера списком).</li>
      <li>Укажите «Ставку» — целые рубли за просмотр. Ориентир — «Мин. ставка для продвижения».</li>
      <li>Включите тумблер «Вкл / выкл». Добавление само продвижение не включает.</li>
    </ol>
    <h3>Что делает сервис</h3>
    <p>Каждые 10 минут сверяет ставку на Авито с настройкой и ставит нужную. Вне графика, при сработавшем ограничении или когда в кабинете закончились деньги объявление уходит на <b>базовую ставку</b> (без продвижения), а когда причина уходит — сервис сам возвращает вашу ставку. Повторно одну и ту же ставку сервис отправляет не чаще раза в час.</p>
    <h3>Ставки</h3>
    <p><b>Базовая</b> — состояние без продвижения. <b>Мин. ставка для продвижения</b> — с неё продвижение уже работает. Диапазон задаёт Авито для каждого объявления; ставка вне его не ставится, в статусе будет ошибка. <b>Опережение конкурентов</b> — процент, который Авито отдаёт для текущей ставки.</p>
    <h3>График и ограничения</h3>
    <p>Время — московское. Каждый выбранный час — полный час (09:00 = 09:00–09:59). Ограничения (показы, просмотры, контакты, расходы, CPV, CPA) считаются за текущие сутки МСК и обнуляются в полночь. Достаточно сработать одному.</p>
    <h3>Статусы</h3>
    <p><b>Успешно</b> — всё в порядке. <b>Остановлено</b> — плановая остановка (по времени, бюджету, метрике, аванс). <b>Ошибка</b> — нужно что-то поправить. Наведите на статус — увидите причину.</p>
    <h3>Много объявлений сразу</h3>
    <p>Отметьте строки (или «Выбрать все» по текущему фильтру — например, по городу или кабинету) → «Массовое редактирование». Меняется только то, у чего включён левый тумблер; числа можно заменить, прибавить или вычесть.</p>
    <p class="note">Удаление из раздела не удаляет объявление на Авито и не меняет его ставку.</p>
  </div>
</div>

<script>
(function () {
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

// cantor.agency — статичный nginx, API в воркере; из РФ ходим через Яндекс-функцию с запасным прямым адресом.
const API_BASE = 'https://mainweb.oxion-ezhkov.workers.dev';
const API_PROXY_URL = 'https://functions.yandexcloud.net/d4eiu56ijlg0jn5o9rch';
const ROUTES = location.hostname.endsWith('workers.dev')
  ? [(p) => location.origin + p, (p) => `${API_PROXY_URL}?p=${encodeURIComponent(p)}`]
  : [(p) => `${API_PROXY_URL}?p=${encodeURIComponent(p)}`, (p) => API_BASE + p];
let route = 0;
const PW_KEY = 'agency_dashboard_pw';
const getPw = () => { try { return localStorage.getItem(PW_KEY) || ''; } catch (e) { return ''; } };
const lsGet = (k, d) => { try { const v = localStorage.getItem(k); return v ? JSON.parse(v) : d; } catch (e) { return d; } };
const lsSet = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} };

async function api(path, opts = {}, pw) {
  for (let i = 0; i < ROUTES.length; i++) {
    const idx = (route + i) % ROUTES.length;
    try {
      const res = await fetch(ROUTES[idx](path), { ...opts, headers: { 'Content-Type': 'application/json', 'x-dashboard-password': pw || getPw() }, signal: AbortSignal.timeout(90000) });
      route = idx;
      const data = await res.json().catch(() => ({}));
      return { status: res.status, ok: res.ok, data };
    } catch (e) { /* следующий маршрут */ }
  }
  return { status: 0, ok: false, data: { error: 'Нет связи с сервером, попробуйте ещё раз' } };
}
const post = (path, body) => api(path, { method: 'POST', body: JSON.stringify(body) });

let tt;
function toast(msg) { const t = $('#toast'); t.textContent = msg; t.hidden = false; clearTimeout(tt); tt = setTimeout(() => { t.hidden = true; }, 5000); }

const rub = (v, d = 0) => v == null ? '—' : `${Number(v).toLocaleString('ru-RU', { minimumFractionDigits: d, maximumFractionDigits: d })} ₽`;
const int = (v) => v == null ? '—' : Number(v).toLocaleString('ru-RU');
const pct = (v) => v == null ? '—' : `${Number(v).toLocaleString('ru-RU', { maximumFractionDigits: 1 })} %`;
const DAYS = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'];
const hh = (h) => `${String(h).padStart(2, '0')}:00`;
const mskToday = () => new Date(Date.now() + 3 * 3600e3).toISOString().slice(0, 10);
const dAdd = (d, n) => { const x = new Date(d + 'T00:00:00Z'); x.setUTCDate(x.getUTCDate() + n); return x.toISOString().slice(0, 10); };
const fmtAt = (ms) => ms ? new Date(ms).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Moscow' }) : '—';

function ranges(list, fmt) {
  const out = [];
  let s = null, p = null;
  list.forEach((x) => { if (s == null) { s = p = x; } else if (x === p + 1) { p = x; } else { out.push([s, p]); s = p = x; } });
  if (s != null) out.push([s, p]);
  return out.map(([a, b]) => a === b ? fmt(a) : `${fmt(a)}–${fmt(b)}`).join(', ');
}
const hoursText = (h) => !h ? 'Весь день' : ranges(h, hh);
const daysText = (d) => !d ? 'Вся неделя' : ranges(d, (x) => DAYS[x]);

/* ── состояние ── */
let S = { accounts: [], groups: {}, items: [], money: {} };
let stats = {};           // key -> { i, v, c, s }
let statsAt = null;
const sel = new Set();
const open = new Set();
let tab = 'all';
let curGroup = null;
let sort = lsGet('mb_sort', null);
let filt = lsGet('mb_filt', { acc: [], city: [], status: [], on: '', group: '' });
let q = '';

const COLS = [
  { id: 'on', t: 'Вкл / выкл', sort: (x) => x.on ? 1 : 0, fixed: true },
  { id: 'status', t: 'Статус', sort: (x) => ({ ok: 0, pending: 1, stop: 2, err: 3, off: 4 }[x.status] ?? 5) },
  { id: 'bid', t: 'Ставка', sort: (x) => x.bid, r: true },
  { id: 'now', t: 'Ставка сейчас', sort: (x) => x.now, r: true },
  { id: 'cmp', t: 'Опережение конкурентов', sort: (x) => x.cmp, r: true },
  { id: 'base', t: 'Базовая ставка', sort: (x) => x.base, r: true },
  { id: 'minPromo', t: 'Мин. ставка для продвижения', sort: (x) => x.minPromo, r: true },
  { id: 'sched', t: 'График продвижения' },
  { id: 'lim', t: 'Отключение по метрике' },
  { id: 'title', t: 'Объявление', sort: (x) => x.title.toLowerCase() },
  { id: 'acc', t: 'Аккаунт', sort: (x) => x.accountName.toLowerCase() },
  { id: 'city', t: 'Город', sort: (x) => x.city.toLowerCase() },
  { id: 'i', t: 'Показы', sort: (x) => st(x).i, r: true },
  { id: 'cv1', t: 'CV в просмотр', sort: (x) => cv(st(x).v, st(x).i), r: true },
  { id: 'v', t: 'Просмотры', sort: (x) => st(x).v, r: true },
  { id: 'cv2', t: 'CV в контакт', sort: (x) => cv(st(x).c, st(x).v), r: true },
  { id: 'c', t: 'Контакты', sort: (x) => st(x).c, r: true },
  { id: 's', t: 'Расходы', sort: (x) => st(x).s, r: true },
  { id: 'cpv', t: 'CPV / 1 просмотр', sort: (x) => div(st(x).s, st(x).v), r: true },
  { id: 'cpa', t: 'CPA / 1 контакт', sort: (x) => div(st(x).s, st(x).c), r: true },
  { id: 'grp', t: 'Группы' },
];
const DEFAULT_COLS = COLS.map((c) => ({ id: c.id, on: c.id !== 'grp' && c.id !== 'cv1' && c.id !== 'cv2' }));
let cols = lsGet('mb_cols', DEFAULT_COLS);
COLS.forEach((c) => { if (!cols.find((x) => x.id === c.id)) cols.push({ id: c.id, on: false }); });
cols = cols.filter((x) => COLS.find((c) => c.id === x.id));
const colById = (id) => COLS.find((c) => c.id === id);

const st = (x) => stats[x.key] || {};
const cv = (a, b) => (a == null || !b ? null : (a / b) * 100);
const div = (a, b) => (a == null || !b ? null : a / b);

/* ── загрузка ── */
async function load() {
  const r = await api('/api/dashboard/mbids/state');
  if (r.status === 401) return showGate();
  if (!r.ok) { $('#rows').innerHTML = `<tr><td class="empty">${esc(r.data.error || 'Не удалось загрузить')}</td></tr>`; return; }
  S = r.data;
  const keys = new Set(S.items.map((x) => x.key));
  [...sel].forEach((k) => { if (!keys.has(k)) sel.delete(k); });
  render();
}

function period() {
  const p = $('#period').value, t = mskToday();
  if (p === 'today') return [t, t];
  if (p === 'yesterday') return [dAdd(t, -1), dAdd(t, -1)];
  if (p === 'custom') {
    const a = $('#pFrom').value || t, b = $('#pTo').value || t;
    return a <= b ? [a, b] : [b, a];
  }
  return [dAdd(t, -(Number(p) - 1)), t];
}

let statsSeq = 0;
async function loadStats() {
  const seq = ++statsSeq;
  const [from, to] = period();
  const accs = [...new Set(S.items.map((x) => x.accountId))];
  $('#statInfo').textContent = accs.length ? 'загружаем статистику…' : '';
  const next = {};
  const errs = [];
  for (const acc of accs) {
    const r = await api(`/api/dashboard/mbids/stats?accountId=${encodeURIComponent(acc)}&from=${from}&to=${to}`);
    if (seq !== statsSeq) return;
    if (r.ok) Object.entries(r.data.stats || {}).forEach(([id, v]) => { next[`${acc}:${id}`] = v; });
    else errs.push(r.data.error || 'ошибка');
    stats = { ...next };
    render();
  }
  // Нет строки в ответе Авито — значит, за период по объявлению ничего не было: нули, а не прочерк.
  S.items.forEach((x) => { if (!next[x.key] && !errs.length) next[x.key] = { i: 0, v: 0, c: 0, s: 0 }; });
  stats = next;
  statsAt = Date.now();
  $('#statInfo').textContent = errs.length ? `Не все кабинеты ответили: ${errs[0]}` : `обновлено ${fmtAt(statsAt)}`;
  render();
}

/* ── отбор ── */
function visible() {
  let list = S.items;
  if (curGroup) list = list.filter((x) => x.groups.includes(curGroup));
  if (filt.acc.length) list = list.filter((x) => filt.acc.includes(x.accountId));
  if (filt.city.length) list = list.filter((x) => filt.city.includes(x.city));
  if (filt.status.length) list = list.filter((x) => filt.status.includes(x.status === 'pending' ? 'ok' : x.status));
  if (filt.on) list = list.filter((x) => (filt.on === 'on') === x.on);
  if (filt.group) list = list.filter((x) => x.groups.includes(filt.group));
  const s = q.trim().toLowerCase();
  if (s) list = list.filter((x) => x.title.toLowerCase().includes(s) || x.id.includes(s) || x.city.toLowerCase().includes(s) || x.address.toLowerCase().includes(s));
  if (sort) {
    const c = colById(sort.id);
    if (c && c.sort) {
      const dir = sort.dir === 'desc' ? -1 : 1;
      list = list.slice().sort((a, b) => {
        const va = c.sort(a), vb = c.sort(b);
        const na = va == null || Number.isNaN(va), nb = vb == null || Number.isNaN(vb);
        if (na && nb) return 0;
        if (na) return 1;
        if (nb) return -1;
        return (va < vb ? -1 : va > vb ? 1 : 0) * dir;
      });
    }
  }
  return list;
}

/* ── отрисовка ── */
function render() {
  renderSum();
  $('#tableCard').hidden = tab === 'groups' && !curGroup;
  $('#kpis').hidden = tab === 'groups' && !curGroup;
  $('#groupsCard').hidden = !(tab === 'groups' && !curGroup);
  const gh = $('#groupHead');
  gh.hidden = !curGroup;
  if (curGroup && S.groups[curGroup]) gh.innerHTML = `<button class="btn sm" type="button" id="gBack">← Все группы</button> <b style="margin-left:6px">${esc(S.groups[curGroup].name)}</b> <button class="btn sm" type="button" id="gAddTo" style="margin-left:8px">Добавить объявления в группу</button>`;
  if (tab === 'groups' && !curGroup) { renderGroups(); renderSelbar([]); return; }
  const list = visible();
  renderKpis(list);
  renderChips();
  renderTable(list);
  renderSelbar(list);
}

function renderSum() {
  const items = S.items;
  const on = items.filter((x) => x.on).length;
  const err = items.filter((x) => x.status === 'err').length;
  const stop = items.filter((x) => x.status === 'stop').length;
  const accs = [...new Set(items.map((x) => x.accountId))];
  const runs = accs.map((a) => (S.money[a] || {}).runAt).filter(Boolean);
  const low = accs.filter((a) => { const m = S.money[a]; return m && m.at && (m.advance ?? 0) + (m.wallet ?? 0) <= 0; });
  $('#sum').innerHTML = `<span>Объявлений в работе: <b>${items.length}</b></span><span>Включено: <b>${on}</b></span><span>Остановлено: <b>${stop}</b></span><span>С ошибкой: <b style="color:${err ? 'var(--red)' : 'inherit'}">${err}</b></span><span>Кабинетов: <b>${accs.length}</b></span><span>Последняя проверка: <b>${runs.length ? fmtAt(Math.max(...runs)) : '—'}</b></span>${low.length ? `<span style="color:var(--red)">Нет денег на продвижение: ${low.map((a) => esc(accName(a))).join(', ')}</span>` : ''}`;
}
const accName = (id) => (S.accounts.find((a) => a.id === id) || {}).name || id;

function renderKpis(list) {
  let i = 0, v = 0, c = 0, s = 0, has = false, bidSum = 0, bidN = 0, cmpSum = 0, cmpN = 0;
  list.forEach((x) => {
    const t = stats[x.key];
    if (t) { has = true; i += t.i; v += t.v; c += t.c; s += t.s; }
    if (x.on && x.now != null) { bidSum += x.now; bidN++; }
    if (x.on && x.cmp != null) { cmpSum += x.cmp; cmpN++; }
  });
  const kv = (l, val, cls = '') => `<div class="kv ${cls}"><div class="l">${l}</div><div class="v">${val}</div></div>`;
  const n = (val, f) => has ? f(val) : '—';
  $('#kpis').innerHTML = `
    <div class="card kpi"><h3>Воронка</h3><div class="kpi-row">${kv('Показы', n(i, int))}${kv('CV в просмотр', has ? pct(cv(v, i)) : '—', 'cv')}${kv('Просмотры', n(v, int))}${kv('CV в контакт', has ? pct(cv(c, v)) : '—', 'cv')}${kv('Контакты', n(c, int))}</div></div>
    <div class="card kpi"><h3>Экономика</h3><div class="kpi-row">${kv('Расходы', n(s, (x) => rub(x, 1)))}${kv('CPV / 1 просмотр', has ? rub(div(s, v), 1) : '—')}${kv('CPA / 1 контакт', has ? rub(div(s, c), 1) : '—')}${kv('Средняя ставка', bidN ? rub(bidSum / bidN, 1) : '—')}${kv('Среднее опережение', cmpN ? pct(cmpSum / cmpN) : '—')}</div></div>`;
}

function renderChips() {
  const ch = [];
  filt.acc.forEach((a) => ch.push([`Аккаунт: ${accName(a)}`, () => { filt.acc = filt.acc.filter((x) => x !== a); }]));
  filt.city.forEach((c) => ch.push([`Город: ${c || 'не указан'}`, () => { filt.city = filt.city.filter((x) => x !== c); }]));
  filt.status.forEach((s) => ch.push([`Статус: ${STATUS[s]}`, () => { filt.status = filt.status.filter((x) => x !== s); }]));
  if (filt.on) ch.push([filt.on === 'on' ? 'Только включённые' : 'Только выключенные', () => { filt.on = ''; }]);
  if (filt.group && S.groups[filt.group]) ch.push([`Группа: ${S.groups[filt.group].name}`, () => { filt.group = ''; }]);
  chipFns = ch.map((x) => x[1]);
  $('#chips').innerHTML = ch.map((x, k) => `<span class="chip">${esc(x[0])}<button type="button" data-chip="${k}" aria-label="Убрать фильтр">×</button></span>`).join('');
}
let chipFns = [];
const STATUS = { ok: 'Успешно', stop: 'Остановлено', err: 'Ошибка', off: 'Выключено' };

function statusPill(x) {
  const map = { ok: ['p-ok', 'Успешно'], pending: ['p-ok', 'Успешно'], stop: ['p-stop', 'Остановлено'], err: ['p-err', 'Ошибка'], off: ['p-off', 'Остановлено'] };
  const [cls, t] = map[x.status] || map.off;
  let reason = x.reason || (x.status === 'pending' ? 'Ждёт первой проверки — до 10 минут' : '');
  if (x.status === 'ok' && x.setAt && x.now !== x.bid) reason = 'Ставка отправлена в Авито, применение может занять время';
  const checked = x.checkedAt ? `Проверено ${fmtAt(x.checkedAt)}` : '';
  return `<span class="pill ${cls}" data-tip="${esc([reason, checked].filter(Boolean).join(' · '))}" tabindex="0">${t}</span>`;
}

function limText(x) {
  const L = x.lim || {};
  const parts = [];
  if (L.imp != null) parts.push(`показы ${int(L.imp)}`);
  if (L.views != null) parts.push(`просмотры ${int(L.views)}`);
  if (L.contacts != null) parts.push(`контакты ${int(L.contacts)}`);
  if (L.spend != null) parts.push(`расходы ${rub(L.spend)}`);
  if (L.cpv != null) parts.push(`CPV ${rub(L.cpv)}`);
  if (L.cpa != null) parts.push(`CPA ${rub(L.cpa)}`);
  return parts;
}

function cell(id, x) {
  const t = st(x);
  const has = !!stats[x.key];
  switch (id) {
    case 'on': return `<td><label class="tg" title="Вкл / выкл"><input type="checkbox" data-on="${esc(x.key)}" ${x.on ? 'checked' : ''} aria-label="Включить ручное управление"><span></span></label></td>`;
    case 'status': return `<td>${statusPill(x)}</td>`;
    case 'bid': {
      const bad = x.bid != null && ((x.minPromo != null && x.bid < x.minPromo) || (x.max != null && x.bid > x.max));
      return `<td class="r"><input class="cell-in${bad ? ' bad' : ''}" inputmode="numeric" data-bid="${esc(x.key)}" value="${x.bid ?? ''}" placeholder="—" aria-label="Ставка, ₽" title="${x.minPromo != null ? `Допустимо: ${Math.ceil(x.minPromo)}–${Math.floor(x.max)} ₽` : 'Ставка, ₽ за просмотр'}"></td>`;
    }
    case 'now': return `<td class="r num">${x.now != null ? rub(x.now) : x.selectedType === 'auto' ? '<span class="sub" title="На Авито включена автостратегия">авто</span>' : '<span class="dash">—</span>'}</td>`;
    case 'cmp': return `<td class="r num">${pct(x.cmp)}</td>`;
    case 'base': return `<td class="r num">${rub(x.base)}</td>`;
    case 'minPromo': return `<td class="r num">${rub(x.minPromo)}</td>`;
    case 'sched': return `<td><div class="sched"><button class="lnkb" type="button" data-hours="${esc(x.key)}">Часы: ${esc(hoursText(x.hours))}</button><button class="lnkb" type="button" data-days="${esc(x.key)}">Дни: ${esc(daysText(x.days))}</button></div></td>`;
    case 'lim': { const p = limText(x); return `<td><button class="lnkb" type="button" data-lim="${esc(x.key)}">${p.length ? esc(p.join(', ')) : 'Настроить'}</button></td>`; }
    case 'title': return `<td class="td-ttl"><a class="ttl" href="${esc(x.url)}" target="_blank" rel="noopener">${esc(x.title || 'Без названия')}</a><div class="sub">№ ${esc(x.id)} · ${esc(x.address)}</div></td>`;
    case 'acc': return `<td class="sub">${esc(x.accountName)}</td>`;
    case 'city': return `<td class="sub">${esc(x.city)}</td>`;
    case 'i': return `<td class="r num">${has ? int(t.i) : '—'}</td>`;
    case 'cv1': return `<td class="r num">${has ? pct(cv(t.v, t.i)) : '—'}</td>`;
    case 'v': return `<td class="r num">${has ? int(t.v) : '—'}</td>`;
    case 'cv2': return `<td class="r num">${has ? pct(cv(t.c, t.v)) : '—'}</td>`;
    case 'c': return `<td class="r num">${has ? int(t.c) : '—'}</td>`;
    case 's': return `<td class="r num">${has ? rub(t.s, 1) : '—'}</td>`;
    case 'cpv': return `<td class="r num">${has ? rub(div(t.s, t.v), 1) : '—'}</td>`;
    case 'cpa': return `<td class="r num">${has ? rub(div(t.s, t.c), 1) : '—'}</td>`;
    case 'grp': return `<td class="sub">${x.groups.map((g) => S.groups[g] ? esc(S.groups[g].name) : '').filter(Boolean).join(', ') || '—'}</td>`;
  }
  return '<td></td>';
}

