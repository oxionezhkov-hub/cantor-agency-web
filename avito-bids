const gSel = new Set();

/* ── подробная статистика объявления ── */
const det = {}; // key -> { per, by, data, loading, metrics }
const MET = [
  { id: 'i', t: 'Показы', c: 'var(--blue)' }, { id: 'v', t: 'Просмотры', c: 'var(--green)' }, { id: 'c', t: 'Контакты', c: 'var(--accent)' },
  { id: 's', t: 'Расходы', c: 'var(--amber)' }, { id: 'cpa', t: 'CPA', c: 'var(--red)' }, { id: 'b', t: 'Средняя ставка', c: 'var(--violet)' },
  { id: 'cmp', t: 'Среднее опережение', c: 'var(--muted)' }, { id: 'set', t: 'Установленная ставка', c: 'var(--ink)' },
];

function detailHtml(x) {
  const d = det[x.key] || (det[x.key] = { per: '7', by: 'day', data: null, loading: false, metrics: ['i', 'v', 'c', 'b'] });
  if (!d.data && !d.loading) setTimeout(() => loadDetail(x.key), 0);
  const top = `<div class="det-top"><b style="font-size:13px">Статистика объявления за:</b>
    <select data-dper="${esc(x.key)}">${[['1', 'Сегодня'], ['7', '7 дней'], ['14', '14 дней'], ['30', '30 дней']].map(([v, t]) => `<option value="${v}" ${d.per === v ? 'selected' : ''}>${t}</option>`).join('')}</select>
    <div class="seg"><button type="button" data-dby="${esc(x.key)}:day" class="${d.by === 'day' ? 'on' : ''}">По дням</button><button type="button" data-dby="${esc(x.key)}:hour" class="${d.by === 'hour' ? 'on' : ''}">По часам</button></div>
    <span class="sp"></span><button class="btn sm" type="button" data-note="${esc(x.key)}">Добавить заметку</button></div>`;
  if (d.loading && !d.data) return top + '<div class="note">Загрузка…</div>';
  if (!d.data) return top + '<div class="note">Не удалось загрузить статистику</div>';
  const rows = d.by === 'hour' ? d.data.hours : d.data.days;
  const tot = rows.reduce((a, r) => ({ i: a.i + r.i, v: a.v + r.v, c: a.c + r.c, s: a.s + r.s }), { i: 0, v: 0, c: 0, s: 0 });
  const bs = rows.filter((r) => r.b != null), cs = rows.filter((r) => r.cmp != null);
  const avgB = bs.length ? bs.reduce((a, r) => a + r.b, 0) / bs.length : null;
  const avgC = cs.length ? cs.reduce((a, r) => a + r.cmp, 0) / cs.length : null;
  const ln = (l, v) => `<div class="ln"><span>${l}</span><b>${v}</b></div>`;
  const empty = !rows.length;
  let html = top;
  if (d.data.error) html += `<div class="err-box">${esc(d.data.error)}</div>`;
  if (d.by === 'hour' && empty) html += '<div class="note">Почасовые данные копятся с момента включения объявления в сервисе (снимок раз в 10 минут).</div>';
  else if (empty) html += '<div class="note">Нет данных за выбранный период</div>';
  html += `<div class="det-k">
    <div class="box"><h4>Воронка</h4>${ln('Показы', int(tot.i))}${ln('Просмотры', int(tot.v))}${ln('Контакты', int(tot.c))}${ln('Показ → просмотр', pct(cv(tot.v, tot.i)))}${ln('Просмотр → контакт', pct(cv(tot.c, tot.v)))}</div>
    <div class="box"><h4>Расходы</h4>${ln('Расходы', rub(tot.s, 1))}${ln('CPV / 1 просмотр', rub(div(tot.s, tot.v), 1))}${ln('CPA / 1 контакт', rub(div(tot.s, tot.c), 1))}</div>
    <div class="box"><h4>Ставка и опережение</h4>${ln('Средняя ставка', rub(avgB, 1))}${ln('Среднее опережение', pct(avgC))}${ln('Установленная ставка', rub(x.bid))}${ln('Рекомендует Авито', rub(x.rec))}</div>
  </div>`;
  if (!empty) html += chartHtml(x.key, rows, d);
  const tod = d.data.tod || [];
  const mx = Math.max(1, ...tod.map((t) => t.v));
  if (tod.some((t) => t.i || t.v)) {
    html += `<div class="chart"><b style="font-size:12.5px">Время суток — просмотры по часам (МСК), сумма за период</b><div class="tod" style="margin-top:8px">${tod.map((t) => `<div style="height:${(t.v / mx) * 100}%" title="${hh(t.h)}: показы ${t.i}, просмотры ${t.v}, контакты ${t.c}, расходы ${rub(t.s, 1)}"></div>`).join('')}</div><div class="tod-l">${tod.map((t) => `<span>${t.h}</span>`).join('')}</div></div>`;
  }
  if (x.scale && x.scale.length) {
    const cur = x.now;
    let curIdx = -1;
    x.scale.forEach(([v], k) => { if (cur != null && v <= cur) curIdx = k; });
    html += `<details><summary class="note" style="cursor:pointer">Шкала ставок Авито (ставка → опережение конкурентов)</summary><table class="scale"><tr><th>Ставка</th><th>Опережение</th></tr>${x.scale.map(([v, c], k) => `<tr class="${k === curIdx ? 'cur' : ''}"><td class="num">${rub(v)}${k === 0 ? ' · базовая' : ''}</td><td class="num">${c} %</td></tr>`).join('')}</table></details>`;
  }
  const notes = d.data.notes || [];
  if (notes.length) html += `<div class="notes"><b style="font-size:12.5px">Заметки</b>${notes.slice().reverse().map((n) => `<div class="n"><time>${fmtAt(n.at)}</time><span>${esc(n.text)}</span><button class="lnkb" type="button" data-delnote="${esc(x.key)}|${n.at}" style="color:var(--muted)">удалить</button></div>`).join('')}</div>`;
  return html;
}

function chartHtml(key, rows, d) {
  const W = 1000, H = 220, P = 28;
  const pts = rows.map((r) => ({ ...r, cpa: div(r.s, r.c) }));
  const lines = MET.filter((m) => d.metrics.includes(m.id)).map((m) => {
    const vals = pts.map((r) => r[m.id]);
    const mx = Math.max(...vals.filter((v) => v != null), 0) || 1;
    const xs = (k) => P + (pts.length === 1 ? (W - 2 * P) / 2 : (k * (W - 2 * P)) / (pts.length - 1));
    let path = '';
    vals.forEach((v, k) => { if (v == null) return; path += `${path ? 'L' : 'M'}${xs(k).toFixed(1)},${(H - P - (v / mx) * (H - 2 * P)).toFixed(1)}`; });
    const dots = vals.map((v, k) => v == null ? '' : `<circle cx="${xs(k).toFixed(1)}" cy="${(H - P - (v / mx) * (H - 2 * P)).toFixed(1)}" r="2.5" fill="${m.c}"><title>${esc(pts[k].at || pts[k].date)} · ${m.t}: ${v}</title></circle>`).join('');
    return `<path d="${path}" fill="none" stroke="${m.c}" stroke-width="2" vector-effect="non-scaling-stroke"/>${dots}`;
  }).join('');
  const label = (r) => (r.at || r.date || '').slice(d.by === 'hour' ? 5 : 5);
  const step = Math.max(1, Math.ceil(pts.length / 8));
  const xl = pts.map((r, k) => k % step ? '' : `<text x="${P + (pts.length === 1 ? (W - 2 * P) / 2 : (k * (W - 2 * P)) / (pts.length - 1))}" y="${H - 8}" font-size="11" text-anchor="middle" fill="currentColor" opacity=".6">${esc(label(r))}</text>`).join('');
  const notes = (det[key].data.notes || []).map((n) => {
    const day = new Date(n.at + 3 * 3600e3).toISOString().slice(0, 10);
    const k = pts.findIndex((r) => (r.date || r.at || '').startsWith(day));
    if (k < 0) return '';
    const x = P + (pts.length === 1 ? (W - 2 * P) / 2 : (k * (W - 2 * P)) / (pts.length - 1));
    return `<line x1="${x}" x2="${x}" y1="${P / 2}" y2="${H - P}" stroke="currentColor" stroke-dasharray="3 3" opacity=".35"/><text x="${x + 3}" y="${P / 2 + 8}" font-size="10" fill="currentColor" opacity=".7"><title>${esc(n.text)}</title>✎</text>`;
  }).join('');
  return `<div class="chart"><div class="legend">${MET.map((m) => `<label class="${d.metrics.includes(m.id) ? '' : 'offl'}"><input type="checkbox" data-met="${esc(key)}|${m.id}" ${d.metrics.includes(m.id) ? 'checked' : ''}><i style="background:${m.c}"></i>${m.t}</label>`).join('')}</div><svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" style="color:var(--muted)" role="img" aria-label="График показателей объявления">${notes}${lines}${xl}</svg><div class="note">Каждая линия — в своём масштабе (максимум линии = верх графика). Наведите на точку — значение.</div></div>`;
}

async function loadDetail(key) {
  const x = S.items.find((i) => i.key === key);
  const d = det[key];
  if (!x || !d) return;
  d.loading = true;
  const to = mskToday(), from = dAdd(to, -(Number(d.per) - 1));
  const r = await api(`/api/dashboard/mbids/item-stats?accountId=${encodeURIComponent(x.accountId)}&id=${x.id}&from=${from}&to=${to}&by=${d.by}`);
  d.loading = false;
  d.data = r.ok ? r.data : null;
  const box = document.getElementById(`det-${cssId(key)}`);
  if (box) box.innerHTML = detailHtml(x);
}

/* ── правки ── */
async function update(keys, set, note, extra = {}) {
  const r = await post('/api/dashboard/mbids/items/update', { refs: keys, set, note, ...extra });
  if (!r.ok) { toast(r.data.error || 'Не сохранилось'); return null; }
  keys.forEach((k) => {
    const x = S.items.find((i) => i.key === k);
    if (!x) return;
    if (set.on !== undefined) x.on = !!set.on;
    if (set.bid !== undefined && set.bid !== null && typeof set.bid !== 'object') x.bid = set.bid;
    if (set.hours !== undefined) x.hours = set.hours && set.hours.length < 24 ? set.hours : null;
    if (set.days !== undefined) x.days = set.days && set.days.length < 7 ? set.days : null;
  });
  render();
  // Движок применяет правки в фоне — подтягиваем статусы чуть позже.
  setTimeout(load, 7000);
  setTimeout(load, 25000);
  return r.data;
}

/* ── события таблицы ── */
$('#rows').addEventListener('change', async (e) => {
  const t = e.target;
  if (t.dataset.sel) { t.checked ? sel.add(t.dataset.sel) : sel.delete(t.dataset.sel); t.closest('tr').classList.toggle('sel', t.checked); renderSelbar(visible()); return; }
  if (t.dataset.on) {
    const x = S.items.find((i) => i.key === t.dataset.on);
    if (t.checked && x && x.bid == null) toast('Ставка не указана — статус будет «Ошибка», пока её не зададите');
    await update([t.dataset.on], { on: t.checked });
    return;
  }
  if (t.dataset.bid) {
    const v = t.value.trim();
    if (v !== '' && !/^\d+$/.test(v)) { toast('Ставка — целое число рублей'); t.classList.add('bad'); return; }
    await update([t.dataset.bid], { bid: v === '' ? null : Number(v) });
    return;
  }
  if (t.dataset.dper) { const d = det[t.dataset.dper]; d.per = t.value; d.data = null; loadDetail(t.dataset.dper); return; }
  if (t.dataset.met) {
    const [key, m] = t.dataset.met.split('|');
    const d = det[key];
    d.metrics = t.checked ? [...d.metrics, m] : d.metrics.filter((x) => x !== m);
    const x = S.items.find((i) => i.key === key);
    const box = document.getElementById(`det-${cssId(key)}`);
    if (box && x) box.innerHTML = detailHtml(x);
  }
});
$('#rows').addEventListener('keydown', (e) => { if (e.key === 'Enter' && e.target.dataset.bid) e.target.blur(); });
$('#rows').addEventListener('click', async (e) => {
  const b = e.target.closest('button');
