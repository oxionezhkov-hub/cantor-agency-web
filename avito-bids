    <label class="row" style="cursor:pointer;flex-wrap:nowrap"><label class="switch"><input type="checkbox" id="eEnabled" ${!ed || ed.enabled ? 'checked' : ''}><i></i></label>Пересобирать XML каждый час</label>
    <div class="err-box hide" id="eErr"></div></form>
    <div class="m-f">${ed ? '<button class="btn warn" type="button" id="eDelete">Удалить клиента</button>' : ''}<span class="grow"></span><button class="btn" type="button" data-close>Отмена</button><button class="btn primary" type="submit" form="eForm" id="eSave">Сохранить</button></div>`);
  const tabs = (all, checked) => { $('#eTabs').innerHTML = all.length ? all.map((t) => `<label><input type="checkbox" class="cb" value="${esc(t)}" ${checked.includes(t) ? 'checked' : ''}>${esc(t)}</label>`).join('') : '<span class="note">Нажмите «Вкладки», чтобы загрузить их из таблицы</span>'; };
  tabs(ed ? ed.tabs : [], ed ? ed.tabs : []);
  const err = (t) => { $('#eErr').textContent = t; $('#eErr').classList.toggle('hide', !t); };
  $('#eLoadTabs').onclick = async () => {
    const sheet = $('#eSheet').value.trim(); if (!sheet) return $('#eSheet').focus();
    $('#eLoadTabs').disabled = true;
    const r = await api('/api/dashboard/feeds/tabs?sheet=' + encodeURIComponent(sheet));
    if ($('#eLoadTabs')) $('#eLoadTabs').disabled = false;
    if (!r.ok) return err(r.data.error || 'Не удалось открыть таблицу');
    err('');
    const cur = $$('#eTabs input:checked').map((i) => i.value);
    tabs(r.data.tabs, cur.length ? cur : r.data.tabs.filter((t) => !SKIP_TABS.test(t)));
  };
  $('#eForm', m).addEventListener('submit', async (e) => {
    e.preventDefault();
    const body = { name: $('#eName').value.trim(), sheetUrl: $('#eSheet').value.trim(), tabs: $$('#eTabs input:checked').map((i) => i.value), avitoAccountId: $('#eAccount').value, enabled: $('#eEnabled').checked };
    const b = $('#eSave'); b.disabled = true; b.textContent = ed ? 'Сохраняю…' : 'Собираю XML…';
    const r = ed ? await api('/api/dashboard/feeds/' + ed.slug, { method: 'PUT', body: JSON.stringify(body) }) : await post('/api/dashboard/feeds', body);
    if ($('#eSave')) { b.disabled = false; b.textContent = 'Сохранить'; }
    if (!r.ok) return err(r.data.error || 'Не удалось сохранить');
    replaceFeed(r.data.feed); closeModal();
    const s = r.data.feed.stat;
    toast(ed ? 'Сохранено' : (s && s.error ? 'Клиент добавлен, но XML не собран: ' + s.error : `Клиент добавлен, в XML ${s ? s.ads : 0} объявлений`));
  });
  if (ed) $('#eDelete').onclick = async () => {
    const b = $('#eDelete');
    if (b.dataset.sure !== '1') { b.dataset.sure = '1'; b.textContent = 'Точно удалить? Ссылка на XML перестанет работать'; return; }
    const r = await api('/api/dashboard/feeds/' + ed.slug, { method: 'DELETE' });
    if (!r.ok) return toast(r.data.error || 'Не удалось удалить');
    F.feeds = F.feeds.filter((f) => f.slug !== ed.slug); feedsRender(); closeModal(); toast('Клиент удалён');
  };
}
function feedImport() {
  const m = openModal(`${mHead('Импорт из BananLab')}<form class="m-b" id="iForm" novalidate>
    <div class="note">Вставьте JSON-список клиентов, собранный в BananLab: <span class="mono">[{"client":"5899_elena_kiseleva","active":true,"sheetUrl":"…","xmlUrl":"…","dataSource":"Авито_выгрузка / …"}]</span>. Вкладки возьмутся из таблицы, кабинет Авито подберётся по фамилии. Клиенты, которые уже есть, пропускаются. В кабинетах Авито ничего не меняется — XML соберётся в течение часа.</div>
    <textarea class="input" id="iJson" rows="10" style="font-family:var(--mono,monospace);font-size:12px" placeholder='[{"client":"…","sheetUrl":"https://docs.google.com/spreadsheets/d/…"}]'></textarea>
    <div class="err-box hide" id="iErr"></div><div id="iDone"></div></form>
    <div class="m-f"><span class="grow"></span><button class="btn" type="button" data-close>Закрыть</button><button class="btn primary" type="submit" form="iForm" id="iSave">Импортировать</button></div>`, { wide: true });
  $('#iForm', m).addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = (t) => { $('#iErr').textContent = t; $('#iErr').classList.toggle('hide', !t); };
    let items;
    try { const txt = $('#iJson').value.trim().replace(/^```\w*|```$/g, ''); items = JSON.parse(txt); } catch (x) { return err('Это не JSON — вставьте список целиком, от [ до ]'); }
    err(''); const b = $('#iSave'); b.disabled = true; b.textContent = 'Импортирую…';
    const r = await post('/api/dashboard/feeds/import', { items });
    if (!$('#iSave')) return;
    b.disabled = false; b.textContent = 'Импортировать';
    if (!r.ok) return err(r.data.error || 'Не удалось импортировать');
    const label = { created: 'добавлен', exists: 'уже есть', skipped: 'пропущен' };
    $('#iDone').innerHTML = `<div class="ok-box">Добавлено клиентов: ${r.data.created}.</div>` + r.data.results.map((x) => `<div class="prob"><div class="small muted">${esc(x.client)}</div><div>${esc(label[x.status] || x.status)}${x.account ? ` · кабинет «${esc(x.account)}»` : x.status === 'created' ? ' · <b>кабинет не найден — выберите в «Редактировать»</b>' : ''}${x.tabs && x.tabs.length ? ` · вкладки: ${x.tabs.map(esc).join(', ')}` : ''}${x.note ? ` · ${esc(x.note)}` : ''}</div></div>`).join('');
    feedsLoad();
  });
}
async function feedCompare(slug) {
  const f = feedBy(slug);
  const m = openModal(`${mHead('Сравнение с BananLab — ' + f.name)}<div class="m-b" id="cmpBody"><div class="note">Сравниваю наш XML с XML BananLab…</div></div>`, { wide: true });
  const r = await api(`/api/dashboard/feeds/${slug}/compare`);
  if (!$('#cmpBody')) return;
  if (!r.ok) { $('#cmpBody').innerHTML = `<div class="err-box">${esc(r.data.error || 'Не удалось сравнить')}</div>`; return; }
  const d = r.data, names = { Title: 'Заголовок', Price: 'Цена', Address: 'Адрес', Category: 'Категория', Description: 'Описание', Images: 'Число фото', PriceList: 'Прайс', PromoAutoOptions: 'Автопродвижение', PromoManualOptions: 'Ручное продвижение' };
  const diffF = Object.entries(d.fieldDiffs).filter(([, n]) => n);
  const same = !d.onlyOursCount && !d.onlyTheirsCount && !diffF.length && d.ours === d.theirs;
  $('#cmpBody').innerHTML = `<div class="${same ? 'ok-box' : 'note'}">${same ? 'Совпадает полностью: можно переключать кабинет на наш XML.' : 'Есть расхождения — посмотрите перед переключением.'}</div>
    <div class="prob"><div class="small muted">Объявлений</div><div>у нас ${int(d.ours)}, в BananLab ${int(d.theirs)}, общих ${int(d.same)}</div></div>
    ${d.onlyOursCount ? `<div class="prob"><div class="small muted">Только у нас</div><div class="mono small">${d.onlyOursCount}: ${d.onlyOurs.map(esc).join(', ')}</div></div>` : ''}
    ${d.onlyTheirsCount ? `<div class="prob"><div class="small muted">Только в BananLab</div><div class="mono small">${d.onlyTheirsCount}: ${d.onlyTheirs.map(esc).join(', ')}</div></div>` : ''}
    ${diffF.length ? `<div class="prob"><div class="small muted">Отличаются поля</div><div>${diffF.map(([k, n]) => `${names[k] || k}: ${n}`).join(' · ')}</div></div>` : ''}
    ${d.diffs.slice(0, 15).map((x) => `<div class="prob"><div class="small muted mono">${esc(x.id)}</div><div>${x.fields.map((g) => `<div><b>${esc(names[g.field] || g.field)}</b>: у нас «${esc(g.ours)}» — в BananLab «${esc(g.theirs)}»</div>`).join('')}</div></div>`).join('')}`;
}
function feedConnect(slug) {
  const f = feedBy(slug);
  const acc = F.accounts.find((a) => a.id === f.avitoAccountId);
  const m = openModal(`${mHead('Подключить на Авито')}<form class="m-b" id="cForm" novalidate>
    <div class="note">${acc ? `В настройки автозагрузки кабинета «${esc(acc.name)}» запишется ссылка на наш XML вместо текущей (например, BananLab)${f.bananlabXml ? ' — перед этим проверьте «Сравнить с BananLab»' : ''}. Объявления не удалятся: у них те же id.` : 'Сначала привяжите аккаунт Авито в «Редактировать».'}</div>
    <div><label class="f" for="cEmail">Почта для отчётов автозагрузки</label><input class="input" id="cEmail" type="email" placeholder="если пусто — оставим ту, что уже в Авито"></div>
    <div class="err-box hide" id="cErr"></div><div id="cDone" class="hide"></div></form>
    <div class="m-f"><button class="btn" type="button" data-close>Отмена</button><button class="btn primary" type="submit" form="cForm" id="cSave" ${acc ? '' : 'disabled'}>Подключить</button></div>`);
  $('#cForm', m).addEventListener('submit', async (e) => {
    e.preventDefault();
    $('#cSave').disabled = true;
    const r = await post(`/api/dashboard/feeds/${f.slug}/avito-connect`, { reportEmail: $('#cEmail').value.trim() });
    if (!$('#cSave')) return;
    $('#cSave').disabled = false;
    if (!r.ok) { $('#cErr').textContent = r.data.error || 'Авито не принял настройки'; $('#cErr').classList.remove('hide'); return; }
    const prev = (r.data.previousFeeds || []).map((p) => p.feed_url).filter(Boolean);
    $('#cDone').innerHTML = `<div class="ok-box">Готово. Авито заберёт наш XML при следующей загрузке.${prev.length ? ` Раньше стояло: ${prev.map((u) => `<span class="mono">${esc(u)}</span>`).join(', ')} — сохраните, если понадобится вернуть.` : ''}</div>`;
    $('#cDone').classList.remove('hide'); $('#cErr').classList.add('hide');
  });
}

/* ═══════════════ Журнал действий ═══════════════ */
const LOG = { month: mskToday().slice(0, 7), area: '', by: '' };
function openLog() {
  openModal(`${mHead('Журнал действий')}<div class="m-b" id="logBody"><div class="note">Загружаю…</div></div>`, { wide: true });
  LOG.reload = async () => {
    const r = await api('/api/dashboard/feeds/log?month=' + LOG.month);
    if (!$('#logBody')) return;
    if (!r.ok) { $('#logBody').innerHTML = `<div class="err-box">${esc(r.data.error || 'Не удалось загрузить журнал')}</div>`; return; }
    LOG.data = r.data; renderLog();
  };
  LOG.reload();
}
function renderLog() {
  const d = LOG.data, people = [...new Set(d.entries.map((e) => e.by))].sort((a, b) => String(a).localeCompare(String(b), 'ru'));
  const list = d.entries.filter((e) => (!LOG.area || e.area === LOG.area) && (!LOG.by || e.by === LOG.by));
  const months = []; for (let i = 0; i < 6; i++) { const x = new Date(); x.setUTCDate(1); x.setUTCMonth(x.getUTCMonth() - i); months.push(x.toISOString().slice(0, 7)); }
  const day = (t) => new Date(t + 3 * 3600e3).toISOString().slice(0, 10);
  const accs = (ids) => (ids || []).filter(Boolean).map((id) => d.accounts[id] || id).join(', ');
  let cur = '';
  const rows = list.map((e) => {
    const dd = day(e.t), head = dd !== cur ? `<div class="lg-day">${esc(new Date(dd + 'T12:00:00Z').toLocaleDateString('ru-RU', { weekday: 'long', day: 'numeric', month: 'long' }))}</div>` : '';
    cur = dd;
    const who = String(e.by || '?');
    const obj = [e.name, accs(e.acc)].filter((x, i, a) => x && a.indexOf(x) === i).join(' · ');
    return `${head}<div class="lg-row"><span class="lg-t">${new Date(e.t).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Moscow' })}</span><span class="av ${e.byId ? '' : 'pw'}" title="${esc(who)}">${esc(who.charAt(0).toUpperCase())}</span>
      <div class="lg-m"><div><b>${esc(who)}</b> · ${esc(e.act)}${e.n != null ? ` <span class="chip">${int(e.n)}</span>` : ''} <span class="chip ${e.area === 'feeds' ? 'accent' : ''}">${e.area === 'feeds' ? 'Автозагрузка' : 'Ставки'}</span></div>${obj || e.detail ? `<div class="note">${esc([obj, e.detail].filter(Boolean).join(' — '))}</div>` : ''}</div></div>`;
  }).join('');
  $('#logBody').innerHTML = `<div class="row" style="gap:8px;flex-wrap:wrap">
      <select class="select" id="lgMonth" style="width:auto">${months.map((x) => `<option value="${x}" ${x === LOG.month ? 'selected' : ''}>${new Date(x + '-15T00:00:00Z').toLocaleDateString('ru-RU', { month: 'long', year: 'numeric' })}</option>`).join('')}</select>
      <select class="select" id="lgArea" style="width:auto"><option value="">Все разделы</option><option value="feeds" ${LOG.area === 'feeds' ? 'selected' : ''}>Автозагрузка</option><option value="bids" ${LOG.area === 'bids' ? 'selected' : ''}>Ставки</option></select>
      <select class="select" id="lgBy" style="width:auto"><option value="">Все сотрудники</option>${people.map((x) => `<option ${x === LOG.by ? 'selected' : ''}>${esc(x)}</option>`).join('')}</select>
      <span class="note">${int(list.length)} действий</span></div>
    <div class="lg">${rows || emptyState('note', 'За этот месяц действий нет', 'Здесь появятся изменения ставок и автозагрузки с именами сотрудников')}</div>`;
  $('#lgMonth').onchange = (e) => { LOG.month = e.target.value; $('#logBody').innerHTML = '<div class="note">Загружаю…</div>'; LOG.reload(); };
  $('#lgArea').onchange = (e) => { LOG.area = e.target.value; renderLog(); };
  $('#lgBy').onchange = (e) => { LOG.by = e.target.value; renderLog(); };
}
$('#logBtn').addEventListener('click', openLog);

/* ═══════════════ Вход и запуск ═══════════════ */
function showGate() {
  let at = false, pw = false;
  try { at = !!localStorage.getItem(AT_KEY); pw = !!localStorage.getItem(PW_KEY); } catch (e) {}
  $('#gateAt').hidden = !(at && !pw);
  $('#app').hidden = true; $('#gate').hidden = false; setTimeout(() => $('#gatePw').focus(), 30);
}
$('#gateForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const pw = $('#gatePw').value;
  const r = await api('/api/dashboard/mbids/state', {}, pw);
  if (r.status === 401) { $('#gateErr').textContent = 'Неверный пароль'; return; }
  try { localStorage.setItem(PW_KEY, pw); } catch (err) {}
  $('#gate').hidden = true; $('#app').hidden = false;
  if (r.ok) { Object.assign(B, r.data, { loaded: true }); setMe(r.data.me); }
  start();
});
function start() {
  setPage(page);
  if (B.loaded) { render(); loadStats(); }
  setInterval(() => { if (page === 'bids' && !modalEl && !popEl && !document.hidden) bidsLoad(); }, 60000);
  setInterval(() => { if (page === 'bids' && !document.hidden && $('#period').value === 'today') loadStats(); }, 600000);
}
window.addEventListener('hashchange', () => setPage(location.hash === '#feeds' ? 'feeds' : 'bids'));
if (!getPw()) showGate(); else { $('#app').hidden = false; start(); }
})();
</script>
