  addSel.clear();
  catalog.filter((x) => !x.added).forEach((x) => addSel.add(x.key));
  $('#aInfo').textContent = `Найдено ${catalog.length} из ${ids.length}.${missing.length ? ` Не найдены среди активных объявлений кабинета «${accName(acc)}»: ${missing.slice(0, 15).join(', ')}${missing.length > 15 ? '…' : ''}` : ''}`;
  renderAdd();
});
$('#aSave').addEventListener('click', async () => {
  if (!addSel.size) return toast('Отметьте объявления');
  if (addSel.size > 500) return toast('За раз можно добавить до 500 объявлений');
  const acc = $('#aAcc').value;
  const pool = new Map([...catalog].map((x) => [x.key, x]));
  const items = [...addSel].map((k) => pool.get(k)).filter(Boolean).map((x) => ({ id: x.id, title: x.title, url: x.url, address: x.address }));
  const btn = $('#aSave'); btn.disabled = true;
  const r = await post('/api/dashboard/mbids/items', { accountId: acc, items });
  btn.disabled = false;
  if (!r.ok) return toast(r.data.error || 'Не добавилось');
  closeModal();
  toast(`Добавлено: ${r.data.added}. Ставки Авито подтянутся в течение пары минут. Укажите ставку и включите тумблер.`);
  await load(); loadStats();
  setTimeout(load, 20000); setTimeout(load, 60000);
});

/* ── группы: события ── */
let gEdit = null;
function openGroupForm(id) {
  gEdit = id || null;
  $('#gTitle').textContent = id ? 'Переименовать группу' : 'Новая группа';
  $('#gName').value = id ? S.groups[id].name : '';
  $('#gErr').hidden = true;
  showModal('#mGroup');
}
$('#gCreate').addEventListener('click', () => openGroupForm());
$('#gForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const name = $('#gName').value.trim();
  const r = gEdit ? await api(`/api/dashboard/mbids/groups/${gEdit}`, { method: 'PUT', body: JSON.stringify({ name }) }) : await post('/api/dashboard/mbids/groups', { name });
  if (!r.ok) { $('#gErr').textContent = r.data.error || 'Не сохранилось'; $('#gErr').hidden = false; return; }
  S.groups = r.data.groups; closeModal(); render();
});
$('#groupsBody').addEventListener('click', async (e) => {
  if (e.target.closest('#gFirst')) return openGroupForm();
  const cb = e.target.closest('[data-gsel]');
  if (cb) { e.stopPropagation(); cb.checked ? gSel.add(cb.dataset.gsel) : gSel.delete(cb.dataset.gsel); $('#gDelSel').hidden = !gSel.size; return; }
  const ren = e.target.closest('[data-gren]');
  if (ren) return openGroupForm(ren.dataset.gren);
  const del = e.target.closest('[data-gdel]');
  if (del) return delGroups([del.dataset.gdel]);
  const card = e.target.closest('[data-gopen]');
  if (card) { curGroup = card.dataset.gopen; sel.clear(); render(); }
});
$('#groupsBody').addEventListener('keydown', (e) => { if (e.key === 'Enter' && e.target.dataset.gopen) { curGroup = e.target.dataset.gopen; render(); } });
$('#gDelSel').addEventListener('click', () => delGroups([...gSel]));
async function delGroups(ids) {
  if (!confirm(`Удалить ${ids.length > 1 ? `${ids.length} групп` : 'группу'}? Объявления останутся в разделе и на Авито.`)) return;
  const r = await post('/api/dashboard/mbids/groups/delete', { ids });
  if (!r.ok) return toast(r.data.error || 'Не удалилось');
  ids.forEach((g) => gSel.delete(g));
  await load();
}
$('#groupHead').addEventListener('click', (e) => {
  if (e.target.closest('#gBack')) { curGroup = null; sel.clear(); render(); }
  if (e.target.closest('#gAddTo')) openPick();
});
const pickSel = new Set();
function openPick() {
  pickSel.clear(); $('#pQ').value = '';
  $('#pHead').innerHTML = '<tr><th style="width:34px"></th><th>Объявление</th><th>Аккаунт</th><th class="r">Ставка</th><th class="r">Ставка сейчас</th><th class="r">Опережение</th></tr>';
  renderPick();
  showModal('#mPick');
}
function renderPick() {
  const s = $('#pQ').value.trim().toLowerCase();
  const list = S.items.filter((x) => !x.groups.includes(curGroup) && (!s || x.title.toLowerCase().includes(s) || x.id.includes(s) || x.city.toLowerCase().includes(s) || x.accountName.toLowerCase().includes(s)));
  $('#pRows').innerHTML = list.slice(0, 1000).map((x) => `<tr><td><input type="checkbox" class="cb" data-psel="${esc(x.key)}" ${pickSel.has(x.key) ? 'checked' : ''} aria-label="Выбрать"></td><td><span class="ttl">${esc(x.title)}</span><div class="sub">№ ${esc(x.id)} · ${esc(x.city)}</div></td><td class="sub">${esc(x.accountName)}</td><td class="r num">${rub(x.bid)}</td><td class="r num">${rub(x.now)}</td><td class="r num">${pct(x.cmp)}</td></tr>`).join('') || '<tr><td colspan="6" class="empty">Все объявления раздела уже в этой группе</td></tr>';
  $('#pSel').textContent = pickSel.size ? `Выбрано: ${pickSel.size}` : '';
}
$('#pQ').addEventListener('input', renderPick);
$('#pRows').addEventListener('change', (e) => { const k = e.target.dataset.psel; if (k) { e.target.checked ? pickSel.add(k) : pickSel.delete(k); $('#pSel').textContent = pickSel.size ? `Выбрано: ${pickSel.size}` : ''; } });
$('#pSave').addEventListener('click', async () => {
  if (!pickSel.size) return toast('Отметьте объявления');
  const r = await post('/api/dashboard/mbids/groups/members', { groupId: curGroup, refs: [...pickSel], action: 'add' });
  if (!r.ok) return toast(r.data.error || 'Не получилось');
  closeModal(); toast(`Добавлено в группу: ${r.data.changed}`); load();
});

/* ── фильтры ── */
$('#filtersBtn').addEventListener('click', (e) => {
  const p = $('#pop');
  const cities = [...new Set(S.items.map((x) => x.city))].sort((a, b) => a.localeCompare(b, 'ru'));
  const accs = [...new Set(S.items.map((x) => x.accountId))];
  const box = (name, val, label, on) => `<label style="display:flex;gap:6px;align-items:center;font-size:12.5px;border:0;justify-content:flex-start;padding:2px 0;background:none;cursor:pointer"><input type="checkbox" class="cb" style="display:inline-block" data-f="${name}" value="${esc(val)}" ${on ? 'checked' : ''}>${esc(label)}</label>`;
  p.innerHTML = `<b style="font-size:13px">Фильтры</b>
    <div><div class="sub">Аккаунт</div>${accs.map((a) => box('acc', a, accName(a), filt.acc.includes(a))).join('')}</div>
    <div><div class="sub">Город</div><div style="max-height:150px;overflow:auto">${cities.map((c) => box('city', c, c || 'не указан', filt.city.includes(c))).join('')}</div></div>
    <div><div class="sub">Статус</div>${Object.entries(STATUS).map(([k, t]) => box('status', k, t, filt.status.includes(k))).join('')}</div>
    <div class="f"><label class="sub" for="fOn">Вкл / выкл</label><select id="fOn"><option value="">Все</option><option value="on" ${filt.on === 'on' ? 'selected' : ''}>Включённые</option><option value="off" ${filt.on === 'off' ? 'selected' : ''}>Выключенные</option></select></div>
    <div class="f"><label class="sub" for="fGr">Группа</label><select id="fGr"><option value="">Все</option>${Object.entries(S.groups).map(([g, v]) => `<option value="${g}" ${filt.group === g ? 'selected' : ''}>${esc(v.name)}</option>`).join('')}</select></div>
    <div style="display:flex;gap:8px;justify-content:flex-end"><button class="btn sm" type="button" data-fq="reset">Сбросить</button><button class="btn sm pri" type="button" data-fq="ok">Готово</button></div>`;
  p.hidden = false;
  const r = e.target.getBoundingClientRect();
  p.style.left = `${Math.max(12, Math.min(r.left, innerWidth - p.offsetWidth - 12))}px`;
  p.style.top = `${Math.min(r.bottom + 6, innerHeight - p.offsetHeight - 12)}px`;
  p.style.maxHeight = `${innerHeight - 24}px`; p.style.overflow = 'auto';
  popCtx = { filters: true };
});
$('#pop').addEventListener('change', (e) => {
  if (!popCtx || !popCtx.filters) return;
  const t = e.target;
  if (t.dataset.f) { const arr = filt[t.dataset.f]; const i = arr.indexOf(t.value); if (t.checked && i < 0) arr.push(t.value); if (!t.checked && i >= 0) arr.splice(i, 1); }
  if (t.id === 'fOn') filt.on = t.value;
  if (t.id === 'fGr') filt.group = t.value;
  lsSet('mb_filt', filt); render();
}, true);
$('#pop').addEventListener('click', (e) => {
  const b = e.target.closest('[data-fq]');
  if (!b) return;
  e.stopImmediatePropagation();
  if (b.dataset.fq === 'reset') { filt = { acc: [], city: [], status: [], on: '', group: '' }; lsSet('mb_filt', filt); render(); }
  $('#pop').hidden = true;
}, true);
document.addEventListener('mousedown', (e) => { if (popCtx && popCtx.filters && !$('#pop').hidden && !e.target.closest('#pop') && !e.target.closest('#filtersBtn')) $('#pop').hidden = true; });

/* ── столбцы ── */
function renderCols() {
  $('#cList').innerHTML = cols.map((c, k) => `<div class="colrow"><input type="checkbox" class="cb" data-col="${c.id}" ${c.on ? 'checked' : ''} id="col_${c.id}"><label for="col_${c.id}">${esc(colById(c.id).t)}</label><span class="sp"></span><button class="ico" type="button" data-up="${k}" aria-label="Выше" ${k ? '' : 'disabled'}>↑</button><button class="ico" type="button" data-down="${k}" aria-label="Ниже" ${k < cols.length - 1 ? '' : 'disabled'}>↓</button></div>`).join('');
}
$('#colsBtn').addEventListener('click', () => { renderCols(); showModal('#mCols'); });
$('#cList').addEventListener('change', (e) => { const c = cols.find((x) => x.id === e.target.dataset.col); if (c) { c.on = e.target.checked; lsSet('mb_cols', cols); render(); } });
$('#cList').addEventListener('click', (e) => {
  const b = e.target.closest('button');
  if (!b) return;
  const k = Number(b.dataset.up ?? b.dataset.down);
  const j = b.dataset.up != null ? k - 1 : k + 1;
  [cols[k], cols[j]] = [cols[j], cols[k]];
  lsSet('mb_cols', cols); renderCols(); render();
});
$('#cReset').addEventListener('click', () => { cols = DEFAULT_COLS.map((c) => ({ ...c })); lsSet('mb_cols', cols); renderCols(); render(); });

/* ── прочее ── */
$('#q').addEventListener('input', (e) => { q = e.target.value; render(); });
$('#period').addEventListener('change', () => { $('#customPer').hidden = $('#period').value !== 'custom'; if ($('#period').value !== 'custom') loadStats(); });
['#pFrom', '#pTo'].forEach((s) => $(s).addEventListener('change', loadStats));
$('#addBtn').addEventListener('click', openAdd);
$('#helpBtn').addEventListener('click', () => showModal('#mHelp'));
$('#fullBtn').addEventListener('click', () => { $('#tableCard').classList.toggle('full'); });
$('#refreshBtn').addEventListener('click', async () => {
  const list = (sel.size ? [...sel] : visible().map((x) => x.key)).slice(0, 120);
  if (!list.length) return;
  const btn = $('#refreshBtn'); btn.disabled = true; btn.textContent = 'Обновляем…';
  for (let i = 0; i < list.length; i += 40) {
    const r = await post('/api/dashboard/mbids/refresh', { refs: list.slice(i, i + 40) });
    if (!r.ok) { toast(r.data.error || 'Авито не ответил'); break; }
  }
  btn.disabled = false; btn.textContent = 'Обновить из Авито';
  await load();
  toast(`Ставки перечитаны: ${list.length} объявл.${list.length === 120 ? ' (за раз — до 120)' : ''}`);
});
$$('[data-tab]').forEach((b) => b.addEventListener('click', () => {
  tab = b.dataset.tab; curGroup = null; sel.clear();
  $$('[data-tab]').forEach((x) => x.classList.toggle('on', x === b));
  render();
}));

function showGate() { $('#app').hidden = true; $('#gate').hidden = false; $('#gatePw').focus(); }
$('#gateForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const pw = $('#gatePw').value;
  const r = await api('/api/dashboard/mbids/state', {}, pw);
  if (r.status === 401) { $('#gateErr').textContent = 'Неверный пароль'; return; }
  try { localStorage.setItem(PW_KEY, pw); } catch (err) {}
  $('#gate').hidden = true; $('#app').hidden = false;
  S = r.data; render(); loadStats();
});

(async function init() {
  if (!getPw()) return showGate();
  $('#app').hidden = false;
  await load();
  if (!$('#gate').hidden) return;
  loadStats();
  // Статусы обновляем раз в минуту, статистику «Сегодня» — раз в 10 минут.
  setInterval(() => { if (!openModal && $('#pop').hidden && !document.hidden) load(); }, 60000);
  setInterval(() => { if (!document.hidden && $('#period').value === 'today') loadStats(); }, 600000);
})();
})();
</script>
</body>
</html>
