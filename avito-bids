.tile.amber{background:var(--amber-bg)}.tile.amber .t-v,.tile.amber .t-l{color:var(--amber)}
.tile.red{background:var(--red-bg)}.tile.red .t-v,.tile.red .t-l{color:var(--red)}
.ph2{font-size:13px;font-weight:700;color:var(--ink);margin-top:4px}
.prob{display:grid;grid-template-columns:150px minmax(0,1fr);gap:10px;padding:9px 0;border-bottom:1px solid var(--line-2);font-size:13px}
.prob:last-child{border-bottom:0}
.tabs-list{display:flex;flex-wrap:wrap;gap:6px}
.tabs-list label{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line);border-radius:999px;padding:5px 11px;font-size:12.5px;cursor:pointer}

@media (max-width:760px){
