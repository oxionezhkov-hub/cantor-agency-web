<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="robots" content="noindex, nofollow">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Ставки Авито — Cantor Agency</title>
<link rel="preload" href="/fonts/geologica-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="icon" type="image/svg+xml" href="/images/brand/favicon.svg">
<style>
:root{
  --accent:#E8391D;--accent-600:#C42D13;--accent-bg:#FFF0EB;--accent-ring:rgba(232,57,29,.16);
  --bg:#F4F3F0;--surface:#fff;--surface-2:#FAF9F7;--sunken:#EFEDE9;--line:#E5E2DD;--line-2:#EEECE8;
  --ink:#151515;--text:#2A2927;--muted:#76716A;--faint:#A7A29B;
  --green:#1C8048;--green-bg:#E6F4EC;--amber:#B06500;--amber-bg:#FFF2DA;--red:#D5311A;--red-bg:#FDEBE7;--blue:#2563C9;--violet:#7A4CC2;
  --shadow:0 1px 2px rgba(22,20,18,.04),0 3px 12px rgba(22,20,18,.045);--shadow-lg:0 18px 48px rgba(22,20,18,.16);--scrim:rgba(18,16,14,.38);
  --font:'Geologica',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;--display:'Unbounded','Geologica',sans-serif;
  color-scheme:light;
}
@media (prefers-color-scheme: dark){:root{
  --accent:#FF5A3C;--accent-600:#FF7A60;--accent-bg:#3A1C15;--accent-ring:rgba(255,90,60,.22);
  --bg:#121211;--surface:#1B1A19;--surface-2:#201F1D;--sunken:#161514;--line:#2E2C2A;--line-2:#282624;
  --ink:#F4F2EE;--text:#DEDAD4;--muted:#A19B93;--faint:#6E6962;
  --green:#4CC784;--green-bg:#133222;--amber:#F2A93B;--amber-bg:#35270D;--red:#FF6F57;--red-bg:#3D1812;--blue:#6EA2FF;--violet:#B48CFF;
  --shadow:0 1px 2px rgba(0,0,0,.3);--shadow-lg:0 18px 48px rgba(0,0,0,.5);--scrim:rgba(0,0,0,.55);color-scheme:dark;
}}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{margin:0}
body{background:var(--bg);color:var(--text);font:14px/1.5 var(--font);-webkit-font-smoothing:antialiased}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:6px}
.wrap{max-width:1600px;margin:0 auto;padding:20px 20px 90px;display:grid;gap:14px}
.wrap>*{min-width:0}
.kpis>*{min-width:0}
.bar{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.bar h1{font:700 20px var(--display);color:var(--ink);margin:0;letter-spacing:-.01em}
.sp{flex:1}
.nav{display:flex;gap:4px}
.nav a{font-size:13px;color:var(--muted);text-decoration:none;padding:6px 10px;border-radius:8px}
.nav a:hover{background:var(--sunken);color:var(--ink)}
.nav a.cur{background:var(--surface);color:var(--ink);border:1px solid var(--line)}
.btn{border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:7px 12px;cursor:pointer;font-weight:500;font-size:13px;white-space:nowrap;display:inline-flex;align-items:center;gap:6px}
.btn:hover{border-color:var(--faint)}
.btn.pri{background:var(--accent);border-color:var(--accent);color:#fff}
.btn.pri:hover{background:var(--accent-600)}
.btn.danger{color:var(--red)}
.btn.sm{padding:4px 9px;font-size:12px;border-radius:8px}
.btn[disabled]{opacity:.55;cursor:wait}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow)}
.seg{display:inline-flex;background:var(--sunken);border-radius:11px;padding:3px;gap:2px}
.seg button{border:0;background:transparent;padding:6px 14px;border-radius:8px;cursor:pointer;font-weight:500;font-size:13px;color:var(--muted)}
.seg button.on{background:var(--surface);color:var(--ink);box-shadow:var(--shadow)}
.sum{display:flex;gap:22px;flex-wrap:wrap;padding:12px 16px;font-size:13px;color:var(--muted)}
.sum b{color:var(--ink);font-weight:600;font-variant-numeric:tabular-nums}
.kpis{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);gap:12px}
.kpi{padding:12px 16px}
.kpi h3{margin:0 0 8px;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);font-weight:600}
.kpi-row{display:flex;gap:18px;flex-wrap:wrap;align-items:flex-end}
.kv .l{font-size:11.5px;color:var(--muted);white-space:nowrap}
.kv .v{font-size:19px;font-weight:600;color:var(--ink);font-variant-numeric:tabular-nums;white-space:nowrap}
.kv.cv .v{font-size:14px;color:var(--accent)}
.tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;padding:12px 14px;border-bottom:1px solid var(--line)}
.search{flex:1;min-width:220px;border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:7px 11px;font-size:13px}
.search:focus,.f input:focus,.f select:focus,.f textarea:focus,.cell-in:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-ring)}
.per{display:flex;gap:8px;align-items:center;flex-wrap:wrap;padding:8px 14px;border-bottom:1px solid var(--line);font-size:13px;color:var(--muted)}
.per select,.per input{border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:5px 8px;font-size:13px}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{display:inline-flex;align-items:center;gap:6px;background:var(--accent-bg);color:var(--accent);border-radius:999px;padding:2px 4px 2px 10px;font-size:12px;font-weight:500}
.chip button{border:0;background:transparent;color:inherit;cursor:pointer;padding:0 6px;font-size:14px;line-height:1}
.tbl-wrap{overflow:auto;max-height:calc(100vh - 140px)}
.full .tbl-wrap{max-height:none}
table{width:100%;border-collapse:separate;border-spacing:0}
th{font-size:11px;font-weight:600;letter-spacing:.02em;color:var(--muted);text-align:left;padding:9px 10px;border-bottom:1px solid var(--line);background:var(--surface-2);position:sticky;top:0;z-index:2;line-height:1.25;vertical-align:bottom}
th.sortable{cursor:pointer;user-select:none}
th.sortable:hover{color:var(--ink)}
th .ar{color:var(--accent);margin-left:3px}
td{padding:8px 10px;border-bottom:1px solid var(--line-2);vertical-align:middle;font-size:13px}
tr.sel td{background:var(--accent-bg)}
tr.det td{background:var(--surface-2);padding:0}
.num{font-variant-numeric:tabular-nums;white-space:nowrap}
.r{text-align:right}
.td-ttl{min-width:260px}
.ttl{font-weight:500;color:var(--ink);text-decoration:none;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;max-width:320px;line-height:1.3}
a.ttl:hover{color:var(--accent)}
.sub{font-size:11.5px;color:var(--muted)}
.dash{color:var(--faint)}
.pill{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:500;padding:3px 9px;border-radius:999px;white-space:nowrap;border:0;cursor:help}
.pill::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
.p-ok{color:var(--green);background:var(--green-bg)}.p-stop{color:var(--amber);background:var(--amber-bg)}.p-err{color:var(--red);background:var(--red-bg)}.p-off{color:var(--muted);background:var(--sunken)}
.tg{position:relative;width:36px;height:20px;flex:none;display:inline-block}
.tg input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer;z-index:1}
.tg span{position:absolute;inset:0;background:var(--line);border-radius:999px;transition:.15s}
.tg span::after{content:"";position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:#fff;transition:.15s;box-shadow:0 1px 2px rgba(0,0,0,.2)}
.tg input:checked+span{background:var(--accent)}
.tg input:checked+span::after{left:18px}
.tg input:disabled+span{opacity:.45}
.tg input:focus-visible+span{outline:2px solid var(--accent);outline-offset:2px}
.cell-in{width:76px;border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:5px 7px;font-size:13px;text-align:right;font-variant-numeric:tabular-nums}
.cell-in.bad{border-color:var(--red)}
.cb{width:16px;height:16px;accent-color:var(--accent);cursor:pointer;margin:0}
.exp{border:0;background:transparent;cursor:pointer;color:var(--muted);padding:2px 4px;border-radius:6px;transition:transform .15s}
.exp.open{transform:rotate(180deg)}
.lnkb{border:0;background:transparent;color:var(--accent);cursor:pointer;padding:0;font-weight:500;font-size:12.5px;text-align:left}
.lnkb:hover{text-decoration:underline}
.sched{display:flex;flex-direction:column;gap:3px;align-items:flex-start}
.sched .lnkb,td .lnkb{white-space:nowrap}
.selbar{position:fixed;left:50%;bottom:calc(16px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);border-radius:14px;padding:8px 10px 8px 16px;display:flex;gap:8px;align-items:center;box-shadow:var(--shadow-lg);z-index:30;flex-wrap:wrap;max-width:calc(100% - 24px)}
.selbar .btn{background:transparent;color:var(--bg);border-color:rgba(255,255,255,.25)}
@media (prefers-color-scheme: dark){.selbar .btn{border-color:rgba(0,0,0,.25)}}
.selbar .btn.pri{background:var(--accent);border-color:var(--accent);color:#fff}
.empty{padding:36px;text-align:center;color:var(--muted)}
.scrim{position:fixed;inset:0;background:var(--scrim);z-index:40}
.modal{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:41;width:min(620px,calc(100% - 32px));max-height:min(90vh,860px);display:flex;flex-direction:column;background:var(--bg);border-radius:14px;box-shadow:var(--shadow-lg);overflow:hidden}
.modal.wide{width:min(1100px,calc(100% - 32px))}
.m-h{padding:14px 18px;background:var(--surface);border-bottom:1px solid var(--line);display:flex;gap:12px;align-items:center}
.m-h h2{font-size:16px;font-weight:600;color:var(--ink);margin:0;flex:1}
.m-b{padding:16px 18px;overflow:auto;display:grid;gap:12px}
.m-f{padding:12px 18px;background:var(--surface);border-top:1px solid var(--line);display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;align-items:center}
.f label{display:block;font-size:12px;font-weight:500;color:var(--muted);margin-bottom:5px}
.f input,.f select,.f textarea{width:100%;border:1px solid var(--line);background:var(--surface);border-radius:9px;padding:8px 10px;font-size:13.5px}
.f textarea{min-height:110px;resize:vertical;font-family:inherit}
.note{font-size:12.5px;color:var(--muted)}
.err-box{background:var(--red-bg);color:var(--red);border-radius:10px;padding:10px 12px;font-size:13px}
.ok-box{background:var(--green-bg);color:var(--green);border-radius:10px;padding:10px 12px;font-size:13px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.be-row{display:grid;grid-template-columns:40px 190px minmax(0,1fr);gap:10px;align-items:center;padding:8px 0;border-bottom:1px solid var(--line-2)}
.be-row:last-child{border-bottom:0}
.be-row .lbl{font-size:13px;font-weight:500;color:var(--ink)}
.be-row.dis .ctl{opacity:.4;pointer-events:none}
.ctl{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.ctl select,.ctl input[type=number],.ctl input[type=text]{border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:6px 8px;font-size:13px}
.ctl input[type=number]{width:110px}
.hgrid{display:grid;grid-template-columns:repeat(6,1fr);gap:4px}
.dgrid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.hgrid label,.dgrid label{display:flex;align-items:center;justify-content:center;border:1px solid var(--line);border-radius:8px;padding:5px 0;font-size:12px;cursor:pointer;background:var(--surface);user-select:none}
.hgrid input,.dgrid input{display:none}
.hgrid label.on,.dgrid label.on{background:var(--accent);border-color:var(--accent);color:#fff}
.pop{position:fixed;z-index:45;background:var(--surface);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow-lg);padding:12px;width:min(340px,calc(100% - 24px));display:grid;gap:10px}
.pop .q{display:flex;gap:6px;flex-wrap:wrap}
.tip{position:fixed;z-index:60;background:var(--ink);color:var(--bg);font-size:12px;padding:6px 10px;border-radius:8px;max-width:320px;pointer-events:none;box-shadow:var(--shadow-lg)}
.toast{position:fixed;left:50%;bottom:calc(76px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:12px;font-size:13px;box-shadow:var(--shadow-lg);z-index:70;max-width:min(560px,calc(100% - 32px))}
.gate{min-height:100vh;display:grid;place-items:center;padding:16px}
.gate .card{padding:22px;width:min(360px,100%);display:grid;gap:12px}
.det-in{padding:14px 16px 18px;display:grid;gap:14px;position:sticky;left:0;width:min(1560px,calc(100vw - 42px))}
.full .det-in{width:calc(100vw - 4px)}
.det-top{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.det-k{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.det-k .box{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:10px 12px}
.det-k h4{margin:0 0 6px;font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}
.det-k .ln{display:flex;justify-content:space-between;gap:8px;font-size:12.5px}
.det-k .ln b{color:var(--ink);font-variant-numeric:tabular-nums}
.chart{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:10px 12px}
.chart svg{display:block;width:100%;height:220px}
.legend{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:6px}
.legend label{display:inline-flex;gap:5px;align-items:center;font-size:12px;border:1px solid var(--line);border-radius:999px;padding:2px 9px;cursor:pointer}
.legend i{width:9px;height:9px;border-radius:50%;display:inline-block}
.legend input{display:none}
.legend label.offl{opacity:.4}
.tod{display:grid;grid-template-columns:repeat(24,1fr);gap:2px;align-items:end;height:80px}
.tod div{background:var(--accent);border-radius:3px 3px 0 0;min-height:1px;opacity:.85}
.tod-l{display:grid;grid-template-columns:repeat(24,1fr);gap:2px;font-size:9.5px;color:var(--muted);text-align:center}
.notes{display:grid;gap:6px}
.notes .n{display:flex;gap:10px;font-size:12.5px;align-items:baseline}
.notes .n time{color:var(--muted);white-space:nowrap;font-variant-numeric:tabular-nums}
.scale{font-size:12px;border-collapse:collapse;width:auto}
.scale td,.scale th{padding:3px 10px;border-bottom:1px solid var(--line-2);position:static;background:transparent}
.scale tr.cur td{color:var(--accent);font-weight:600}
.groups{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px;padding:14px}
.gcard{border:1px solid var(--line);border-radius:12px;padding:12px 14px;display:grid;gap:8px;background:var(--surface);cursor:pointer}
.gcard:hover{border-color:var(--faint)}
.gcard .gn{font-weight:600;color:var(--ink);display:flex;gap:8px;align-items:center}
.gcard .gs{display:flex;gap:14px;font-size:12px;color:var(--muted)}
.gcard .gs b{color:var(--ink)}
.colrow{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--line-2);font-size:13px}
.colrow .sp{flex:1}
.ico{width:28px;height:28px;display:grid;place-items:center;border:1px solid var(--line);background:var(--surface);border-radius:8px;cursor:pointer;color:var(--muted);padding:0}
.ico:hover{color:var(--ink)}
.full{position:fixed;inset:0;z-index:35;border-radius:0;overflow:auto}
.help h3{margin:6px 0 2px;font-size:14px;color:var(--ink)}
.help p,.help li{font-size:13px;margin:4px 0}
@media (max-width:900px){.kpis{grid-template-columns:minmax(0,1fr)}}
@media (max-width:640px){.wrap{padding:14px 16px 90px}.be-row{grid-template-columns:36px minmax(0,1fr)}.be-row .ctl{grid-column:1/-1}.grid2{grid-template-columns:minmax(0,1fr)}}
</style>
</head>
<body>

<div class="gate" id="gate" hidden>
  <form class="card" id="gateForm">
    <div class="f"><label for="gatePw">Пароль дашборда</label><input id="gatePw" type="password" autocomplete="current-password"></div>
    <div class="note" id="gateErr"></div>
    <button class="btn pri" type="submit">Войти</button>
  </form>
</div>

<div class="wrap" id="app" hidden>
  <div class="bar">
    <h1>Ручное управление ставками</h1>
    <button class="btn sm" type="button" id="helpBtn">Инструкция</button>
    <span class="sp"></span>
    <nav class="nav" aria-label="Разделы Авито"><a href="/avito-feeds">Автозагрузка</a><a class="cur" href="/avito-bids" aria-current="page">Ставки</a></nav>
  </div>

  <div class="card sum" id="sum"></div>

  <div class="bar">
    <div class="seg" role="tablist"><button type="button" class="on" data-tab="all" role="tab">Все объявления</button><button type="button" data-tab="groups" role="tab">Группы объявлений</button></div>
    <span id="groupHead" hidden></span>
  </div>

  <div class="kpis" id="kpis"></div>

  <div class="card" id="tableCard">
    <div class="tools">
      <input class="search" id="q" type="search" placeholder="Поиск по объявлениям (заголовок, номер объявления, город)">
      <button class="btn" type="button" id="filtersBtn">Фильтры ▾</button>
      <button class="btn" type="button" id="colsBtn">Столбцы</button>
      <button class="btn" type="button" id="fullBtn" title="Во весь экран" aria-label="Во весь экран">⛶</button>
      <button class="btn" type="button" id="refreshBtn" title="Перечитать ставки из Авито для видимых объявлений">Обновить из Авито</button>
      <button class="btn pri" type="button" id="addBtn">Добавить объявления</button>
    </div>
    <div class="per">
      <span>Период статистики объявлений:</span>
      <select id="period"><option value="today">Сегодня</option><option value="yesterday">Вчера</option><option value="7">7 дней</option><option value="30">30 дней</option><option value="custom">Свой период</option></select>
      <span id="customPer" hidden><input type="date" id="pFrom"> — <input type="date" id="pTo"></span>
      <span class="sub" id="statInfo"></span>
      <span class="sp"></span>
      <div class="chips" id="chips"></div>
    </div>
    <div class="tbl-wrap"><table><thead id="thead"></thead><tbody id="rows"><tr><td class="empty">Загрузка…</td></tr></tbody></table></div>
  </div>

  <div class="card" id="groupsCard" hidden>
    <div class="tools">
      <span class="note" id="gInfo"></span><span class="sp"></span>
      <button class="btn danger" type="button" id="gDelSel" hidden>Удалить выбранные группы</button>
      <button class="btn pri" type="button" id="gCreate">Создать группу</button>
    </div>
    <div id="groupsBody"></div>
  </div>
</div>

<div class="selbar" id="selbar" hidden></div>
<div class="scrim" id="scrim" hidden></div>
<div class="tip" id="tip" hidden></div>
<div class="pop" id="pop" hidden></div>
<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>

<!-- добавить объявления -->
<div class="modal wide" id="mAdd" role="dialog" aria-modal="true" aria-labelledby="aTitle" hidden>
  <div class="m-h"><h2 id="aTitle">Добавить объявления</h2><button class="btn" type="button" data-close>Закрыть</button></div>
  <div class="m-b">
    <div class="seg"><button type="button" class="on" data-atab="filter">Отобрать по фильтрам и поиску</button><button type="button" data-atab="list">Добавить списком</button></div>
    <div class="grid2">
      <div class="f"><label for="aAcc">Аккаунт Авито</label><select id="aAcc"></select></div>
      <div class="f" id="aCityWrap"><label for="aCity">Город</label><select id="aCity"><option value="">Все города</option></select></div>
    </div>
    <div id="aFilter">
      <input class="search" id="aQ" type="search" placeholder="Поиск по заголовку, номеру объявления или городу" style="width:100%">
    </div>
    <div id="aList" hidden>
      <div class="f"><label for="aIds">Внесите номера объявлений списком</label><textarea id="aIds" placeholder="Номера через пробел, запятую, точку с запятой или с новой строки"></textarea></div>
      <button class="btn" type="button" id="aFind">Найти</button>
    </div>
    <div class="note" id="aInfo"></div>
    <div class="tbl-wrap" style="max-height:46vh;border:1px solid var(--line);border-radius:10px;background:var(--surface)"><table><thead><tr><th style="width:34px"><input type="checkbox" class="cb" id="aAll" aria-label="Выбрать все"></th><th>Объявление</th><th>Город</th><th class="r">Цена</th><th>Аккаунт</th></tr></thead><tbody id="aRows"></tbody></table></div>
  </div>
