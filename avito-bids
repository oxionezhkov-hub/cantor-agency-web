  const build = () => {
    const set = {};
    const on = (id) => $(`[data-ben="${id}"]`).checked;
    if (on('on')) set.on = $('#bv_on').checked;
    if (on('bid')) {
      if ($('#bv_bidmin').checked) set.bid = { min: true };
      else { const v = $('#bv_bid').value.trim(); if (!/^\d+$/.test(v)) throw new Error('Ставка — целое число рублей'); set.bid = { op: $('#bo_bid').value, value: Number(v) }; }
    }
    const lim = {};
    LIMS.forEach(([k]) => {
      if (!on(`lim_${k}`)) return;
      const v = $(`#bv_lim_${k}`).value.trim().replace(',', '.');
      if (v !== '' && !(Number(v) >= 0)) throw new Error('Лимиты — неотрицательные числа');
      lim[k] = v === '' ? null : { op: $(`#bo_lim_${k}`).value, value: Number(v) };
    });
    if (Object.keys(lim).length) set.lim = lim;
    if (on('hours')) set.hours = sch.hours;
    if (on('days')) set.days = sch.days;
    return set;
  };
  const opText = (o) => o.min ? 'минимальная для продвижения' : `${{ set: '=', add: '+', sub: '−' }[o.op]} ${o.value}`;
  $('#bCheck').onclick = () => {
    err('');
    let set; try { set = build(); } catch (ex) { return err(ex.message); }
    const lines = [];
    if (set.on !== undefined) lines.push(`Вкл / выкл → ${set.on ? 'включить' : 'выключить'}`);
    if (set.bid) {
      lines.push(`Ставка: ${opText(set.bid)}`);
      const bad = [...sel].map((k) => B.items.find((i) => i.key === k)).filter(Boolean).filter((x) => {
        if (set.bid.min) return x.minPromo == null;
        const nv = set.bid.op === 'add' ? (x.bid || 0) + set.bid.value : set.bid.op === 'sub' ? (x.bid || 0) - set.bid.value : set.bid.value;
        return x.minPromo != null && (nv < x.minPromo || nv > x.max);
      });
      if (bad.length) lines.push(`⚠ У ${bad.length} объявл. ставка выйдет за диапазон Авито — у них будет «Ошибка»`);
    }
    if (set.lim) Object.entries(set.lim).forEach(([k, v]) => lines.push(`${LIMS.find((l) => l[0] === k)[1]}: ${v === null ? 'снять ограничение' : opText(v)}`));
    if (set.hours) lines.push(`Часы: ${hoursText(set.hours.length === 24 ? null : set.hours)}`);
    if (set.days) lines.push(`Дни: ${daysText(set.days.length === 7 ? null : set.days)}`);
    if ($('#bNote').value.trim()) lines.push(`Заметка: ${$('#bNote').value.trim()}`);
    $('#bPreview').innerHTML = lines.length ? `<div class="ok-box">Изменится у ${sel.size} объявл.:<ul style="margin:6px 0 0 18px">${lines.map((l) => `<li>${esc(l)}</li>`).join('')}</ul></div>` : '<div class="note">Не включено ни одной настройки.</div>';
    $('#bPreview').classList.remove('hide');
  };
  $('#bApply').onclick = async () => {
    err('');
    let set; try { set = build(); } catch (ex) { return err(ex.message); }
    const note = $('#bNote').value.trim();
    if (!Object.keys(set).length && !note) return err('Включите левый переключатель у настройки, которую нужно изменить');
    $('#bApply').disabled = true;
    const r = await update([...sel], set, note);
    if ($('#bApply')) $('#bApply').disabled = false;
    if (!r) return;
    closeModal();
    toast(`Изменено: ${r.changed}${r.skipped && r.skipped.length ? `, пропущено: ${r.skipped.length} (${r.skipped[0].reason})` : ''}`);
    bidsLoad();
  };
}

