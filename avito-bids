/* ── Ошибки: группируем одинаковые, показываем где ── */
// [{ msg, where }] → карточки «текст ошибки · N раз» со списком мест.
function probGroups(items) {
  const g = new Map();
  for (const it of items) {
    const key = it.msg.replace(/«[^»]*»|\d{3,}|https?:\/\/\S+|:\s.*$/g, '…').slice(0, 140);
    if (!g.has(key)) g.set(key, { msg: it.msg, kind: it.kind, items: [] });
    g.get(key).items.push(it);
  }
  // Если тексты в группе разные («…фото: A_01.png», «…фото: A_02.png») — общий заголовок, детали — в метках.
  return [...g.values()].map((x) => {
    const same = x.items.every((it) => it.msg === x.msg);
    const m = !same && x.msg.match(/^([^:]{6,}):\s(.+)$/);
    return { kind: x.kind, msg: m ? m[1] : x.msg, where: x.items.map((it) => { const d = m && it.msg.slice(m[1].length + 1).trim(); return [it.where, d && esc(d.slice(0, 60))].filter(Boolean).join(' · '); }) };
  }).sort((a, b) => b.where.length - a.where.length);
}
function probCards(groups) {
  return groups.map((g) => `<div class="pcard ${g.kind || 'warn'}"><div class="pc-h"><span class="pc-ic">${I(g.kind === 'err' ? 'x' : 'info', 'ic-sm')}</span><div class="pc-t">${esc(g.msg)}</div>${g.where.length > 1 ? `<span class="chip">${g.where.length}</span>` : ''}</div>
    ${g.where.filter(Boolean).length ? `<div class="pc-w">${g.where.filter(Boolean).slice(0, 40).map((w) => `<span class="pill">${w}</span>`).join('')}${g.where.length > 40 ? `<span class="pill muted">ещё ${g.where.length - 40}</span>` : ''}</div>` : ''}</div>`).join('');
}
function feedProbs(slug) {
  const f = feedBy(slug), s = f.stat || {};
  const items = [];
  if (s.error) items.push({ kind: 'err', msg: s.error, where: '' });
  if (s.s3Error) items.push({ kind: 'err', msg: 'XML не выложен в Yandex Object Storage: ' + s.s3Error, where: '' });
  (s.tabs || []).filter((t) => t.error).forEach((t) => items.push({ kind: 'err', msg: t.error, where: esc(`вкладка «${t.name}»`) }));
  const multi = [];
  (s.problems || []).forEach((p) => {
    if (p.ids && p.ids.length > 1) { multi.push({ kind: 'warn', msg: p.msg, where: p.ids.map((id) => `<b>${esc(id)}</b>`) }); return; }
    items.push({ kind: 'warn', msg: p.msg, where: [p.row && `стр. ${p.row}`, p.id && `<b>${esc(p.id)}</b>`].filter(Boolean).join(' · ') });
  });
  const groups = multi.concat(probGroups(items));
  const tagRu = { SubjectOrSpecialty: 'Предмет', ServiceSubtype: 'Тип услуги', WorkExperience: 'Опыт работы', TargetAudience: 'Целевая аудитория', WorkTimeFrom: 'Время работы, с', WorkTimeTo: 'Время работы, до', Images: 'Фото', Teacher: 'Преподаватель', Format: 'Формат', Place: 'Место', Level: 'Уровень', Classes: 'Занятия', ForWhom: 'Для кого' };
  const fixCard = (x) => `<div class="pcard fix"><div class="pc-h"><span class="pc-ic">${I('check', 'ic-sm')}</span><div class="pc-t"><b>${esc(tagRu[x.tag] || x.tag)}</b>: «${esc(x.from)}» → «${esc(x.to)}»</div><span class="chip">${int(x.n)}</span></div>`
    + `<div class="pc-w">${x.ids.slice(0, 20).map((id) => `<span class="pill"><b>${esc(id)}</b></span>`).join('')}${x.n > 20 ? `<span class="pill">ещё ${int(x.n - 20)}</span>` : ''}</div></div>`;
  const fixes = (s.fixes || []).map(fixCard).join('');
  openModal(`${mHead('Ошибки XML — ' + f.name)}<div class="m-b">
    <div class="psum">${items.length ? `<div><div class="big ${items.some((x) => x.kind === 'err') ? 'red' : 'amber'}">${items.length}</div><div class="note">${items.some((x) => x.kind === 'err') ? 'XML не собран — исправьте таблицу' : 'строк с замечаниями — эти строки или фото не попали в XML'}</div></div>` : '<div class="ok-box">Ошибок нет</div>'}
      ${s.builtAt ? `<div class="note">Сборка ${esc(ago(Date.parse(s.builtAt)))} · в XML ${int(s.ads)} объявлений</div>` : ''}</div>
    ${probCards(groups)}
    ${fixes ? `<h3 class="ph2">Исправлено автоматически — Авито не принимает эти значения</h3><div class="note">Сервис сверил таблицу со справочником Авито и в XML поставил правильные значения. Таблица не меняется — поправьте её так же, чтобы не путаться (номера — id объявлений).</div>${fixes}` : ''}
    <div class="note">Это ошибки сборки XML из Google Таблицы. Что Авито сделал с объявлениями — в «Отчёт Авито».</div></div>`, { wide: true });
}

