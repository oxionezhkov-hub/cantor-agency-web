<script>
const ADMIN_STORAGE_KEY = 'salescrm_admin_ok';
// Client-side gate only (same convention as /avito-export and /serp-analysis) — not a real
// auth boundary, just keeps the tool out of casual view.
const ADMIN_PASSWORD = '12345678';
// This page can be reached both from cantor.agency (plain nginx, no API) and from the
// Worker's own host — always call the Worker's own host directly (same pattern as
// mba-mybrand/serp-analysis/avito-export's API_BASE), relying on its permissive CORS.
const API_BASE = 'https://mainweb.oxion-ezhkov.workers.dev';

const STATUSES = ['Первое сообщение','Вопросы','Формат','Оффер','Игнор','Отложенный спрос','Отказ','Продажа'];
const STATUS_BG = {
  'Первое сообщение':'#F1F5F9','Вопросы':'#FEF3C7','Формат':'#EDE9FE','Оффер':'#CFFAFE',
  'Игнор':'#FFE4E6','Отложенный спрос':'#FDE9D9','Отказ':'#FEE2E2','Продажа':'#DCFCE7',
};
const STATUS_FG = {
  'Первое сообщение':'#64748B','Вопросы':'#D97706','Формат':'#7C3AED','Оффер':'#0891B2',
  'Игнор':'#E11D48','Отложенный спрос':'#92400E','Отказ':'#DC2626','Продажа':'#16A34A',
};
const PRIORITIES = ['green','yellow','orange','red'];
const PRIORITY_LABEL = { green:'Целевой', yellow:'Вероятный', orange:'Сомнительный', red:'Нецелевой' };
const PRIORITY_BG = { green:'var(--p-green-bg)', yellow:'var(--p-yellow-bg)', orange:'var(--p-orange-bg)', red:'var(--p-red-bg)' };
const PRIORITY_FG = { green:'var(--p-green)', yellow:'var(--p-yellow)', orange:'var(--p-orange)', red:'var(--p-red)' };

const GROUPS = ['РЕПБИЗ','ВЕБИНАР','НОВЫЕ'];
const GROUP_BG = { 'РЕПБИЗ':'#E3F2FD', 'ВЕБИНАР':'#F3E5F5', 'НОВЫЕ':'#E0F2F1' };
const GROUP_FG = { 'РЕПБИЗ':'#1565C0', 'ВЕБИНАР':'#7B1FA2', 'НОВЫЕ':'#00695C' };

const STALE_WARN_DAYS = 3;
const STALE_DANGER_DAYS = 7;

const TELEGRAM_ICON_SVG = '<svg viewBox="0 0 16 16" width="20" height="20" fill="#29A9EB"><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8.287 5.906c-.778.324-2.334.994-4.666 1.962-.378.15-.577.298-.595.442-.03.243.275.339.69.47l.175.055c.408.133.958.288 1.243.294.26.006.549-.1.868-.32 2.179-1.471 3.304-2.214 3.374-2.23.05-.012.12-.026.166.016.047.041.042.12.037.141-.03.129-1.227 1.241-1.846 1.817-.193.18-.33.307-.358.336a8.154 8.154 0 0 1-.188.186c-.38.366-.664.64.015 1.088.327.216.589.393.85.571.284.194.568.387.936.629.093.06.183.125.27.187.331.236.63.448.997.414.214-.02.435-.22.547-.82.265-1.417.786-4.486.906-5.751a1.426 1.426 0 0 0-.013-.315.337.337 0 0 0-.114-.217.526.526 0 0 0-.31-.093c-.3.005-.763.166-2.984 1.09z"/></svg>';

let clients = [];
let viewMode = 'table'; // 'table' | 'cards'
// Each filter dimension accepts any number of selected values now (checkboxes) — an empty set
// means "no filter" for that dimension, matching everything.
const filterValues = { group: new Set(), priority: new Set(), status: new Set() };

async function api(path, opts) {
  const res = await fetch(API_BASE + path, {
    headers: { 'Content-Type': 'application/json' },
    ...opts,
  });
  if (!res.ok) {
    const body = await res.json().catch(() => ({}));
    throw new Error(body.message || body.error || ('http_' + res.status));
  }
  return res.json();
}

function escapeHtml(v) {
  return String(v == null ? '' : v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function fmtDateTime(iso) {
  if (!iso) return '';
  const d = new Date(iso);
  return d.toLocaleDateString('ru-RU', { day:'2-digit', month:'2-digit', year:'2-digit' }) + ' ' + d.toLocaleTimeString('ru-RU', { hour:'2-digit', minute:'2-digit' });
}
// tg:// hands off straight to the Telegram desktop app without ever opening a browser tab —
// unlike a https://t.me/... link, which leaves a tab behind that has to be closed or switched
// back from. Falls back to doing nothing if no app is registered for the tg: scheme.
function openTelegram(username) {
  if (!username) return;
  window.location.href = 'tg://resolve?domain=' + encodeURIComponent(username);
}
function daysSince(iso) {
  return (Date.now() - new Date(iso).getTime()) / 86400000;
}
let toastTimer = null;
function showToast(text) {
  const toast = document.getElementById('toast');
  toast.textContent = text;
  toast.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove('show'), 2600);
}

/* ════════════ GATE ════════════ */
function isAdminUnlocked() { return localStorage.getItem(ADMIN_STORAGE_KEY) === '1'; }
function logout() {
  localStorage.removeItem(ADMIN_STORAGE_KEY);
  document.getElementById('app').classList.add('hidden');
  document.getElementById('adminGate').classList.remove('hidden');
}
document.getElementById('gateForm').addEventListener('submit', (e) => {
  e.preventDefault();
  const input = document.getElementById('gatePassword');
  const err = document.getElementById('gateError');
  if (input.value === ADMIN_PASSWORD) {
    localStorage.setItem(ADMIN_STORAGE_KEY, '1');
    input.value = '';
    err.classList.remove('show');
    boot();
  } else {
    err.classList.add('show');
  }
});
if (isAdminUnlocked()) boot();

async function boot() {
  document.getElementById('adminGate').classList.add('hidden');
  document.getElementById('app').classList.remove('hidden');
  renderFilterDropdowns();
  await loadClients();
}

/* ════════════ DATA ════════════ */
async function loadClients() {
  try {
    const data = await api('/api/salescrm/clients');
    clients = data.clients || [];
    renderTable();
  } catch (err) {
    showToast('Ошибка загрузки: ' + err.message);
  }
}

async function addClient() {
  try {
    const client = (await api('/api/salescrm/clients', {
      method: 'POST',
      body: JSON.stringify({ name: 'Новый клиент' }),
    })).client;
    clients.push(client);
    renderTable();
    showToast('Клиент добавлен');
    requestAnimationFrame(() => {
      const input = document.querySelector(`[data-id="${client.id}"] .name-input`);
      if (input) { input.focus(); input.select(); }
    });
  } catch (err) {
    showToast('Ошибка: ' + err.message);
  }
}

// Edits on the same row can fire close together (e.g. blurring a comment textarea by
// clicking straight into that row's status dropdown) — two concurrent PATCH requests for the
// same client would each read-modify-write from their own stale snapshot, so whichever
// request's write lands last could silently wipe out the other's change. Chaining every patch
// for a given id onto the same promise makes them run one at a time instead.
const patchQueue = new Map();
function patchClient(id, field, value) {
  const prior = patchQueue.get(id) || Promise.resolve();
  const run = prior.then(async () => {
    try {
      const client = (await api(`/api/salescrm/clients/${id}`, {
        method: 'PATCH',
        body: JSON.stringify({ [field]: value }),
      })).client;
      const idx = clients.findIndex((c) => c.id === id);
      if (idx !== -1) clients[idx] = client;
      return client;
    } catch (err) {
      showToast('Не удалось сохранить: ' + err.message);
      return null;
    }
  });
  patchQueue.set(id, run.catch(() => {}));
  return run;
}

/* ════════════ DROPDOWNS (group / priority / status — hover-open, colored options) ════════════ */
// Menus open downward by default; for a trigger near the bottom of the viewport (the last
// rows of the table) that would push the menu off-screen, so flip it to open upward instead.
// Recomputed on every hover/focus since rows are re-rendered (fresh nodes) after each edit.
function positionDropdownMenu(dd) {
  const trigger = dd.querySelector('.dd-trigger, .dd-trigger-compact');
  const menu = dd.querySelector('.dd-menu');
  if (!trigger || !menu) return;
  const triggerRect = trigger.getBoundingClientRect();
  const spaceBelow = window.innerHeight - triggerRect.bottom;
  const spaceAbove = triggerRect.top;
  const flipUp = spaceBelow < menu.offsetHeight + 14 && spaceAbove > spaceBelow;
  // Flush against the trigger (no gap): since the menu is fixed-position, it no longer
  // contributes to .dd's own layout box, so any gap here would be a dead zone where the
  // pointer briefly leaves .dd while moving from the trigger into the menu — breaking the
  // hover chain the same way a visible gap did before this was fixed-position.
  if (flipUp) {
    menu.style.top = 'auto';
    menu.style.bottom = (window.innerHeight - triggerRect.top) + 'px';
  } else {
    menu.style.bottom = 'auto';
    menu.style.top = triggerRect.bottom + 'px';
  }
  const maxLeft = window.innerWidth - menu.offsetWidth - 8;
  menu.style.left = Math.max(8, Math.min(triggerRect.left, maxLeft)) + 'px';
}
document.addEventListener('mouseover', (e) => {
  const dd = e.target.closest('.dd');
  if (dd) positionDropdownMenu(dd);
});
document.addEventListener('focusin', (e) => {
  const dd = e.target.closest('.dd');
  if (dd) positionDropdownMenu(dd);
});

function ddListFor(kind) {
  if (kind === 'priority') return { list: PRIORITIES, bg: PRIORITY_BG, fg: PRIORITY_FG, labelOf: (v) => PRIORITY_LABEL[v] };
  if (kind === 'group') return { list: GROUPS, bg: GROUP_BG, fg: GROUP_FG, labelOf: (v) => v };
  return { list: STATUSES, bg: STATUS_BG, fg: STATUS_FG, labelOf: (v) => v };
}
function ddOptionHtml(fg, label, onclick) {
  return `<div class="dd-option" onclick="${onclick}"><span class="dot" style="background:${fg}"></span>${escapeHtml(label)}</div>`;
}
function ddTriggerHtml(bg, fg, label, showDot) {
  return `<button type="button" class="dd-trigger" style="background:${bg};color:${fg}">
    ${showDot ? `<span class="dot" style="background:${fg}"></span>` : ''}
    <span class="dd-label">${escapeHtml(label)}</span>
    <svg class="chev" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
  </button>`;
}
function ddTriggerCompactHtml(bg, fg, label) {
  const letter = String(label || '?').trim().charAt(0).toUpperCase();
  return `<button type="button" class="dd-trigger-compact" style="background:${bg};color:${fg}" title="${escapeHtml(label)}">${escapeHtml(letter)}</button>`;
}
function rowDropdownHtml(kind, clientId, currentValue, compact) {
  const { list, bg, fg, labelOf } = ddListFor(kind);
  const options = list.map((v) => ddOptionHtml(fg[v], labelOf(v), `selectRowValue('${clientId}','${kind}','${v}')`)).join('');
  const trigger = compact
    ? ddTriggerCompactHtml(bg[currentValue], fg[currentValue], labelOf(currentValue))
    : ddTriggerHtml(bg[currentValue], fg[currentValue], labelOf(currentValue), true);
  return `<div class="dd">${trigger}<div class="dd-menu">${options}</div></div>`;
}
function filterChecksHtml(kind) {
  const { list, fg, labelOf } = ddListFor(kind);
  const selected = filterValues[kind];
  return list.map((v) => `
    <label class="filter-check${selected.has(v) ? ' checked' : ''}">
      <input type="checkbox" ${selected.has(v) ? 'checked' : ''} onchange="toggleFilterValue('${kind}','${v}')">
      <span class="dot" style="background:${fg[v]}"></span>${escapeHtml(labelOf(v))}
    </label>
  `).join('');
}
function renderFilterDropdowns() {
  document.getElementById('filterGroupCell').innerHTML = filterChecksHtml('group');
  document.getElementById('filterPriorityCell').innerHTML = filterChecksHtml('priority');
  document.getElementById('filterStatusCell').innerHTML = filterChecksHtml('status');
  const active = filterValues.group.size || filterValues.priority.size || filterValues.status.size;
  document.getElementById('filterDot').classList.toggle('show', Boolean(active));
}
function toggleFilterValue(kind, value) {
  const set = filterValues[kind];
  if (set.has(value)) set.delete(value); else set.add(value);
  renderFilterDropdowns();
  renderTable();
}
function resetFilters() {
  filterValues.group.clear();
  filterValues.priority.clear();
  filterValues.status.clear();
  renderFilterDropdowns();
  renderTable();
}
async function selectRowValue(id, field, value) {
  const updated = await patchClient(id, field, value);
  if (updated) renderTable();
}

/* ════════════ TABLE RENDER ════════════ */
function staleClassFor(c) {
  const age = daysSince(c.updatedAt);
  return age >= STALE_DANGER_DAYS ? 'stale-danger' : age >= STALE_WARN_DAYS ? 'stale-warn' : '';
}
function tgFieldHtml(c) {
  const tgUsername = (c.telegram || '').replace(/^@/, '').replace(/^https?:\/\/t\.me\//i, '');
  const tgLinkSafe = tgUsername.replace(/[^A-Za-z0-9_]/g, '');
  return `
    <div class="tg-cell">
      <button class="btn-tg-icon" ${tgLinkSafe ? '' : 'disabled'} onclick="openTelegram('${tgLinkSafe}')" title="Открыть диалог в Telegram">${TELEGRAM_ICON_SVG}</button>
      <input class="cell-input" placeholder="username" value="${escapeHtml(tgUsername)}"
        onblur="onFieldBlur('${c.id}','telegram',this.value)"
        onkeydown="if(event.key==='Enter') this.blur()">
    </div>
  `;
}
function rowHtml(c) {
  return `
    <tr data-id="${c.id}" class="${staleClassFor(c)}">
      <td class="col-name">
        <input class="cell-input name-input" value="${escapeHtml(c.name)}"
          onblur="onFieldBlur('${c.id}','name',this.value)"
          onkeydown="if(event.key==='Enter') this.blur()">
      </td>
      <td class="col-tg">${tgFieldHtml(c)}</td>
      <td class="col-priority">${rowDropdownHtml('priority', c.id, c.priority)}</td>
      <td class="col-status">${rowDropdownHtml('status', c.id, c.status)}</td>
      <td class="col-comment">
        <textarea class="cell-input" rows="1" placeholder="Комментарий…"
          oninput="autoGrow(this)"
          onblur="onFieldBlur('${c.id}','comment',this.value)">${escapeHtml(c.comment)}</textarea>
      </td>
    </tr>
  `;
}
function cardHtml(c) {
  return `
    <div class="lead-card ${staleClassFor(c)}" data-id="${c.id}">
      <div class="lead-card-head">
        <input class="cell-input name-input" value="${escapeHtml(c.name)}"
          onblur="onFieldBlur('${c.id}','name',this.value)"
          onkeydown="if(event.key==='Enter') this.blur()">
        <span class="group-badge" style="background:${GROUP_BG[c.group]};color:${GROUP_FG[c.group]}">${escapeHtml(c.group)}</span>
      </div>
      ${tgFieldHtml(c)}
      <div class="lead-card-dd">
        ${rowDropdownHtml('priority', c.id, c.priority)}
        ${rowDropdownHtml('status', c.id, c.status)}
      </div>
      <textarea class="cell-input" rows="1" placeholder="Комментарий…"
        oninput="autoGrow(this)"
        onblur="onFieldBlur('${c.id}','comment',this.value)">${escapeHtml(c.comment)}</textarea>
    </div>
  `;
}

function toggleView() {
  viewMode = viewMode === 'table' ? 'cards' : 'table';
  const btn = document.getElementById('viewToggleBtn');
  btn.title = viewMode === 'table' ? 'Показать карточками' : 'Показать таблицей';
  btn.innerHTML = viewMode === 'table'
    ? '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg>'
    : '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>';
  renderTable();
}

function renderTable() {
  // Row order is fixed at load time (oldest-updated first) and never re-sorted on edit — an
  // in-place edit only updates that row's own cells, so the table doesn't jump around under
  // the pointer mid-interaction. Reload the page (or re-open the tool) to re-sort by the
  // latest updatedAt.
  const q = (document.getElementById('searchInput').value || '').trim().toLowerCase();
  const rows = clients.filter((c) => {
    if (filterValues.group.size && !filterValues.group.has(c.group)) return false;
    if (filterValues.priority.size && !filterValues.priority.has(c.priority)) return false;
    if (filterValues.status.size && !filterValues.status.has(c.status)) return false;
    if (!q) return true;
    return [c.name, c.telegram, c.comment].some((v) => String(v || '').toLowerCase().includes(q));
  });

  document.getElementById('emptyState').classList.toggle('hidden', clients.length > 0);

  const table = document.querySelector('.wrap table');
  const cardsGrid = document.getElementById('cardsGrid');
  if (viewMode === 'cards') {
    table.classList.add('hidden');
    cardsGrid.classList.remove('hidden');
    cardsGrid.innerHTML = rows.map(cardHtml).join('');
    cardsGrid.querySelectorAll('textarea.cell-input').forEach(autoGrow);
  } else {
    cardsGrid.classList.add('hidden');
    table.classList.remove('hidden');
    const tbody = document.getElementById('tableBody');
    tbody.innerHTML = rows.map(rowHtml).join('');
    tbody.querySelectorAll('textarea.cell-input').forEach(autoGrow);
  }
}

// Comment textareas size to their content instead of a fixed row count, so a long note is
// always fully visible without the user having to drag-resize it.
function autoGrow(el) {
  el.style.height = 'auto';
  el.style.height = el.scrollHeight + 'px';
}

async function onFieldBlur(id, field, value) {
  const client = clients.find((c) => c.id === id);
  if (!client) return;
  const current = field === 'telegram' ? (client.telegram || '').replace(/^@/, '') : (client[field] || '');
  if (value === current) return;
  await patchClient(id, field, value);
  renderTable();
}
/* ════════════ STATS ════════════ */
function statBarRow(label, count, total, color) {
  const pct = total ? Math.round((count / total) * 100) : 0;
  return `
    <div class="bar-row">
      <div class="bar-row-label">${escapeHtml(label)}</div>
      <div class="bar-track"><div class="bar-fill" style="width:${pct}%;background:${color}"></div></div>
      <div class="bar-row-val">${count}</div>
    </div>`;
}

function openStats() {
  const total = clients.length;
  const stale = clients.filter((c) => daysSince(c.updatedAt) >= STALE_WARN_DAYS).length;
  const byStatus = {};
  STATUSES.forEach((s) => byStatus[s] = 0);
  clients.forEach((c) => { byStatus[c.status] = (byStatus[c.status] || 0) + 1; });
  const byPriority = {};
  PRIORITIES.forEach((p) => byPriority[p] = 0);
  clients.forEach((c) => { byPriority[c.priority] = (byPriority[c.priority] || 0) + 1; });
  const sales = byStatus['Продажа'] || 0;
  const conv = total ? Math.round((sales / total) * 100) : 0;

  const statusBars = STATUSES.map((s) => statBarRow(s, byStatus[s], total, STATUS_FG[s])).join('');
  const priorityBars = PRIORITIES.map((p) => statBarRow(PRIORITY_LABEL[p], byPriority[p], total, PRIORITY_FG[p])).join('');

  // A dense numeric table ("сколько из какой группы на каком статусе") is hard to scan at a
  // glance — a stacked bar per group (segment width = share of that group's own leads) shows
  // the same breakdown as a shape you can compare in one look, with exact counts on hover.
  const groupBars = GROUPS.map((g) => {
    const groupClients = clients.filter((c) => c.group === g);
    const gTotal = groupClients.length;
    const segments = STATUSES.map((s) => {
      const n = groupClients.filter((c) => c.status === s).length;
      if (!n) return '';
      const pct = gTotal ? (n / gTotal * 100) : 0;
      return `<div class="stack-seg" style="width:${pct}%;background:${STATUS_FG[s]}" title="${escapeHtml(s)}: ${n}"></div>`;
    }).join('');
    return `
      <div class="group-bar-row">
        <div class="group-bar-label" style="color:${GROUP_FG[g]}">${escapeHtml(g)} <span class="muted">— ${gTotal}</span></div>
        <div class="stack-track">${segments}</div>
      </div>`;
  }).join('');
  const statusLegend = STATUSES.map((s) => `<span class="legend-item"><span class="dot" style="background:${STATUS_FG[s]}"></span>${escapeHtml(s)}</span>`).join('');

  document.getElementById('statsBody').innerHTML = `
    <div class="kpi-row">
      <div class="kpi-card"><h3>Всего</h3><div class="stat-big">${total}</div></div>
      <div class="kpi-card"><h3>Внимание ${STALE_WARN_DAYS}+ дня</h3><div class="stat-big" style="color:var(--p-red)">${stale}</div></div>
      <div class="kpi-card"><h3>В продажу</h3><div class="stat-big">${conv}%</div><div style="font-size:11px;color:var(--muted)">${sales} из ${total}</div></div>
    </div>
    <div class="stat-card"><h3>По статусам</h3>${statusBars}</div>
    <div class="stat-card"><h3>По приоритету</h3>${priorityBars}</div>
    <div class="stat-card">
      <h3>Группа × статус</h3>
      ${groupBars}
      <div class="stat-legend">${statusLegend}</div>
    </div>
  `;
  document.getElementById('statsOverlay').classList.remove('hidden');
}
function closeStats() { document.getElementById('statsOverlay').classList.add('hidden'); }

/* ════════════ CSV EXPORT ════════════ */
function csvEscape(v) {
  const s = String(v == null ? '' : v);
  return /[",\n;]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
}
function downloadCsv(filename, rows) {
  const csv = '﻿' + rows.map((row) => row.map(csvEscape).join(';')).join('\r\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
}

function downloadClientsCsv() {
  const rows = [['Группа', 'Имя', 'Telegram', 'Приоритет', 'Статус', 'Комментарий', 'Создан', 'Обновлён']];
  clients.forEach((c) => {
    rows.push([
      c.group, c.name, c.telegram, PRIORITY_LABEL[c.priority] || c.priority, c.status, c.comment,
      fmtDateTime(c.createdAt), fmtDateTime(c.updatedAt),
    ]);
  });
  downloadCsv(`crm-klienty-${new Date().toISOString().slice(0,10)}.csv`, rows);
  showToast('Таблица скачана');
}

const HISTORY_ACTION_LABEL = { create: 'Создан', update: 'Изменение', delete: 'Удалён' };
const HISTORY_FIELD_LABEL = { name: 'Имя', telegram: 'Telegram', priority: 'Приоритет', status: 'Статус', group: 'Группа', comment: 'Комментарий' };
function historyValueLabel(field, v) {
  if (v == null) return '';
  if (field === 'priority') return PRIORITY_LABEL[v] || v;
  return v;
}

async function downloadHistoryCsv() {
  try {
    const data = await api('/api/salescrm/history');
    const history = data.history || [];
    const rows = [['Дата', 'Клиент', 'Действие', 'Поле', 'Было', 'Стало']];
    history.forEach((h) => {
      rows.push([
        fmtDateTime(h.ts), h.clientName, HISTORY_ACTION_LABEL[h.action] || h.action,
        HISTORY_FIELD_LABEL[h.field] || h.field || '', historyValueLabel(h.field, h.oldValue), historyValueLabel(h.field, h.newValue),
      ]);
    });
    downloadCsv(`crm-istoriya-${new Date().toISOString().slice(0,10)}.csv`, rows);
    showToast('История скачана');
  } catch (err) {
    showToast('Ошибка: ' + err.message);
  }
}

