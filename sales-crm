// Latest sign of life on a lead: a person/AI editing its row, or a Telegram message either way.
function lastActivityIso(c) {
  const msgAt = c.lastMessage && c.lastMessage.at ? new Date(c.lastMessage.at).toISOString() : '';
  return msgAt > (c.updatedAt || '') ? msgAt : c.updatedAt;
}
function staleClassFor(c) {
  const age = daysSince(lastActivityIso(c));
  return age >= STALE_DANGER_DAYS ? 'stale-danger' : age >= STALE_WARN_DAYS ? 'stale-warn' : '';
}
