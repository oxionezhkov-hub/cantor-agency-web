/* ════════════ DELETE ════════════ */
async function deleteClient(id) {
  const client = clients.find((c) => c.id === id);
  if (!client) return;
  if (!confirm(`Удалить «${client.name}» из CRM?` + (client.tgChatId ? '\nДиалог из Telegram больше не будет добавляться автоматически.' : ''))) return;
  try {
    await api(`/api/salescrm/clients/${id}`, { method: 'DELETE' });
    clients = clients.filter((c) => c.id !== id);
    if (chatState.clientId === id) closeChat();
    renderTable();
    showToast('Клиент удалён');
  } catch (err) {
    showToast('Ошибка: ' + err.message);
  }
}

/* ════════════ LIVE REFRESH ════════════ */
// Last messages / AI status changes arrive server-side (MyBrand → /api/salescrm/tg/sync), so
// re-pull the list every minute — but never while the user is mid-edit or hovering a dropdown
// (a re-render would drop their focus / close the menu). Keeps the existing row order.
const CLIENTS_REFRESH_MS = 60000;
async function refreshClients() {
  if (document.hidden) return;
  const active = document.activeElement;
  if (active && active.closest && active.closest('.wrap') && /^(INPUT|TEXTAREA)$/.test(active.tagName)) return;
  if (document.querySelector('.dd:hover')) return;
  try {
    const fresh = (await api('/api/salescrm/clients')).clients || [];
    const byId = new Map(fresh.map((c) => [c.id, c]));
    const next = clients.filter((c) => byId.has(c.id)).map((c) => byId.get(c.id));
    const known = new Set(next.map((c) => c.id));
    fresh.forEach((c) => { if (!known.has(c.id)) next.push(c); });
    clients = next;
    renderTable();
  } catch (err) { /* transient — next tick retries */ }
}

/* ════════════ TELEGRAM CHAT (via the MyBrand inbox bot) ════════════ */
// Chats live in the MyBrand worker (repo mybrand-smm), which receives the owner's personal
// Telegram through a Telegram Business bot. This page talks to its /message API directly with
// the same access code as the /message page, stored only in this browser — the CRM's own API
// stays unable to read chats or send messages as the owner.
const INBOX_API_BASE = 'https://tasktracker.oxion-ezhkov.workers.dev/message/api';
const INBOX_TOKEN_KEY = 'salescrm_inbox_token';
const CHAT_POLL_MS = 8000;
const CHAT_PAGE = 80;
const INBOX_TYPE_LABEL = {
  photo: '📷 Фото', document: '📎 Файл', voice: '🎤 Голосовое', audio: '🎵 Аудио', video: '🎬 Видео',
  video_note: '⭕ Видеосообщение', animation: '🎞️ GIF', sticker: '🖼️ Стикер', contact: '👤 Контакт',
  location: '📍 Локация', other: '📦 Сообщение',
};
const chatState = { clientId: null, chatId: null, messages: [], hasMore: false, timer: null, sending: false };

function inboxToken() { try { return localStorage.getItem(INBOX_TOKEN_KEY) || ''; } catch (e) { return ''; } }
async function inboxApi(path, opts = {}) {
  const res = await fetch(INBOX_API_BASE + path, {
    ...opts,
    headers: { Authorization: 'Bearer ' + inboxToken(), ...(opts.body ? { 'Content-Type': 'application/json' } : {}) },
  });
  const data = await res.json().catch(() => ({}));
  if (res.status === 401) { const e = new Error('Неверный код доступа MyBrand'); e.unauthorized = true; throw e; }
  if (!res.ok) throw new Error(data.error || ('http_' + res.status));
  return data;
}
function inboxMediaUrl(chatId, msgId) {
  return `${INBOX_API_BASE}/media/${encodeURIComponent(chatId)}/${encodeURIComponent(msgId)}?token=${encodeURIComponent(inboxToken())}`;
}

// Telegram message entities (UTF-16 offsets — same units as JS strings) → safe HTML. Entities
// may overlap without nesting, so a closing tag closes everything above it on the stack and
// re-opens whatever is still running.
function safeHref(url) {
  const u = String(url || '').trim();
  if (/^(https?:|tg:|mailto:|tel:)/i.test(u)) return u;
  if (/^[\w.-]+\.[a-z]{2,}(\/|$)/i.test(u)) return 'https://' + u;
  return '';
}
function entityTags(e, text) {
  const slice = text.slice(e.offset, e.offset + e.length);
  const link = (href) => href ? [`<a href="${escapeHtml(href)}" target="_blank" rel="noopener noreferrer">`, '</a>'] : ['', ''];
  switch (e.type) {
    case 'bold': return ['<b>', '</b>'];
    case 'italic': return ['<i>', '</i>'];
    case 'underline': return ['<u>', '</u>'];
    case 'strikethrough': return ['<s>', '</s>'];
    case 'spoiler': return ['<span class="tg-spoiler" onclick="this.classList.toggle(\'shown\')">', '</span>'];
    case 'code': return ['<code>', '</code>'];
    case 'pre': return ['<pre>', '</pre>'];
    case 'blockquote': case 'expandable_blockquote': return ['<blockquote>', '</blockquote>'];
    case 'text_link': return link(safeHref(e.url));
    case 'url': return link(safeHref(slice));
    case 'email': return link('mailto:' + slice);
    case 'phone_number': return link('tel:' + slice.replace(/[^\d+]/g, ''));
    case 'mention': return link('https://t.me/' + slice.replace(/^@/, ''));
    default: return ['', ''];
  }
}
function entitiesToHtml(text, entities) {
  text = String(text || '');
  const ents = (entities || []).filter((e) => e && e.length > 0 && e.offset >= 0 && e.offset < text.length);
  if (!ents.length) return escapeHtml(text);
  const cuts = new Set([0, text.length]);
  ents.forEach((e) => { cuts.add(e.offset); cuts.add(Math.min(text.length, e.offset + e.length)); });
  const points = [...cuts].sort((a, b) => a - b);
  let stack = [];
  let html = '';
  for (let i = 0; i < points.length - 1; i++) {
    const pos = points[i];
    const endingIdx = stack.findIndex((s) => s.e.offset + s.e.length <= pos);
    if (endingIdx !== -1) {
      for (let j = stack.length - 1; j >= endingIdx; j--) html += stack[j].tags[1];
      const reopen = stack.slice(endingIdx).filter((s) => s.e.offset + s.e.length > pos);
      stack = stack.slice(0, endingIdx);
      reopen.forEach((s) => { html += s.tags[0]; stack.push(s); });
    }
    ents.filter((e) => e.offset === pos).sort((a, b) => b.length - a.length).forEach((e) => {
      const tags = entityTags(e, text);
      html += tags[0];
      stack.push({ e, tags });
    });
    html += escapeHtml(text.slice(pos, points[i + 1]));
  }
  for (let j = stack.length - 1; j >= 0; j--) html += stack[j].tags[1];
  return html;
}

function mediaHtml(m) {
  if (!m.fileId) return m.type !== 'text' && m.type !== 'contact' && m.type !== 'location' ? `<div>${escapeHtml(INBOX_TYPE_LABEL[m.type] || '')}</div>` : '';
  const src = inboxMediaUrl(chatState.chatId, m.id);
  if (m.type === 'photo' || m.type === 'sticker') return `<a href="${src}" target="_blank" rel="noopener"><img src="${src}" loading="lazy" alt=""></a>`;
  if (m.type === 'voice' || m.type === 'audio') return `<audio controls preload="none" src="${src}"></audio>`;
  if (m.type === 'video' || m.type === 'video_note' || m.type === 'animation') return `<video controls preload="none" src="${src}"></video>`;
  return `<div><a href="${src}" target="_blank" rel="noopener">📎 ${escapeHtml(m.fileName || 'Файл')}</a></div>`;
}
function bubbleHtml(m) {
  const d = new Date(m.at);
  const time = d.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
  const flags = [m.editedAt ? 'изменено' : '', m.deletedAt ? 'удалено' : ''].filter(Boolean).join(', ');
  const prefix = m.type === 'contact' || m.type === 'location' ? escapeHtml(INBOX_TYPE_LABEL[m.type]) + ' ' : '';
  return `<div class="bubble ${m.direction === 'out' ? 'out' : 'in'}${m.deletedAt ? ' deleted' : ''}">`
    + mediaHtml(m)
    + (m.text ? prefix + entitiesToHtml(m.text, m.entities) : '')
    + `<div class="bubble-meta">${flags ? escapeHtml(flags) + ' · ' : ''}${time}</div></div>`;
}
function renderChatMessages(stickToBottom) {
  const body = document.getElementById('chatBody');
  const wasAtBottom = body.scrollHeight - body.scrollTop - body.clientHeight < 80;
  const prevHeight = body.scrollHeight;
  let html = chatState.hasMore ? '<button class="btn-ghost-sm chat-more" onclick="loadOlderChat()">Показать более ранние</button>' : '';
  if (!chatState.messages.length) html += '<div class="chat-center">Сообщений пока нет. Бот видит только переписку с момента подключения.</div>';
  let lastDay = '';
  chatState.messages.forEach((m) => {
    const day = new Date(m.at).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
    if (day !== lastDay) { html += `<div class="day-sep">${escapeHtml(day)}</div>`; lastDay = day; }
    html += bubbleHtml(m);
  });
  body.innerHTML = html;
  if (stickToBottom === 'keep') body.scrollTop = body.scrollHeight - prevHeight;
  else if (stickToBottom || wasAtBottom) body.scrollTop = body.scrollHeight;
}

function chatClient() { return clients.find((c) => c.id === chatState.clientId); }
function setChatHeader(c, conv) {
  const username = (conv && conv.username) || (c.telegram || '').replace(/^@/, '');
  document.getElementById('chatName').textContent = c.name;
  document.getElementById('chatSub').textContent = [username ? '@' + username : '', c.status].filter(Boolean).join(' · ');
  document.getElementById('chatUnlink').classList.toggle('hidden', !c.tgChatId);
  document.getElementById('chatOpenTg').classList.toggle('hidden', !username);
  document.getElementById('chatOpenTg').dataset.username = username || '';
}
function stopChatPolling() {
  clearInterval(chatState.timer);
  chatState.timer = null;
}

function openChat(clientId) {
  const c = clients.find((x) => x.id === clientId);
  if (!c) return;
  stopChatPolling();
  Object.assign(chatState, { clientId, chatId: c.tgChatId || null, messages: [], hasMore: false });
  document.getElementById('chatOverlay').classList.remove('hidden');
  const drawer = document.getElementById('chatDrawer');
  drawer.classList.add('open');
  drawer.setAttribute('aria-hidden', 'false');
  setChatHeader(c, null);
  document.getElementById('chatCompose').classList.add('hidden');
  if (!inboxToken()) return renderChatSetup();
  if (!c.tgChatId) return renderChatPicker();
  loadChat();
}
function closeChat() {
  stopChatPolling();
  chatState.clientId = null;
  chatState.chatId = null;
  document.getElementById('chatOverlay').classList.add('hidden');
  const drawer = document.getElementById('chatDrawer');
  drawer.classList.remove('open');
  drawer.setAttribute('aria-hidden', 'true');
}
function openChatInTelegram() {
  openTelegram(document.getElementById('chatOpenTg').dataset.username);
}

function renderChatSetup(error) {
  document.getElementById('chatCompose').classList.add('hidden');
  document.getElementById('chatBody').innerHTML = `
    <form class="chat-center" onsubmit="event.preventDefault(); saveInboxToken(this.token.value)">
      <b style="color:var(--text)">Подключите переписку из Telegram</b><br>
      Введите код доступа MyBrand — тот же, что на странице /message. Он сохранится только в этом браузере.
      <input name="token" type="password" placeholder="Код доступа" autocomplete="off">
      ${error ? `<div style="color:var(--red);margin-bottom:10px">${escapeHtml(error)}</div>` : ''}
      <button class="btn-red" type="submit" style="width:100%">Подключить</button>
    </form>`;
  const input = document.querySelector('#chatBody input');
  if (input) input.focus();
}
async function saveInboxToken(value) {
  const token = String(value || '').trim();
  if (!token) return;
  try { localStorage.setItem(INBOX_TOKEN_KEY, token); } catch (e) { /* private mode — works for this session only */ }
  try {
    await inboxApi('/conversations?q=__ping__');
  } catch (err) {
    try { localStorage.removeItem(INBOX_TOKEN_KEY); } catch (e) {}
    return renderChatSetup(err.unauthorized ? 'Код не подошёл' : 'Не удалось проверить: ' + err.message);
  }
  if (chatState.clientId) openChat(chatState.clientId);
}

// A row with no linked chat yet (its @username never wrote since the bot was connected, or it
// has no username at all): pick the right dialog from the owner's personal chats by hand.
async function renderChatPicker(query) {
  const body = document.getElementById('chatBody');
  const c = chatClient();
  if (!c) return;
  const q = query !== undefined ? query : (c.telegram || c.name || '').replace(/^@/, '');
  if (query === undefined) {
    body.innerHTML = `
      <div class="chat-center" style="margin-top:0;max-width:none;width:100%">
        <b style="color:var(--text)">Диалог не привязан</b><br>
        Выберите переписку с этим клиентом из вашего Telegram:
        <input id="pickSearch" placeholder="Имя или @username" value="${escapeHtml(q)}" oninput="clearTimeout(window._pickT); window._pickT=setTimeout(()=>renderChatPicker(this.value),300)">
        <div class="pick-list" id="pickList">Загрузка…</div>
      </div>`;
  }
  const listEl = document.getElementById('pickList');
  try {
    let convs = (await inboxApi('/conversations?q=' + encodeURIComponent(q.trim()))).conversations || [];
    if (!convs.length && q.trim()) convs = (await inboxApi('/conversations')).conversations || [];
    const linked = new Set(clients.filter((x) => x.tgChatId).map((x) => x.tgChatId));
    convs = convs.filter((v) => v.chatType === 'private' && !linked.has(v.chatId)).slice(0, 30);
    if (chatState.clientId !== c.id) return;
    listEl.innerHTML = convs.length
      ? convs.map((v) => `
          <button class="pick-item" onclick="linkChat('${escapeHtml(v.chatId)}','${escapeHtml(v.username || '')}')">
            <b>${escapeHtml(v.displayName || 'Без имени')}</b>${v.username ? ' <span style="display:inline">@' + escapeHtml(v.username) + '</span>' : ''}
            <span>${v.lastDirection === 'out' ? 'Вы: ' : ''}${escapeHtml(v.lastMessagePreview || '')}</span>
          </button>`).join('')
      : '<div style="text-align:center">Ничего не найдено. Диалог появится, как только в нём будет новое сообщение.</div>';
  } catch (err) {
    if (err.unauthorized) return renderChatSetup('Код доступа больше не подходит');
    listEl.textContent = 'Ошибка: ' + err.message;
  }
}
async function linkChat(chatId, username) {
  const c = chatClient();
  if (!c) return;
  const updated = await patchClient(c.id, 'tgChatId', chatId);
  if (!updated) return;
  if (!updated.telegram && username) await patchClient(c.id, 'telegram', username);
  renderTable();
  openChat(c.id);
}
async function unlinkChat() {
  const c = chatClient();
  if (!c || !c.tgChatId) return;
  if (!confirm('Отвязать этот диалог от клиента?')) return;
  const updated = await patchClient(c.id, 'tgChatId', '');
  if (!updated) return;
  renderTable();
  openChat(c.id);
}

async function fetchChatPage(offset) {
  return inboxApi(`/conversations/${encodeURIComponent(chatState.chatId)}/messages?limit=${CHAT_PAGE}&offset=${offset}`);
}
async function loadChat() {
  const chatId = chatState.chatId;
  const body = document.getElementById('chatBody');
  body.innerHTML = '<div class="chat-center">Загрузка…</div>';
  try {
    const [page, meta] = await Promise.all([
      fetchChatPage(0),
      inboxApi(`/conversations/${encodeURIComponent(chatId)}`).catch(() => null),
    ]);
    if (chatState.chatId !== chatId) return;
    chatState.messages = page.messages || [];
    chatState.hasMore = !!page.hasMore;
    const c = chatClient();
    if (c && meta && meta.conversation) setChatHeader(c, meta.conversation);
    renderChatMessages(true);
    document.getElementById('chatCompose').classList.remove('hidden');
    inboxApi(`/conversations/${encodeURIComponent(chatId)}/read`, { method: 'POST' }).catch(() => {});
    chatState.timer = setInterval(pollChat, CHAT_POLL_MS);
  } catch (err) {
    if (err.unauthorized) return renderChatSetup('Код доступа больше не подходит');
    body.innerHTML = `<div class="chat-center">${err.message === 'conversation not found'
      ? 'Этот диалог удалён из MyBrand. Нажмите «Отвязать» и выберите другой.'
      : 'Ошибка загрузки: ' + escapeHtml(err.message)}</div>`;
  }
}
async function pollChat() {
  if (document.hidden || !chatState.chatId) return;
  const chatId = chatState.chatId;
  try {
    const page = await fetchChatPage(0);
    if (chatState.chatId !== chatId) return;
    const fresh = page.messages || [];
    const sig = (list) => list.map((m) => m.id + (m.editedAt || '') + (m.deletedAt || '')).join('|');
    const current = chatState.messages.slice(-fresh.length);
    if (sig(fresh) === sig(current)) return;
    const older = chatState.messages.slice(0, Math.max(0, chatState.messages.length - fresh.length));
    const freshIds = new Set(fresh.map((m) => m.id));
    chatState.messages = older.filter((m) => !freshIds.has(m.id)).concat(fresh);
    renderChatMessages(false);
  } catch (err) { /* transient */ }
}
async function loadOlderChat() {
  try {
    const page = await fetchChatPage(chatState.messages.length);
    chatState.messages = (page.messages || []).concat(chatState.messages);
    chatState.hasMore = !!page.hasMore;
    renderChatMessages('keep');
  } catch (err) {
    showToast('Ошибка: ' + err.message);
  }
}

/* ── composer: rich text → Telegram HTML ── */
// Telegram accepts only <b> <i> <u> <s> <code> <pre> <a href> <tg-spoiler> <blockquote>, with
// real newlines instead of <br>/<p>. Walk the editor's DOM (whatever the browser or a paste put
// there — incl. Google Docs' <span style="font-weight:700">) and emit just that subset.
function escapeTg(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
function domToTelegramHtml(root) {
  let out = '';
  const walk = (node, inPre) => {
    node.childNodes.forEach((child) => {
      if (child.nodeType === 3) { out += escapeTg(child.nodeValue.replace(/ /g, ' ')); return; }
      if (child.nodeType !== 1) return;
      const tag = child.tagName.toLowerCase();
      if (tag === 'br') { out += '\n'; return; }
      if (/^(script|style|head|meta|title|img)$/.test(tag)) return;
      const st = child.style || {};
      const fw = st.fontWeight || '';
      const td = (st.textDecorationLine || st.textDecoration || '');
      const wraps = [];
      const boldTag = tag === 'b' || tag === 'strong' || /^h[1-6]$/.test(tag);
      if ((boldTag && !(fw === 'normal' || (+fw && +fw < 600))) || (!boldTag && (fw === 'bold' || +fw >= 600))) wraps.push(['<b>', '</b>']);
      if (tag === 'i' || tag === 'em' || st.fontStyle === 'italic') wraps.push(['<i>', '</i>']);
      if (tag === 'u' || tag === 'ins' || td.includes('underline')) wraps.push(['<u>', '</u>']);
      if (tag === 's' || tag === 'strike' || tag === 'del' || td.includes('line-through')) wraps.push(['<s>', '</s>']);
      if (tag === 'a') {
        const href = safeHref(child.getAttribute('href'));
        if (href) wraps.push([`<a href="${escapeTg(href).replace(/"/g, '&quot;')}">`, '</a>']);
      }
      if (tag === 'tg-spoiler' || (child.classList && child.classList.contains('tg-spoiler'))) wraps.push(['<tg-spoiler>', '</tg-spoiler>']);
      if (tag === 'code' && !inPre) wraps.push(['<code>', '</code>']);
      if (tag === 'pre') wraps.push(['<pre>', '</pre>']);
      if (tag === 'blockquote') wraps.push(['<blockquote>', '</blockquote>']);
      const isBlock = /^(div|p|li|h[1-6]|pre|blockquote|ul|ol|tr)$/.test(tag);
      if (isBlock && out && !out.endsWith('\n')) out += '\n';
      if (tag === 'li') out += '• ';
      wraps.forEach((w) => { out += w[0]; });
      walk(child, inPre || tag === 'pre');
      for (let i = wraps.length - 1; i >= 0; i--) out += wraps[i][1];
      if (isBlock && !out.endsWith('\n')) out += '\n';
    });
  };
  walk(root, false);
  return out.replace(/\n{3,}/g, '\n\n').replace(/^\s+|\s+$/g, '');
}
function composerEl() { return document.getElementById('composer'); }
function fmtCmd(cmd) {
  composerEl().focus();
  document.execCommand(cmd, false, null);
}
function fmtWrap(tag, cls) {
  const editor = composerEl();
  const sel = window.getSelection();
  if (!sel.rangeCount) return;
  const range = sel.getRangeAt(0);
  if (range.collapsed || !editor.contains(range.commonAncestorContainer)) { showToast('Сначала выделите текст'); return; }
  const el = document.createElement(tag);
  if (cls) el.className = cls;
  el.appendChild(range.extractContents());
  range.insertNode(el);
  sel.removeAllRanges();
  const r = document.createRange();
  r.selectNodeContents(el);
  sel.addRange(r);
}
function fmtLink() {
  const sel = window.getSelection();
  if (!sel.rangeCount || sel.getRangeAt(0).collapsed) { showToast('Сначала выделите текст для ссылки'); return; }
  const range = sel.getRangeAt(0).cloneRange();
  const url = safeHref(prompt('Ссылка (https://…)', 'https://') || '');
  if (!url || url === 'https://') return;
  composerEl().focus();
  sel.removeAllRanges();
  sel.addRange(range);
  document.execCommand('createLink', false, url);
}
// Paste keeps formatting (bold/italic/links… from Google Docs, Notion, another chat) but only
// the parts Telegram can show — reduced through the same converter, then put back as markup.
document.addEventListener('paste', (e) => {
  const editor = composerEl();
  if (!editor || !editor.contains(e.target)) return;
  e.preventDefault();
  const html = e.clipboardData.getData('text/html');
  if (html) {
    const doc = new DOMParser().parseFromString(html, 'text/html');
    const tg = domToTelegramHtml(doc.body)
      .replace(/<tg-spoiler>/g, '<span class="tg-spoiler">').replace(/<\/tg-spoiler>/g, '</span>')
      .replace(/\n/g, '<br>');
    document.execCommand('insertHTML', false, tg);
  } else {
    document.execCommand('insertText', false, e.clipboardData.getData('text/plain'));
  }
});
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && chatState.clientId && !document.getElementById('chatOverlay').classList.contains('hidden')) closeChat();
  if (e.key === 'Enter' && (e.ctrlKey || e.metaKey) && composerEl() && composerEl().contains(e.target)) {
    e.preventDefault();
    sendChatMessage();
  }
});

async function sendChatMessage() {
  if (chatState.sending || !chatState.chatId) return;
  const editor = composerEl();
  const html = domToTelegramHtml(editor);
  if (!html.replace(/<[^>]+>/g, '').trim()) return;
  const chatId = chatState.chatId;
  const btn = document.getElementById('chatSendBtn');
  chatState.sending = true;
  btn.disabled = true;
  try {
    const { message } = await inboxApi(`/conversations/${encodeURIComponent(chatId)}/send`, {
      method: 'POST',
      body: JSON.stringify({ html }),
    });
    editor.innerHTML = '';
    if (chatState.chatId === chatId && message) {
      chatState.messages.push(message);
      renderChatMessages(true);
    }
    const c = clients.find((x) => x.tgChatId === chatId);
    if (c && message) {
      c.lastMessage = { text: message.text, at: message.at, direction: 'out', type: 'text' };
      renderTable();
    }
  } catch (err) {
    showToast(err.unauthorized ? err.message : 'Не отправлено: ' + err.message);
  } finally {
    chatState.sending = false;
    btn.disabled = false;
  }
}

