<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CRM продаж — Cantor Agency</title>
<meta name="robots" content="noindex, nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;600;700;900&family=Geologica:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="icon" type="image/svg+xml" href="/Frame 1000011449.svg">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --red:#E8391D;--red-dark:#C42D13;--red-light:#FF6347;
  --dark:#0F0F0F;--dark2:#1A1A1A;--text:#1C1C1C;--muted:#888;
  --bg:#F6F5F2;--white:#FFFFFF;--border:#E2E0DC;
  --accent-bg:#FFF3F0;--warm-bg:#FFFBF9;
  --shadow-sm:0 2px 8px rgba(0,0,0,0.06);
  --shadow-md:0 12px 40px rgba(0,0,0,0.1);
  --shadow-red:0 8px 28px rgba(232,57,29,0.28);
  --r-sm:6px;--r-md:10px;--r-lg:16px;--r-xl:20px;
  --p-green:#059669;--p-green-bg:#d1fae5;
  --p-yellow:#ca8a04;--p-yellow-bg:#fef3c7;
  --p-orange:#ea580c;--p-orange-bg:#ffedd5;
  --p-red:#dc2626;--p-red-bg:#fee2e2;
  --stale-warn-bg:#fef9e7;--stale-danger-bg:#fdf2f2;
}
html{-webkit-text-size-adjust:100%}
body{font-family:'Geologica',sans-serif;color:var(--text);background:var(--bg);line-height:1.5;min-height:100vh;-webkit-font-smoothing:antialiased}
.hidden{display:none !important}
button{font-family:inherit}
input,textarea,select{font-family:inherit}

/* ── TOPBAR ── */
.topbar{display:flex;align-items:center;gap:12px;padding:14px 24px;border-bottom:1.5px solid var(--border);background:var(--white);position:sticky;top:0;z-index:20;flex-wrap:wrap}
.topbar-right{display:flex;align-items:center;gap:8px;flex-wrap:wrap;flex-shrink:0}

/* ── BUTTONS ── */
.btn-red{background:var(--red);color:white;border:none;border-radius:var(--r-md);padding:9px 16px;font-size:12.5px;font-weight:700;cursor:pointer;transition:all 0.2s;white-space:nowrap}
.btn-red:hover{background:var(--red-dark)}
.btn-red:disabled{opacity:0.55;cursor:wait}
.btn-outline{background:white;color:var(--text);border:1.5px solid var(--border);border-radius:var(--r-md);padding:9px 16px;font-size:12.5px;font-weight:700;cursor:pointer;transition:all 0.18s;white-space:nowrap}
.btn-outline:hover{border-color:var(--red);color:var(--red)}
.btn-outline.active{border-color:var(--red);color:var(--red);background:var(--accent-bg)}
.btn-icon{background:white;color:var(--text);border:1.5px solid var(--border);border-radius:var(--r-md);width:36px;height:36px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all 0.18s;flex-shrink:0}
.btn-icon:hover{border-color:var(--red);color:var(--red)}
.btn-icon-red{background:var(--red);border-color:var(--red);color:white}
.btn-icon-red:hover{background:var(--red-dark);border-color:var(--red-dark);color:white}
.btn-ghost-sm{background:none;border:1.5px solid var(--border);border-radius:var(--r-sm);padding:5px 10px;font-size:11.5px;font-weight:700;color:var(--muted);cursor:pointer;transition:all 0.15s;white-space:nowrap}
.btn-ghost-sm:hover{border-color:var(--red);color:var(--red)}
.btn-ghost-sm.danger:hover{border-color:#c0392b;color:#c0392b}

/* ── TOAST ── */
.toast{position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(16px);background:var(--dark);color:white;padding:12px 20px;border-radius:var(--r-md);font-size:13.5px;font-weight:600;box-shadow:var(--shadow-md);opacity:0;pointer-events:none;transition:all 0.25s ease;display:flex;align-items:center;gap:8px;z-index:200;max-width:80vw}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ── ADMIN GATE ── */
#adminGate{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}
.gate-card{width:100%;max-width:380px;background:var(--white);border:1.5px solid var(--border);border-radius:var(--r-xl);box-shadow:var(--shadow-md);padding:36px 30px;text-align:center}
.gate-card h1{font-family:'Unbounded',sans-serif;font-size:19px;font-weight:700;color:var(--dark);margin-bottom:8px;letter-spacing:-0.02em}
.gate-card p{font-size:13px;color:var(--muted);margin-bottom:22px;line-height:1.6}
.gate-card input{width:100%;border:1.5px solid var(--border);border-radius:var(--r-md);padding:13px 14px;font-size:15px;color:var(--text);outline:none;transition:border-color 0.2s;background:white;margin-bottom:12px;text-align:center;letter-spacing:0.1em}
.gate-card input:focus{border-color:var(--red)}
.gate-error{font-size:12px;color:var(--red);margin:-4px 0 14px;display:none}
.gate-error.show{display:block}

/* ── SEARCH FIELD ── */
.search-field{display:flex;align-items:center;gap:8px;border:1.5px solid var(--border);border-radius:100px;padding:9px 16px;background:var(--bg);color:var(--muted);transition:border-color 0.18s;flex:1;min-width:120px}
.search-field:focus-within{border-color:var(--red)}
.search-field svg{flex-shrink:0}
.search-field input{border:none;outline:none;background:transparent;font-size:13px;color:var(--text);width:100%}

/* ── TABLE ── */
.wrap{padding:20px 24px 60px;overflow-x:auto}
table{width:100%;border-collapse:collapse;background:var(--white);border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow-sm);min-width:1200px}
thead th{background:var(--dark);color:white;font-size:10.5px;text-transform:uppercase;letter-spacing:0.06em;font-weight:700;padding:11px 12px;text-align:left;white-space:nowrap}
thead th.sortable{cursor:pointer;user-select:none}
thead th.sortable:hover{color:var(--red-light)}
tbody tr{border-bottom:1px solid var(--border);transition:background 0.15s}
tbody tr:last-child{border-bottom:none}
tbody tr.stale-warn{background:var(--stale-warn-bg)}
tbody tr.stale-danger{background:var(--stale-danger-bg)}
tbody td{padding:8px 12px;vertical-align:middle;font-size:13px}
th.col-name,td.col-name{width:170px}
th.col-tg,td.col-tg{width:190px}
th.col-priority,td.col-priority{width:150px}
th.col-status,td.col-status{width:170px}
th.col-date,td.col-date{width:200px}
th.col-last,td.col-last{width:250px}
th.col-comment,td.col-comment{width:auto}
th.col-actions,td.col-actions{width:36px;padding-left:0;padding-right:8px}
.cell-input{width:100%;min-width:80px;border:1.5px solid transparent;border-radius:var(--r-sm);padding:6px 8px;font-size:13px;background:transparent;outline:none;transition:all 0.15s}
.date-input.na-overdue{border-color:var(--p-red);background:var(--p-red-bg);color:var(--p-red)}
.date-input.na-today{border-color:var(--p-orange);background:var(--p-orange-bg);color:var(--p-orange)}
.date-input.na-soon{border-color:var(--p-yellow);background:var(--p-yellow-bg);color:var(--p-yellow)}
.cell-input:hover{border-color:var(--border)}
.cell-input:focus{border-color:var(--red);background:var(--white)}
textarea.cell-input{resize:none;min-height:34px;overflow:hidden;font-family:inherit;line-height:1.4;width:100%}
.tg-cell{display:flex;align-items:center;gap:8px}
.tg-cell .cell-input{flex:1;min-width:70px}
.btn-tg-icon{background:none;border:none;padding:2px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:50%;transition:transform 0.15s}
.btn-tg-icon:hover{transform:scale(1.12)}
.btn-tg-icon:disabled{opacity:0.3;cursor:not-allowed}

/* ── name cell: AI-added badge ── */
.name-cell{display:flex;align-items:center;gap:4px}
.name-cell .cell-input{flex:1;min-width:60px}
.ai-badge{font-size:9px;font-weight:800;letter-spacing:0.03em;padding:2px 5px;border-radius:4px;background:#EEF2FF;color:#4338CA;white-space:nowrap;flex-shrink:0;cursor:help}
/* ── task cell: next-action date + what to do ── */
.task-cell{display:flex;flex-direction:column;gap:2px}
.task-input{font-size:12px;padding:4px 8px;color:var(--text)}
.task-input::placeholder{color:#bbb}
.task-ai{font-size:10px;color:#4338CA;padding:0 8px;font-weight:600}
/* ── last Telegram message ── */
.last-msg{display:flex;gap:7px;align-items:flex-start;width:100%;background:none;border:1.5px solid transparent;border-radius:var(--r-sm);padding:5px 7px;cursor:pointer;text-align:left;font:inherit;color:inherit;transition:all 0.15s}
.last-msg:hover{border-color:var(--border);background:var(--white)}
.last-msg-dir{flex-shrink:0;font-size:13px;line-height:1.3;font-weight:800;color:var(--muted)}
.last-msg.awaiting .last-msg-dir{color:var(--red)}
.last-msg-main{flex:1;min-width:0}
.last-msg-text{font-size:12px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-word}
.last-msg-time{font-size:10.5px;color:var(--muted);margin-top:1px}
.last-msg.awaiting .last-msg-time{color:var(--red);font-weight:700}
.last-msg-empty{font-size:11.5px;color:var(--muted)}
.row-del{opacity:0;background:none;border:none;color:var(--muted);cursor:pointer;padding:4px;border-radius:var(--r-sm);display:flex;transition:all 0.15s}
tbody tr:hover .row-del,.lead-card:hover .row-del{opacity:1}
.row-del:hover{color:#c0392b;background:#fdecea}
@media (hover:none){.row-del{opacity:0.6}}
/* ── Telegram chat drawer ── */
.chat-overlay{position:fixed;inset:0;background:rgba(10,10,10,0.35);z-index:250}
.chat-drawer{position:fixed;top:0;right:0;bottom:0;width:min(480px,100vw);background:#EEF1F4;z-index:260;display:flex;flex-direction:column;box-shadow:-12px 0 40px rgba(0,0,0,0.15);transform:translateX(105%);transition:transform 0.22s ease}
.chat-drawer.open{transform:none}
.chat-head{display:flex;align-items:center;gap:10px;padding:12px 14px;background:var(--white);border-bottom:1.5px solid var(--border)}
.chat-who{flex:1;min-width:0}
.chat-who-name{font-weight:700;font-size:14.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-who-sub{font-size:11.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-body{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:5px}
.chat-center{margin:auto;text-align:center;color:var(--muted);font-size:13px;max-width:320px;line-height:1.55}
.chat-center input{width:100%;border:1.5px solid var(--border);border-radius:var(--r-md);padding:11px 12px;font-size:14px;margin:12px 0 10px;outline:none}
.chat-center input:focus{border-color:var(--red)}
.bubble{max-width:84%;padding:7px 11px 5px;border-radius:14px;font-size:13.5px;line-height:1.45;white-space:pre-wrap;word-wrap:break-word;overflow-wrap:anywhere;box-shadow:0 1px 2px rgba(0,0,0,0.08)}
.bubble.in{align-self:flex-start;background:var(--white);border-bottom-left-radius:4px}
.bubble.out{align-self:flex-end;background:#E3F4D7;border-bottom-right-radius:4px}
.bubble.deleted{opacity:0.55}
.bubble-meta{font-size:10px;color:var(--muted);text-align:right;margin-top:2px;white-space:nowrap}
.bubble img,.bubble video{max-width:100%;max-height:320px;border-radius:10px;display:block;margin:2px 0 4px}
.bubble audio{max-width:100%;display:block;margin:2px 0 4px}
.bubble a{color:#1C7ED6}
.bubble code{font-family:ui-monospace,Menlo,monospace;font-size:12.5px;background:rgba(0,0,0,0.06);padding:1px 4px;border-radius:4px}
.bubble pre{font-family:ui-monospace,Menlo,monospace;font-size:12.5px;background:rgba(0,0,0,0.06);padding:8px;border-radius:8px;margin:3px 0;white-space:pre-wrap}
.bubble blockquote{border-left:3px solid var(--red);padding:1px 0 1px 8px;margin:3px 0;background:rgba(0,0,0,0.03);border-radius:0 6px 6px 0}
.tg-spoiler{background:#9aa0a6;color:transparent;border-radius:3px;cursor:pointer;transition:all 0.2s}
.tg-spoiler.shown{background:rgba(0,0,0,0.08);color:inherit}
.composer .tg-spoiler{background:rgba(0,0,0,0.12);color:inherit;border-bottom:2px dotted #666}
.day-sep{align-self:center;font-size:11px;font-weight:600;color:var(--muted);background:rgba(255,255,255,0.8);padding:3px 10px;border-radius:100px;margin:8px 0 4px}
.chat-more{align-self:center;margin-bottom:6px}
.pick-list{display:flex;flex-direction:column;gap:6px;width:100%;margin-top:10px;text-align:left}
.pick-item{display:block;width:100%;background:var(--white);border:1.5px solid var(--border);border-radius:var(--r-md);padding:9px 12px;cursor:pointer;font:inherit;text-align:left;color:var(--text)}
.pick-item:hover{border-color:var(--red)}
.pick-item b{font-size:13px}
.pick-item span{display:block;font-size:11.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-compose{background:var(--white);border-top:1.5px solid var(--border);padding:10px 12px 12px;display:flex;flex-direction:column;gap:8px}
.fmt-bar{display:flex;gap:4px;flex-wrap:wrap}
.fmt-btn{min-width:30px;height:28px;padding:0 6px;border:1.5px solid var(--border);border-radius:6px;background:var(--white);cursor:pointer;font-size:12.5px;color:var(--text);font-family:inherit}
.fmt-btn:hover{border-color:var(--red);color:var(--red)}
.composer{min-height:46px;max-height:240px;overflow-y:auto;border:1.5px solid var(--border);border-radius:var(--r-md);padding:9px 12px;font-size:13.5px;line-height:1.45;outline:none;white-space:pre-wrap;word-wrap:break-word;overflow-wrap:anywhere;background:var(--white)}
.composer:focus{border-color:var(--red)}
.composer:empty::before{content:attr(data-placeholder);color:var(--muted);pointer-events:none}
.composer code{font-family:ui-monospace,Menlo,monospace;background:rgba(0,0,0,0.06);padding:1px 4px;border-radius:4px}
.composer blockquote{border-left:3px solid var(--red);padding-left:8px;margin:2px 0}
.composer a{color:#1C7ED6}
.compose-row{display:flex;justify-content:space-between;align-items:center;gap:8px}
.compose-hint{font-size:11px;color:var(--muted)}

/* ── custom dropdown (priority / status pills, opens on hover) ── */
.dd{position:relative;display:inline-flex;width:100%}
.dd-trigger{display:flex;align-items:center;gap:7px;width:100%;border:1.5px solid rgba(0,0,0,0.08);border-radius:100px;padding:6px 10px;font-size:11.5px;font-weight:700;font-family:inherit;color:inherit;cursor:pointer;transition:all 0.15s}
.dd-trigger:hover{border-color:rgba(0,0,0,0.2);box-shadow:0 1px 4px rgba(0,0,0,0.08)}
.dd:focus-within .dd-trigger{border-color:var(--red)}
.dd .dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.dd-label{flex:1;text-align:left;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dd-trigger .chev{flex-shrink:0;opacity:0.6;transition:transform 0.15s}
.dd:hover .dd-trigger .chev,.dd:focus-within .dd-trigger .chev{transform:rotate(180deg)}
/* position:fixed, not absolute: an ancestor no taller than its (short) table content would
   otherwise clip the menu wherever it overshoots that box — most visible with just a
   handful of rows, where the table (and everything wrapping it) is barely taller than one
   row. Its exact top/left/bottom is computed in JS (positionDropdownMenu) against the
   viewport, run on every hover/focus since rows are fresh DOM nodes after each re-render. */
.dd-menu{position:fixed;min-width:170px;max-height:min(280px,calc(100vh - 24px));overflow-y:auto;background:var(--white);border:1.5px solid var(--border);border-radius:var(--r-md);box-shadow:var(--shadow-md);padding:6px;z-index:120;opacity:0;visibility:hidden;pointer-events:none;transition:opacity 0.15s ease}
.dd:hover .dd-menu,.dd:focus-within .dd-menu{opacity:1;visibility:visible;pointer-events:auto}
.dd-option{display:flex;align-items:center;gap:8px;padding:7px 10px;border-radius:var(--r-sm);font-size:12.5px;font-weight:600;color:var(--text);cursor:pointer;white-space:nowrap}
.dd-option:hover{background:var(--bg)}
.dd-trigger-compact{width:26px;height:26px;padding:0;border-radius:var(--r-md);border:1.5px solid rgba(0,0,0,0.1);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;font-family:inherit;cursor:pointer;transition:all 0.15s}
.dd-trigger-compact:hover{border-color:rgba(0,0,0,0.25);box-shadow:0 1px 4px rgba(0,0,0,0.08)}
.dd:focus-within .dd-trigger-compact{border-color:var(--red)}
.empty-state{text-align:center;padding:60px 20px;color:var(--muted);font-size:13px}

/* ── card view (alternative to the table) ── */
/* auto-fit (not auto-fill) so unused column tracks collapse to 0 instead of sitting there as
   blank space — auto-fill keeps every track it can fit even with no card left to put in it,
   which is exactly the "lots of empty space" look at in-between widths. */
.cards-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
.lead-card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--r-lg);padding:14px;box-shadow:var(--shadow-sm);display:flex;flex-direction:column;gap:10px}
.lead-card.stale-warn{background:var(--stale-warn-bg)}
.lead-card.stale-danger{background:var(--stale-danger-bg)}
.lead-card-head{display:flex;align-items:center;gap:8px}
.lead-card-head .name-input{flex:1;font-weight:700;min-width:0}
.lead-card-dd{display:flex;gap:8px;flex-wrap:wrap}
.lead-card-dd .dd{width:auto;flex:1;min-width:110px}
.group-badge{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:0.03em;padding:3px 8px;border-radius:var(--r-sm);white-space:nowrap;flex-shrink:0}

/* ── filter popover ── */
.filter-wrap{position:relative}
.filter-dot{position:absolute;top:6px;right:6px;width:7px;height:7px;border-radius:50%;background:var(--red);display:none}
.filter-dot.show{display:block}
.filter-wrap::before{content:'';position:absolute;top:100%;left:50%;transform:translateX(-50%);width:100%;height:10px}
.filter-panel{position:absolute;top:calc(100% + 10px);left:50%;transform:translateX(-50%) translateY(4px);background:var(--white);border:1.5px solid var(--border);border-radius:var(--r-lg);box-shadow:var(--shadow-md);padding:18px;width:260px;max-height:calc(100vh - 100px);overflow-y:auto;z-index:50;display:flex;flex-direction:column;gap:14px;opacity:0;visibility:hidden;pointer-events:none;transition:opacity 0.15s ease,transform 0.15s ease}
.filter-wrap:hover .filter-panel,.filter-wrap:focus-within .filter-panel{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0)}
.filter-row label{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);margin-bottom:6px;display:block}
.filter-checks{display:flex;flex-direction:column;gap:2px}
.filter-check{display:flex;align-items:center;gap:8px;padding:5px 8px;border-radius:var(--r-sm);font-size:12.5px;font-weight:600;color:var(--text);cursor:pointer;transition:background 0.15s}
.filter-check:hover{background:var(--bg)}
.filter-check.checked{background:var(--accent-bg)}
.filter-check input{accent-color:var(--red);cursor:pointer;flex-shrink:0}
.filter-check .dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.filter-reset{background:none;border:none;color:var(--red);font-size:12px;font-weight:700;cursor:pointer;padding:2px 0;text-align:left}

/* ── MODAL (stats) ── */
.modal-overlay{position:fixed;inset:0;background:rgba(10,10,10,0.45);backdrop-filter:blur(3px);z-index:300;display:flex;align-items:flex-start;justify-content:center;padding:40px 20px;overflow-y:auto}
.modal-card{width:100%;max-width:520px;background:var(--white);border-radius:var(--r-xl);box-shadow:var(--shadow-md);padding:0;animation:modalIn 0.2s ease}
@keyframes modalIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.modal-head{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;border-bottom:1.5px solid var(--border)}
.modal-head h2{font-family:'Unbounded',sans-serif;font-size:16px;font-weight:700}
.modal-body{padding:20px 24px;max-height:70vh;overflow-y:auto}
.stat-card{background:var(--bg);border-radius:var(--r-lg);padding:16px;margin-bottom:14px}
.stat-card h3{font-size:12.5px;margin-bottom:10px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:0.04em}
.stat-big{font-size:26px;font-weight:800;font-family:'Unbounded',sans-serif;color:var(--dark);line-height:1.15}
.kpi-row{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}
.kpi-card{background:var(--bg);border-radius:var(--r-lg);padding:14px 8px;text-align:center}
.kpi-card h3{font-size:10px;margin-bottom:6px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:0.03em}
.bar-row{display:grid;grid-template-columns:minmax(80px,110px) 1fr 26px;align-items:center;gap:10px;padding:4px 0;font-size:12px}
.bar-row-label{color:var(--text);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bar-track{height:8px;background:var(--white);border-radius:100px;overflow:hidden}
.bar-fill{height:100%;border-radius:100px;transition:width 0.3s ease;min-width:2px}
.bar-row-val{text-align:right;font-weight:700;color:var(--muted)}
.group-bar-row{margin-bottom:10px}
.group-bar-row:last-child{margin-bottom:0}
.group-bar-label{font-size:12.5px;font-weight:700;margin-bottom:5px}
.group-bar-label .muted{color:var(--muted);font-weight:600}
.stack-track{display:flex;height:16px;border-radius:100px;overflow:hidden;background:var(--white)}
.stack-seg{height:100%}
.stat-legend{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:12px;padding-top:12px;border-top:1px solid var(--border);font-size:11px;color:var(--muted)}
.legend-item{display:flex;align-items:center;gap:5px;white-space:nowrap}
.legend-item .dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}

/* Narrower window: drop the Telegram username field (keep just the jump button) and
   collapse the priority/status pills down to their color dot only. */
@media (max-width:900px){
  /* Scoped to the table, not just .wrap — #cardsGrid is also a child of .wrap, and its cards
     have their own full-width layout regardless of viewport width, so collapsing every
     .dd-trigger in .wrap was shrinking the card view's priority/status pills down to blank
     26px circles too, leaving big empty gaps around them. */
  .wrap table .tg-cell input{display:none}
  th.col-tg,td.col-tg{width:44px;text-align:center}
  th.col-priority,td.col-priority{width:44px}
  th.col-status,td.col-status{width:44px}
  th.col-name,td.col-name{width:130px}
  th.col-date,td.col-date{width:150px}
  th.col-last,td.col-last{width:170px}
  .wrap table .dd-trigger{width:26px;height:26px;padding:0;border-radius:var(--r-md);justify-content:center;gap:0}
  .wrap table .dd-trigger .dd-label,.wrap table .dd-trigger .chev{display:none}
  /* The column headers above these now-icon-only cells would otherwise sit awkwardly wide
     over a tiny column — hide the label text so the header just shows blank space there. */
  th.col-tg .th-label,th.col-priority .th-label,th.col-status .th-label{display:none}
  /* Every column above now fits in a fraction of its full-width size, so the table itself no
     longer needs the wide minimum — let it shrink to the viewport instead of scrolling. */
  table{min-width:0}
}

@media (max-width:640px){
  .topbar{padding:12px 14px}
  .wrap{padding:14px}
  .search-field input{width:90px}
  .kpi-card .stat-big{font-size:20px}
  .bar-row{grid-template-columns:minmax(64px,90px) 1fr 22px;gap:6px}
}
</style>
</head>
<body>

