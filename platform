<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="robots" content="noindex, nofollow">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#F6F5F2">
<script>
try {
  var t = localStorage.getItem("platform.theme");
  if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
} catch (e) {}
</script>
<title>Cantor</title>
<link rel="preload" href="/fonts/geologica-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="icon" type="image/svg+xml" href="/images/brand/favicon.svg">
<style>
:root{
  --bg:#F6F5F2;--surface:#fff;--ink:#141414;--text:#2C2A28;--muted:#6F6B66;--line:#E2E0DC;
  --red:#E8391D;--ok:#2F7D4F;
  --font:'Geologica',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --display:'Unbounded','Arial Black',sans-serif;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#0F0F0F;--surface:#1A1A1A;--ink:#F3F1EC;--text:#E7E4DE;--muted:#A3A09B;--line:rgba(255,255,255,.12);
    --red:#FF6347;--ok:#6CC891;color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0F0F0F;--surface:#1A1A1A;--ink:#F3F1EC;--text:#E7E4DE;--muted:#A3A09B;--line:rgba(255,255,255,.12);
  --red:#FF6347;--ok:#6CC891;color-scheme:dark;
}
*{box-sizing:border-box}
html,body{margin:0}
body{font-family:var(--font);font-size:15px;line-height:1.45;background:var(--bg);color:var(--text);min-height:100vh}
button,input,textarea{font:inherit;color:inherit}
button{cursor:pointer;border:0;background:none;padding:0}
textarea{resize:vertical;width:100%}
:focus-visible{outline:2px solid var(--red);outline-offset:2px}
h1,h2{font-family:var(--display);font-weight:500;color:var(--ink);letter-spacing:-.02em;margin:0}
h1{font-size:32px;line-height:1.15}
h2{font-size:18px}
p{margin:0}
.app{display:grid;grid-template-columns:232px minmax(0,1fr);min-height:100vh}
.side{position:sticky;top:0;height:100vh;padding:22px 14px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:22px;background:var(--bg)}
.brand{font-family:var(--display);font-weight:700;font-size:18px;color:var(--red);text-decoration:none;padding:0 10px}
.cab{padding:0 10px;display:grid;gap:2px}
.cab b{color:var(--ink);font-size:14px}
.cab span{color:var(--muted);font-size:13px}
.nav{display:grid;gap:2px}
.nav button{height:40px;border-radius:999px;padding:0 14px;text-align:left;font-weight:600;color:var(--muted);display:flex;align-items:center;justify-content:space-between}
.nav button.on{background:var(--surface);color:var(--ink);box-shadow:inset 0 0 0 1px var(--line)}
.nav i{font-style:normal;color:var(--red);font-variant-numeric:tabular-nums}
.theme{margin-top:auto;height:36px;text-align:left;padding:0 14px;color:var(--muted);font-weight:600;font-size:13px}
.main{padding:28px 32px 72px;max-width:920px}
.view{display:none}
.view.on{display:grid;gap:28px;align-content:start}
.nums{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
.nums div{display:grid;gap:4px}
.nums b{font-family:var(--display);font-weight:500;font-size:28px;color:var(--ink);font-variant-numeric:tabular-nums;letter-spacing:-.03em}
.nums span{color:var(--muted);font-size:13px}
.bad{color:var(--red)}.good{color:var(--ok)}
.list{display:grid}
.list button,.pay{display:grid;grid-template-columns:148px minmax(0,1fr) auto;gap:16px;align-items:baseline;width:100%;text-align:left;padding:14px 0;border-bottom:1px solid var(--line);color:inherit}
.list button:first-child,.pay:first-child{border-top:1px solid var(--line)}
.list b,.pay b{color:var(--ink);font-weight:600}
.list span,.pay span{color:var(--text)}
.list em,.pay em{font-style:normal;color:var(--muted);font-size:13px;white-space:nowrap}
table{width:100%;border-collapse:collapse}
th,td{text-align:left;padding:12px 10px 12px 0;border-bottom:1px solid var(--line);vertical-align:baseline}
th{font-size:12px;font-weight:600;color:var(--muted);letter-spacing:.04em}
td:last-child,th:last-child{text-align:right;padding-right:0}
tr{cursor:pointer}
tr.on td{color:var(--ink)}
.detail{display:grid;gap:14px;padding-top:4px}
.photos{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}
.ph{aspect-ratio:1;border-radius:12px;background:var(--surface);box-shadow:inset 0 0 0 1px var(--line);display:grid;align-content:end;padding:8px;font-size:12px;color:var(--muted)}
.ph.off{background:transparent}
.funnel{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
.fs{background:var(--surface);box-shadow:inset 0 0 0 1px var(--line);border-radius:16px;padding:14px;display:grid;gap:6px}
.fs b{font-family:var(--display);font-weight:500;font-size:26px;color:var(--ink);font-variant-numeric:tabular-nums}
.fs span{font-size:13px;color:var(--muted)}
.chat{display:grid;grid-template-columns:260px minmax(0,1fr);min-height:640px;background:var(--surface);box-shadow:inset 0 0 0 1px var(--line);border-radius:16px;overflow:hidden}
.clist{border-right:1px solid var(--line);display:grid;align-content:start}
.clist button{text-align:left;padding:14px;border-bottom:1px solid var(--line);display:grid;gap:3px}
.clist button.on{background:var(--bg)}
.clist b{color:var(--ink)}
.clist span{color:var(--muted);font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pane{display:grid;grid-template-rows:auto 1fr auto;min-width:0}
.pane-h{padding:14px 16px;border-bottom:1px solid var(--line);display:flex;gap:12px;align-items:center}
.pane-h b{color:var(--ink)}
.back{display:none;font-weight:600;color:var(--red)}
.msgs{padding:16px;display:grid;align-content:start;gap:8px}
.msg{max-width:78%;padding:8px 12px;border-radius:14px;background:var(--bg);font-size:14.5px}
.msg.me{justify-self:end;background:var(--ink);color:var(--bg)}
.msg small{display:block;font-size:11px;font-weight:600;margin-bottom:2px;opacity:.65}
.reply{padding:12px 16px 16px;border-top:1px solid var(--line)}
.reply textarea{border:0;background:var(--bg);border-radius:12px;padding:10px 12px;min-height:72px;line-height:1.45}
.steps{display:grid}
.step{display:grid;grid-template-columns:28px minmax(0,1fr);gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}
.step i{font-style:normal;font-family:var(--display);color:var(--red);font-size:14px}
.step b{display:block;color:var(--ink)}
.step span{color:var(--muted);font-size:14px}
.wins{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.win{background:var(--surface);box-shadow:inset 0 0 0 1px var(--line);border-radius:16px;padding:14px;display:grid;gap:4px}
.win b{font-family:var(--display);font-weight:500;color:var(--ink)}
.plans{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.plan{text-align:left;background:var(--surface);box-shadow:inset 0 0 0 1px var(--line);border-radius:16px;padding:16px;display:grid;gap:6px;align-content:start}
.plan.on{box-shadow:inset 0 0 0 1.5px var(--red)}
.plan b{font-family:var(--display);font-weight:500;font-size:16px;color:var(--ink)}
.price{font-family:var(--display);font-size:22px;color:var(--ink);font-weight:500}
.pay-add{display:flex;gap:8px;align-items:center;padding-top:12px}
.pay-add input{height:40px;border:0;background:var(--surface);box-shadow:inset 0 0 0 1px var(--line);border-radius:12px;padding:0 12px;width:140px}
.pay-add button{height:40px;padding:0 14px;border-radius:999px;background:var(--ink);color:var(--bg);font-weight:600}
@media (max-width:800px){
  .app{grid-template-columns:minmax(0,1fr)}
  .side{position:sticky;top:0;height:auto;z-index:2;border-right:0;border-bottom:1px solid var(--line);padding:12px;gap:10px;background:var(--bg);min-width:0}
  .cab,.theme{display:none}
  .nav{display:flex;overflow-x:auto;gap:4px;min-width:0;max-width:100%}
  .nav button{white-space:nowrap;height:36px;flex:none}
  .main{padding:18px 16px 48px;min-width:0}
  h1{font-size:26px}
  .nums,.funnel,.wins,.plans{grid-template-columns:1fr 1fr}
  .photos{grid-template-columns:repeat(2,minmax(0,1fr))}
  .list button,.pay{grid-template-columns:1fr auto;gap:4px 12px}
  .list span{grid-column:1/-1}
  .chat{grid-template-columns:1fr;min-height:0}
  .chat.thread .clist{display:none}
  .chat:not(.thread) .pane{display:none}
  .back{display:inline}
  table{display:block;overflow-x:auto}
}
</style>
</head>
<body>
<div class="app">
  <aside class="side">
    <a class="brand" href="#dash">Cantor</a>
    <div class="cab"><b>Анна Смирнова</b><span>Математика ОГЭ/ЕГЭ</span></div>
    <nav class="nav" id="nav">
      <button type="button" data-v="dash">Дашборд <i id="wait-n">2</i></button>
      <button type="button" data-v="chats">Диалоги</button>
      <button type="button" data-v="ads">Объявления</button>
      <button type="button" data-v="stats">Аналитика</button>
      <button type="button" data-v="base">База</button>
      <button type="button" data-v="settings">Настройки</button>
    </nav>
    <button class="theme" type="button" id="theme">Тёмная тема</button>
  </aside>
  <main class="main">
    <section class="view" id="view-dash">
      <h1>Дашборд</h1>
      <div class="nums">
        <div><b>6 420 ₽</b><span>расход за 9–15 ноября</span></div>
        <div><b>318</b><span>просмотров</span></div>
        <div><b class="bad">9,1%</b><span>просмотров в контакт</span></div>
        <div><b>3 210 ₽</b><span>стоимость ученика</span></div>
      </div>
      <div class="list" id="queue"></div>
    </section>

    <section class="view" id="view-stats">
      <h1>9–15 ноября</h1>
      <div class="funnel">
        <div class="fs"><b>4 120</b><span>показов</span></div>
        <div class="fs"><b>318</b><span>просмотров · 7,7%</span></div>
        <div class="fs"><b class="bad">29</b><span>контактов · 9,1%</span></div>
        <div class="fs"><b>3</b><span>диагностики · 10%</span></div>
        <div class="fs"><b>2</b><span>оплаты</span></div>
      </div>
      <p>Объявление к ЕГЭ: 8 контактов на 140 просмотров. ОГЭ за ту же неделю — 11,8%.</p>
    </section>

    <section class="view" id="view-ads">
      <h1>Объявления</h1>
      <table>
        <thead>
          <tr><th>Объявление</th><th>Просмотры</th><th>Контакты</th><th>В контакт</th><th>Ставка</th><th>Место</th></tr>
        </thead>
        <tbody id="ads"></tbody>
      </table>
      <div class="detail" id="ad-detail"></div>
    </section>

    <section class="view" id="view-chats">
      <h1>Диалоги</h1>
      <div class="chat" id="chat">
        <div class="clist" id="chat-list"></div>
        <div class="pane">
          <div class="pane-h">
            <button class="back" type="button" id="back">Назад</button>
            <div><b id="chat-name"></b><div id="chat-meta" style="color:var(--muted);font-size:13px"></div></div>
          </div>
          <div class="msgs" id="msgs"></div>
          <div class="reply" id="reply"></div>
        </div>
      </div>
    </section>

    <section class="view" id="view-base">
      <h1>База</h1>
      <div>
        <h2>Оффер</h2>
        <p style="margin-top:8px">Диагностика 30 минут. На ней смотрим пробник или тетрадь и называем формат и цену. В переписке цены нет.</p>
      </div>
      <div class="steps">
        <div class="step"><i>1</i><div><b>Ответить сразу</b><span>Пока человек в чате, не через час.</span></div></div>
        <div class="step"><i>2</i><div><b>Класс и пробник</b><span>Экзамен или оценка, решал ли целиком.</span></div></div>
        <div class="step"><i>3</i><div><b>На «сколько стоит» — окно</b><span>Одно время, не «напишите, когда удобно».</span></div></div>
        <div class="step"><i>4</i><div><b>Молчит сутки — одно сообщение</b><span>Второе не пишем.</span></div></div>
        <div class="step"><i>5</i><div><b>Напоминание за 3 часа</b><span>Время и что взять: пробник или тетрадь.</span></div></div>
      </div>
      <div>
        <h2>Окна</h2>
        <div class="wins" style="margin-top:10px">
          <div class="win"><b>Вт 17:00</b><span>свободно</span></div>
          <div class="win"><b>Чт 19:00</b><span>19 ноября, Светлана</span></div>
          <div class="win"><b>Сб 12:00 и 16:00</b><span>21 ноября, свободно</span></div>
        </div>
      </div>
    </section>

    <section class="view" id="view-settings">
      <h1>Настройки</h1>
      <div class="plans" id="plans">
        <button class="plan" type="button" data-plan="constructor"><b>Конструктор</b><span class="price">от 1 990 ₽</span><span>Кабинет ведёте сами.</span></button>
        <button class="plan" type="button" data-plan="curator"><b>Всё включено</b><span class="price">9 990 ₽</span><span>С куратором.</span></button>
        <button class="plan" type="button" data-plan="premium"><b>Премиум</b><span class="price">под ключ</span><span>Команда в этом же кабинете.</span></button>
      </div>
      <div>
        <h2>Оплаты</h2>
        <div id="pays" style="margin-top:8px"></div>
        <form class="pay-add" id="pay-form">
          <input id="pay-sum" inputmode="numeric" placeholder="Кирилл, ₽" aria-label="Оплата Кирилла">
          <button type="submit">Внести</button>
        </form>
      </div>
    </section>
  </main>
</div>
<script>
(function () {
  var ads = [
    {id:"ege", title:"Математика ЕГЭ, с 60 до 80+", city:"Москва", views:"140", contacts:"8", rate:"5,7%", rateBad:true, bid:"42 ₽", place:"14", spend:"2 940 ₽",
      text:"Готовлю к профильному ЕГЭ: с школьных 50–60 к 80+. На первой встрече смотрю пробник и говорю, что закрывать первым. Цена — после диагностики, 30 минут.",
      photos:["Репетитор","Доска","Пробник","Баллы","Оффер","Отзыв","Формат","Расписание","Результат","Запись"], missing:0},
    {id:"oge", title:"ОГЭ, разбор ошибок", city:"Москва и область", views:"178", contacts:"21", rate:"11,8%", rateBad:false, bid:"28 ₽", place:"6", spend:"3 480 ₽",
      text:"ОГЭ по математике: разбираем ошибки, а не прорешиваем вариант подряд. На диагностике смотрю работу и называю, сколько занятий нужно до экзамена.",
      photos:["Ошибка","Доска","Репетитор","Формат","Оффер","Отзыв","Тетрадь","Баллы","Результат","Запись"], missing:0},
    {id:"alg", title:"Алгебра, 8 класс", city:"Не в показе", views:"—", contacts:"—", rate:"—", rateBad:false, bid:"—", place:"—", spend:"0 ₽",
      text:"Дроби, уравнения, оценка за четверть. В показ не стоит: нет четырёх фото.",
      photos:["Репетитор","Тетрадь","Тема","Формат","Оффер","Отзыв"], missing:4}
  ];
  var chats = {
    marina:{name:"Марина", meta:"ЕГЭ · ждёт ответ", last:"А сколько стоит подготовка?", wait:true,
      msgs:[["Марина","Здравствуйте. Дочь в 11 классе, пробник по профилю на 58. К ЕГЭ берёте?"],["Анна","Да, к профилю веду. Пробник решала целиком или отдельные номера?"],["Марина","Целиком, вторая часть почти пустая. А сколько стоит подготовка?"]],
      reply:"Цену назову на диагностике: за 30 минут посмотрим пробник и скажу, что закрывать первым. В четверг свободно в 19:00. Подойдёт?"},
    igor:{name:"Игорь", meta:"ОГЭ · ждёт ответ", last:"Можно в субботу?", wait:true,
      msgs:[["Игорь","Здравствуйте, сын в 9 классе, математика — тройка. Нужен ОГЭ."],["Анна","К ОГЭ беру. Удобно на 30 минут и посмотреть, где сыпется?"],["Игорь","Можно в субботу?"]],
      reply:"21 ноября есть 12:00 и 16:00. Какое записать?"},
    olga:{name:"Ольга", meta:"10 класс · нет ответа", last:"В среду в 18:00 свободно.", wait:false,
      msgs:[["Ольга","Добрый день. Дочь в 10 классе, алгебра проседает."],["Анна","Могу посмотреть тетрадь на диагностике. В среду, 18 ноября, свободно в 18:00."]],
      reply:"Ольга, окно в среду 18:00 ещё держу. Если неудобно — напишите день."},
    kirill:{name:"Кирилл", meta:"ОГЭ · диагностика была", last:"Вчера в 16:00", wait:false,
      msgs:[["Кирилл","Мы на 16:00. Тетрадь с собой."],["Анна","Жду. Ссылка на созвон в этом чате."]],
      reply:""},
    sveta:{name:"Светлана", meta:"ЕГЭ · чт 19 ноября, 19:00", last:"Записала на диагностику", wait:false,
      msgs:[["Светлана","Четверг в 19:00 нормально."],["Анна","Записала на 19 ноября, 19:00. На диагностике смотрим пробник."]],
      reply:""}
  };
  var order = ["marina","igor","olga","kirill","sveta"];
  var queue = [
    {chat:"marina", who:"Марина", what:"А сколько стоит подготовка?", tag:"ЕГЭ"},
    {chat:"igor", who:"Игорь", what:"Можно в субботу?", tag:"ОГЭ"},
    {chat:"olga", who:"Ольга", what:"Нет ответа на окно в среду", tag:"10 класс"},
    {chat:"kirill", who:"Кирилл", what:"Диагностика была, оплаты нет", tag:"вчера"}
  ];

  var views = ["dash","chats","ads","stats","base","settings"];
  var nav = document.getElementById("nav");
  var chatBox = document.getElementById("chat");
  var currentChat = "marina";

  function show(id) {
    if (views.indexOf(id) < 0) id = "dash";
    document.querySelectorAll(".view").forEach(function (v) { v.classList.toggle("on", v.id === "view-" + id); });
    nav.querySelectorAll("button").forEach(function (b) { b.classList.toggle("on", b.getAttribute("data-v") === id); });
    if (location.hash !== "#" + id) history.replaceState(null, "", "#" + id);
  }
  nav.addEventListener("click", function (e) {
    var b = e.target.closest("button");
    if (b) show(b.getAttribute("data-v"));
  });

  document.getElementById("queue").innerHTML = queue.map(function (q) {
    return '<button type="button" data-chat="'+q.chat+'"><b>'+q.who+'</b><span>'+q.what+'</span><em>'+q.tag+'</em></button>';
  }).join("");
  document.getElementById("queue").addEventListener("click", function (e) {
    var b = e.target.closest("[data-chat]");
    if (!b) return;
    show("chats");
    openChat(b.getAttribute("data-chat"), true);
  });

  function renderAds(active) {
    document.getElementById("ads").innerHTML = ads.map(function (a) {
      return '<tr data-ad="'+a.id+'"'+(a.id===active?' class="on"':'')+'><td><b>'+a.title+'</b><div style="color:var(--muted);font-size:13px">'+a.city+'</div></td><td>'+a.views+'</td><td>'+a.contacts+'</td><td class="'+(a.rateBad?'bad':'')+'">'+a.rate+'</td><td>'+a.bid+'</td><td>'+a.place+'</td></tr>';
    }).join("");
    var a = ads.filter(function (x) { return x.id === active; })[0];
    var slots = a.photos.map(function (name, i) {
      return '<div class="ph"><b>'+(i+1)+'</b>'+name+'</div>';
    }).join("");
    for (var i = 0; i < a.missing; i++) slots += '<div class="ph off">'+(a.photos.length+i+1)+'</div>';
    document.getElementById("ad-detail").innerHTML = '<p>'+a.text+'</p><p style="color:var(--muted)">'+a.spend+' за неделю · автобидер выключен</p><div class="photos">'+slots+'</div>';
  }
  var adNow = "ege";
  renderAds(adNow);
  document.getElementById("ads").addEventListener("click", function (e) {
    var tr = e.target.closest("[data-ad]");
    if (!tr) return;
    adNow = tr.getAttribute("data-ad");
    renderAds(adNow);
  });

  function openChat(id, enter) {
    currentChat = id;
    var c = chats[id];
    document.getElementById("chat-list").querySelectorAll("button").forEach(function (b) {
      b.classList.toggle("on", b.getAttribute("data-chat") === id);
    });
    if (enter) chatBox.classList.add("thread");
    document.getElementById("chat-name").textContent = c.name;
    document.getElementById("chat-meta").textContent = c.meta;
    var msgs = document.getElementById("msgs");
    msgs.replaceChildren();
    c.msgs.forEach(function (m) {
      var el = document.createElement("div");
      el.className = "msg" + (m[0] === "Анна" ? " me" : "");
      var who = document.createElement("small");
      who.textContent = m[0];
      el.appendChild(who);
      el.appendChild(document.createTextNode(m[1]));
      msgs.appendChild(el);
    });
    var slot = document.getElementById("reply");
    slot.replaceChildren();
    if (!c.reply) return;
    var area = document.createElement("textarea");
    area.value = c.reply;
    area.setAttribute("aria-label", "Ответ");
    area.addEventListener("input", function () { c.reply = area.value; });
    slot.appendChild(area);
  }
  document.getElementById("chat-list").innerHTML = order.map(function (id) {
    var c = chats[id];
    return '<button type="button" data-chat="'+id+'"><b>'+c.name+'</b><span>'+c.last+'</span></button>';
  }).join("");
  document.getElementById("chat-list").addEventListener("click", function (e) {
    var b = e.target.closest("[data-chat]");
    if (b) openChat(b.getAttribute("data-chat"), true);
  });
  document.getElementById("back").addEventListener("click", function () { chatBox.classList.remove("thread"); });
  openChat("marina", false);

  var pays = [];
  try { pays = JSON.parse(localStorage.getItem("platform.pays") || "[]"); } catch (e) {}
  if (!Array.isArray(pays)) pays = [];
  function renderPays() {
    var base = '<div class="pay"><b>10 ноября</b><span>ЕГЭ, после диагностики</span><em>4 800 ₽</em></div>'
      + '<div class="pay"><b>12 ноября</b><span>ОГЭ, после диагностики</span><em>4 800 ₽</em></div>';
    document.getElementById("pays").innerHTML = base + pays.map(function (n) {
      return '<div class="pay"><b>Кирилл</b><span>диагностика 14 ноября</span><em>'+n+' ₽</em></div>';
    }).join("");
  }
  renderPays();
  document.getElementById("pay-form").addEventListener("submit", function (e) {
    e.preventDefault();
    var raw = document.getElementById("pay-sum").value.replace(/\s/g, "").replace(",", ".");
    var n = Math.round(Number(raw));
    if (!n || n < 0) return;
    pays.push(n.toLocaleString("ru-RU"));
    try { localStorage.setItem("platform.pays", JSON.stringify(pays)); } catch (err) {}
    document.getElementById("pay-sum").value = "";
    renderPays();
  });

  document.querySelectorAll(".plan").forEach(function (p) {
    var saved = "";
    try { saved = localStorage.getItem("platform.plan") || "constructor"; } catch (e) { saved = "constructor"; }
    p.classList.toggle("on", p.getAttribute("data-plan") === saved);
  });
  document.getElementById("plans").addEventListener("click", function (e) {
    var b = e.target.closest("[data-plan]");
    if (!b) return;
    document.querySelectorAll(".plan").forEach(function (p) { p.classList.remove("on"); });
    b.classList.add("on");
    try { localStorage.setItem("platform.plan", b.getAttribute("data-plan")); } catch (err) {}
  });

  var themeBtn = document.getElementById("theme");
  function paintTheme() {
    var dark = document.documentElement.dataset.theme === "dark" ||
      (!document.documentElement.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
    themeBtn.textContent = dark ? "Светлая тема" : "Тёмная тема";
  }
  themeBtn.addEventListener("click", function () {
    var dark = document.documentElement.dataset.theme === "dark" ||
      (!document.documentElement.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
    var next = dark ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem("platform.theme", next); } catch (e) {}
    paintTheme();
  });
  paintTheme();

  var initial = (location.hash || "#dash").slice(1);
  show(views.indexOf(initial) >= 0 ? initial : "dash");
  window.addEventListener("hashchange", function () {
    var id = location.hash.slice(1);
    if (views.indexOf(id) >= 0) show(id);
  });
})();
</script>
</body>
</html>
