  </main>
</div>
<div id="modal" class="modal-bg hide"><div class="card modal" id="modalIn"></div></div>
<div id="toast" class="toast hide"></div>

<script>
'use strict';
// Страница на cantor.agency, API — в воркере Cloudflare. На cantor.agency запросы идут через функцию
// Яндекс Облака (пропускает /api/dashboard/*), если она не ответила — напрямую в воркер.
const API_BASE = 'https://mainweb.oxion-ezhkov.workers.dev';
const API_PROXY_URL = 'https://functions.yandexcloud.net/d4eiu56ijlg0jn5o9rch';
const API_PATH = '/api/dashboard/ai-sales/';
const ROUTES = (() => {
  const host = location.hostname;
  const same = (p) => location.origin + p;
  const direct = (p) => API_BASE + p;
  const proxy = (p) => API_PROXY_URL + '?p=' + encodeURIComponent(p);
  if (host === 'localhost' || host === '127.0.0.1') return [same];
  if (/workers\.dev$/.test(host)) return [same, proxy];
  return [proxy, direct];
})();
let routeFirst = 0;
const store = {
  get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } },
  set(k, v) { try { localStorage.setItem(k, v); } catch (e) {} },
  del(k) { try { localStorage.removeItem(k); } catch (e) {} },
};

const S = {
  pw: store.get('aiSales.pw') || '',
  state: null, acc: store.get('aiSales.acc') || '', tab: 'dialogs',
  chats: [], chatId: null, chat: null, filter: 'all', q: '',
  sims: [], simId: null, sim: null, prompt: null, defaults: null,
  busy: {}, editing: null,
};

async function api(action, { method = 'GET', body, params } = {}) {
  const qs = new URLSearchParams(Object.assign({ accountId: S.acc }, params || {})).toString();
  const path = API_PATH + action + (qs ? '?' + qs : '');
  let lastErr;
  for (let n = 0; n < ROUTES.length; n += 1) {
    const idx = (routeFirst + n) % ROUTES.length;
    try {
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 32000);
      const res = await fetch(ROUTES[idx](path), {
        method, signal: ctrl.signal,
        headers: { 'Content-Type': 'application/json', 'x-dashboard-password': S.pw },
        body: body ? JSON.stringify(Object.assign({ accountId: S.acc }, body)) : undefined,
      });
      clearTimeout(timer);
      const data = await res.json().catch(() => ({}));
      if ((res.status === 502 || res.status === 504) && !data.error && n < ROUTES.length - 1) continue;
      routeFirst = idx;
      if (res.status === 401) { showGate('Неверный пароль'); throw new Error('unauthorized'); }
      if (!res.ok) throw new Error(data.message || data.error || ('HTTP ' + res.status));
      return data;
    } catch (e) { lastErr = e; if (e.message === 'unauthorized') throw e; }
  }
  throw lastErr || new Error('network');
}

// Задачи ИИ: сервер ждёт до 20 с, дальше страница сама спрашивает, готово ли.
async function waitJob(job) {
  const t0 = Date.now();
  while (job && (job.status === 'running' || job.status === 'queued') && Date.now() - t0 < 180000) {
    await new Promise((r) => setTimeout(r, 2500));
    job = (await api('job', { params: { id: job.id } })).job;
  }
  if (!job || job.status === 'running' || job.status === 'queued') throw new Error('ИИ отвечает слишком долго — попробуйте ещё раз или другую модель');
  if (job.status === 'error') throw new Error(job.error || 'ошибка ИИ');
  return job.result;
}

// ── utils ──
const $ = (s, r) => (r || document).querySelector(s);
const $$ = (s, r) => Array.from((r || document).querySelectorAll(s));
const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const linkify = (t) => esc(t).replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1" target="_blank" rel="noopener">$1</a>');
function toast(msg, ms) { const t = $('#toast'); t.textContent = msg; t.classList.remove('hide'); clearTimeout(toast.t); toast.t = setTimeout(() => t.classList.add('hide'), ms || 3200); }
function fmtTime(ts) {
  if (!ts) return '';
  const d = new Date(ts), now = new Date();
  const hm = d.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
  if (d.toDateString() === now.toDateString()) return hm;
  const y = new Date(now); y.setDate(now.getDate() - 1);
  if (d.toDateString() === y.toDateString()) return 'вчера';
  return d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' });
}
function fmtDay(ts) { return new Date(ts).toLocaleDateString('ru-RU', { weekday: 'short', day: 'numeric', month: 'long' }); }
function ago(ts) { if (!ts) return 'ещё не обновлялось'; const m = Math.round((Date.now() - ts) / 60000); return m < 1 ? 'только что' : m < 60 ? m + ' мин назад' : Math.round(m / 60) + ' ч назад'; }
function initials(n) { return (String(n || '?').trim().split(/\s+/).map((x) => x[0]).join('').slice(0, 2) || '?').toUpperCase(); }
function modelLabel(ref) { const m = (S.state.models || []).find((x) => x.ref === ref); return m ? m.label.replace(/ \(.*\)$/, '') : String(ref || '').replace(/^[^:]+:/, '').replace(/^@cf\/[^/]+\//, ''); }
function modelOptions(sel, withDefault) {
  return (withDefault ? `<option value="">По умолчанию (${esc(modelLabel(S.state.config.defaultModel))})</option>` : '') +
    S.state.models.map((m) => `<option value="${esc(m.ref)}"${m.ref === sel ? ' selected' : ''}>${esc(m.label)}</option>`).join('');
}
function stageOptions(sel) { return '<option value="">Этап: авто</option>' + Object.entries(S.state.stages).map(([k, v]) => `<option value="${k}"${k === sel ? ' selected' : ''}>${esc(v)}</option>`).join(''); }
function stageChip(k) {
  if (!k) return '';
  const cls = { booked: 'green', messenger: 'green', lost: 'red', spam: 'red', offer: 'blue', cold: 'amber' }[k] || '';
  return `<span class="chip ${cls}">${esc(S.state.stages[k] || k)}</span>`;
}

// ── gate / boot ──
function showGate(err) {
  $('#app').classList.add('hide'); $('#gate').classList.remove('hide');
  $('#gateErr').classList.toggle('hide', !err); $('#gateErr').textContent = err || '';
}
$('#gateForm').addEventListener('submit', async (e) => {
  e.preventDefault(); S.pw = $('#pw').value.trim(); store.set('aiSales.pw', S.pw); boot();
});
async function boot() {
  if (!S.pw) return showGate();
  try { await loadState(); } catch (e) { if (e.message !== 'unauthorized') showGate('Не удалось загрузить: ' + e.message); return; }
  $('#gate').classList.add('hide'); $('#app').classList.remove('hide');
  const h = location.hash.replace('#', '');
  if (['dialogs', 'sim', 'prompt', 'models', 'learn'].includes(h)) setTab(h);
  await loadChats();
  firstImport();
  setInterval(() => { if (!document.hidden && S.tab === 'dialogs') loadChats(true); }, 60000);
  setInterval(() => { if (!document.hidden) syncOnce(true); }, 180000);
}
async function loadState() {
  S.state = await api('state', { params: { accountId: S.acc || '' } });
  const cabs = S.state.config.cabinets;
  if (!cabs.some((c) => c.accountId === S.acc)) S.acc = cabs[0] ? cabs[0].accountId : '';
  store.set('aiSales.acc', S.acc);
  $('#cabSel').innerHTML = cabs.map((c) => `<option value="${esc(c.accountId)}"${c.accountId === S.acc ? ' selected' : ''}>${esc(c.name)}</option>`).join('');
  renderSyncInfo();
}
function cab() { return S.state.config.cabinets.find((c) => c.accountId === S.acc) || {}; }
function renderSyncInfo() { const c = cab(); $('#syncInfo').textContent = 'Авито: ' + ago(c.lastSyncAt); }
$('#cabSel').addEventListener('change', async (e) => { S.acc = e.target.value; store.set('aiSales.acc', S.acc); S.chatId = null; S.simId = null; await loadChats(); firstImport(); setTab(S.tab); });

$('#themeBtn').addEventListener('click', () => {
  const cur = document.documentElement.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  const next = cur === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = next; store.set('aiSales.theme', next);
});

// ── tabs ──
$('#tabs').addEventListener('click', (e) => { const b = e.target.closest('[data-tab]'); if (b) setTab(b.dataset.tab); });
function setTab(t) {
  S.tab = t; history.replaceState(null, '', '#' + t);
  $$('#tabs .tab').forEach((b) => b.classList.toggle('on', b.dataset.tab === t));
  ['dialogs', 'sim', 'prompt', 'models', 'learn'].forEach((x) => $('#t-' + x).classList.toggle('hide', x !== t));
  if (t === 'sim') loadSims();
  if (t === 'prompt') loadPrompt();
  if (t === 'models') renderModels();
  if (t === 'learn') loadLearn();
}

// ── sync ──
async function syncOnce(quiet) {
  if (S.busy.sync) return;
  S.busy.sync = true; $('#syncBtn').disabled = true;
  try {
    const r = await api('sync', { method: 'POST', body: {} });
    if (r.errors && r.errors.length && !quiet) toast('Часть чатов не загрузилась: ' + r.errors[0]);
    await loadChats(true);
    return r;
  } catch (e) { if (!quiet) toast('Авито не ответил: ' + e.message); return null; }
  finally { S.busy.sync = false; $('#syncBtn').disabled = false; await refreshCab(); }
}
async function refreshCab() { try { const st = await api('state'); S.state = st; renderSyncInfo(); } catch (e) {} }
$('#syncBtn').addEventListener('click', () => fullSync());
// Первая загрузка: история с даты подключения кабинета, порциями по ~15 секунд.
async function fullSync() {
  const bar = $('#prog'); bar.classList.remove('hide');
  let guard = 0;
  while (guard++ < 80) {
    const r = await syncOnce(guard > 1);
    if (!r) break;
    const done = r.total - r.remaining;
    bar.firstElementChild.style.width = (r.total ? Math.round(done / r.total * 100) : 100) + '%';
    $('#syncInfo').textContent = `Загружено ${done} из ${r.total} диалогов…`;
    if (r.imported && r.remaining === 0) break;
  }
  bar.classList.add('hide'); renderSyncInfo();
}
function firstImport() { const c = cab(); if (!c.imported || !c.chats || c.lastSyncAt == null || Date.now() - c.lastSyncAt > 15 * 60000) fullSync(); }

// ── dialogs list ──
async function loadChats(quiet) {
  try {
    const r = await api('chats');
    S.chats = r.chats || [];
    renderList();
    const typing = document.activeElement && $('#chat').contains(document.activeElement) && /INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName);
    if (S.chatId && !S.editing && !typing) openChat(S.chatId, true);
  } catch (e) { if (!quiet) toast('Не удалось загрузить диалоги: ' + e.message); }
}
$('#q').addEventListener('input', (e) => { S.q = e.target.value.toLowerCase(); renderList(); });
$('#filters').addEventListener('click', (e) => { const b = e.target.closest('[data-f]'); if (!b) return; S.filter = b.dataset.f; $$('#filters button').forEach((x) => x.classList.toggle('on', x === b)); renderList(); });
function chatMatches(c) {
  if (S.q && !(`${c.name} ${c.itemTitle} ${c.lastText}`.toLowerCase().includes(S.q))) return false;
  if (S.filter === 'waiting') return c.waiting;
  if (S.filter === 'draft') return c.hasDraft && !c.draftReviewed;
  if (S.filter === 'human') return c.draftNeedsHuman && !c.draftReviewed;
  if (S.filter === 'reviewed') return c.draftReviewed;
  return true;
}
function renderList() {
  const waiting = S.chats.filter((c) => c.waiting).length;
  $('#nWaiting').textContent = waiting; $('#nWaiting').classList.toggle('hide', !waiting);
  const list = S.chats.filter(chatMatches);
  $('#items').innerHTML = list.length ? list.map((c) => {
    const st = c.stage || c.aiStage;
    const badges = [
      c.waiting ? '<span class="chip accent">ждёт ответа</span>' : '',
      c.hasDraft && !c.draftReviewed ? '<span class="chip blue">черновик ИИ</span>' : '',
      c.draftReviewed ? '<span class="chip green">проверен</span>' : '',
      c.draftNeedsHuman && !c.draftReviewed ? '<span class="chip amber">нужен человек</span>' : '',
      stageChip(st),
    ].join('');
    return `<div class="item${c.chatId === S.chatId ? ' on' : ''}" data-id="${esc(c.chatId)}">
      <div class="ava">${c.avatar ? `<img src="${esc(c.avatar)}" alt="" loading="lazy" onerror="this.replaceWith(document.createTextNode('•'))">` : esc(initials(c.name))}</div>
      <div style="min-width:0"><div class="nm">${esc(c.name || 'Без имени')}</div><div class="it">${esc(c.itemTitle || '')}</div>
        <div class="lt">${c.lastAuthor === 'manager' ? '<span class="faint">Вы: </span>' : ''}${esc(c.lastText || (c.stale ? 'загружается…' : ''))}</div>
        <div class="bd">${badges}</div></div>
      <div class="tm">${esc(fmtTime(c.lastAt || c.updated * 1000))}${c.waiting ? '<br><span class="dot"></span>' : ''}</div>
    </div>`;
  }).join('') : `<div class="empty">${S.chats.length ? 'Ничего не найдено' : 'Диалоги загружаются из Авито…'}</div>`;
}
$('#items').addEventListener('click', (e) => { const it = e.target.closest('.item'); if (it) openChat(it.dataset.id); });

// ── one chat ──
async function openChat(id, refresh) {
  if (!refresh) { S.chatId = id; S.editing = null; renderList(); $('#t-dialogs').classList.add('open'); $('#chat').innerHTML = '<div class="empty"><span class="spin"></span></div>'; }
  try {
    const r = await api('chat', { params: { chatId: id } });
    if (S.chatId !== id) return;
    S.chat = r.chat; renderChat(!refresh);
  } catch (e) { if (!refresh) $('#chat').innerHTML = `<div class="empty">Диалог ещё не загружен: ${esc(e.message)}</div>`; }
}
function bubbles(messages, extra) {
  let lastDay = '', out = '';
  messages.forEach((m) => {
    const day = new Date(m.at).toDateString();
    if (day !== lastDay) { out += `<div class="day">${esc(fmtDay(m.at))}</div>`; lastDay = day; }
    const cls = m.author === 'manager' ? 'manager' : m.author === 'system' ? 'system' : 'client';
    out += `<div class="b ${cls}">${linkify(m.text)}<span class="tm">${esc(new Date(m.at).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' }))}</span>${extra ? extra(m) : ''}</div>`;
  });
  return out;
}
function renderChat(scroll) {
  const c = S.chat;
  const idxEntry = S.chats.find((x) => x.chatId === c.chatId) || {};
  const msgs = c.messages || [];
  const lastMeaningful = [...msgs].reverse().find((m) => m.author !== 'system' || /заинтересовал/i.test(m.text));
  const d = c.draft;
  const outdated = d && lastMeaningful && d.forMsgId && d.forMsgId !== lastMeaningful.id;
  $('#chat').innerHTML = `
    <div class="chat-head">
      <button class="btn sm back" id="backBtn">←</button>
      <div class="ava">${c.avatar ? `<img src="${esc(c.avatar)}" alt="" onerror="this.replaceWith(document.createTextNode('•'))">` : esc(initials(c.name))}</div>
      <div style="min-width:0;flex:1"><div class="t">${esc(c.name || 'Без имени')}</div>
        <div class="s">${c.itemUrl ? `<a href="${esc(c.itemUrl)}" target="_blank" rel="noopener">${esc(c.itemTitle)}</a>` : esc(c.itemTitle || '')}</div></div>
      <select class="select" id="cStage" style="width:auto">${stageOptions(c.stage || '')}</select>
      <select class="select" id="cModel" style="width:auto;max-width:240px" title="Модель для этого диалога">${modelOptions(c.model || '', true)}</select>
    </div>
    <div class="msgs" id="msgs">${bubbles(msgs)}${d && d.reply && !d.review ? `<div class="b ai">${esc(d.reply)}<span class="tm">черновик ИИ — не отправлен</span></div>` : ''}</div>
    <div class="draft">${draftPanel(d, outdated, idxEntry)}
      <details class="why note"><summary>Заметка по диалогу (видит ИИ)</summary><textarea class="input" id="cNote" rows="2" placeholder="Например: мама просила писать только после 18:00">${esc(c.note || '')}</textarea><button class="btn sm" id="cNoteSave" style="margin-top:6px">Сохранить заметку</button></details>
    </div>`;
  if (scroll !== false) { const m = $('#msgs'); m.scrollTop = m.scrollHeight; }
  bindChat();
}
function draftPanel(d, outdated, idxEntry) {
  if (S.busy.draft === S.chatId) return '<div class="draft-h"><span class="spin"></span> ИИ читает историю, базу знаний и пишет ответ…</div>';
  if (!d) {
    return `<div class="draft-h">Черновика ещё нет${idxEntry.waiting ? ' · клиент ждёт ответа' : ''}</div>
      <div class="draft-actions"><button class="btn accent" data-a="gen">✦ Предложить ответ</button><button class="btn" data-a="cmp">⚖ Сравнить модели</button></div>`;
  }
  const rv = d.review;
  const sc = d.selfCheck;
  const scChip = !sc ? '' : sc.ok === true ? '<span class="chip green">самопроверка ✓</span>' : sc.ok === false ? '<span class="chip amber">исправлен самопроверкой</span>' : '<span class="chip">самопроверка не прошла</span>';
  let html = '';
  if (outdated) html += '<div class="warnbox">После черновика пришли новые сообщения — сделайте новый вариант.</div>';
  if (d.needsHuman) html += `<div class="warnbox">Нужен человек: ${esc(d.humanReason || 'ИИ не уверен')}</div>`;
  html += `<div class="draft-h"><b>Черновик ИИ</b><span>${esc(modelLabel(d.model))}</span><span>${(d.ms / 1000).toFixed(1)} с</span>${scChip}${d.stage ? stageChip(d.stage) : ''}${d.confidence ? `<span class="chip">уверенность ${Math.round(d.confidence * 100)}%</span>` : ''}${rv ? `<span class="chip ${rv.action === 'approve' ? 'green' : rv.action === 'edit' ? 'blue' : 'red'}">${rv.action === 'approve' ? 'одобрен' : rv.action === 'edit' ? 'исправлен' : 'не отвечать'}</span>` : ''}</div>`;
  if (S.editing === d.id) {
    html += `<textarea class="input" id="edText" rows="4">${esc(rv && rv.text ? rv.text : d.reply)}</textarea>
      <input class="input" id="edWhy" placeholder="Почему так (необязательно): ИИ учтёт в следующий раз" style="margin-top:6px">
      <div class="draft-actions"><button class="btn primary" data-a="saveEdit">Сохранить правку</button><button class="btn" data-a="cancelEdit">Отмена</button></div>`;
  } else {
    html += d.needsReply === false && !d.reply ? '<div class="draft-text muted">ИИ считает, что отвечать не нужно.</div>' : `<div class="draft-text">${esc(rv && rv.action === 'edit' ? rv.text : d.reply)}</div>`;
    html += `<div class="draft-actions">
      <button class="btn good" data-a="approve" title="Ответ правильный — запомнить как хороший пример">✓ Верно</button>
      <button class="btn" data-a="edit">✎ Исправить</button>
      <button class="btn warn" data-a="reject" title="Здесь не нужно отвечать">✕ Не отвечать</button>
      <button class="btn" data-a="regen">↻ Новый вариант</button>
      <button class="btn" data-a="cmp">⚖ Сравнить модели</button>
      <button class="btn" data-a="copy">⧉ Копировать</button></div>`;
  }
  html += `<details class="why"><summary>Как ИИ думал</summary>
    ${d.analysis ? `<p style="margin-top:6px">${esc(d.analysis)}</p>` : ''}
    ${d.checks && d.checks.length ? `<ul>${d.checks.map((x) => `<li>${esc(x)}</li>`).join('')}</ul>` : ''}
    ${sc && sc.issues && sc.issues.length ? `<p style="margin-top:6px"><b>Самопроверка нашла:</b></p><ul>${sc.issues.map((x) => `<li>${esc(x)}</li>`).join('')}</ul>` : ''}
    ${d.firstReply ? `<p style="margin-top:6px">До самопроверки: <span class="old">${esc(d.firstReply)}</span></p>` : ''}
    ${d.instruction ? `<p>Пожелание: ${esc(d.instruction)}</p>` : ''}
    ${(S.chat.drafts || []).length > 1 ? `<p style="margin-top:6px"><b>Прошлые варианты:</b></p><ul>${S.chat.drafts.slice(1, 6).map((x) => `<li><span class="faint">${esc(modelLabel(x.model))}:</span> ${esc(x.reply)}</li>`).join('')}</ul>` : ''}
  </details>`;
  return html;
}
function bindChat() {
  const c = S.chat;
  $('#backBtn').onclick = () => { $('#t-dialogs').classList.remove('open'); };
