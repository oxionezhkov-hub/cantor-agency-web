  $('#lModels').innerHTML = Object.keys(byModel).length ? 'По моделям: ' + Object.entries(byModel).map(([k, v]) => `${esc(modelLabel(k))} — ${v.a}/${v.t} верно`).join(' · ') : '';
  $('#lList').innerHTML = fb.length ? fb.map((f) => `<div class="fb">
    <div class="row"><span class="chip ${f.action === 'approve' ? 'green' : f.action === 'edit' ? 'blue' : 'red'}">${f.action === 'approve' ? 'верно' : f.action === 'edit' ? 'исправлено' : 'не отвечать'}</span><span class="small muted">${esc(new Date(f.at).toLocaleString('ru-RU'))} · ${f.source === 'sim' ? 'тест-клиент' : 'диалог'} · ${esc(modelLabel(f.model))}</span><span class="grow"></span><button class="icon-btn sm" data-fbdel="${esc(f.key)}" title="Удалить" aria-label="Удалить" style="color:var(--red)">${I('trash', 'ic-sm')}</button></div>
    ${f.lastClient ? `<div class="small"><span class="muted">Клиент:</span> ${esc(f.lastClient)}</div>` : ''}
    <div class="pair"><div><span class="lbl">ИИ</span>${esc(f.aiText)}</div><div><span class="lbl">Как надо</span>${esc(f.action === 'reject' ? '(не отвечать)' : f.finalText)}</div></div>
    ${f.comment ? `<div class="small"><span class="muted">Почему:</span> ${esc(f.comment)}</div>` : ''}</div>`).join('') : emptyState('chart', 'Оценок пока нет', 'Откройте диалог и оцените черновик ИИ: «Верно», «Исправить» или «Не отвечать»');
  $$('[data-fbdel]').forEach((b) => b.onclick = async () => { await api('feedback', { method: 'DELETE', body: { key: b.dataset.fbdel } }); loadLearn(); });
}

boot();
</script>
</body>
</html>
