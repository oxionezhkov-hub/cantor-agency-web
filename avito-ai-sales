<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="robots" content="noindex, nofollow">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#F4F3F0" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)">
<script>
  try { var t = localStorage.getItem('aiSales.theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
</script>
<title>Avito AI Sales</title>
<link rel="preload" href="/fonts/geologica-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="icon" type="image/svg+xml" href="/images/brand/favicon.svg">
<style>
:root{
  --accent:#E8391D;--accent-600:#C42D13;--accent-bg:#FFF0EB;--accent-ring:rgba(232,57,29,.16);
  --bg:#F4F3F0;--surface:#fff;--surface-2:#FAF9F7;--sunken:#EFEDE9;
  --line:#E5E2DD;--line-2:#EEECE8;
  --ink:#151515;--text:#2A2927;--muted:#76716A;--faint:#A7A29B;
  --green:#1C8048;--green-bg:#E6F4EC;--amber:#B06500;--amber-bg:#FFF2DA;--blue:#2556C4;--blue-bg:#E9EFFC;--red:#D5311A;--red-bg:#FDEBE7;
  --me:#1F1E1C;--me-text:#F4F2EE;
  --shadow:0 1px 2px rgba(22,20,18,.04),0 3px 12px rgba(22,20,18,.045);
  --shadow-lg:0 18px 48px rgba(22,20,18,.16);
  --r:14px;--r-sm:10px;
  --font:'Geologica',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  --display:'Unbounded','Geologica',sans-serif;
  color-scheme:light;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --accent:#FF5A3C;--accent-600:#FF7A60;--accent-bg:#3A1C15;--accent-ring:rgba(255,90,60,.22);
    --bg:#121211;--surface:#1B1A19;--surface-2:#201F1D;--sunken:#161514;
    --line:#2E2C2A;--line-2:#282624;
    --ink:#F4F2EE;--text:#DEDAD4;--muted:#A19B93;--faint:#6E6962;
    --green:#4CC784;--green-bg:#133222;--amber:#F2A93B;--amber-bg:#35270D;--blue:#7FA2F5;--blue-bg:#18264A;--red:#FF6F57;--red-bg:#3D1812;
    --me:#2C2A27;--me-text:#F4F2EE;
    --shadow:0 1px 2px rgba(0,0,0,.3);--shadow-lg:0 18px 48px rgba(0,0,0,.5);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --accent:#FF5A3C;--accent-600:#FF7A60;--accent-bg:#3A1C15;--accent-ring:rgba(255,90,60,.22);
  --bg:#121211;--surface:#1B1A19;--surface-2:#201F1D;--sunken:#161514;
  --line:#2E2C2A;--line-2:#282624;
  --ink:#F4F2EE;--text:#DEDAD4;--muted:#A19B93;--faint:#6E6962;
  --green:#4CC784;--green-bg:#133222;--amber:#F2A93B;--amber-bg:#35270D;--blue:#7FA2F5;--blue-bg:#18264A;--red:#FF6F57;--red-bg:#3D1812;
  --me:#2C2A27;--me-text:#F4F2EE;
  --shadow:0 1px 2px rgba(0,0,0,.3);--shadow-lg:0 18px 48px rgba(0,0,0,.5);
  color-scheme:dark;
}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%}
body{font-family:var(--font);font-size:14.5px;line-height:1.5;color:var(--text);background:var(--bg);-webkit-font-smoothing:antialiased;min-height:100vh;overflow-x:hidden}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer;border:0;background:none}
a{color:var(--blue)}
.hide{display:none!important}
.muted{color:var(--muted)}.faint{color:var(--faint)}.small{font-size:12.5px}
.btn{display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 13px;border-radius:999px;border:1px solid var(--line);background:var(--surface);font-size:13.5px;font-weight:500;white-space:nowrap;transition:background .12s,border-color .12s}
.btn:hover{border-color:var(--faint)}
.btn.primary{background:var(--ink);border-color:var(--ink);color:var(--bg)}
.btn.accent{background:var(--accent);border-color:var(--accent);color:#fff}
.btn.good{background:var(--green-bg);border-color:transparent;color:var(--green)}
.btn.warn{background:var(--red-bg);border-color:transparent;color:var(--red)}
.btn.sm{height:28px;padding:0 10px;font-size:12.5px}
.btn:disabled{opacity:.5;cursor:default}
.input,.select,textarea.input{width:100%;border:1px solid var(--line);background:var(--surface);border-radius:var(--r-sm);padding:8px 11px;outline:none;font-size:14px}
.input:focus,textarea.input:focus,.select:focus{border-color:var(--ink);box-shadow:0 0 0 3px var(--accent-ring)}
textarea.input{resize:vertical;min-height:70px;line-height:1.45}
.select{height:34px;padding:0 10px}
label.f{display:block;font-size:12.5px;color:var(--muted);margin:10px 0 4px}
.card{background:var(--surface);border:1px solid var(--line-2);border-radius:var(--r);box-shadow:var(--shadow)}
.chip{display:inline-flex;align-items:center;gap:5px;height:22px;padding:0 8px;border-radius:999px;font-size:11.5px;font-weight:500;background:var(--sunken);color:var(--muted);white-space:nowrap}
.chip.accent{background:var(--accent-bg);color:var(--accent)}
.chip.green{background:var(--green-bg);color:var(--green)}
.chip.amber{background:var(--amber-bg);color:var(--amber)}
.chip.blue{background:var(--blue-bg);color:var(--blue)}
.chip.red{background:var(--red-bg);color:var(--red)}

/* top */
.top{position:sticky;top:0;z-index:30;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:saturate(1.4) blur(14px);-webkit-backdrop-filter:saturate(1.4) blur(14px);border-bottom:1px solid var(--line-2)}
.top-in{display:flex;align-items:center;gap:12px;padding:10px 20px;flex-wrap:wrap}
.logo{font-family:var(--display);font-weight:600;font-size:15px;letter-spacing:-.01em;color:var(--ink);display:flex;align-items:center;gap:8px}
.logo i{width:10px;height:10px;border-radius:3px;background:var(--accent);display:inline-block}
.tabs{display:flex;gap:4px;flex-wrap:wrap}
.tab{height:32px;padding:0 12px;border-radius:999px;font-size:13.5px;color:var(--muted);font-weight:500}
.tab.on{background:var(--ink);color:var(--bg)}
.tab .n{display:inline-grid;place-items:center;min-width:18px;height:18px;padding:0 5px;border-radius:999px;background:var(--accent);color:#fff;font-size:11px;margin-left:5px}
.grow{flex:1}
.safe{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--green);background:var(--green-bg);padding:4px 10px;border-radius:999px;font-weight:500}
.sync{font-size:12.5px;color:var(--muted);display:flex;align-items:center;gap:8px}
.progress{height:3px;background:var(--line-2);position:relative;overflow:hidden}
.progress b{position:absolute;inset:0 auto 0 0;background:var(--accent);transition:width .3s}

main{padding:16px 20px 40px;max-width:1500px;margin:0 auto}

/* dialogs */
.dlg{display:grid;grid-template-columns:360px 1fr;gap:14px;height:calc(100vh - 92px);min-height:520px}
.list{display:flex;flex-direction:column;overflow:hidden}
.list-head{padding:12px;border-bottom:1px solid var(--line-2);display:flex;flex-direction:column;gap:8px}
.filters{display:flex;gap:4px;flex-wrap:wrap}
.filters button{height:26px;padding:0 9px;border-radius:999px;font-size:12px;color:var(--muted);background:var(--sunken)}
.filters button.on{background:var(--ink);color:var(--bg)}
.items{overflow-y:auto;flex:1}
.item{display:grid;grid-template-columns:38px 1fr auto;gap:10px;padding:10px 12px;border-bottom:1px solid var(--line-2);cursor:pointer;align-items:start}
.item:hover{background:var(--surface-2)}
.item.on{background:var(--accent-bg)}
.ava{width:38px;height:38px;border-radius:50%;background:var(--sunken);display:grid;place-items:center;font-weight:600;color:var(--muted);font-size:14px;overflow:hidden;flex:none}
.ava img{width:100%;height:100%;object-fit:cover}
.item .nm{font-weight:600;color:var(--ink);font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.item .it{font-size:11.5px;color:var(--faint);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.item .lt{font-size:12.5px;color:var(--muted);overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;margin-top:2px}
.item .tm{font-size:11.5px;color:var(--faint);text-align:right;white-space:nowrap}
.item .bd{display:flex;gap:4px;flex-wrap:wrap;margin-top:5px}
.dot{width:8px;height:8px;border-radius:50%;background:var(--accent);display:inline-block;margin-top:6px}

.chat{display:flex;flex-direction:column;overflow:hidden}
.chat-head{padding:12px 16px;border-bottom:1px solid var(--line-2);display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.chat-head .t{font-weight:600;color:var(--ink);font-size:15px}
.chat-head .s{font-size:12px;color:var(--muted)}
.msgs{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:6px;background:var(--surface-2)}
.day{align-self:center;font-size:11.5px;color:var(--faint);margin:10px 0 4px}
.b{max-width:72%;padding:8px 12px;border-radius:14px;white-space:pre-wrap;word-wrap:break-word;font-size:14px;line-height:1.42;position:relative}
.b .tm{display:block;font-size:10.5px;opacity:.6;margin-top:3px;text-align:right}
.b.client{align-self:flex-start;background:var(--surface);border:1px solid var(--line-2);border-bottom-left-radius:4px}
.b.manager{align-self:flex-end;background:var(--me);color:var(--me-text);border-bottom-right-radius:4px}
.b.system{align-self:center;background:transparent;color:var(--muted);font-size:12px;text-align:center;max-width:90%}
.b.ai{align-self:flex-end;background:var(--blue-bg);color:var(--text);border:1px dashed var(--blue);border-bottom-right-radius:4px}
.b .rev{font-size:11px;margin-top:4px;display:flex;gap:6px;justify-content:flex-end;flex-wrap:wrap;align-items:center}
.b.manager .btn{color:var(--text)}
.b.manager .btn.good{color:var(--green)}.b.manager .btn.warn{color:var(--red)}
.chk{display:flex;align-items:flex-start;gap:8px;margin-top:10px;font-size:13.5px}.chk input{flex:none;margin-top:4px}
.empty{display:grid;place-items:center;height:100%;color:var(--muted);text-align:center;padding:30px}

.draft{border-top:1px solid var(--line-2);padding:12px 16px;background:var(--surface);max-height:58%;overflow-y:auto}
.draft-h{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:12.5px;color:var(--muted);margin-bottom:8px}
.draft-h b{color:var(--blue);font-weight:600}
.draft-text{background:var(--blue-bg);border-radius:12px;padding:10px 12px;white-space:pre-wrap;font-size:14.5px;color:var(--ink)}
.draft-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}
.why{margin-top:10px;font-size:12.5px;color:var(--muted)}
.why summary{cursor:pointer;color:var(--muted)}
.why ul{margin:6px 0 0 18px}
.why .old{text-decoration:line-through;opacity:.7}
.note{margin-top:6px}
.warnbox{background:var(--amber-bg);color:var(--amber);border-radius:10px;padding:8px 10px;font-size:12.5px;margin-bottom:8px}
.errbox{background:var(--red-bg);color:var(--red);border-radius:10px;padding:8px 10px;font-size:12.5px;margin:8px 0;white-space:pre-wrap}

/* generic panes */
.grid2{display:grid;grid-template-columns:300px 1fr;gap:14px}
.pane{padding:16px}
.pane h2{font-family:var(--display);font-size:16px;font-weight:600;color:var(--ink);margin-bottom:4px}
.pane h3{font-size:14px;font-weight:600;color:var(--ink);margin:18px 0 6px}
.pane p.lead{color:var(--muted);font-size:13px;margin-bottom:10px}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.script{border:1px solid var(--line-2);border-radius:12px;padding:10px;margin-bottom:8px;background:var(--surface-2)}
.script .row .input{flex:1}
.prov{border:1px solid var(--line-2);border-radius:12px;padding:12px;margin-bottom:10px}
.out{white-space:pre-wrap;background:var(--surface-2);border:1px solid var(--line-2);border-radius:12px;padding:12px;font-size:13.5px;margin-top:10px;max-height:480px;overflow:auto}
.fb{border-bottom:1px solid var(--line-2);padding:12px 0;display:grid;gap:4px;font-size:13.5px}
.fb .pair{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.fb .pair div{background:var(--surface-2);border-radius:10px;padding:8px 10px;white-space:pre-wrap}
.stat{display:flex;gap:10px;flex-wrap:wrap;margin:10px 0}
.stat div{background:var(--surface-2);border:1px solid var(--line-2);border-radius:12px;padding:10px 14px;min-width:120px}
.stat b{display:block;font-size:20px;color:var(--ink);font-family:var(--display);font-weight:600}
.cmp{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px;margin-top:12px}
.modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:60;display:grid;place-items:center;padding:16px}
.modal{width:min(980px,100%);max-height:90vh;overflow:auto;padding:18px}
.toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:12px;z-index:80;font-size:13.5px;box-shadow:var(--shadow-lg);max-width:90vw}
.gate{max-width:360px;margin:12vh auto;padding:24px}
.spin{width:14px;height:14px;border:2px solid var(--line);border-top-color:var(--accent);border-radius:50%;animation:sp 0.8s linear infinite;display:inline-block}
@keyframes sp{to{transform:rotate(360deg)}}
.back{display:none}
@media (max-width:860px){
  main{padding:10px 12px 30px}
  .top-in{padding:8px 12px}
  .dlg{grid-template-columns:1fr;height:auto}
  .dlg .list{height:calc(100vh - 140px)}
  .dlg.open .list{display:none}
  .dlg:not(.open) .chat{display:none}
  .dlg .chat{height:calc(100vh - 110px)}
  .back{display:inline-flex}
  .grid2{grid-template-columns:1fr!important}
  .chat-head .select{flex:1 1 40%;min-width:0;width:auto!important;max-width:none!important}
  .chat-head > div[style*="flex:1"]{flex-basis:60%!important}
  .b{max-width:88%}
  .fb .pair{grid-template-columns:1fr}
}
</style>
</head>
<body>
<div id="gate" class="card gate hide">
  <div class="logo" style="margin-bottom:14px"><i></i>Avito AI Sales</div>
  <p class="muted small" style="margin-bottom:12px">ИИ-менеджер для чатов Авито. Введите пароль дашборда.</p>
  <form id="gateForm" class="row"><input id="pw" class="input" type="password" placeholder="Пароль" autocomplete="current-password" style="flex:1"><button class="btn primary">Войти</button></form>
  <div id="gateErr" class="errbox hide"></div>
</div>

<div id="app" class="hide">
  <header class="top">
    <div class="top-in">
      <div class="logo"><i></i>Avito AI Sales</div>
      <select id="cabSel" class="select" style="width:auto"></select>
      <nav class="tabs" id="tabs">
        <button class="tab on" data-tab="dialogs">Диалоги<span class="n hide" id="nWaiting"></span></button>
        <button class="tab" data-tab="sim">Тест-клиент</button>
        <button class="tab" data-tab="prompt">Скрипты и база знаний</button>
        <button class="tab" data-tab="models">Модели и настройки</button>
        <button class="tab" data-tab="learn">Обучение</button>
      </nav>
      <div class="grow"></div>
      <span class="safe" title="Сервис только читает чаты и предлагает ответы. Отправки в Авито нет.">● Отправка в Авито выключена — только черновики</span>
      <div class="sync"><span id="syncInfo"></span><button class="btn sm" id="syncBtn">↻ Обновить</button><button class="btn sm" id="themeBtn" title="Тема">◐</button></div>
    </div>
    <div class="progress hide" id="prog"><b style="width:0"></b></div>
  </header>

  <main>
    <!-- Диалоги -->
    <section id="t-dialogs" class="dlg">
      <div class="card list">
        <div class="list-head">
          <input id="q" class="input" placeholder="Поиск по имени, объявлению, тексту">
          <div class="filters" id="filters">
            <button data-f="all" class="on">Все</button>
            <button data-f="waiting">Ждут ответа</button>
            <button data-f="draft">Есть черновик</button>
            <button data-f="human">Нужен человек</button>
            <button data-f="reviewed">Проверены</button>
          </div>
        </div>
        <div class="items" id="items"></div>
      </div>
      <div class="card chat" id="chat"><div class="empty">Выберите диалог слева.<br><span class="small faint">Новые сообщения подтягиваются из Авито сами — каждые 10 минут и при открытой странице.</span></div></div>
    </section>

    <!-- Тест-клиент -->
    <section id="t-sim" class="grid2 hide">
      <div class="card pane">
        <h2>Тест-клиент</h2>
        <p class="lead">Пишите как родитель или ученик — ИИ отвечает за преподавателя. Ответы можно исправлять: правки идут в обучение.</p>
        <button class="btn primary" id="simNew">+ Новый тест</button>
        <div id="simList" style="margin-top:12px"></div>
      </div>
      <div class="card chat" id="simChat" style="height:calc(100vh - 92px);min-height:520px"><div class="empty">Создайте тест или выберите его слева.</div></div>
    </section>

    <!-- Промпт -->
    <section id="t-prompt" class="hide">
      <div class="card pane">
        <div class="row"><h2 class="grow">Скрипты, правила и база знаний</h2>
          <button class="btn" id="pDefaults">Вернуть исходные</button>
          <select class="select" id="pHist" style="width:auto"><option value="">Прошлые версии…</option></select>
          <button class="btn primary" id="pSave">Сохранить</button></div>
        <p class="lead">Из этого ИИ собирает ответ. Исходный сценарий составлен по 145 диалогам Елены за октябрь. Всё здесь можно править: ИИ использует новую версию сразу.</p>

        <h3>Свободные окна для диагностики</h3>
        <p class="lead">ИИ предлагает время только отсюда. Если поле пустое, он спрашивает клиента, когда тому удобно, и помечает диалог «нужен человек».</p>
        <textarea id="pSlots" class="input" rows="4"></textarea>

        <h3>Роль и правила</h3>
        <textarea id="pSystem" class="input" rows="16"></textarea>

        <h3>База знаний</h3>
        <p class="lead">Факты, цены, форматы, контакты, ссылка ZOOM. Всё, что ИИ может сказать клиенту, должно быть здесь.</p>
        <textarea id="pKnow" class="input" rows="10"></textarea>

        <h3>Скрипты</h3>
        <div id="pScripts"></div>
        <button class="btn" id="pAddScript">+ Скрипт</button>

        <h3>Подсказки ИИ</h3>
        <div class="row">
          <button class="btn" id="sugScripts">Предложить скрипты по живым диалогам</button>
          <button class="btn" id="sugRules">Сформулировать правила из правок</button>
        </div>
        <div id="sugOut"></div>
      </div>
    </section>

    <!-- Модели -->
    <section id="t-models" class="hide">
      <div class="grid2" style="grid-template-columns:1fr 1fr">
        <div class="card pane">
          <h2>Как работает ИИ</h2>
          <label class="f">Модель по умолчанию</label>
          <select id="mDefault" class="select"></select>
          <label class="chk"><input type="checkbox" id="mSelf"> Самопроверка: вторым шагом ИИ проверяет черновик по истории и базе знаний и исправляет его</label>
          <label class="chk"><input type="checkbox" id="mAuto"> Сам писать черновики к новым сообщениям (каждые 10 минут)</label>
          <div class="row" style="margin-top:8px"><span class="small muted">…к сообщениям не старше</span><input id="mHours" class="input" type="number" min="1" style="width:80px"><span class="small muted">часов</span></div>
          <button class="btn primary" id="mSave" style="margin-top:12px">Сохранить</button>

          <h3>Кабинеты Авито</h3>
          <div id="cabList"></div>
          <div class="row" style="margin-top:8px"><select id="cabAdd" class="select" style="flex:1"></select><input id="cabSince" class="input" type="date" style="width:160px"><button class="btn" id="cabAddBtn">Подключить</button></div>
          <p class="lead" style="margin-top:6px">Подключённый кабинет только читается: сообщения в Авито сервис не отправляет.</p>
        </div>
        <div class="card pane">
          <h2>Подключения моделей</h2>
