async function chatAction(a) {
  const c = S.chat; const d = c.draft;
  if (a === 'gen') return genDraft();
  if (a === 'regen') {
    const instr = await promptModal('Новый вариант', 'Что изменить? (необязательно) Например: «короче», «предложи субботу», «ответь про цену».', '', true);
    if (instr === null) return; return genDraft(instr.text, instr.model);
  }
  if (a === 'cmp') return compareModels();
  if (a === 'copy') { const t = d.review && d.review.action === 'edit' ? d.review.text : d.reply; navigator.clipboard.writeText(t).then(() => toast('Скопировано')); return; }
  if (a === 'edit') { S.editing = d.id; renderChat(false); $('#edText').focus(); return; }
  if (a === 'cancelEdit') { S.editing = null; renderChat(false); return; }
  if (a === 'approve' || a === 'reject' || a === 'saveEdit') {
    const action = a === 'saveEdit' ? 'edit' : a;
    const text = a === 'saveEdit' ? $('#edText').value.trim() : '';
    if (a === 'saveEdit' && !text) return toast('Пустой текст');
    try {
      await api('feedback', { method: 'POST', body: { chatId: c.chatId, draftId: d.id, action, text, comment: a === 'saveEdit' ? $('#edWhy').value : '' } });
      S.editing = null; toast(action === 'approve' ? 'Запомнил как хороший ответ' : action === 'edit' ? 'Правка сохранена — ИИ учтёт её' : 'Запомнил: здесь не отвечаем');
      await openChat(c.chatId, true); loadChats(true);
    } catch (e) { toast('Ошибка: ' + e.message); }
  }
}
async function genDraft(instruction, model) {
  const id = S.chatId; S.busy.draft = id; renderChat(false);
  try {
    const r = await api('draft', { method: 'POST', body: { chatId: id, instruction: instruction || '', model: model || undefined } });
    await waitJob(r.job);
  } catch (e) { toast('ИИ: ' + e.message, 6000); }
  S.busy.draft = null;
  if (S.chatId === id) await openChat(id, true);
  loadChats(true);
}

