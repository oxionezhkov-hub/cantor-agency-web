  const id = $('#cabAdd').value; if (!id) return;
  await api('config', { method: 'POST', body: { addCabinet: { accountId: id, since: $('#cabSince').value } } });
  toast('Кабинет подключён — выберите его вверху, история загрузится'); await loadState(); renderModels();
};

// ── learning ──
async function loadLearn() {
  let fb = [];
  try { fb = (await api('feedback')).feedback; } catch (e) { return toast(e.message); }
  const n = (a) => fb.filter((f) => f.action === a).length;
  $('#lStat').innerHTML = `<div><b>${fb.length}</b><span class="small muted">оценок</span></div><div><b>${n('approve')}</b><span class="small muted">верно как есть</span></div><div><b>${n('edit')}</b><span class="small muted">исправлено</span></div><div><b>${n('reject')}</b><span class="small muted">не отвечать</span></div><div><b>${fb.length ? Math.round(n('approve') / fb.length * 100) : 0}%</b><span class="small muted">точность</span></div>`;
  const byModel = {};
  fb.forEach((f) => { const k = f.model || '—'; byModel[k] = byModel[k] || { a: 0, t: 0 }; byModel[k].t += 1; if (f.action === 'approve') byModel[k].a += 1; });
  $('#lModels').innerHTML = Object.keys(byModel).length ? 'По моделям: ' + Object.entries(byModel).map(([k, v]) => `${esc(modelLabel(k))} — ${v.a}/${v.t} верно`).join(' · ') : '';
  $('#lList').innerHTML = fb.length ? fb.map((f) => `<div class="fb">
    <div class="row"><span class="chip ${f.action === 'approve' ? 'green' : f.action === 'edit' ? 'blue' : 'red'}">${f.action === 'approve' ? 'верно' : f.action === 'edit' ? 'исправлено' : 'не отвечать'}</span><span class="small muted">${esc(new Date(f.at).toLocaleString('ru-RU'))} · ${f.source === 'sim' ? 'тест-клиент' : 'диалог'} · ${esc(modelLabel(f.model))}</span><span class="grow"></span><button class="btn sm warn" data-fbdel="${esc(f.key)}">Удалить</button></div>
    ${f.lastClient ? `<div class="small"><span class="muted">Клиент:</span> ${esc(f.lastClient)}</div>` : ''}
    <div class="pair"><div><span class="small muted">ИИ:</span>\n${esc(f.aiText)}</div><div><span class="small muted">Как надо:</span>\n${esc(f.action === 'reject' ? '(не отвечать)' : f.finalText)}</div></div>
    ${f.comment ? `<div class="small"><span class="muted">Почему:</span> ${esc(f.comment)}</div>` : ''}</div>`).join('') : '<p class="muted">Оценок пока нет. Откройте диалог и оцените черновик ИИ.</p>';
  $$('[data-fbdel]').forEach((b) => b.onclick = async () => { await api('feedback', { method: 'DELETE', body: { key: b.dataset.fbdel } }); loadLearn(); });
}

boot();
</script>
</body>
</html>
