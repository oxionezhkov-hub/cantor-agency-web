          <div id="provList"></div>
          <div class="prov" id="provForm">
            <div class="row"><select id="prType" class="select" style="flex:1"></select><input id="prLabel" class="input" placeholder="Название" style="flex:1"></div>
            <label class="f">Адрес API</label><input id="prBase" class="input">
            <label class="f">Ключ API</label><input id="prKey" class="input" type="password" placeholder="sk-…" autocomplete="off">
            <label class="f">Модели (через запятую)</label><input id="prModels" class="input">
            <input type="hidden" id="prId">
            <div class="row" style="margin-top:10px"><button class="btn primary" id="prSave">Сохранить подключение</button><button class="btn hide" id="prCancel">Отмена</button></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Обучение -->
    <section id="t-learn" class="hide">
      <div class="card pane">
        <h2>Обучение на правках</h2>
        <p class="lead">Каждая оценка черновика («Верно», «Исправить», «Не отвечать») сохраняется. Последние правки ИИ видит как примеры в каждом ответе. Кнопка «Сформулировать правила из правок» во вкладке «Скрипты» превращает их в постоянные правила.</p>
        <div class="stat" id="lStat"></div>
