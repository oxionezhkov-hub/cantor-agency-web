*{box-sizing:border-box;margin:0;padding:0}
:root{
  --red:#E8391D;
  --red-dark:#C42D13;
  --red-light:#FF6347;
  --dark:#0F0F0F;
  --dark2:#1A1A1A;
  --text:#1C1C1C;
  --muted:#787672;
  --bg:#F6F5F2;
  --white:#FFFFFF;
  --border:#E2E0DC;
  --accent-bg:#FFF3F0;
  --shadow-sm:0 2px 8px rgba(0,0,0,0.06);
  --r-sm:6px;
  --r-md:10px;
  --r-lg:16px;
  --r-xl:20px;
}
html{scroll-behavior:smooth}
body{font-family:'Geologica',sans-serif;color:var(--text);background:var(--bg);line-height:1.65;-webkit-font-smoothing:antialiased}
