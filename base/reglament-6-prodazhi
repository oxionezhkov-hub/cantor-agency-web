<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --red:#E8391D;
  --red-dark:#C42D13;
  --red-light:#FF6347;
  --dark:#0F0F0F;
  --dark2:#1A1A1A;
  --text:#1C1C1C;
  --muted:#787672;
  --bg:#F6F5F2;
  --white:#FFFFFF;
  --border:#E2E0DC;
  --accent-bg:#FFF3F0;
  --shadow-sm:0 2px 8px rgba(0,0,0,0.06);
  --r-sm:6px;
  --r-md:10px;
  --r-lg:16px;
  --r-xl:20px;
}
html{scroll-behavior:smooth}
body{font-family:'Geologica',sans-serif;color:var(--text);background:var(--bg);line-height:1.65;-webkit-font-smoothing:antialiased}
a{color:var(--red)}
a:hover{text-decoration:none}

.header-trigger{position:fixed;top:0;left:0;right:0;height:16px;z-index:99}
.header{background:var(--white);border-bottom:1px solid var(--border);padding:18px 40px;display:flex;align-items:center;justify-content:space-between;position:fixed;top:-72px;left:0;right:0;z-index:100;transition:top .22s ease;box-shadow:var(--shadow-sm)}
.header-trigger:hover ~ .header,.header:hover{top:0}
.logo{font-size:16px;font-weight:700;color:var(--dark);text-decoration:none;letter-spacing:-0.01em}
.logo span{color:var(--red)}
.header-tag{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;text-decoration:none}
.header-tag:hover{color:var(--red)}

.wrap{max-width:820px;margin:0 auto;padding:44px 24px 60px}

.doc-title{font-family:'Unbounded',sans-serif;font-size:clamp(22px,4vw,30px);font-weight:800;color:var(--dark);margin-bottom:10px;letter-spacing:-0.02em;line-height:1.25}
.doc-meta{font-size:13.5px;color:var(--muted);margin-bottom:32px}
.toc{background:var(--white);border:1px solid var(--border);border-radius:var(--r-lg);padding:16px 20px;margin-bottom:20px}
.toc-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin-bottom:10px}
.toc-links{display:flex;flex-wrap:wrap;gap:8px 10px}
.toc-links a{font-size:13px;font-weight:600;color:var(--red-dark);text-decoration:none;background:var(--accent-bg);padding:6px 12px;border-radius:999px;line-height:1.3}
.toc-links a:hover{background:var(--red);color:#fff}

.reg-card{background:var(--white);border:1px solid var(--border);border-radius:var(--r-xl);padding:32px 32px 8px;margin-bottom:0;box-shadow:var(--shadow-sm)}
.reg-title{font-family:'Unbounded',sans-serif;font-size:20px;font-weight:700;color:var(--dark);margin-bottom:6px;letter-spacing:-0.01em}
.reg-goal{font-size:15px;color:var(--muted);margin-bottom:22px;font-style:italic}

.step{border-top:1px solid var(--border);padding:22px 0}
.reg-card > .step:first-of-type{border-top:none;padding-top:2px}
.step-title{font-size:16.5px;font-weight:700;color:var(--dark);margin-bottom:4px;letter-spacing:-0.005em}
.step-meta{font-size:13px;color:var(--muted);margin-bottom:12px}
.step h4{font-size:13px;font-weight:700;color:var(--red-dark);text-transform:uppercase;letter-spacing:.03em;margin:16px 0 8px}
.step h4:first-of-type{margin-top:0}
.step p{font-size:15px;color:var(--text);margin-bottom:10px}
.step p:last-child{margin-bottom:0}
ul,ol{padding-left:20px;margin-bottom:10px}
li{font-size:15px;color:var(--text);margin-bottom:6px;line-height:1.65}
li:last-child{margin-bottom:0}
.sample-box{background:var(--bg);border:1px dashed var(--border);border-radius:var(--r-md);padding:16px 18px;font-size:14px;color:var(--dark2);margin:10px 0 14px;white-space:pre-line}
.sample-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin-bottom:8px}

.doc-nav{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:28px;flex-wrap:wrap}
.doc-nav a{font-size:13.5px;font-weight:700;color:var(--red-dark);text-decoration:none;display:inline-flex;align-items:center;gap:6px}
.doc-nav a:hover{color:var(--red)}
.doc-nav .to-catalog{color:var(--muted)}
.doc-nav .to-catalog:hover{color:var(--red)}


@media(max-width:640px){
  .header{padding:14px 20px}
  .wrap{padding:30px 16px 50px}
  .reg-card{padding:24px 20px 6px}
  .doc-nav{flex-direction:column;align-items:flex-start}
}
.feedback-btn{position:fixed;top:16px;right:16px;z-index:110;width:42px;height:42px;border-radius:50%;background:var(--white);border:1px solid var(--border);box-shadow:var(--shadow-sm);display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--red-dark);transition:transform .15s,border-color .15s;padding:0}
.feedback-btn:hover{border-color:var(--red);transform:scale(1.06)}
.feedback-btn svg{width:20px;height:20px}
.feedback-panel{position:fixed;top:66px;right:16px;z-index:110;width:300px;max-width:calc(100vw - 32px);background:var(--white);border:1px solid var(--border);border-radius:var(--r-lg);box-shadow:var(--shadow-sm);padding:16px;display:none}
.feedback-panel.open{display:block}
.feedback-panel-label{font-size:13.5px;color:var(--text);margin-bottom:10px;line-height:1.5}
.feedback-textarea{width:100%;min-height:90px;resize:vertical;font-family:inherit;font-size:14px;color:var(--text);border:1px solid var(--border);border-radius:var(--r-md);padding:10px 12px;margin-bottom:10px;box-sizing:border-box}
.feedback-textarea:focus{outline:none;border-color:var(--red)}
.feedback-actions{display:flex;justify-content:flex-end;gap:8px}
.feedback-btn-cancel{font-size:13px;font-weight:600;color:var(--muted);background:none;border:none;cursor:pointer;padding:8px 10px}
.feedback-btn-cancel:hover{color:var(--text)}
.feedback-btn-send{font-size:13px;font-weight:700;color:#fff;background:var(--red);border:none;border-radius:999px;padding:8px 16px;cursor:pointer}
.feedback-btn-send:hover{background:var(--red-dark)}
.feedback-btn-send:disabled{opacity:.6;cursor:default}
.feedback-status{font-size:12.5px;color:var(--muted);margin-top:8px}

@media(max-width:640px){
  .feedback-btn{top:12px;right:12px}
  .feedback-panel{top:60px;right:12px}
}
</style>
</head>
<body>

<div class="header-trigger"></div>
<div class="header">
  <a href="/" class="logo">Cantor <span>Agency</span></a>
  <a href="/base" class="header-tag">← База знаний</a>
</div>

<button type="button" class="feedback-btn" id="feedback-btn" aria-label="Оставить комментарий">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.63 22 9.27 16.5 14.14 18.18 21 12 17.27 5.82 21 7.5 14.14 2 9.27 8.91 8.63 12 2"></polygon></svg>
</button>
<div class="feedback-panel" id="feedback-panel">
  <div class="feedback-panel-label">Напишите что хотите уточнить — добавим это в базу знаний</div>
  <textarea class="feedback-textarea" id="feedback-text" placeholder="Ваш комментарий…"></textarea>
  <div class="feedback-actions">
    <button type="button" class="feedback-btn-cancel" id="feedback-cancel">Закрыть</button>
    <button type="button" class="feedback-btn-send" id="feedback-send">Отправить</button>
  </div>
  <div class="feedback-status" id="feedback-status" hidden></div>
</div>

<div class="wrap">

  <div class="doc-title">Продажи и продление сотрудничества</div>
  <div class="doc-meta">Как проходит первичная продажа новому клиенту и продление сотрудничества с текущим.</div>

  <div class="toc">
    <div class="toc-label">Быстрые ссылки</div>
    <div class="toc-links">
        <a href="#s1">Часть 1. Первичная продажа</a>
        <a href="#s2">Часть 2. Продление сотрудничества</a>
    </div>
  </div>

  <div class="reg-card">
    <div class="reg-title">Продажи и продление сотрудничества</div>
    <div class="reg-goal">Цель: системно закрывать новых клиентов и продлевать сотрудничество с текущими.</div>

    <div class="step" id="s1">
      <div class="step-title">Часть 1. Первичная продажа</div>
      <h4>Поступление заявки</h4>
      <ul>
        <li>Заявка от клиента приходит через: сайт, Авито (реклама услуг агентства), рекомендацию, холодный outreach.</li>
        <li>КМ связывается с клиентом в течение 2 рабочих часов.</li>
        <li>Первый контакт — короткий звонок (15–20 минут) или переписка: узнаём нишу, город, продукт; текущая ситуация с Авито (есть ли кабинет, работает или нет, какие города и форматы уже давали результат); ожидания и бюджет; кем представлен клиент (владелец, маркетолог, руководитель отдела продаж).</li>
      </ul>
      <h4>Презентация услуг</h4>
      <p>После первичного контакта КМ готовит персонализированное предложение: что сделаем в первый месяц (по шагам); какие результаты ожидаем (реалистичные цифры на основе ниши); стоимость услуг агентства + рекомендованный бюджет на продвижение.</p>
      <p>Презентация — видео-звонок 30–45 минут или отправка коммерческого предложения в PDF. На презентации: показать кейсы похожих клиентов; объяснить, как считаем эффективность; обозначить, что нужно от клиента для старта.</p>
      <p>Ниже — пример стартового сообщения клиенту, которое закрывает основные вопросы по формату работы (суммы приводятся условно, реальная стоимость и бюджет согласуются индивидуально):</p>
      <div class="sample-label">Пример сообщения клиенту</div>
      <div class="sample-box">Рады продолжить работу! 👋
Услуга: Авито
1 месяц: [сумма] ₽ (включая бюджет на продвижение [сумма] ₽)

Какие у нас этапы работы:
1. Сбор брифа (1–3 дня)
2. Подготовка кабинета (2–3 дня)
3. Тестирование объявлений и стратегии (7–10 дней)
4. Оптимизация кабинета и выход на стабильные заявки (до расхода бюджета первого месяца)

Коммуникация по проекту происходит в этом чате: вопросы, проблемы, идеи.
Мы на связи по будням с 10:00 до 18:00 по МСК.

Каждый рабочий день делимся отчётом с метриками и по итогам недели обсуждаем направления для улучшений.</div>
      <h4>Подбор условий</h4>
      <ul>
        <li>Стоимость услуг — фиксированная за месяц или за пакет работ (на усмотрение агентства).</li>
        <li>Бюджет на продвижение — оплачивается клиентом напрямую в кабинет Авито.</li>
        <li>Срок первого контракта — 1 месяц (тестовый), далее продление; если клиенту комфортнее короче — можно согласовать тестовую неделю вместо месяца.</li>
        <li>Условия фиксируются в договоре и счёте.</li>
      </ul>
      <h4>Приём оплаты</h4>
      <ul>
        <li>После согласования условий — КМ выставляет счёт.</li>
        <li>Оплата — 100% предоплата за месяц работы агентства + клиент самостоятельно пополняет баланс Авито.</li>
        <li>После поступления оплаты — запуск работ по <a href="/base/reglament-1-zapusk">Регламенту 1</a> (день 1 — авторизация и аудит).</li>
      </ul>
    </div>

    <div class="step" id="s2">
      <div class="step-title">Часть 2. Продление сотрудничества</div>
      <h4>Сроки</h4>
      <p>За 7 дней до окончания месяца КМ инициирует разговор о продлении. Готовит «Отчёт за месяц» с результатами: что было сделано; метрики: показы, лиды, продажи, ROI; динамика от недели к неделе; что планируем улучшить в следующем месяце. Отчёт отправляется клиенту за 3 дня до встречи о продлении.</p>
      <h4>Встреча о продлении</h4>
      <div class="step-meta">30 минут</div>
      <ul>
        <li>Презентация результатов месяца.</li>
        <li>Обсуждение: что сработало, что нет, корректировки.</li>
        <li>План на следующий месяц: новые гипотезы, расширение (новые города, категории).</li>
        <li>Согласование стоимости и бюджета на следующий месяц.</li>
        <li>Если клиент сомневается — предложить месяц на тех же условиях с расширенным объёмом работ.</li>
      </ul>
      <h4>Оформление продления</h4>
      <ul>
        <li>КМ выставляет счёт за следующий месяц.</li>
        <li>Дедлайн оплаты — до конца текущего месяца, чтобы не было простоя в кабинете.</li>
        <li>Если клиент не оплатил до конца месяца — КМ уведомляет о приостановке работ (кабинет продолжает работать на остатках баланса, но без управления специалистом).</li>
        <li>После оплаты — работа продолжается без перерыва, начинается новый отчётный период.</li>
      </ul>
      <h4>Если клиент отказывается от продления</h4>
      <ul>
        <li>КМ выясняет причину: результаты, цена, качество коммуникации, внешние факторы.</li>
        <li>Фиксирует причину в CRM.</li>
        <li>Предлагает альтернативу: пауза на 1 месяц с сохранением настроек, снижение бюджета, изменение объёма услуг.</li>
        <li>Если отказ окончательный — передаёт клиенту доступы и все материалы, закрывает проект с актом сверки.</li>
      </ul>
    </div>
  </div>

  <div class="doc-nav">
    <a href="/base/reglament-4-vstrechi">← Регламент 4. Еженедельные встречи</a>
    <a href="/base/reglament-5-advaizery">Регламент 5. Опыт эдвайзеров →</a>
  </div>
  <div class="doc-nav" style="margin-top:6px">
    <a href="/base" class="to-catalog">← К каталогу регламентов</a>
  </div>

</div>



<script>
(function(){
  var FEEDBACK_URL = 'https://functions.yandexcloud.net/d4ee1rhgpv5toe7lcjta';

  var btn = document.getElementById('feedback-btn');
  var panel = document.getElementById('feedback-panel');
  var textarea = document.getElementById('feedback-text');
  var sendBtn = document.getElementById('feedback-send');
  var cancelBtn = document.getElementById('feedback-cancel');
  var statusEl = document.getElementById('feedback-status');

  function nearestBlock(){
    var titleEl = document.querySelector('.doc-title');
    var regulation = titleEl ? titleEl.textContent.trim() : document.title;
    var blocks = document.querySelectorAll('.step-title, .cat-card-title, .featured-card-title, .section-label, .reg-title');
    var block = '';
    var threshold = window.innerHeight * 0.4;
    for (var i = 0; i < blocks.length; i++){
      var rect = blocks[i].getBoundingClientRect();
      if (rect.top <= threshold) block = blocks[i].textContent.trim();
      else break;
    }
    if (!block && blocks.length) block = blocks[0].textContent.trim();
    return { regulation: regulation, block: block };
  }

  function closePanel(){
    panel.classList.remove('open');
    statusEl.hidden = true;
    statusEl.textContent = '';
  }

  btn.addEventListener('click', function(){
    var opening = !panel.classList.contains('open');
    panel.classList.toggle('open');
    if (opening) {
      textarea.focus();
    }
  });
  cancelBtn.addEventListener('click', closePanel);
  document.addEventListener('click', function(e){
    if (panel.classList.contains('open') && !panel.contains(e.target) && e.target !== btn && !btn.contains(e.target)) {
      closePanel();
    }
  });
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape') closePanel();
  });

  sendBtn.addEventListener('click', function(){
    var comment = textarea.value.trim();
    if (!comment) { textarea.focus(); return; }
    var ctx = nearestBlock();
    sendBtn.disabled = true;
    statusEl.hidden = false;
    statusEl.textContent = 'Отправляем…';
    fetch(FEEDBACK_URL, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        comment: comment,
        regulation: ctx.regulation,
        block: ctx.block,
        url: window.location.href
      })
    }).then(function(r){
      if (!r.ok) throw new Error('bad status');
      statusEl.textContent = 'Спасибо, отправлено!';
      textarea.value = '';
      setTimeout(closePanel, 1200);
    }).catch(function(){
      statusEl.textContent = 'Не получилось отправить. Попробуйте ещё раз.';
    }).finally(function(){
      sendBtn.disabled = false;
    });
  });
})();
</script>

