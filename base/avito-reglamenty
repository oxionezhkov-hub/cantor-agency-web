<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --red:#E8391D;
  --red-dark:#C42D13;
  --red-light:#FF6347;
  --dark:#0F0F0F;
  --dark2:#1A1A1A;
  --text:#1C1C1C;
  --muted:#787672;
  --bg:#F6F5F2;
  --white:#FFFFFF;
  --border:#E2E0DC;
  --accent-bg:#FFF3F0;
  --shadow-sm:0 2px 8px rgba(0,0,0,0.06);
  --r-sm:6px;
  --r-md:10px;
  --r-lg:16px;
  --r-xl:20px;
}
html{scroll-behavior:smooth}
body{font-family:'Geologica',sans-serif;color:var(--text);background:var(--bg);line-height:1.65;-webkit-font-smoothing:antialiased}
a{color:var(--red)}
a:hover{text-decoration:none}

.header{background:var(--white);border-bottom:1px solid var(--border);padding:18px 40px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50}
.logo{font-size:16px;font-weight:700;color:var(--dark);text-decoration:none;letter-spacing:-0.01em}
.logo span{color:var(--red)}
.header-tag{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}

.wrap{max-width:860px;margin:0 auto;padding:44px 24px 90px}

.doc-eyebrow{display:inline-flex;align-items:center;gap:8px;background:var(--dark);color:#fff;border-radius:100px;padding:6px 16px;font-size:11px;font-weight:600;margin-bottom:18px;letter-spacing:.04em;text-transform:uppercase}
.doc-eyebrow-dot{width:5px;height:5px;border-radius:50%;background:var(--red-light)}
.doc-title{font-family:'Unbounded',sans-serif;font-size:clamp(24px,4vw,32px);font-weight:800;color:var(--dark);margin-bottom:10px;letter-spacing:-0.02em;line-height:1.25}
.doc-meta{font-size:13.5px;color:var(--muted);margin-bottom:32px}

.toc-card{background:var(--white);border:1px solid var(--border);border-radius:var(--r-lg);padding:26px 28px;margin-bottom:36px}
.toc-title{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:14px}
.toc-group{margin-bottom:14px}
.toc-group:last-child{margin-bottom:0}
.toc-group-label{font-size:12px;font-weight:700;color:var(--red-dark);text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px}
.toc-list{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:6px 20px}
.toc-list a{font-size:13.5px;color:var(--dark2);text-decoration:none;font-weight:600;line-height:1.5}
.toc-list a:hover{color:var(--red)}

.part-divider{display:flex;align-items:center;gap:14px;margin:48px 0 24px}
.part-divider::before,.part-divider::after{content:"";flex:1;height:1px;background:var(--border)}
.part-divider span{font-family:'Unbounded',sans-serif;font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;white-space:nowrap}

.reg-card{background:var(--white);border:1px solid var(--border);border-radius:var(--r-xl);padding:32px 32px 8px;margin-bottom:20px;box-shadow:var(--shadow-sm);scroll-margin-top:80px}
.reg-tag{display:inline-block;background:var(--accent-bg);color:var(--red-dark);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;border-radius:100px;padding:5px 13px;margin-bottom:12px}
.reg-title{font-family:'Unbounded',sans-serif;font-size:20px;font-weight:700;color:var(--dark);margin-bottom:6px;letter-spacing:-0.01em}
.reg-goal{font-size:15px;color:var(--muted);margin-bottom:22px;font-style:italic}

.step{border-top:1px solid var(--border);padding:22px 0;scroll-margin-top:80px}
.reg-card > .step:first-of-type{border-top:none;padding-top:2px}
.step-title{font-size:16.5px;font-weight:700;color:var(--dark);margin-bottom:4px;letter-spacing:-0.005em}
.step-meta{font-size:13px;color:var(--muted);margin-bottom:12px}
.step h4{font-size:13px;font-weight:700;color:var(--red-dark);text-transform:uppercase;letter-spacing:.03em;margin:16px 0 8px}
.step h4:first-of-type{margin-top:0}
.step p{font-size:15px;color:var(--text);margin-bottom:10px}
.step p:last-child{margin-bottom:0}
ul,ol{padding-left:20px;margin-bottom:10px}
li{font-size:15px;color:var(--text);margin-bottom:6px;line-height:1.65}
li:last-child{margin-bottom:0}
.result-box{background:var(--accent-bg);border-radius:var(--r-md);padding:12px 16px;font-size:14px;color:var(--dark2);margin-top:14px}
.result-box strong{color:var(--red-dark)}

table.data-table{width:100%;border-collapse:collapse;margin:12px 0 16px;font-size:14px}
table.data-table th,table.data-table td{border-bottom:1px solid var(--border);padding:10px 12px;text-align:left;vertical-align:top}
table.data-table th{font-weight:700;color:var(--dark);background:var(--bg)}
table.data-table td{color:var(--text)}
table.data-table tr:last-child td{border-bottom:none}
.table-scroll{overflow-x:auto;margin:12px 0 16px}
.table-scroll table.data-table{margin:0;min-width:480px}

.checklist{list-style:none;padding-left:0;margin:10px 0 4px}
.checklist li{display:flex;gap:10px;align-items:flex-start;padding-left:0}
.checklist li::before{content:"✓";flex:0 0 20px;height:20px;width:20px;border-radius:50%;background:var(--accent-bg);color:var(--red);font-weight:700;font-size:11px;line-height:20px;text-align:center;margin-top:1px}

footer.page-footer{text-align:center;padding:24px;font-size:12px;color:var(--muted)}

@media(max-width:640px){
  .header{padding:14px 20px}
  .wrap{padding:30px 16px 60px}
  .reg-card{padding:24px 20px 6px}
  .toc-card{padding:20px 18px}
  .toc-list{grid-template-columns:1fr}
  table.data-table th,table.data-table td{font-size:12.5px;padding:8px 8px}
}
</style>
