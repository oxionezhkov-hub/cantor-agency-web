  KB.rendered = true;
  if (!KB.regs) loadRegs();
  renderKbForm();
  renderKbJobs();
  if (!KB.jobs || Date.now() - KB.loadedAt > 15000) loadKbJobs();
}

function renderKbForm() {
  const el = $('kbForm');
  if (KB.sending) {
    const s = KB.sending;
    el.innerHTML = `<div class="kb-card kb-done">
      <div class="spinner"></div>
      <h2>${esc(s.stage)}</h2>
      ${s.total ? `<div class="kb-progress"><i style="width:${Math.round((s.done / s.total) * 100)}%"></i></div><p class="kb-hint">${fmtSize(s.bytesDone)} из ${fmtSize(s.bytes)}</p>` : ''}
      <p class="kb-hint">Не закрывайте страницу, пока идёт загрузка файлов — это несколько секунд.</p>
    </div>`;
    return;
  }
  if (KB.sent) {
    const j = KB.sent;
    const bad = j.status === 'failed' || j.status === 'stuck';
    const wait = j.status === 'not_configured';
    el.innerHTML = `<div class="kb-card kb-done">
      <div class="kb-done-ic ${bad ? 'bad' : wait ? 'warn' : ''}">${ico(bad ? 'x' : wait ? 'clock' : 'check')}</div>
      <h2>${bad ? 'Claude не запустился' : wait ? 'Запрос сохранён' : j.status === 'done' ? 'Готово — база знаний обновлена' : 'Принято! Claude уже взялся за работу'}</h2>
      <p class="kb-target">${esc(j.targetLabel)}</p>
      ${bad ? `<p class="kb-note bad">${esc(j.error || 'Неизвестная ошибка')}</p>`
        : wait ? `<p class="kb-note warn">Рутина Claude для базы знаний ещё не подключена — Олег получил уведомление. Запрос не потеряется: отправьте его снова, когда рутину подключат.</p>`
        : j.status === 'done' ? '<p class="kb-hint">Что именно изменилось — в истории справа.</p>'
        : `<p>Можно заниматься другими делами. Когда база знаний обновится, придёт уведомление здесь${S.me.tg ? ' и в Telegram' : ''} — с тем, что именно и в каких регламентах изменилось. Обычно это занимает 5–15 минут.</p>`}
      <div class="kb-done-actions">
        ${bad || wait ? `<button class="btn btn-primary" data-kbretry="${esc(j.id)}">${ico('refresh')}Отправить снова</button>` : ''}
        <button class="btn btn-ghost" data-kb="again">${ico('plus')}Добавить ещё знания</button>
      </div>
    </div>`;
    return;
  }
  const modes = [['reglament', 'В регламент'], ['general', 'Пусть ИИ разберёт'], ['new', 'Новый регламент']];
  const sections = [...new Set((KB.regs || KB_FALLBACK).map((r) => r.section).filter(Boolean))];
  let where = '';
  if (KB.mode === 'reglament') {
    where = `<div class="search kb-search">${ico('search', 'ic-sm')}<input class="input" id="kbQ" type="search" placeholder="Найти регламент по названию" value="${esc(KB.q)}" autocomplete="off"></div>
      <div class="kb-regs" id="kbRegs"></div>`;
  } else if (KB.mode === 'general') {
    where = `<div class="kb-note run">${ico('bot', 'ic-sm')} Claude сам прочитает базу знаний и решит, куда это относится: допишет нужные регламенты (можно сразу несколько) или предложит новый, если ничего не подходит.</div>`;
  } else {
    where = `<div class="grid2">
        <div><label class="label" for="kbNewTitle">Название регламента</label><input class="input" id="kbNewTitle" value="${esc(KB.newTitle)}" maxlength="200" placeholder="Например: Работа с отзывами на Авито" autocomplete="off"></div>
        <div><label class="label" for="kbNewSection">Раздел каталога</label><select class="select" id="kbNewSection"><option value="">Пусть решит Claude</option>${sections.map((s) => `<option ${s === KB.newSection ? 'selected' : ''}>${esc(s)}</option>`).join('')}</select></div>
      </div>
      <div class="kb-hint">Claude создаст страницу регламента в общем стиле базы и добавит её в каталог.</div>`;
  }
  const files = KB.files.map((f) => `<div class="kb-file" data-kbfile="${f.key}">
      ${f.thumb ? `<img src="${f.thumb}" alt="">` : `<span class="kb-fic">${ico('clip', 'ic-sm')}</span>`}
      <span style="min-width:0"><span class="nm" title="${esc(f.name)}">${esc(f.name)}</span><span class="sz">${fmtSize(f.size)}</span></span>
      <button class="x" data-kbrm="${f.key}" aria-label="Убрать файл">${ico('x', 'ic-sm')}</button>
    </div>`).join('');
  el.innerHTML = `
    <div class="kb-card">
      <div class="kb-step"><span class="kb-num">1</span>Куда добавить</div>
      <div class="seg kb-modes">${modes.map(([k, v]) => `<button data-kbmode="${k}" class="${KB.mode === k ? 'on' : ''}">${v}</button>`).join('')}</div>
      ${where}
    </div>
    <div class="kb-card">
      <div class="kb-step"><span class="kb-num">2</span>Что добавить</div>
      <textarea class="textarea" id="kbText" rows="7" maxlength="30000" placeholder="Новые правила, порядок действий, ответы на частые вопросы, договорённости с командой… Пишите как удобно — Claude оформит в стиле регламента.">${esc(KB.text)}</textarea>
      <label class="kb-drop" id="kbDrop">
        <span class="kb-drop-ic">${ico('clip')}</span>
        <span><b>Прикрепить файлы или фото</b><br><span class="kb-hint">или перетащите сюда · скриншот можно вставить через Ctrl+V</span></span>
        <input type="file" id="kbFile" multiple hidden>
      </label>
      ${files ? `<div class="kb-files">${files}</div>` : ''}
    </div>
    <div class="kb-submit">
      <span class="hint">${KB.configured ? 'После отправки можно не ждать — придёт уведомление' : 'Рутина Claude ещё не подключена — запрос сохранится и уйдёт позже'}</span>
      <button class="btn btn-primary" id="kbSend">${ico('send')}Отправить в базу знаний</button>
    </div>`;
  if (KB.mode === 'reglament') renderKbRegs();
}

function renderKbRegs() {
  const box = $('kbRegs');
  if (!box) return;
  if (!KB.regs) { box.innerHTML = '<div class="kb-hint" style="padding:10px 4px">Загружаю регламенты…</div>'; return; }
  const words = KB.q.toLowerCase().replace(/ё/g, 'е').split(/\s+/).filter(Boolean);
  const list = KB.regs.filter((r) => { const hay = `${r.title} ${r.desc}`.toLowerCase().replace(/ё/g, 'е'); return words.every((w) => hay.includes(w)); });
  if (!list.length) { box.innerHTML = '<div class="kb-hint" style="padding:10px 4px">Ничего не нашлось. Попробуйте другое слово — или выберите «Пусть ИИ разберёт» / «Новый регламент».</div>'; return; }
  let sec = null;
  box.innerHTML = list.map((r) => {
    const head = r.section && r.section !== sec ? `<div class="kb-sec">${esc(r.section)}</div>` : '';
    sec = r.section;
    return `${head}<div class="kb-reg ${KB.slug === r.slug ? 'on' : ''}">
      <button class="kb-pick" data-kbpick="${esc(r.slug)}" aria-pressed="${KB.slug === r.slug}"><span class="kb-radio"></span><span style="min-width:0"><span class="kb-reg-title">${esc(r.title)}</span>${r.desc ? `<span class="kb-reg-desc">${esc(r.desc)}</span>` : ''}</span></button>
      <a class="btn btn-ghost btn-sm kb-open" href="${KB_SITE}/${esc(r.slug)}" target="_blank" rel="noopener" title="Открыть регламент в новой вкладке">Открыть${ico('ext', 'ic-sm')}</a>
    </div>`;
  }).join('');
}

function renderKbJobs() {
  const el = $('kbJobs');
  if (!KB.jobs) { el.innerHTML = '<div class="empty">Загружаю…</div>'; return; }
  const jobs = KB.jobs.filter((j) => j.status !== 'draft');
  if (!jobs.length) { el.innerHTML = `<div class="empty">${ico('book')}<div style="margin-top:6px">Здесь будут ваши обновления базы знаний и что Claude по ним сделал.</div></div>`; return; }
  const now = Date.now();
  el.innerHTML = jobs.map((j) => {
    const [label, cls] = KB_STATUS[j.status] || [j.status, 'tag-cancelled'];
    const author = userById(j.byId) || { id: j.byId, name: j.byName };
    const r = j.result;
    let body = '';
    if (j.status === 'done' && r) {
      body = `${r.changes.length ? `<div class="kb-changes">${r.changes.map((c) => `<div class="kb-change">${ico('check', 'ic-sm')}<div class="w"><b>${esc(c.title)}</b>${c.isNew ? ' <span class="tag tag-progress">новый</span>' : ''}${c.what ? `<div>${esc(c.what)}</div>` : ''}</div>${c.url ? `<a class="btn btn-ghost btn-sm" href="${esc(c.url)}" target="_blank" rel="noopener">Открыть${ico('ext', 'ic-sm')}</a>` : ''}</div>`).join('')}</div>` : ''}
        ${r.summary ? `<div class="kb-sum">${esc(r.summary)}</div>` : ''}
        ${r.published ? '' : '<div class="kb-note warn">Правки готовы, но ещё не опубликованы — PR ждёт проверки Олега.</div>'}`;
    } else if (kbIsActive(j)) {
      body = `<div class="kb-note run">${j.progress ? `Claude: ${esc(j.progress)}` : j.status === 'sent' ? 'Claude запускается…' : 'Claude читает материалы и вносит правки…'}</div>`;
    } else if (j.status === 'failed' || j.status === 'stuck' || j.status === 'not_configured') {
      body = `<div class="kb-note ${j.status === 'not_configured' ? 'warn' : 'bad'}">${esc(j.error || 'Неизвестная ошибка')}</div>
        <div><button class="btn btn-ghost btn-sm" data-kbretry="${esc(j.id)}">${ico('refresh', 'ic-sm')}Отправить снова</button></div>`;
    }
    const links = [
      r && r.prUrl ? `<a href="${esc(r.prUrl)}" target="_blank" rel="noopener">PR на GitHub</a>` : '',
      j.sessionUrl ? `<a href="${esc(j.sessionUrl)}" target="_blank" rel="noopener">Сессия Claude</a>` : '',
    ].filter(Boolean).join(' · ');
    return `<div class="kb-job ${KB.focus === j.id ? 'flash' : ''}" data-kbjob="${esc(j.id)}">
      <div class="kb-job-head"><span class="tag ${cls}">${esc(r && !r.published && j.status === 'done' ? 'Готово, ждёт публикации' : label)}</span><span class="kb-job-meta">${avatar(author, 'xs')}${esc(first(j.byName))} · ${esc(ago(Date.parse(j.createdAt), now))}</span></div>
      <div class="kb-job-target">${esc(j.targetLabel)}</div>
      ${j.text ? `<div class="kb-job-text">${esc(j.text)}</div>` : ''}
      ${j.files.length ? `<div class="kb-job-meta">${ico('clip', 'ic-sm')}${j.files.length} ${plural(j.files.length, 'файл', 'файла', 'файлов')}: ${esc(j.files.map((f) => f.name).join(', '))}</div>` : ''}
      ${body}
      ${links ? `<div class="kb-job-links">${links}</div>` : ''}
    </div>`;
  }).join('');
  if (KB.focus) {
    const card = el.querySelector(`[data-kbjob="${CSS.escape(KB.focus)}"]`);
    if (card) setTimeout(() => card.scrollIntoView({ behavior: 'smooth', block: 'center' }), 50);
    KB.focus = null;
  }
}

// ── файлы ──
let kbFileSeq = 0;
function kbAddFiles(list) {
  const incoming = [...(list || [])].filter((f) => f && f.size);
  for (const f of incoming) {
    if (KB.files.length >= 12) { toast('Не больше 12 файлов за раз'); break; }
    if (f.size > 25 * 1048576 && !/^image\//.test(f.type)) { toast(`«${f.name}» больше 25 МБ — так много не загрузить`); continue; }
    const name = f.name && f.name !== 'image.png' ? f.name : `скриншот-${fmtTime(Date.now()).replace(':', '')}-${kbFileSeq + 1}.${(f.type.split('/')[1] || 'png').replace('jpeg', 'jpg')}`;
    KB.files.push({ key: `k${(kbFileSeq += 1)}`, file: f, name, type: f.type || 'application/octet-stream', size: f.size, thumb: /^image\//.test(f.type) ? URL.createObjectURL(f) : null });
  }
  renderKbForm();
}
// Большие фото ужимаются до 2400 px по длинной стороне (JPEG) — текст на скриншотах остаётся читаемым.
async function kbPrepFile(f) {
  const limit = 25 * 1048576;
  if (!/^image\/(jpeg|png|webp|bmp)$/.test(f.type) || f.size <= 1.5 * 1048576) return { name: f.name, type: f.type, blob: f.file };
  try {
    const bmp = await createImageBitmap(f.file);
    const k = Math.min(1, 2400 / Math.max(bmp.width, bmp.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bmp.width * k); canvas.height = Math.round(bmp.height * k);
    canvas.getContext('2d').drawImage(bmp, 0, 0, canvas.width, canvas.height);
    const blob = await new Promise((res) => canvas.toBlob(res, 'image/jpeg', 0.86));
    if (blob && blob.size < f.size) return { name: f.name.replace(/\.(png|webp|bmp|jpe?g)$/i, '') + '.jpg', type: 'image/jpeg', blob };
  } catch (e) { /* формат, который браузер не открывает (HEIC и т.п.), — уходит как есть */ }
  if (f.size > limit) throw new Error(`«${f.name}» больше 25 МБ`);
  return { name: f.name, type: f.type, blob: f.file };
}
function kbBase64(blob) {
  return new Promise((resolve, reject) => {
    const r = new FileReader();
    r.onload = () => resolve(String(r.result).slice(String(r.result).indexOf(',') + 1));
    r.onerror = () => reject(r.error);
    r.readAsDataURL(blob);
  });
}
async function kbApiRetry(action, body) {
  let res;
  for (let n = 0; n < 3; n += 1) {
    try { res = await api(action, body); if (res.ok || (res.status >= 400 && res.status < 500)) return res; } catch (e) { if (n === 2) throw e; }
    await new Promise((r) => setTimeout(r, 1500 * (n + 1)));
  }
  return res;
}

async function kbSubmit() {
  KB.text = ($('kbText') || {}).value != null ? $('kbText').value : KB.text;
  if (KB.mode === 'reglament' && !KB.slug) { toast('Выберите регламент — или режим «Пусть ИИ разберёт»'); return; }
  if (KB.mode === 'new' && KB.newTitle.trim().length < 3) { $('kbNewTitle') && $('kbNewTitle').focus(); toast('Напишите название нового регламента'); return; }
  if (!KB.text.trim() && !KB.files.length) { $('kbText').focus(); toast('Напишите, что добавить, или прикрепите файл'); return; }
  KB.sending = { stage: 'Готовлю…', done: 0, total: 0, bytes: 0, bytesDone: 0 };
  renderKbForm();
  try {
    const prepared = await Promise.all(KB.files.map(kbPrepFile));
    const created = await kbApiRetry('kb-create', {
      mode: KB.mode, slug: KB.slug, title: KB.title, newTitle: KB.newTitle.trim(), newSection: KB.newSection, text: KB.text,
      files: prepared.map((p) => ({ name: p.name, type: p.type, size: p.blob.size })),
    });
    if (!created || !created.ok) throw new Error({ file_too_big: 'Файл больше 25 МБ', files_too_big: 'Файлы вместе больше 80 МБ', too_many_files: 'Не больше 12 файлов' }[created && created.data.error] || 'Не получилось создать запрос');
    const { job, partBytes } = created.data;
    const parts = [];
    job.files.forEach((f, i) => { for (let p = 0; p < f.parts; p += 1) parts.push({ fileId: f.id, part: p, blob: prepared[i].blob.slice(p * partBytes, (p + 1) * partBytes) }); });
    const upload = async (list) => {
      for (const x of list) {
        const res = await kbApiRetry('kb-file', { id: job.id, fileId: x.fileId, part: x.part, data: await kbBase64(x.blob) });
        if (!res || !res.ok) throw new Error('Файл не загрузился — проверьте интернет и попробуйте ещё раз');
        KB.sending.done += 1; KB.sending.bytesDone += x.blob.size;
        renderKbForm();
      }
    };
    if (parts.length) {
      Object.assign(KB.sending, { stage: 'Загружаю файлы…', total: parts.length, bytes: parts.reduce((s, x) => s + x.blob.size, 0) });
      renderKbForm();
      await upload(parts);
    }
    KB.sending.stage = 'Отправляю Claude…'; KB.sending.total = 0;
    renderKbForm();
    let sent = await kbApiRetry('kb-send', { id: job.id });
    if (sent && sent.status === 409 && sent.data.error === 'files_incomplete') {
      await upload(sent.data.missing.map((m) => parts.find((x) => x.fileId === m.fileId && x.part === m.part)).filter(Boolean));
      sent = await kbApiRetry('kb-send', { id: job.id });
    }
    if (!sent || !sent.ok) throw new Error('Не получилось отправить — попробуйте ещё раз');
    KB.files.forEach((f) => f.thumb && URL.revokeObjectURL(f.thumb));
    Object.assign(KB, { sending: null, sent: sent.data.job, files: [], text: '', newTitle: '' });
    kbSaveDraft();
    KB.jobs = [sent.data.job, ...(KB.jobs || []).filter((j) => j.id !== sent.data.job.id)];
    renderKbForm(); renderKbJobs();
    window.scrollTo({ top: 0, behavior: 'smooth' });
    loadKbJobs();
  } catch (e) {
    KB.sending = null;
    renderKbForm();
    toast(e && e.message && !/fetch|network|abort/i.test(e.message) ? e.message : 'Нет связи — ничего не потерялось, попробуйте ещё раз', null, null, 7000);
  }
}

async function kbRetry(id, btn) {
  if (btn) btn.disabled = true;
  try {
    const res = await kbApiRetry('kb-send', { id });
    if (!res || !res.ok) throw new Error();
    const job = res.data.job;
    KB.jobs = (KB.jobs || []).map((j) => (j.id === job.id ? job : j));
    if (KB.sent && KB.sent.id === job.id) KB.sent = job;
    renderKbForm(); renderKbJobs();
    toast(job.status === 'sent' ? 'Отправлено — Claude взялся за работу' : job.status === 'not_configured' ? 'Рутина всё ещё не подключена' : 'Снова не получилось — подробности в карточке');
    loadKbJobs();
  } catch (e) { if (btn) btn.disabled = false; toast('Не получилось — проверьте интернет'); }
}

$('kbForm').addEventListener('click', (e) => {
  const mode = e.target.closest('[data-kbmode]');
  if (mode) { KB.mode = mode.dataset.kbmode; kbSaveDraft(); renderKbForm(); return; }
  const pick = e.target.closest('[data-kbpick]');
  if (pick) {
    const r = (KB.regs || []).find((x) => x.slug === pick.dataset.kbpick);
    KB.slug = r ? r.slug : ''; KB.title = r ? r.title : '';
    kbSaveDraft(); renderKbRegs();
    return;
  }
  const rm = e.target.closest('[data-kbrm]');
  if (rm) { e.preventDefault(); const f = KB.files.find((x) => x.key === rm.dataset.kbrm); if (f && f.thumb) URL.revokeObjectURL(f.thumb); KB.files = KB.files.filter((x) => x !== f); renderKbForm(); return; }
  if (e.target.closest('#kbSend')) { kbSubmit(); return; }
  if (e.target.closest('[data-kb="again"]')) { KB.sent = null; renderKbForm(); setTimeout(() => $('kbText') && $('kbText').focus(), 30); }
});
$('view-kb').addEventListener('click', (e) => { const b = e.target.closest('[data-kbretry]'); if (b) kbRetry(b.dataset.kbretry, b); });
$('kbForm').addEventListener('input', (e) => {
  if (e.target.id === 'kbText') { KB.text = e.target.value; kbSaveDraft(); }
  if (e.target.id === 'kbNewTitle') { KB.newTitle = e.target.value; kbSaveDraft(); }
  if (e.target.id === 'kbQ') { KB.q = e.target.value.trim(); renderKbRegs(); }
});
$('kbForm').addEventListener('change', (e) => {
  if (e.target.id === 'kbNewSection') { KB.newSection = e.target.value; kbSaveDraft(); }
  if (e.target.id === 'kbFile') { kbAddFiles(e.target.files); }
});
$('kbForm').addEventListener('dragover', (e) => { const d = e.target.closest('#kbDrop'); if (!d) return; e.preventDefault(); d.classList.add('over'); });
$('kbForm').addEventListener('dragleave', (e) => { const d = e.target.closest('#kbDrop'); if (d) d.classList.remove('over'); });
$('kbForm').addEventListener('drop', (e) => { const d = e.target.closest('#kbDrop'); if (!d) return; e.preventDefault(); d.classList.remove('over'); kbAddFiles(e.dataTransfer.files); });
document.addEventListener('paste', (e) => {
  if (S.view !== 'kb' || KB.sending || KB.sent) return;
  const files = [...((e.clipboardData && e.clipboardData.files) || [])];
  // Из Word/Excel вместе с текстом приходит и картинка-копия — тогда вставляем только текст.
  if (!files.length || (e.clipboardData.getData('text/plain') && e.target.closest && e.target.closest('textarea, input'))) return;
  e.preventDefault();
  kbAddFiles(files);
  toast(files.length > 1 ? `Добавлено файлов: ${files.length}` : 'Скриншот добавлен');
});

boot();
</script>
