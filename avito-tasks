    if (!res.ok) throw new Error(res.data.error);
    KB.jobs = res.data.jobs || [];
    KB.configured = res.data.configured !== false;
    KB.loadedAt = Date.now();
    if (KB.sent) KB.sent = KB.jobs.find((j) => j.id === KB.sent.id) || KB.sent;
  } catch (e) { if (!KB.jobs) KB.jobs = []; }
  if (S.view !== 'kb') return;
  renderKbJobs();
  if (KB.sent && !KB.sending) renderKbForm();
  clearTimeout(KB.pollTimer);
