.an-right .an-bar{margin:0;justify-content:flex-end}
.an-right .an-actions{justify-content:flex-end}
@media (max-width:760px){.an-right{align-items:stretch;width:100%}.an-right .an-bar{justify-content:flex-start}}
.an-table td.bad{background:var(--red-bg);color:var(--red);font-weight:600}
.an-table tbody tr:hover td.bad{background:var(--red-bg)}
.an-f.bad{background:var(--red-bg);border-radius:8px;padding:4px 6px;margin:-4px -6px}
.an-f.bad b,.an-f.bad span{color:var(--red)}
.an-row2{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:14px}
.an-row2 .an-bar{margin:0;justify-content:flex-end;min-width:0}
.an-row2 .an-actions{flex-wrap:nowrap}
@media (max-width:760px){.an-row2{flex-direction:column;align-items:stretch}.an-row2 .an-bar{justify-content:flex-start}}
#view-tasks>.hello{display:none}
.toolbar.t-row{padding-left:0;padding-right:0}
.hello h1{display:none}
#view-clients>.hello,#view-analytics>.hello,#view-reflection>.hello{display:none}
.hello{justify-content:flex-end}
.cc-ico{width:32px;height:32px;border-radius:50%;display:inline-grid;place-items:center;color:var(--muted)}
.cc-ico:hover{background:var(--sunken);color:var(--ink)}
.cc-ico .ic{width:17px;height:17px}
.cc-links2{gap:2px}
.cc-adv{display:flex;align-items:center;gap:8px;flex-wrap:wrap;border:1px solid var(--line);border-radius:12px;padding:9px 12px;font-size:13px;color:var(--muted)}
.cc-adv .ic{width:16px;height:16px}
.cc-adv b{color:var(--ink);font-size:14.5px;margin-left:auto;font-variant-numeric:tabular-nums}
.cc-adv em{flex-basis:100%;font-style:normal;font-size:12.5px;color:var(--muted);padding-left:24px}
.cc-adv.low{background:var(--amber-bg);border-color:transparent;color:var(--amber)}
.cc-adv.low em{color:var(--amber);font-weight:500}
.cc-adv.off em{flex-basis:auto;margin-left:auto;padding:0}
.cc-adv:not(.off){display:grid;gap:4px}
.cc-money{display:flex;align-items:center;gap:8px}
.cc-money span{display:inline-flex;align-items:center;gap:8px}
.cc-money b{margin-left:auto}
.cc-adv:not(.off) em{padding-left:24px}
.cc-when{font-style:normal;font-size:11.5px;color:var(--faint);padding-left:24px}
.cc-adv.low .cc-when{color:var(--amber);opacity:.8}
.c-refresh.busy .ic{animation:spin 1s linear infinite}
@media (max-width:760px){.c-refresh span{display:none}.c-refresh{padding:0 10px}}
@keyframes spin{to{transform:rotate(360deg)}}
.cc-check{display:flex;gap:10px;align-items:flex-start;cursor:pointer;color:var(--ink)!important;font-size:13.5px!important;padding:4px 0}
.cc-check input{width:18px;height:18px;accent-color:var(--accent);margin-top:1px;flex:none}
.cc-check small{font-size:12px;color:var(--muted);font-weight:500}
.m-secs{display:grid;gap:8px;padding:10px 12px;background:var(--surface-2);border-radius:12px}
.m-secs-h{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.m-secs-list{display:flex;gap:6px;flex-wrap:wrap}
.sec-chip{display:inline-flex;align-items:center;gap:5px;height:30px;padding:0 12px;border-radius:999px;border:1px solid var(--line);background:var(--surface);font-size:13px;font-weight:600;color:var(--muted)}
.sec-chip:hover{border-color:var(--faint);color:var(--ink)}
.sec-chip.on{background:var(--ink);border-color:var(--ink);color:var(--bg)}
.sec-chip[disabled]{opacity:.55;cursor:default}
.an-table-wrap{scrollbar-width:none}
.an-table-wrap::-webkit-scrollbar{display:none}
.an-table:not(.edit){font-size:13px}
.an-table:not(.edit) th{white-space:normal;line-height:1.25;vertical-align:bottom;min-width:0}
.an-table:not(.edit) th,.an-table:not(.edit) td{padding-left:7px;padding-right:7px}
.an-table:not(.edit) th:first-child,.an-table:not(.edit) td:first-child{min-width:140px;padding-left:12px}
.an-table:not(.edit) .an-name{font-size:13px}
.c-new{flex:none}
@media (max-width:760px){.c-new{width:40px;padding:0}.c-new span{display:none}}
</style>
