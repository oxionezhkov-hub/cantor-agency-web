        S.token = res.data.token; store.set(K_TOKEN, S.token);
        S.justActivated = res.data.me;
        // Встроенный браузер Telegram может не сохранять вход — тогда ссылка-приглашение остаётся
        // в адресе, и обновление страницы снова пускает внутрь, а не показывает «Нет доступа».
        if (store.get(K_TOKEN) === S.token) history.replaceState(null, '', bare);
