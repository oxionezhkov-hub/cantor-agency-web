    const bare = location.pathname + (qs ? '?' + qs : '') + location.hash;
    try {
      const res = await api('activate', { invite });
      if (res.ok && res.data.token) {
        if (S.token !== res.data.token) store.del(K_CACHE);
        S.token = res.data.token; store.set(K_TOKEN, S.token);
        S.justActivated = res.data.me;
