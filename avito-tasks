// ── приоритеты: что делать первым ──
function statusKey(t) { return t.status === 'open' ? (t.takenAt ? 'progress' : 'new') : t.status; }
function isOpen(t) { return t.status === 'open'; }
function urgency(t, now) {
  let s = { urgent: 300, high: 150, normal: 0, low: -80 }[t.priority] || 0;
  const due = dueMs(t);
  if (isOpen(t) && due) {
    if (due < now) s += 1000 + Math.min(200, (now - due) / 3600000);
    else if (due - now < 86400000 || dayStart(due) === dayStart(now)) s += 500;
    else if (due - now < 3 * 86400000) s += 200;
  }
  if (t.status === 'done') s += 50;
  if (!isOpen(t) && t.status !== 'done') s -= 5000;
  return s;
}
function focusReason(t, now) {
  const due = dueMs(t);
  if (due && due < now) { const h = Math.round((now - due) / 3600000); return h < 24 ? `просрочено на ${Math.max(1, h)} ч` : `просрочено на ${Math.round(h / 24)} ${plural(Math.round(h / 24), 'день', 'дня', 'дней')}`; }
  if (due && dayStart(due) === dayStart(now)) return `срок сегодня в ${fmtTime(due)}`;
  if (t.priority === 'urgent') return 'срочно';
  if (due && due - now < 86400000) return `срок ${fmtDay(due, now)} в ${fmtTime(due)}`;
  if (t.priority === 'high') return 'высокий приоритет';
  return '';
}
const PRIO = { urgent: ['Срочно', 'var(--p-urgent)'], high: ['Высокий', 'var(--p-high)'], normal: ['Обычный', 'var(--faint)'], low: ['Низкий', 'var(--p-low)'] };
const STATUS = { new: 'Новая', progress: 'В работе', done: 'Готово — сообщить клиенту', closed: 'Закрыта', cancelled: 'Отменена' };

// ── фильтры ──
function matches(t, now) {
  const f = S.f;
  if (f.scope === 'mine' && t.assigneeId !== S.me.id) return false;
  if (f.scope === 'byme' && t.createdById !== S.me.id) return false;
  if (f.client && (t.projectId || '__none') !== f.client) return false;
  if (f.assignee && (t.assigneeId || '__none') !== f.assignee) return false;
  if (f.priority && (t.priority || 'normal') !== f.priority) return false;
  const sk = statusKey(t);
  const due = dueMs(t);
  if (f.status === 'active' && !(sk === 'new' || sk === 'progress' || sk === 'done')) return false;
  if (f.status === 'overdue' && !(isOpen(t) && due && due < now)) return false;
  if (f.status === 'today' && !(isOpen(t) && due && dayStart(due) <= dayStart(now))) return false;
  if (STATUS[f.status] && sk !== f.status) return false;
  if (f.q) {
    const hay = `${t.text} ${t.note} ${clientName(t)} ${(userById(t.assigneeId) || {}).name || t.owner || ''}`.toLowerCase().replace(/ё/g, 'е');
    if (!f.q.toLowerCase().replace(/ё/g, 'е').split(/\s+/).filter(Boolean).every((w) => hay.includes(w))) return false;
  }
  return true;
}
