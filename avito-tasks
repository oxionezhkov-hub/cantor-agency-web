  if (cab) {
    try {
      const res = await api('an-cabinet-link', { projectId: cab.dataset.pid, accountId: cab.value || null });
      if (!res.ok) throw new Error();
      AN.cab = res.data;
      toast('Сохранено');
    } catch (err) { toast('Не сохранилось — нет связи'); }
  }
});

// ── вкладка «Клиенты»: по каждому клиенту — что сделать сейчас и как идут дела на Авито ──
// Цифры с Авито (неделя, ₽ контакта, аванс) грузятся отдельно и только когда вкладка открыта.
const CM = { data: null, loading: false, loadedAt: 0 };
async function loadClientMetrics(force) {
  if (CM.loading || (!force && CM.data && Date.now() - CM.loadedAt < 5 * 60000)) return;
  CM.loading = true;
  try { const res = await api('clients-metrics'); if (res.ok) { CM.data = res.data.clients; CM.loadedAt = Date.now(); } } catch (e) { /* покажем без цифр */ }
  CM.loading = false;
  if (S.view === 'clients' && !isEditing()) renderClients();
}
$('clientsRefresh').addEventListener('click', async () => {
  const b = $('clientsRefresh');
  if (b.classList.contains('busy')) return;
  b.classList.add('busy'); b.querySelector('span').textContent = 'Обновляю…';
  try {
    const res = await api('clients-refresh');
    if (!res.ok) throw new Error();
    CM.data = res.data.clients; CM.loadedAt = Date.now();
    toast('Аванс и кошелёк обновлены по всем клиентам');
  } catch (e) { toast('Не получилось обновить — попробуйте ещё раз'); }
  b.classList.remove('busy'); b.querySelector('span').textContent = 'Обновить с Авито';
  if (S.view === 'clients' && !isEditing()) renderClients();
});
function clientTodo(p, i, m, now) {
  const out = [];
  const pend = i.b.pending;
  if (i.wd == null || i.wd >= 3) out.push({ kind: 'silent', tone: 'red', html: `${ico('send')}<div><b>Пора написать клиенту</b><div class="cc-sub2">${i.last ? `последний раз ${esc(fmtDay(i.last, now))}${i.lastWhat ? ` — ${esc(i.lastWhat)}` : ''}` : 'обновлений ещё не было'}</div></div>` });
  if (i.inform.length) out.push({ kind: 'inform', tone: 'amber', html: `${ico('check')}<div><b>Сделано — расскажите клиенту</b><div class="cc-tasks">${i.inform.slice(0, 3).map((t) => `<button data-open="${esc(t.id)}">${esc(t.text)}</button>`).join('')}${i.inform.length > 3 ? `<button data-filter>…и ещё ${i.inform.length - 3}</button>` : ''}</div></div>` });
  const money = clientMoney(m);
  const daysLeft = money != null && m.perDay > 0 ? Math.floor(money / m.perDay) : null;
  if (money != null && money < 1500) out.push({ kind: 'money', tone: 'amber', html: `${ico('wallet')}<div><b>Заканчиваются деньги в кабинете: ${anMoney(money)}</b><div class="cc-sub2">${daysLeft < 1 ? 'хватит меньше чем на день' : `хватит примерно на ${daysLeft} ${plural(daysLeft, 'день', 'дня', 'дней')}`} — попросите пополнить</div></div>` });
  return out;
}
function clientMetricsHtml(p, m) {
  if (p.inactive) return '';
  if (!CM.data) return `<div class="cc-metrics2"><i class="sk"></i><i class="sk"></i><i class="sk"></i></div>`;
  if (!m) return '';
  const cpl = (r) => (r.contacts ? r.budget / r.contacts : null);
  const conv = (r) => (r.views ? (r.contacts / r.views) * 100 : null);
  const mon = AN_MONTHS[+m.monthKey.slice(5, 7) - 1];
  const dayCpl = cpl(m.day); const monCpl = cpl(m.month);
  const dayConv = conv(m.day); const monConv = conv(m.month);
  return `<div class="cc-metrics2">
    <span></span><span class="h">Вчера</span><span class="h">${esc(mon)}</span>
    <span class="l">Контакты</span><b>${anNum(m.day.contacts)}</b><b>${anNum(m.month.contacts)}</b>
    <span class="l">% в контакт</span><b class="${dayConv != null && monConv && dayConv < monConv * 0.75 ? 'warn' : ''}">${anPct(dayConv)}</b><b>${anPct(monConv)}</b>
    <span class="l">₽ контакта</span><b class="${dayCpl && monCpl && dayCpl > monCpl * 1.2 ? 'warn' : ''}">${anMoney(dayCpl)}</b><b>${anMoney(monCpl)}</b>
    <span class="l">Бюджет</span><b>${anMoney(m.day.budget)}</b><b>${anMoney(m.month.budget)}</b>
  </div>`;
}
// Деньги в кабинете: аванс (CPA) и кошелёк — отдельными строками. Предупреждение — по авансу, а если
// его нет (кабинет без CPA) — по кошельку.
function clientMoney(m) { return !m ? null : m.advance != null ? m.advance : m.wallet; }
function clientAdvanceHtml(p, m) {
  if (p.inactive || !CM.data || !m) return '';
  if (m.advance == null && m.wallet == null) return `<div class="cc-adv off">${ico('wallet')}<span>Аванс и кошелёк</span><em>${m.linked ? 'нет данных' : 'кабинет не подключён'}</em></div>`;
  const money = clientMoney(m);
  const days = m.perDay > 0 ? Math.floor(money / m.perDay) : null;
  const low = money < 1500; // предупреждаем, только когда в кабинете меньше 1 500 ₽
  const at = m.moneyAt ? Date.parse(m.moneyAt) : 0;
  return `<div class="cc-adv ${low ? 'low' : ''}">
    <div class="cc-money"><span>${ico('wallet')}Аванс</span><b>${m.advance == null ? '—' : anMoney(m.advance)}</b></div>
    <div class="cc-money"><span>${ico('wallet')}Кошелёк</span><b>${m.wallet == null ? '—' : anMoney(m.wallet)}</b></div>
    ${low ? `<em>${days != null && days >= 1 ? `хватит на ~${days} ${plural(days, 'день', 'дня', 'дней')}` : 'хватит меньше чем на день'} — попросите пополнить</em>` : ''}
    ${at ? `<i class="cc-when">обновлено ${esc(fmtDay(at, Date.now()))}${fmtDay(at, Date.now()).length < 12 ? ` в ${fmtTime(at)}` : ''}</i>` : ''}
  </div>`;
}
function renderClients() {
  if (!canSeeClients()) return;
  if (S.view === 'clients') loadClientMetrics(false);
  const now = Date.now();
  const all = S.projects.map((p) => { const i = clientInfo(p); const m = CM.data && CM.data[p.id]; return { p, i, m, todo: p.inactive ? [] : clientTodo(p, i, m, now) }; });
  const active = all.filter((r) => !r.p.inactive);
  const has = (kind) => active.filter((r) => r.todo.some((t) => t.kind === kind)).length;
  const attention = active.filter((r) => r.todo.length).length;
  const stat = (key, n, label, color) => (n || key === '' ? `<button class="stat ${CF.show === key ? 'on' : ''}" data-cstat="${key}">${color ? `<span class="dot" style="background:${color}"></span>` : ''}${label} <b>${n}</b></button>` : '');
  $('clientStats').innerHTML = [
    stat('', active.length, 'Все', ''),
    stat('attention', attention, 'Нужно действие', 'var(--accent)'),
    stat('silent', has('silent'), 'Давно не писали', 'var(--red)'),
    stat('inform', has('inform'), 'Рассказать о сделанном', 'var(--amber)'),
    stat('money', has('money'), 'Кончается аванс', 'var(--amber)'),
  ].join('');
  const filtering = !!(CF.q || CF.show);
  const shown = (r) => {
    if (CF.q && !r.p.name.toLowerCase().replace(/ё/g, 'е').includes(CF.q)) return false;
    if (CF.show === 'attention') return r.todo.length > 0;
    if (CF.show) return r.todo.some((t) => t.kind === CF.show);
    return true;
  };
  const weight = { waiting: 1000, silent: 400, money: 300, overdue: 200, inform: 150 };
  // наверх — клиенты с уведомлениями (сначала самые срочные), остальные ниже по алфавиту
  const score = (r) => r.todo.reduce((s, t) => s + (weight[t.kind] || 0), 0);
  const rows = all.filter((r) => (prefs.showInactive || filtering || !r.p.inactive) && shown(r))
    .sort((a, b) => (a.p.inactive - b.p.inactive) || score(b) - score(a) || a.p.name.localeCompare(b.p.name, 'ru'));
  $('clientCards').innerHTML = (rows.length ? '' : `<div class="cc-empty">${filtering ? 'Никого не нашлось' : 'Клиентов пока нет'}</div>`)
    + rows.map(({ p, i, m, todo }) => {
      const stLabel = p.inactive ? 'неактивный' : i.wd == null ? 'Нет обновлений' : i.wd === 0 ? 'Писали сегодня' : i.wd === 1 ? 'Писали вчера' : `${i.wd} ${plural(i.wd, 'рабочий день', 'рабочих дня', 'рабочих дней')} тишины`;
      const level = p.inactive ? 'off' : todo.some((t) => t.tone === 'red') ? 'red' : todo.length ? 'amber' : 'green';
      const link = (url, label, icon) => (url ? `<a class="cc-ico" href="${esc(url)}" target="_blank" rel="noopener" title="${esc(label)}" aria-label="${esc(label)}">${ico(icon)}</a>` : '');
      return `<div class="ccard lv-${level} ${p.inactive ? 'off' : ''} ${CF.focus === p.id ? 'focus' : ''}" data-client="${esc(p.id)}">
        <div class="cc-head"><div><div class="cc-name">${esc(p.name)}</div></div>
          ${p.inactive ? '<span class="cc-state st-off">неактивный</span>' : ''}</div>
        ${clientMetricsHtml(p, m)}
        ${clientAdvanceHtml(p, m)}
        ${p.inactive ? '' : todo.some((t) => t.kind !== 'money') ? `<div class="cc-todo">${todo.filter((t) => t.kind !== 'money').map((t) => `<div class="cc-do ${t.tone}">${t.html}</div>`).join('')}</div>` : ''}
        ${linksOpen === p.id ? linksHtml(p) : ''}
        <div class="cc-foot">
          <button class="btn btn-ghost btn-sm" data-newtask>${ico('plus', 'ic-sm')}Задача</button>
          <button class="cc-mini" data-filter>Задачи: ${i.open.length}${ico('chev', 'rot-90')}</button>
          <span class="cc-links2">${link(p.staffUrl, 'Подключиться к кабинету Авито (ссылка для сотрудников)', 'key')}${link(p.profileUrl, 'Профиль на Авито', 'tag')}${link(p.briefUrl, 'Бриф', 'report')}<button class="cc-ico" data-links-edit title="Изменить клиента: ссылки, вход в кабинет, активность" aria-label="Изменить клиента">${ico('edit')}</button></span>
        </div>
      </div>`;
    }).join('');
  $('newClient').hidden = !isAdmin();
  const inactive = S.projects.filter((p) => p.inactive).length;
  $('toggleInactive').hidden = !inactive || filtering;
  $('toggleInactive').textContent = prefs.showInactive ? 'Скрыть неактивных клиентов' : `Показать неактивных клиентов (${inactive})`;
  if (CF.focus) {
    const el = $('clientCards').querySelector(`[data-client="${CSS.escape(CF.focus)}"]`);
    CF.focus = null;
    if (el) setTimeout(() => el.scrollIntoView({ block: 'center', behavior: 'smooth' }), 50);
  }
}

// ── доступ к разделам: по умолчанию от роли, руководитель может включить или выключить любой раздел человеку ──
const SEC_ALL = [['tasks', 'Задачи'], ['clients', 'Клиенты'], ['analytics', 'Аналитика'], ['meet', 'Встречи'], ['reflection', 'Рефлексия'], ['team', 'Команда'], ['kb', 'База знаний']];
const roleSections = (role) => ((S.team && S.team.roleSections) || SEC_BY_ROLE)[role] || ['tasks'];
function memberSections(u) { return u.role === 'owner' ? SEC_ALL.map(([k]) => k) : u.sections || roleSections(u.role); }
function memberSectionsHtml(u, locked) {
  const on = memberSections(u);
  const custom = !!u.sections;
  return `<div class="m-secs">
    <div class="m-secs-h"><span class="label" style="margin:0">Разделы</span>${custom ? `<span class="tag tag-progress">своя настройка</span>${locked ? '' : '<button class="btn btn-quiet btn-sm" data-sec-reset>Как у роли</button>'}` : '<span class="muted" style="font-size:12.5px">как у роли</span>'}</div>
    <div class="m-secs-list">${SEC_ALL.map(([k, label]) => {
      const fixed = locked || k === 'tasks';
      return `<button type="button" class="sec-chip ${on.includes(k) ? 'on' : ''}" data-sec-toggle="${k}" ${fixed ? 'disabled' : ''} aria-pressed="${on.includes(k)}">${on.includes(k) ? ico('check', 'ic-sm') : ''}${label}</button>`;
    }).join('')}</div>
  </div>`;
}
$('members').addEventListener('click', async (e) => {
  const card = e.target.closest('[data-member]');
  if (!card || !S.team) return;
  const u = S.team.users.find((x) => x.id === card.dataset.member);
  const t = e.target.closest('[data-sec-toggle]');
  const r = e.target.closest('[data-sec-reset]');
  if (!u || (!t && !r)) return;
  const before = u.sections;
  if (r) u.sections = null;
  else {
    const k = t.dataset.secToggle;
    const cur = memberSections(u);
    const next = cur.includes(k) ? cur.filter((x) => x !== k) : SEC_ALL.map(([x]) => x).filter((x) => cur.includes(x) || x === k);
    const role = roleSections(u.role);
    u.sections = next.length === role.length && next.every((x) => role.includes(x)) ? null : next;
  }
  renderMembers();
  try {
    const res = await api('user-sections', { id: u.id, sections: u.sections });
    if (!res.ok) throw new Error();
    S.team = res.data;
    renderMembers();
    toast(`${first(u.name)}: доступ к разделам обновлён`);
  } catch (err) { u.sections = before; renderMembers(); toast('Не сохранилось — нет связи'); }
});

// Новый клиент (раньше — «Новый проект» в дашборде).
$('newClient').addEventListener('click', () => {
  $('drawerRoot').innerHTML = `<div class="scrim" data-close></div>
    <aside class="drawer an-drawer" role="dialog" aria-label="Новый клиент">
      <div class="drawer-head"><h2>Новый клиент</h2><button class="icon-btn" data-close aria-label="Закрыть">${ico('x')}</button></div>
      <form class="drawer-body" id="newClientForm"><label class="label" for="newClientName">Имя</label><input class="input" id="newClientName" maxlength="120" placeholder="Имя Фамилия" autocomplete="off" required></form>
      <div class="drawer-foot"><button class="btn btn-primary" type="submit" form="newClientForm">Создать</button></div>
    </aside>`;
  setTimeout(() => $('newClientName') && $('newClientName').focus(), 30);
});
$('drawerRoot').addEventListener('submit', async (e) => {
  if (e.target.id !== 'newClientForm') return;
  e.preventDefault();
  const name = $('newClientName').value.trim();
  if (name.length < 2) return;
  const btn = $('drawerRoot').querySelector('[form="newClientForm"]');
  btn.disabled = true;
  try {
    const res = await api('client-new', { name });
    if (!res.ok) throw new Error();
    S.projects = [...S.projects, res.data.project];
    $('drawerRoot').innerHTML = '';
    CM.data = null;
    renderClients();
    toast(`Клиент «${name}» добавлен`);
  } catch (err) { btn.disabled = false; toast('Не сохранилось — нет связи'); }
});

boot();
</script>
