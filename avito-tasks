  if (due && dayStart(due) === dayStart(now)) return `срок сегодня в ${fmtTime(due)}`;
  if (t.priority === 'urgent') return 'срочно';
  if (due && due - now < 86400000) return `срок ${fmtDay(due, now)} в ${fmtTime(due)}`;
