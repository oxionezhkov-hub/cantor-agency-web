async function loadRegs() {
  try {
    const res = await fetch('/base/', { cache: 'no-cache' });
    if (!res.ok) throw new Error(String(res.status));
    const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
    const list = [];
    doc.querySelectorAll('.cat-section').forEach((sec) => {
      const label = sec.querySelector('.section-label');
      sec.querySelectorAll('a.featured-card, a.cat-card').forEach((a) => {
        const slug = (a.getAttribute('href') || '').replace(/^\/base\//, '').replace(/\/$/, '');
        if (!/^[a-z0-9][a-z0-9-]+$/.test(slug) || list.some((x) => x.slug === slug)) return;
        const t = a.querySelector('.featured-card-title, .cat-card-title');
        const d = a.querySelector('.featured-card-desc, .cat-card-desc');
        list.push({ slug, title: t ? t.textContent.trim() : slug, desc: d ? d.textContent.trim() : '', section: label ? label.textContent.trim() : '' });
      });
    });
    if (!list.length) throw new Error('empty');
    KB.regs = list;
