// ── вкладка «Задачи» ──
function renderTasks() {
  const now = Date.now();
  const h = msk(now).hh;
  $('helloTitle').textContent = `${h < 5 ? 'Доброй ночи' : h < 12 ? 'Доброе утро' : h < 18 ? 'Добрый день' : 'Добрый вечер'}, ${first(S.me.name)}`;
  const mine = S.tasks.filter((t) => t.assigneeId === S.me.id && isOpen(t));
  const overdue = mine.filter((t) => dueMs(t) && dueMs(t) < now).length;
  const today = mine.filter((t) => dueMs(t) && dueMs(t) >= now && dayStart(dueMs(t)) === dayStart(now)).length;
  const inWork = mine.filter((t) => t.takenAt).length;
  $('helloSub').textContent = mine.length
    ? `На вас ${mine.length} ${plural(mine.length, 'открытая задача', 'открытые задачи', 'открытых задач')}${overdue ? `, из них ${overdue} ${plural(overdue, 'просрочена', 'просрочены', 'просрочено')}` : ''}.`
    : 'Открытых задач на вас нет — можно помочь коллегам или поставить новую.';
  const toInform = S.tasks.filter(needsInform).length;
  const stat = (key, n, label, color, extra) => `<button class="stat ${extra || ''}" data-stat="${key}"><span class="dot" style="background:${color}"></span>${label} <b>${n}</b></button>`;
  const f = S.f;
  $('stats').innerHTML = [
    overdue ? stat('overdue', overdue, 'Просрочено', 'var(--red)', f.scope === 'mine' && stIs('overdue') ? 'on' : '') : '',
    stat('today', today, 'На сегодня', 'var(--amber)', f.scope === 'mine' && stIs('today') ? 'on' : ''),
    stat('progress', inWork, 'В работе', 'var(--blue)', f.scope === 'mine' && stIs('progress') ? 'on' : ''),
    canSeeClients() && toInform ? stat('inform', toInform, 'Сообщить клиенту', 'var(--amber)', f.scope === 'all' && stIs('done') ? 'on' : '') : '',
  ].join('');
  renderBanners();
  renderComposer();
  fillFilters();
  renderLists();
}
$('stats').addEventListener('click', (e) => {
  const b = e.target.closest('[data-stat]');
