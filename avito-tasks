  const statusBtns = ['new', 'progress', 'done', 'closed', 'cancelled'].filter((k) => k !== 'done' || inform || sk === 'done').map((k) => `<button type="button" class="pill ${sk === k ? 'on' : ''}" data-status="${k}">${k === 'done' ? (inform ? 'Готово, сообщить клиенту' : 'Готово') : k === 'closed' && inform ? 'Закрыта, клиенту сообщили' : k === 'closed' && t.internal ? 'Готово, закрыта' : STATUS[k]}</button>`).join('');
  const acts = (t.activity || []).slice().reverse();
