// ── вкладка «Встречи»: окна для созвонов с клиентами ──
// Руководитель выбирает дни и отмечает свободные окна по 30 минут (мышью можно вести по нескольким
// сразу, в том числе через разные дни). Менеджер нажимает на свободное окно и выбирает клиента —
// сохраняется сразу; чтобы перенести, очищает окно и записывает в другое. Остальные видят только
// назначенные встречи со ссылкой Zoom и могут отметить «хочу прийти» — руководитель видит их аватарки.
const MT_TIMES = (() => { const a = []; for (let h = 9; h < 21; h += 1) a.push(`${pad(h)}:00`, `${pad(h)}:30`); return a; })();
const MT = { state: null, loadedAt: 0, loading: false, queue: [], add: new Set(), remove: new Set(), timer: null, saving: false, saveState: '', pick: null, q: '', calWeek: 0, menu: null, paint: null, mouseAt: 0 };
const mtToday = () => { const p = msk(Date.now()); return `${p.y}-${pad(p.m + 1)}-${pad(p.d)}`; };
function mtAddDays(ymd, n) { const d = new Date(ymd + 'T12:00:00Z'); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); }
function mtDay(ymd) { const d = new Date(ymd + 'T12:00:00Z'); return { dow: DOW[d.getUTCDay()], dm: `${pad(d.getUTCDate())}.${pad(d.getUTCMonth() + 1)}`, day: d.getUTCDate(), month: d.getUTCMonth() }; }
const MT_MONTHS = ['янв', 'фев', 'мар', 'апр', 'мая', 'июн', 'июл', 'авг', 'сен', 'окт', 'ноя', 'дек'];
function mtTodayCount() {
  if (!MT.state) return 0;
  const today = mtToday();
  const now = fmtTime(Date.now());
  return Object.keys(MT.state.book).filter((k) => k.slice(0, 10) === today && mtEnd(k.slice(11)) > now).length;
}
async function loadMeet(force) {
  if (MT.loading || MT.queue.length || MT.add.size || MT.remove.size || MT.saving || MT.inflight) return;
  if (!force && MT.state && Date.now() - MT.loadedAt < 25000) return renderMeet();
  MT.loading = true;
  try {
    const res = await api('meet');
    if (res.ok && res.data.state) { MT.state = res.data.state; MT.loadedAt = Date.now(); }
  } catch (e) { /* нет связи — покажем, что было */ }
  MT.loading = false;
  renderHeader();
  renderMeet();
}
// Пока страница открыта на «Встречах» — обновляем раз в 30 секунд (менеджер мог записать клиента).
setInterval(() => { if (S.view === 'meet' && !document.hidden && !MT.pick && !MT.paint && !MT.menu) loadMeet(true); }, 30000);

function mtBookings(fromDate) {
  return Object.entries(MT.state.book).filter(([k]) => k.slice(0, 10) >= fromDate).sort(([a], [b]) => (a < b ? -1 : 1));
}
function mtAvatars(ids) {
  const people = (ids || []).map(userById).filter(Boolean);
  return people.length ? `<span class="mt-av" title="${esc(people.map((u) => u.name).join(', '))}">${people.map((u) => avatar(u, 'xs')).join('')}</span>` : '';
