    <div class="grid2">
      <div><label class="label">Клиент</label><select class="select" data-f="projectId">${clientOptions(t.projectId)}</select></div>
      <div><label class="label">Исполнитель</label><select class="select" data-f="assigneeId">${userOptions(t.assigneeId)}</select></div>
    </div>
    <div><label class="label">Срок</label>${dueChips(dueMs(t) ? toInput(dueMs(t)) : null, now)}</div>
