function mtSave(state) {
  MT.saveState = state;
  const el = $('mtSave');
  if (!el) return;
  el.textContent = state === 'saving' ? 'Сохраняю…' : state === 'ok' ? 'Сохранено' : state === 'err' ? 'Нет связи — повторю' : '';
