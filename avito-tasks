  const on = b.classList.contains('on');
  Object.assign(S.f, on ? { scope: 'all', status: ST_ACTIVE.slice() } : k === 'inform' ? { scope: 'all', status: ['done'] } : { scope: 'mine', status: [k] });
  savePrefs(); renderTasks();
});

function renderBanners() {
  if (!S.me || S.view !== 'tasks') return;
  const out = [];
  if (S.offline) out.push(`<div class="banner warn"><div class="b-ic">${ico('refresh')}</div><div class="b-text"><b>Нет связи с сервером.</b> Показываю последние загруженные задачи, попробую снова через минуту.</div></div>`);
