}
function render() {
  if (isEditing()) { S.pendingRender = true; renderHeader(); return; }
  S.pendingRender = false;
  renderHeader();
  if (S.view === 'tasks') renderTasks();
  if (S.view === 'clients') renderClients();
  if (S.view === 'analytics') renderAnalytics();
  if (S.view === 'team') { if (S.teamTab === 'access') renderTeamStatic(); else loadActivity(); }
  if (S.view === 'meet') renderMeet();
