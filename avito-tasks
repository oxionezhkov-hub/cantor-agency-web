    <div class="comp-line">
      <span class="plus">${ico('plus', 'ic-sm')}</span>
      <input class="comp-input" id="cText" value="${esc(d.text)}" placeholder="Новая задача — себе или коллеге…" maxlength="300" autocomplete="off">
      ${d.open ? '' : '<button class="btn btn-primary btn-sm" data-c="open">Создать</button>'}
    </div>
    ${d.open ? `<div class="comp-body">
      <div class="grid2">
        <div><label class="label">Клиент</label><select class="select" id="cClient">${clientOptions(d.projectId)}</select></div>
        <div><label class="label">Исполнитель</label><select class="select" id="cAssignee">${userOptions(d.assigneeId)}</select></div>
      </div>
      <div><label class="label">Срок</label>${dueChips(d.due, Date.now())}</div>
      <div><label class="label">Приоритет</label>${prioPills(d.priority)}</div>
      <div><label class="label">Детали</label><textarea class="textarea" id="cNote" rows="2" placeholder="Необязательно: что именно, ссылки, договорённости">${esc(d.note)}</textarea></div>
      <div class="comp-actions">
        <span class="hint">${assignee && assignee.id !== S.me.id ? `${esc(first(assignee.name))} получит уведомление${assignee.tg ? ' в Telegram' : ' в трекере'}` : 'Enter в названии — создать'}</span>
        <button class="btn btn-quiet btn-sm" data-c="cancel">Отмена</button>
        <button class="btn btn-primary btn-sm" data-c="create">Создать задачу</button>
      </div>
    </div>` : ''}`;
}
function draftFromDom() {
  const d = S.draft;
  if ($('cText')) d.text = $('cText').value;
  if ($('cClient')) d.projectId = $('cClient').value;
  if ($('cAssignee')) d.assigneeId = $('cAssignee').value;
  if ($('cNote')) d.note = $('cNote').value;
}
function openComposer(prefill) {
  if (S.view !== 'tasks') setView('tasks');
  draftFromDom();
  Object.assign(S.draft, { open: true }, prefill || {});
  renderComposer();
  $('composer').scrollIntoView({ behavior: 'smooth', block: 'start' });
  setTimeout(() => $('cText') && $('cText').focus({ preventScroll: true }), 250);
}
$('composer').addEventListener('focusin', (e) => { if (e.target.id === 'cText' && !S.draft.open) { S.draft.open = true; draftFromDom(); renderComposer(); $('cText').focus(); const v = $('cText'); v.setSelectionRange(v.value.length, v.value.length); } });
$('composer').addEventListener('click', (e) => {
  const c = e.target.closest('[data-c]');
  const due = e.target.closest('[data-due]');
  const prio = e.target.closest('[data-prio]');
  if (due) { draftFromDom(); S.draft.due = due.dataset.due || null; renderComposer(); return; }
  if (prio) { draftFromDom(); S.draft.priority = prio.dataset.prio; renderComposer(); return; }
  if (!c) return;
  if (c.dataset.c === 'open') openComposer();
  if (c.dataset.c === 'cancel') { S.draft = newDraft(); renderComposer(); }
  if (c.dataset.c === 'create') createTask();
});
$('composer').addEventListener('change', (e) => {
  if (e.target.dataset.f === 'due') { draftFromDom(); S.draft.due = e.target.value || null; renderComposer(); }
  if (e.target.id === 'cAssignee') { draftFromDom(); renderComposer(); }
});
$('composer').addEventListener('keydown', (e) => {
  if (e.target.id === 'cText' && e.key === 'Enter') { e.preventDefault(); createTask(); }
  if (e.key === 'Escape') { S.draft.open = false; draftFromDom(); renderComposer(); }
});
let creating = false;
async function createTask() {
  draftFromDom();
  const d = S.draft;
  if (!d.text.trim()) { $('cText') && $('cText').focus(); return; }
  if (creating) return;
  creating = true;
  const btn = document.querySelector('[data-c="create"]'); if (btn) btn.disabled = true;
  try {
    const res = await api('task-save', { task: { text: d.text.trim(), note: d.note.trim(), projectId: d.projectId || null, assigneeId: d.assigneeId || null, due: d.due || null, priority: d.priority } });
    if (!res.ok) throw new Error(res.data.error);
    S.tasks.push(res.data.task);
    const u = userById(res.data.task.assigneeId);
    S.draft = Object.assign(newDraft(), { open: true, projectId: d.projectId, assigneeId: d.assigneeId });
    renderComposer();
    renderLists();
    const el = document.querySelector(`.task[data-id="${CSS.escape(res.data.task.id)}"]`);
    if (el) el.classList.add('flash');
    toast(u && u.id !== S.me.id ? `Задача поставлена — ${first(u.name)} получит уведомление` : 'Задача создана', 'Открыть', () => openTask(res.data.task.id));
    $('cText') && $('cText').focus();
  } catch (e) {
    toast('Не получилось создать задачу — проверьте интернет');
  } finally { creating = false; if (btn) btn.disabled = false; }
}
$('fab').addEventListener('click', () => openComposer());

// ── вкладка «Клиенты» ──
function clientInfo(p) {
  const now = Date.now();
  const b = (S.clients || []).find((c) => c.id === p.id) || {};
  const ts = S.tasks.filter((t) => t.projectId === p.id);
  const open = ts.filter(isOpen);
  const overdue = open.filter((t) => dueMs(t) && dueMs(t) < now);
  const inform = ts.filter((t) => t.status === 'done');
  let last = 0; let lastBy = null; let lastWhat = null;
  const bump = (iso, by, what) => { const ms = Date.parse(iso || ''); if (ms > last) { last = ms; lastBy = by; lastWhat = what; } };
  bump(b.lastUpdateAt, b.lastUpdateBy, b.lastUpdateNote || 'отметили «клиенту написали»');
  bump(b.lastTeamAt, null, 'сообщение команды в чате клиента');
  ts.forEach((t) => bump(t.informedAt, null, `сообщили результат: ${t.text}`));
  const wd = last ? workdaysSince(last, now) : null;
  let level = 'green';
  if (b.pending || wd == null || wd >= 3) level = 'red';
  else if (wd >= 2 || inform.length) level = 'amber';
  const score = (b.pending ? 1000 : 0) + (wd == null ? 500 : wd * 100) + inform.length * 60 + overdue.length * 40;
  return { b, open, overdue, inform, last, lastBy, lastWhat, wd, level, score };
}
function renderClients() {
  if (!canSeeClients()) return;
  const now = Date.now();
  const rows = S.projects.filter((p) => prefs.showInactive || !p.inactive).map((p) => ({ p, i: clientInfo(p) })).sort((a, b) => (a.p.inactive - b.p.inactive) || b.i.score - a.i.score || a.p.name.localeCompare(b.p.name, 'ru'));
  const cnt = (lvl) => rows.filter((r) => !r.p.inactive && r.i.level === lvl).length;
  const waiting = rows.filter((r) => r.i.b.pending).length;
  const informN = rows.reduce((s, r) => s + r.i.inform.length, 0);
  $('clientStats').innerHTML = [
    waiting ? `<span class="stat"><span class="dot" style="background:var(--red)"></span>Ждут ответа <b>${waiting}</b></span>` : '',
    `<span class="stat"><span class="dot" style="background:var(--red)"></span>Нужно внимание <b>${cnt('red')}</b></span>`,
    informN ? `<span class="stat"><span class="dot" style="background:var(--amber)"></span>Сообщить результаты <b>${informN}</b></span>` : '',
    `<span class="stat"><span class="dot" style="background:var(--green)"></span>В порядке <b>${cnt('green')}</b></span>`,
  ].join('');
  const anyChat = (S.clients || []).some((c) => c.chat);
  $('clientCards').innerHTML = (anyChat ? '' : `<div class="banner" style="grid-column:1/-1;margin:0"><div class="b-ic">${ico('bot')}</div><div class="b-text"><b>Бот пока только в рабочем чате.</b> Когда его добавят в чаты клиентов, здесь сами появятся вопросы клиентов, которые ждут ответа, и дата последнего сообщения от команды. Пока — отмечайте «Клиенту написали» вручную.</div></div>`)
    + rows.map(({ p, i }) => {
      const stLabel = i.b.pending ? 'Ждёт ответа' : i.wd == null ? 'Нет обновлений' : i.wd === 0 ? 'Писали сегодня' : i.wd === 1 ? 'Писали вчера' : `${i.wd} ${plural(i.wd, 'рабочий день', 'рабочих дня', 'рабочих дней')} без обновлений`;
      return `<div class="ccard ${i.level === 'red' && !p.inactive ? 'red' : ''}" data-client="${esc(p.id)}" ${p.inactive ? 'style="opacity:.6"' : ''}>
        <div class="cc-head"><div><div class="cc-name">${esc(p.name)}</div>${p.inactive ? '<div class="muted" style="font-size:12px">неактивный клиент</div>' : ''}</div><span class="cc-state st-${i.level}">${esc(stLabel)}</span></div>
        ${i.b.pending ? `<div class="cc-line alert">${ico('msg')}<div><b>Клиент ждёт ответа</b> · написал(а) ${esc(ago(i.b.pending.since, now))}<br>«${esc(i.b.pending.text)}»${i.b.pending.link ? ` <a class="tg" href="${esc(i.b.pending.link)}"><b>Открыть</b></a>` : ''}</div></div>` : ''}
        <div class="cc-line">${ico('send')}<div>${i.last ? `Последнее обновление: <b>${esc(fmtDay(i.last, now))} в ${fmtTime(i.last)}</b>${i.lastBy ? ` · ${esc(first(i.lastBy))}` : ''}<br><span class="muted">${esc(i.lastWhat || '')}</span>` : '<span class="muted">Обновлений клиенту пока не отмечено</span>'}</div></div>
        ${i.inform.length ? `<div class="cc-line inform">${ico('check')}<div><b>Готово — передать клиенту: ${i.inform.length}</b><div class="cc-tasks">${i.inform.slice(0, 4).map((t) => `<button data-open="${esc(t.id)}">• ${esc(t.text)}</button>`).join('')}</div></div></div>` : ''}
        <div class="cc-nums"><span>Открыто <b>${i.open.length}</b></span>${i.overdue.length ? `<span style="color:var(--red)">Просрочено <b style="color:inherit">${i.overdue.length}</b></span>` : ''}${i.b.chat ? `<span>${ico('bot', 'ic-sm')} бот в чате</span>` : ''}</div>
        <div class="cc-touch"><input class="input" data-touch-note placeholder="Что отправили (необязательно)" maxlength="300"><button class="btn btn-primary btn-sm" data-touch>${ico('check', 'ic-sm')}Клиенту написали</button></div>
        <div class="cc-actions">
          <button class="btn btn-ghost btn-sm" data-newtask>${ico('plus', 'ic-sm')}Задача</button>
          <button class="btn btn-quiet btn-sm" data-filter>Задачи клиента →</button>
        </div>
      </div>`;
    }).join('');
  const inactive = S.projects.filter((p) => p.inactive).length;
  $('toggleInactive').hidden = !inactive;
  $('toggleInactive').textContent = prefs.showInactive ? 'Скрыть неактивных клиентов' : `Показать неактивных клиентов (${inactive})`;
}
$('toggleInactive').addEventListener('click', () => { prefs.showInactive = !prefs.showInactive; store.set(K_PREFS, JSON.stringify(prefs)); renderClients(); });
$('clientCards').addEventListener('click', async (e) => {
  const cardEl = e.target.closest('[data-client]');
  if (!cardEl) return;
  const pid = cardEl.dataset.client;
  const open = e.target.closest('[data-open]');
  if (open) return openTask(open.dataset.open);
  if (e.target.closest('[data-newtask]')) return openComposer({ projectId: pid });
  if (e.target.closest('[data-filter]')) { Object.assign(S.f, { scope: 'all', status: 'active', client: pid, assignee: '', priority: '' }); setView('tasks'); renderTasks(); return; }
  const touch = e.target.closest('[data-touch]');
  if (touch) {
    const note = cardEl.querySelector('[data-touch-note]').value.trim();
    touch.disabled = true;
    try {
      const res = await api('client-touch', { projectId: pid, note });
      if (!res.ok) throw new Error();
      const list = S.clients || (S.clients = []);
      let c = list.find((x) => x.id === pid);
      if (!c) { c = { id: pid }; list.push(c); }
      Object.assign(c, { lastUpdateAt: res.data.client.lastUpdateAt, lastUpdateBy: res.data.client.by, lastUpdateNote: res.data.client.note });
      c.pending = null;
      renderClients(); renderHeader();
      toast('Отмечено: клиенту написали');
    } catch (err) { touch.disabled = false; toast('Не сохранилось — нет связи'); }
  }
});

// ── вкладка «Команда» (только руководитель) ──
function renderTeamStatic() {
  $('newRole').innerHTML = [['manager', 'Клиентский менеджер'], ['specialist', 'Специалист по Авито'], ['trainee', 'Стажёр по Авито']].map(([k, v]) => `<option value="${k}" ${k === 'trainee' ? 'selected' : ''}>${v}</option>`).join('');
  if (S.team) renderMembers();
}
async function loadTeam() {
  try {
    const res = await api('team');
    if (!res.ok) throw new Error();
    S.team = res.data;
    renderMembers();
  } catch (e) { $('members').innerHTML = '<div class="empty">Не получилось загрузить команду — проверьте интернет.</div>'; }
}
function renderMembers() {
  if (isEditing()) { S.pendingRender = true; return; }
  const now = Date.now();
  const roles = S.team.roles || {};
  $('members').innerHTML = S.team.users.map((u) => {
    const me = u.id === S.me.id;
    const shareText = `${first(u.name)}, это ваша личная ссылка в Avito Tasks — трекер задач команды. Откройте её один раз, дальше трекер будет открываться сам. Потом нажмите «Подключить Telegram», чтобы получать задачи и напоминания.`;
    const share = `https://t.me/share/url?url=${encodeURIComponent(u.invite)}&text=${encodeURIComponent(shareText)}`;
    const flags = [
      u.active ? (u.activatedAt ? `<span class="tag tag-closed">вошёл(а) ${esc(fmtDate(Date.parse(u.activatedAt)))}</span>` : '<span class="tag tag-done">ещё не входил(а)</span>') : '<span class="tag tag-cancelled">доступ отключён</span>',
      u.tg ? `<span class="tag tag-progress">${ico('tg', 'ic-sm')}Telegram${u.tgUsername ? ' @' + esc(u.tgUsername) : ''}</span>` : '<span class="tag tag-cancelled">без Telegram</span>',
      u.seenAt ? `<span class="tag tag-bot">был(а) ${esc(ago(Date.parse(u.seenAt), now))}</span>` : '',
    ].join('');
    return `<div class="member ${u.active ? '' : 'off'} ${S.freshMember === u.id ? 'fresh' : ''}" data-member="${esc(u.id)}">
      <div class="m-head">${avatar(u, 'lg')}<div><div class="m-name">${esc(u.name)}${me ? ' <span class="muted" style="font-weight:500">(вы)</span>' : ''}</div><div class="m-role">${esc(u.roleLabel)}</div></div><div class="m-flags">${flags}</div></div>
      ${S.freshMember === u.id ? '<div class="banner" style="margin:0"><div class="b-ic">' + ico('send') + '</div><div class="b-text"><b>Ссылка готова.</b> Отправьте её человеку — по ней он войдёт в трекер.</div></div>' : ''}
      <div class="m-link">
        <input class="input" value="${esc(u.invite)}" readonly aria-label="Пригласительная ссылка" onclick="this.select()">
        <button class="btn btn-ghost btn-sm" data-m="copy">${ico('copy', 'ic-sm')}Скопировать</button>
        <a class="btn btn-ghost btn-sm tg" href="${esc(share)}">${ico('tg', 'ic-sm')}Отправить в Telegram</a>
      </div>
      <details><summary class="btn btn-quiet btn-sm" style="list-style:none;display:inline-flex">Изменить</summary>
        <div style="display:grid;gap:12px;margin-top:10px">
          <div class="m-edit">
            <div><label class="label">Имя</label><input class="input" data-mf="name" value="${esc(u.name)}" maxlength="80"></div>
            <div><label class="label">Роль</label><select class="select" data-mf="role" ${me ? 'disabled' : ''}>${Object.entries(roles).map(([k, v]) => `<option value="${k}" ${k === u.role ? 'selected' : ''} ${k === 'owner' && !me ? 'disabled' : ''}>${esc(v)}</option>`).join('')}</select></div>
            <div><label class="label">Как называют в чатах (для бота)</label><input class="input" data-mf="aliases" value="${esc((u.aliases || []).join(', '))}" placeholder="Женя, Евгений"></div>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
            <button class="btn btn-primary btn-sm" data-m="save">Сохранить</button>
            <button class="btn btn-ghost btn-sm" data-m="reset" title="Старая ссылка перестанет работать, все устройства выйдут">${ico('refresh', 'ic-sm')}Выдать новую ссылку</button>
            ${me ? '' : `<button class="btn btn-quiet btn-sm btn-danger" data-m="delete">${ico('trash', 'ic-sm')}Удалить</button>`}
          </div>
        </div>
      </details>
      ${me ? '' : `<div style="display:flex;align-items:center;gap:10px"><button class="switch ${u.active ? 'on' : ''}" data-m="toggle" role="switch" aria-checked="${u.active}" aria-label="Доступ"></button><span class="sw-wrap">${u.active ? 'Доступ включён' : 'Доступ выключен'}</span></div>`}
    </div>`;
  }).join('');
}
async function teamAction(action, body, okText) {
  try {
    const res = await api(action, body);
    if (!res.ok) throw new Error(res.data.error);
    if (res.data.token) { S.token = res.data.token; store.set(K_TOKEN, S.token); }
    S.team = res.data;
    renderMembers();
    sync(false);
    if (okText) toast(okText);
    return res.data;
  } catch (e) { toast(e.message === 'bad_name' ? 'Введите имя' : 'Не получилось — проверьте интернет'); return null; }
}
$('addMember').addEventListener('click', async () => {
  const name = $('newName').value.trim();
  if (name.length < 2) { $('newName').focus(); return toast('Введите имя сотрудника'); }
  $('addMember').disabled = true;
  const before = new Set((S.team ? S.team.users : []).map((u) => u.id));
  const data = await teamAction('user-save', { user: { name, role: $('newRole').value } });
  $('addMember').disabled = false;
  if (data) {
    $('newName').value = '';
    const added = data.users.find((u) => !before.has(u.id));
    S.freshMember = added ? added.id : null;
    renderMembers();
    const el = added && document.querySelector(`[data-member="${CSS.escape(added.id)}"]`);
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
});
$('newName').addEventListener('keydown', (e) => { if (e.key === 'Enter') $('addMember').click(); });
$('members').addEventListener('click', async (e) => {
  const b = e.target.closest('[data-m]');
  const m = e.target.closest('[data-member]');
  if (!b || !m) return;
  const id = m.dataset.member;
  const u = S.team.users.find((x) => x.id === id);
  const act = b.dataset.m;
  if (act === 'copy') {
    try { await navigator.clipboard.writeText(u.invite); toast('Ссылка скопирована'); } catch (err) { m.querySelector('.m-link .input').select(); document.execCommand('copy'); toast('Ссылка скопирована'); }
  }
  if (act === 'toggle') teamAction('user-access', { id, active: !u.active }, u.active ? `${first(u.name)}: доступ отключён` : `${first(u.name)}: доступ включён`);
  if (act === 'reset' && confirm(`Выдать ${u.name} новую ссылку? Старая перестанет работать, все устройства ${id === S.me.id ? 'кроме этого ' : ''}выйдут из трекера.`)) {
    const data = await teamAction('user-reset', { id }, 'Новая ссылка готова — отправьте её');
    if (data) { S.freshMember = id; renderMembers(); }
  }
  if (act === 'delete' && confirm(`Удалить ${u.name} из команды? Доступ пропадёт, задачи останутся.`)) teamAction('user-delete', { id }, 'Сотрудник удалён');
  if (act === 'save') {
    const val = (k) => m.querySelector(`[data-mf="${k}"]`).value;
    document.activeElement && document.activeElement.blur();
    teamAction('user-save', { user: { id, name: val('name'), role: val('role') || u.role, aliases: val('aliases').split(',').map((s) => s.trim()).filter(Boolean) } }, 'Сохранено');
  }
});

boot();
</script>
