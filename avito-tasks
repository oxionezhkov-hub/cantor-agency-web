// Клиент, исполнитель, приоритет и поиск — без «Все/Мои» и статусов (ими же фильтруются «ничьи» задачи).
function matchesBasics(t) {
  const f = S.f;
  if (f.client && (t.projectId || '__none') !== f.client) return false;
  if (f.priority && (t.priority || 'normal') !== f.priority) return false;
  if (f.q) {
    const hay = `${t.text} ${t.note} ${clientName(t)}`.toLowerCase().replace(/ё/g, 'е');
    if (!f.q.toLowerCase().replace(/ё/g, 'е').split(/\s+/).filter(Boolean).every((w) => hay.includes(w))) return false;
  }
  return true;
}
function matches(t, now) {
  const f = S.f;
  if (f.scope === 'mine' && t.assigneeId !== S.me.id) return false;
  if (f.scope === 'byme' && t.createdById !== S.me.id) return false;
  if (f.client && (t.projectId || '__none') !== f.client) return false;
  if (f.assignee && (t.assigneeId || '__none') !== f.assignee) return false;
  if (f.priority && (t.priority || 'normal') !== f.priority) return false;
  const sk = statusKey(t);
  const due = dueMs(t);
  // Внутри группы — «или», между группами «по сроку» и «по статусу» — «и».
  const byDue = f.status.filter((k) => ST_DUE.includes(k));
  const bySt = f.status.filter((k) => !ST_DUE.includes(k));
  if (byDue.length && !(isOpen(t) && due && byDue.some((k) => (k === 'overdue' ? due < now : dayStart(due) <= dayStart(now))))) return false;
  if (bySt.length && !bySt.includes(sk)) return false;
  if (f.q) {
    const hay = `${t.text} ${t.note} ${clientName(t)} ${(userById(t.assigneeId) || {}).name || t.owner || ''}`.toLowerCase().replace(/ё/g, 'е');
    if (!f.q.toLowerCase().replace(/ё/g, 'е').split(/\s+/).filter(Boolean).every((w) => hay.includes(w))) return false;
  }
  return true;
}
