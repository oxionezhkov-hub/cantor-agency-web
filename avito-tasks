    <div><label class="label">Приоритет</label>${prioPills(c.priority)}</div>
    <div class="claim-foot">
      <button type="button" class="btn btn-quiet btn-sm btn-danger" data-act="claim-reject">Это не задача</button>
      <span style="flex:1"></span>
      <button type="button" class="btn btn-ghost btn-sm" data-act="claim-cancel">Отмена</button>
