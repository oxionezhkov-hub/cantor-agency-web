}

function renderMeet() {
  if (S.view !== 'meet' || !S.me) return;
  if (document.activeElement && document.activeElement.id === 'mtQ') return; // менеджер печатает имя клиента
  if (!MT.state) { $('mtBody').innerHTML = '<div class="empty">Загружаю…</div>'; loadMeet(true); return; }
  if (isAdmin()) mtRenderOwner();
  else if (S.me.role === 'manager') mtRenderManager();
  else mtRenderTeam();
  mtSave(MT.saveState);
}

// Список назначенных встреч по дням (руководитель и команда).
function mtListHtml(withWant) {
  const list = mtBookings(mtToday());
  if (!list.length) return `<div class="empty">${ico('cal')}<div style="margin-top:6px">Встреч пока нет.</div></div>`;
  const byDay = new Map();
  list.forEach(([k, b]) => { const d = k.slice(0, 10); if (!byDay.has(d)) byDay.set(d, []); byDay.get(d).push([k, b]); });
  const today = mtToday();
  return [...byDay].map(([d, items]) => {
    const x = mtDay(d);
    return `<div class="mt-dgroup"><div class="mt-dlabel">${d === today ? 'Сегодня' : d === mtAddDays(today, 1) ? 'Завтра' : esc(x.dow)}, ${esc(x.dm)}</div>
      ${items.map(([k, b]) => {
        const mine = (b.want || []).includes(S.me.id);
        return `<div class="mt-item">
          <div class="tm">${esc(k.slice(11))}</div>
          <div class="cl"><div class="nm">${esc(b.client)}</div><div class="by">до ${esc(mtEnd(k.slice(11)))}${b.by ? ` · записал(а) ${esc(first(b.by))}` : ''}</div></div>
          ${mtAvatars(b.want)}
          ${withWant ? `<button class="btn btn-sm ${mine ? 'btn-on' : 'btn-ghost'}" data-mt-want="${esc(k)}">${mine ? `${ico('check', 'ic-sm')}Приду` : 'Хочу прийти'}</button>` : ''}
          <a class="btn btn-ghost btn-sm" href="${esc(MT.state.zoom)}" target="_blank" rel="noopener">${ico('video', 'ic-sm')}Zoom</a>
        </div>`;
      }).join('')}</div>`;
  }).join('');
}
function mtEnd(t) { const [h, m] = t.split(':').map(Number); const e = h * 60 + m + 30; return `${pad(Math.floor(e / 60))}:${pad(e % 60)}`; }

// ── руководитель ──
function mtRenderOwner() {
  $('mtTitle').textContent = 'Встречи с клиентами';
  $('mtSub').textContent = 'Выберите дни в календаре и отметьте свободные окна по 30 минут — менеджер запишет в них клиентов. Мышью можно провести сразу по нескольким окнам.';
  const today = mtToday();
  const days = Object.keys(MT.state.days).filter((d) => d >= today).sort();
  // Календарь: 4 недели с понедельника.
  const dow = new Date(today + 'T12:00:00Z').getUTCDay();
  const start = mtAddDays(today, -((dow + 6) % 7) + MT.calWeek * 7);
  const cells = Array.from({ length: 28 }, (_, i) => mtAddDays(start, i));
  const booked = new Set(Object.keys(MT.state.book).map((k) => k.slice(0, 10)));
  const a = mtDay(cells[0]); const z = mtDay(cells[27]);
  const cal = `<div class="mt-cal">
    <div class="mt-cal-head"><button class="icon-btn" data-mt-cal="-1" ${MT.calWeek <= 0 ? 'disabled' : ''} aria-label="Раньше">${ico('chev', 'ic-sm rot-l')}</button>
      <b>${a.day} ${MT_MONTHS[a.month]} — ${z.day} ${MT_MONTHS[z.month]}</b>
      <button class="icon-btn" data-mt-cal="1" aria-label="Позже">${ico('chev', 'ic-sm rot-r')}</button></div>
    <div class="mt-cal-grid">${['пн', 'вт', 'ср', 'чт', 'пт', 'сб', 'вс'].map((w) => `<span class="w">${w}</span>`).join('')}
      ${cells.map((d) => { const x = mtDay(d); const on = !!MT.state.days[d]; return `<button class="mt-cd ${on ? 'on' : ''} ${d === today ? 'today' : ''}" data-mt-day="${d}" ${d < today ? 'disabled' : ''} title="${on ? 'Убрать день' : 'Добавить день'}">${x.day}${booked.has(d) ? '<i></i>' : ''}</button>`; }).join('')}
    </div>
    <div class="mt-cal-hint">Нажмите на даты, чтобы добавить дни для встреч.</div>
  </div>`;
  const grid = days.length ? `<div class="mt-grid-wrap"><div class="mt-grid" style="--cols:${days.length}">
    <div class="mt-corner"></div>
    ${days.map((d) => { const x = mtDay(d); const n = (MT.state.days[d] || []).length; return `<div class="mt-dh"><div><b>${esc(x.dow)}</b> ${esc(x.dm)}</div><div class="n">${n ? `${n} ${plural(n, 'окно', 'окна', 'окон')}` : 'нет окон'}</div><button class="mt-more" data-mt-menu="${d}" aria-label="Действия с днём">⋯</button>${MT.menu === d ? `<div class="mt-menu">
        <button data-mt-act="all" data-d="${d}">Весь день свободен</button>
        <button data-mt-act="copy" data-d="${d}">Такие же окна — во все дни</button>
        <button data-mt-act="clear" data-d="${d}">Очистить окна</button>
        <button data-mt-act="remove" data-d="${d}" class="danger">Убрать день</button></div>` : ''}</div>`; }).join('')}
    ${MT_TIMES.map((t) => `<div class="mt-t">${t}</div>${days.map((d) => mtCell(d, t)).join('')}`).join('')}
  </div></div>` : '<div class="empty">Выберите в календаре дни, когда можно созваниваться с клиентами.</div>';
  $('mtBody').innerHTML = `<div class="mt-top">${cal}<div class="mt-side"><div class="sec-head"><h2>Записи</h2></div>${mtListHtml(false)}</div></div>${grid}`;
}
function mtCell(d, t) {
  const key = `${d} ${t}`;
  const b = MT.state.book[key];
  if (b) return `<button class="mt-c booked" data-mt-cell="${key}" title="${esc(b.client)}"><span class="cl">${esc(b.client)}</span>${mtAvatars(b.want)}</button>`;
  const open = (MT.state.days[d] || []).includes(t);
  return `<button class="mt-c ${open ? 'open' : ''}" data-mt-cell="${key}" aria-pressed="${open}"><span>${open ? t : ''}</span></button>`;
}
function mtApply(st, op) {
  const set = new Set(st.days[op.date] || []);
  if (op.open) set.add(op.time); else if (!st.book[`${op.date} ${op.time}`]) set.delete(op.time);
  st.days[op.date] = [...set].sort();
}
function mtApplyDays(st, add, remove) {
  add.forEach((d) => { if (!st.days[d]) st.days[d] = []; });
  remove.forEach((d) => {
    const booked = Object.keys(st.book).filter((k) => k.startsWith(d + ' ')).map((k) => k.slice(11));
    if (booked.length) st.days[d] = booked; else delete st.days[d];
  });
}
function mtQueue(ops, addDays, removeDays, quiet) {
  (addDays || []).forEach((d) => { MT.add.add(d); MT.remove.delete(d); });
  (removeDays || []).forEach((d) => { MT.remove.add(d); MT.add.delete(d); MT.queue = MT.queue.filter((o) => o.date !== d); });
  mtApplyDays(MT.state, addDays || [], removeDays || []);
  (ops || []).forEach((op) => { mtApply(MT.state, op); MT.queue.push(op); });
  if (!quiet) renderMeet();
  clearTimeout(MT.timer);
  MT.timer = setTimeout(mtFlush, 700);
}
async function mtFlush() {
  if (MT.paint) { MT.timer = setTimeout(mtFlush, 300); return; }
  if (MT.saving) { MT.timer = setTimeout(mtFlush, 400); return; }
  const ops = MT.queue; const addDays = [...MT.add]; const removeDays = [...MT.remove];
  if (!ops.length && !addDays.length && !removeDays.length) return;
  MT.queue = []; MT.add = new Set(); MT.remove = new Set();
  MT.saving = true; mtSave('saving');
  try {
    const res = await api('meet-days', { ops, addDays, removeDays });
    if (!res.ok || !res.data.state) throw new Error('save');
    MT.state = res.data.state; MT.loadedAt = Date.now();
    // правки, сделанные, пока шло сохранение
    mtApplyDays(MT.state, [...MT.add], [...MT.remove]);
    MT.queue.forEach((op) => mtApply(MT.state, op));
    mtSave('ok');
  } catch (e) {
    MT.queue = ops.concat(MT.queue);
    addDays.forEach((d) => { if (!MT.remove.has(d)) MT.add.add(d); });
    removeDays.forEach((d) => { if (!MT.add.has(d)) MT.remove.add(d); });
    mtSave('err');
    MT.timer = setTimeout(mtFlush, 5000);
  }
  MT.saving = false;
  if (!MT.paint) renderMeet();
}
