  S.syncing = true;
  $('syncDot').classList.add('busy');
  try {
    if (initial) markActive(true);
    const activity = activityPayload(initial);
    const known = Object.keys(mineSaved);
    const res = await api('sync', { ver: initial ? null : S.ver, initial: !!initial, activity: activity || undefined, known: known.length ? known : undefined });
    if (res.ok && activity) activitySent(activity);
    if (res.status === 401) return signOut(S.me ? 'reset' : 'none');
    if (res.status === 403) return signOut('blocked');
    if (!res.ok) throw new Error(res.data.error || 'error');
    S.offline = false;
    applySync(res.data, false);
    if (!res.data.unchanged) store.set(K_CACHE, JSON.stringify({ token: S.token, data: res.data }));
    showApp();
  } catch (e) {
    S.offline = true;
    if ($('app').hidden) { showGate('none'); $('gateTitle').textContent = 'Нет связи'; $('gateText').textContent = 'Не получилось загрузить задачи. Проверьте интернет — страница попробует снова через минуту.'; startPolling(); }
  } finally {
    S.syncing = false;
    S.lastSync = Date.now();
    const dot = $('syncDot');
    dot.classList.remove('busy');
    dot.classList.toggle('off', S.offline);
    dot.title = S.offline ? 'Нет связи — повторю через минуту' : `Обновлено в ${fmtTime(Date.now())} · обновляется само каждую минуту`;
