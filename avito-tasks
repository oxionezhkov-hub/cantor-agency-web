// ── учёт активности: 10-минутные отрезки, в которые человек что-то делал на странице ──
// Отрезки копятся на устройстве и уходят на сервер вместе с обновлением раз в ~10 минут.
const K_ACT = 'avitoTasks.act';
const actPending = store.json(K_ACT) || {};
let actLastMark = 0;
let actLastSent = 0;
const mskDateStr = (ms) => new Date(ms + MSK).toISOString().slice(0, 10);
function markActive(force) {
  if (document.hidden || !S.token) return;
  const now = Date.now();
  if (!force && now - actLastMark < 15000) return;
  actLastMark = now;
  const p = msk(now);
  const d = mskDateStr(now);
  const slot = Math.floor((p.hh * 60 + p.mi) / 10);
  const arr = actPending[d] || (actPending[d] = []);
  if (!arr.includes(slot)) { arr.push(slot); store.set(K_ACT, JSON.stringify(actPending)); }
}
['pointerdown', 'keydown', 'scroll', 'touchstart', 'wheel', 'mousemove'].forEach((ev) => window.addEventListener(ev, () => markActive(false), { passive: true, capture: true }));
function activityPayload(initial) {
  const keep = new Set([0, 1, 2].map((d) => mskDateStr(Date.now() - d * 86400000)));
  Object.keys(actPending).forEach((d) => { if (!keep.has(d) || !actPending[d].length) delete actPending[d]; });
  if (!Object.keys(actPending).length || (!initial && Date.now() - actLastSent < 9 * 60000)) return null;
  return JSON.parse(JSON.stringify(actPending));
}
function activitySent(sent) {
  actLastSent = Date.now();
  Object.keys(sent).forEach((d) => {
    actPending[d] = (actPending[d] || []).filter((x) => !sent[d].includes(x));
    if (!actPending[d].length) delete actPending[d];
  });
  store.set(K_ACT, JSON.stringify(actPending));
}

async function sync(initial) {
  if (S.syncing) return;
  S.syncing = true;
  $('syncDot').classList.add('busy');
  try {
    if (initial) markActive(true);
    const activity = activityPayload(initial);
    const known = Object.keys(mineSaved);
    const res = await api('sync', { ver: initial ? null : S.ver, initial: !!initial, activity: activity || undefined, known: known.length ? known : undefined });
    if (res.ok && activity) activitySent(activity);
    if (res.status === 401) return signOut(S.me ? 'reset' : 'none');
    if (res.status === 403) return signOut('blocked');
    if (!res.ok) throw new Error(res.data.error || 'error');
    S.offline = false;
    applySync(res.data, false);
    if (!res.data.unchanged) store.set(K_CACHE, JSON.stringify({ token: S.token, data: res.data }));
    showApp();
  } catch (e) {
    S.offline = true;
    if ($('app').hidden) { showGate('none'); $('gateTitle').textContent = 'Нет связи'; $('gateText').textContent = 'Не получилось загрузить задачи. Проверьте интернет — страница попробует снова через минуту.'; startPolling(); }
  } finally {
    S.syncing = false;
    S.lastSync = Date.now();
    const dot = $('syncDot');
    dot.classList.remove('busy');
    dot.classList.toggle('off', S.offline);
    dot.title = S.offline ? 'Нет связи — повторю через минуту' : `Обновлено в ${fmtTime(Date.now())} · обновляется само каждую минуту`;
    renderBanners();
    if (S.view === 'team' && S.teamTab !== 'access' && !S.offline) loadActivity();
    if (!S.offline && (S.view === 'meet' || Date.now() - MT.loadedAt > 5 * 60000)) loadMeet(S.view === 'meet');
  }
}

// Задачи, сохранённые с этого устройства за последние 30 минут. Сервер Cloudflare в другом
// дата-центре может какое-то время отдавать список, где их ещё нет, — страница не прячет их из-за
// этого, а просит сервер дочитать (known), и тот чинит свой список для всех.
const MINE_KEEP_MS = 30 * 60000;
const mineSaved = (() => { const m = store.json(K_MINE) || {}; for (const id of Object.keys(m)) if (Date.now() - m[id].at > MINE_KEEP_MS) delete m[id]; return m; })();
function rememberSaved(task) { if (!task || !task.id) return; mineSaved[task.id] = { at: Date.now(), task }; store.set(K_MINE, JSON.stringify(mineSaved)); }
function forgetSaved(id) { if (mineSaved[id]) { delete mineSaved[id]; store.set(K_MINE, JSON.stringify(mineSaved)); } }
function mergeSaved(tasks, gone) {
  const byId = new Map(tasks.map((t) => [t.id, t]));
  const now = Date.now();
  for (const [id, m] of Object.entries(mineSaved)) {
    const server = byId.get(id);
    if (now - m.at > MINE_KEEP_MS) { forgetSaved(id); continue; }
    if (server) {
      // Сервер уже знает эту задачу — берём его версию, если она не старше нашей.
      if (String(server.updatedAt || '') >= String(m.task.updatedAt || '')) forgetSaved(id);
      else byId.set(id, m.task);
    } else if ((gone || []).includes(id) && now - m.at > 2 * 60000) {
      forgetSaved(id); // сервер прочитал её напрямую и не нашёл — значит, удалили
    } else {
      byId.set(id, m.task);
    }
  }
  return [...byId.values()];
}

function applySync(d, fromCache) {
  const hadMe = !!S.me;
  S.me = d.me || S.me;
  S.notifications = d.notifications || S.notifications;
  if ('reflection' in d || !d.unchanged) setReflection(d.reflection || null);
  if (!d.unchanged) {
    S.ver = fromCache ? null : d.ver;
    S.users = d.users || [];
    S.projects = d.projects || [];
    S.tasks = mergeSaved(d.tasks || [], d.gone);
    S.clients = d.clients || null;
    S.tgStart = d.tgStart || null;
    S.bot = d.bot || null;
    if (S.me && S.draft && !S.draft.assigneeId && !hadMe) S.draft.assigneeId = S.me.id;
    render();
  } else {
    renderHeader();
  }
}

function isEditing() {
