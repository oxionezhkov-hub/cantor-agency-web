  $('rfSub').textContent = `Неделя с ${fmtDate(Date.parse(week + 'T09:00:00Z'))} · оценки 1–10 от сотрудников, по одной на клиента. Задача «заполнить рефлексию» ставится каждую среду.`;
  const person = (u) => `<span class="rf-person">${avatar(userById(u.id) || u, 'xs')}${esc(first(u.name))} <span class="st">${u.done >= clients.length && clients.length ? 'готово' : `${u.done}/${clients.length}`}</span></span>`;
  $('rfBody').innerHTML = `<div class="rf-res">
    <div class="rf-actions"><button class="btn btn-ghost btn-sm" data-rf-week="${prevWeek}">← Прошлая неделя</button><span class="grow"></span>${week < RF.current ? `<button class="btn btn-ghost btn-sm" data-rf-week="${nextWeek}">Следующая →</button>` : ''}</div>
    <div class="rf-people">${R.people.map(person).join('') || '<span class="muted">Нет сотрудников, которые заполняют рефлексию</span>'}</div>
    ${clients.map((p) => {
      const ans = R.people.map((u) => ({ u, a: u.answers[p.id] })).filter((x) => x.a && x.a.score);
      const avg = ans.length ? (ans.reduce((s, x) => s + x.a.score, 0) / ans.length) : null;
      return `<div class="rf-client"><h3>${esc(p.name)}<span class="avg">${avg == null ? 'нет оценок' : `в среднем ${Math.round(avg * 10) / 10}`}</span></h3>
        ${R.people.map((u) => { const a = u.answers[p.id]; return a && a.score ? `<div class="rf-ans" style="--sc:${rfColor(a.score)}"><span class="sc">${a.score}</span><div><span class="who">${esc(first(u.name))}:</span> ${esc(a.comment || '')}</div></div>` : `<div class="rf-ans"><span class="none">${esc(first(u.name))} — ещё не оценил(а)</span></div>`; }).join('')}
      </div>`;
    }).join('')}
  </div>`;
