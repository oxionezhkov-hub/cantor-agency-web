    try {
      const res = await fetch(ROUTES[idx](API_PATH + 'an-report-file'), { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload });
      if (!res.ok) { if (n < ROUTES.length - 1 && (res.status === 502 || res.status === 504)) continue; break; }
