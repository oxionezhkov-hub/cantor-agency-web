  return `${['воскресенье', 'понедельник', 'вторник', 'среду', 'четверг', 'пятницу', 'субботу'][d.getUTCDay()]}, ${d.getUTCDate()} ${['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'][d.getUTCMonth()]}`;
}
function renderReflection() {
  if (S.view !== 'reflection') return;
  if (!S.reflection) return renderReflectionResults();
  const r = S.reflection;
  const list = reflClientsList();
  const left = reflLeft();
  $('rfTitle').textContent = 'Рефлексия за неделю';
  if (!list.length) { $('rfSub').textContent = ''; $('rfBody').innerHTML = '<div class="empty">Активных клиентов пока нет.</div>'; return; }
  if (!left && RF.editing == null) {
    $('rfSub').textContent = `Неделя с ${fmtDate(Date.parse(r.week + 'T09:00:00Z'))}. Следующая рефлексия — в ${fmtLongDate(r.next)}.`;
    $('rfBody').innerHTML = `<div class="rf-wrap"><div class="rf-card"><div class="rf-done">
      <div class="big">${ico('check')}</div>
      <h2>Готово — спасибо!</h2>
      <div class="muted">Все ${list.length} ${plural(list.length, 'клиент оценён', 'клиента оценены', 'клиентов оценены')}. До следующей среды здесь ничего не нужно.</div>
      <div class="rf-list">${list.map((p) => { const a = r.answers[p.id]; return `<div class="rf-row" style="--sc:${rfColor(a.score)}"><span class="sc">${a.score}</span><div style="min-width:0"><div class="nm">${esc(p.name)}</div><div class="cm">${esc(a.comment || '—')}</div></div><button class="btn btn-quiet btn-sm" data-rf-edit="${esc(p.id)}">${ico('edit', 'ic-sm')}</button></div>`; }).join('')}</div>
    </div></div></div>`;
    return;
  }
  // Где продолжаем: правим выбранного, иначе — первый неоценённый (или тот, на котором остановились).
  if (RF.editing != null) RF.idx = list.findIndex((p) => p.id === RF.editing);
  if (RF.idx == null || RF.idx < 0 || RF.idx >= list.length) RF.idx = Math.max(0, list.findIndex((p) => !reflAnswered(p)));
  const p = list[RF.idx];
  const d = rfDraft(p.id);
  const doneCount = list.length - left;
  $('rfSub').textContent = left ? `Осталось ${left} из ${list.length}. Можно выйти в любой момент — продолжим с этого места.` : 'Правка оценки';
  $('rfBody').innerHTML = `<div class="rf-wrap"><div class="rf-card" data-rf="${esc(p.id)}">
    <div class="rf-progress"><span>${RF.idx + 1} / ${list.length}</span><div class="rf-bar"><span style="width:${Math.round(doneCount / list.length * 100)}%"></span></div><span>${doneCount} ${plural(doneCount, 'готов', 'готово', 'готово')}</span></div>
    <div>
      <div class="rf-name">${esc(p.name)}</div>
      <div class="rf-q">Как идёт проект на этой неделе?</div>
    </div>
    <div>
      <div class="rf-scale" role="radiogroup" aria-label="Оценка от 1 до 10">${Array.from({ length: 10 }, (_, i) => i + 1).map((n) => `<button type="button" role="radio" aria-checked="${d.score === n}" class="${d.score === n ? 'on' : d.score && n < d.score ? 'lit' : ''}" style="--sc:${rfColor(n)}" data-score="${n}">${n}</button>`).join('')}</div>
      <div class="rf-ends"><span>1 — всё плохо</span><span>10 — отлично</span></div>
    </div>
    <div class="rf-verdict" style="color:${d.score ? rfColor(d.score) : 'var(--faint)'}">${d.score ? RF_WORDS[d.score] : 'Выберите оценку'}</div>
    <div>
      <label class="label" for="rfComment">Почему такая оценка</label>
      <textarea class="textarea rf-comment" id="rfComment" maxlength="400" placeholder="1–2 предложения: что получилось, что мешает, что дальше">${esc(d.comment)}</textarea>
      <div class="rf-hint"><span>Коротко — одно-два предложения</span><span id="rfCount">${d.comment.length}/400</span></div>
    </div>
    <div class="rf-actions">
      <button class="btn btn-ghost btn-sm" data-rf-prev ${RF.idx === 0 ? 'disabled' : ''}>← Назад</button>
      <span class="grow"></span>
      <button class="btn btn-primary" data-rf-next ${!d.score || d.comment.trim().length < 3 || RF.saving ? 'disabled' : ''}>${RF.editing != null ? 'Сохранить' : left <= 1 && !reflAnswered(p) ? 'Завершить' : 'Дальше →'}</button>
    </div>
  </div></div>`;
}
function rfRefreshNext() {
  const card = document.querySelector('[data-rf]');
  if (!card) return;
  const d = rfDraft(card.dataset.rf);
  const b = card.querySelector('[data-rf-next]');
  if (b) b.disabled = !d.score || d.comment.trim().length < 3 || RF.saving;
  const c = $('rfCount'); if (c) c.textContent = `${d.comment.length}/400`;
}
async function rfSave(pid) {
  const r = S.reflection;
  const d = rfDraft(pid);
  RF.saving = true; rfRefreshNext();
  // Отправляем все известные ответы недели — сервер объединит их со своими.
  const answers = Object.assign({}, r.answers, { [pid]: { score: d.score, comment: d.comment.trim() } });
  try {
    const res = await api('refl-save', { week: r.week, answers });
    if (res.status === 409) { toast('Неделя сменилась — открылась новая рефлексия'); await sync(false); return false; }
    if (!res.ok) throw new Error();
    S.reflection = res.data.reflection;
    if (RF.local.drafts) delete RF.local.drafts[pid];
    store.set(K_REFL, JSON.stringify(RF.local));
    renderHeader();
    return true;
  } catch (e) {
    toast('Не сохранилось — нет связи. Ответ не потерян, попробуйте ещё раз.');
    return false;
  } finally { RF.saving = false; rfRefreshNext(); }
}
$('rfBody').addEventListener('click', async (e) => {
  const card = e.target.closest('[data-rf]');
  const edit = e.target.closest('[data-rf-edit]');
  if (edit) { RF.editing = edit.dataset.rfEdit; renderReflection(); return; }
  const prevR = e.target.closest('[data-rf-week]');
  if (prevR) { RF.resultsWeek = prevR.dataset.rfWeek; RF.results = null; renderReflectionResults(); return; }
  if (!card) return;
  const pid = card.dataset.rf;
  const sc = e.target.closest('[data-score]');
  if (sc) { rfSetDraft(pid, { score: Number(sc.dataset.score) }); renderReflection(); const t = $('rfComment'); if (t && !t.value) t.focus({ preventScroll: true }); return; }
  if (e.target.closest('[data-rf-prev]')) { RF.editing = null; RF.idx = Math.max(0, RF.idx - 1); renderReflection(); return; }
  if (e.target.closest('[data-rf-next]')) {
    const wasEditing = RF.editing != null;
    if (!(await rfSave(pid))) return;
    RF.editing = null;
    const list = reflClientsList();
    if (!wasEditing) {
      // следующий неоценённый после текущего, иначе — первый неоценённый вообще
      let next = list.findIndex((p, i) => i > RF.idx && !reflAnswered(p));
      if (next < 0) next = list.findIndex((p) => !reflAnswered(p));
      RF.idx = next < 0 ? null : next;
    }
    if (!reflLeft()) toast('Рефлексия заполнена — спасибо!');
    renderReflection();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
});
$('rfBody').addEventListener('input', (e) => {
  if (e.target.id !== 'rfComment') return;
  const card = e.target.closest('[data-rf]');
  rfSetDraft(card.dataset.rf, { comment: e.target.value });
  rfRefreshNext();
});
document.addEventListener('keydown', (e) => {
  if (S.view !== 'reflection' || !document.querySelector('[data-rf]') || /^(INPUT|TEXTAREA|SELECT)$/.test((document.activeElement || {}).tagName || '')) return;
  const n = e.key === '0' ? 10 : Number(e.key);
