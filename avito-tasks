function tgAppUrl(url) {
  const u = String(url || '');
  let m = u.match(/^https?:\/\/t\.me\/c\/(\d+)\/(\d+)\/(\d+)/);
  if (m) return `tg://privatepost?channel=${m[1]}&post=${m[3]}&thread=${m[2]}`;
  m = u.match(/^https?:\/\/t\.me\/c\/(\d+)\/(\d+)/);
  if (m) return `tg://privatepost?channel=${m[1]}&post=${m[2]}`;
  m = u.match(/^https?:\/\/t\.me\/share\/url\?(.*)$/);
  if (m) return `tg://msg_url?${m[1]}`;
  m = u.match(/^https?:\/\/t\.me\/([A-Za-z0-9_]{4,})\/?(?:\?(.*))?$/);
  if (m) return `tg://resolve?domain=${m[1]}${m[2] ? '&' + m[2] : ''}`;
