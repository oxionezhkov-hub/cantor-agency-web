    ${acts.length ? `<details class="activity"><summary>${ico('chev', 'ic-sm')}История изменений · ${acts.length}</summary><ul style="margin-top:6px;display:grid;gap:3px">${acts.map((a) => `<li>${esc(ago(a.t, now))} — <b>${esc(a.by)}</b>: ${esc(a.what)}</li>`).join('')}</ul></details>` : ''}
    <div class="ed-foot">
      <span class="origin">${t.source === 'bot' ? 'Бот нашёл в чате' : 'Поставил(а) ' + esc(t.author || '—')}${created ? ` · ${esc(fmtDay(created, now))} в ${fmtTime(created)}` : ''}${t.author && t.source === 'bot' ? ` · ${esc(t.author)}` : ''}</span>
      <span class="saved" data-saved>Сохранено ✓</span>
      ${t.link ? `<a class="btn btn-ghost btn-sm tg" href="${esc(t.link)}">${ico('tg', 'ic-sm')}Сообщение в Telegram</a>` : ''}
      ${canDelete ? `<button class="btn btn-quiet btn-sm btn-danger" data-act="delete">${ico('trash', 'ic-sm')}Удалить</button>` : ''}
      <button class="btn btn-ghost btn-sm" data-act="collapse">Свернуть</button>
    </div>
  </div>`;
}

// ── действия с задачей (inline, без поп-апов) ──
function taskById(id) { return S.tasks.find((t) => t.id === id); }
function rerenderCard(id, keepFocus) {
  const el = document.querySelector(`.task[data-id="${CSS.escape(id)}"]`);
  const t = taskById(id);
  if (!el || !t) return renderLists();
  const now = Date.now();
  const focus = el.classList.contains('focus');
  const active = keepFocus && document.activeElement && document.activeElement.dataset ? document.activeElement.dataset.f : null;
  const tmp = document.createElement('div');
  tmp.innerHTML = card(t, now, focus && isOpen(t));
  el.replaceWith(tmp.firstElementChild);
  if (active) { const f = document.querySelector(`.task[data-id="${CSS.escape(id)}"] [data-f="${active}"]`); if (f) f.focus(); }
  autosize();
}
function applyLocal(t, patch) {
  const now = new Date().toISOString();
  if ('text' in patch) t.text = patch.text;
  if ('note' in patch) t.note = patch.note;
  if ('projectId' in patch) t.projectId = patch.projectId || null;
  if ('assigneeId' in patch) { t.assigneeId = patch.assigneeId || null; const u = userById(t.assigneeId); t.owner = u ? u.name : null; }
  if ('priority' in patch) t.priority = patch.priority;
  if ('due' in patch) t.due = patch.due ? patch.due + ':00+03:00' : null;
  if ('status' in patch) {
    const s = patch.status;
    t.hint = null; // решение человека снимает догадку бота
    if (s === 'new') Object.assign(t, { status: 'open', takenAt: null });
    if (s === 'progress') Object.assign(t, { status: 'open', takenAt: t.takenAt || now });
    const inform = t.projectId && !t.internal;
    if (s === 'done' && inform) Object.assign(t, { status: 'done', doneAt: now });
    if (s === 'closed' || (s === 'done' && !inform)) Object.assign(t, { status: 'closed', doneAt: t.doneAt || now, informedAt: inform ? now : t.informedAt });
    if (s === 'cancelled') t.status = 'cancelled';
  }
}
async function saveTask(id, patch, opts) {
  const t = taskById(id);
  if (!t) return;
  const prev = JSON.parse(JSON.stringify(t));
  applyLocal(t, patch);
  if (!(opts && opts.noRender)) rerenderCard(id, true);
  try {
    const res = await api('task-save', { task: Object.assign({ id }, patch) });
    if (!res.ok) throw new Error(res.data.error);
    Object.assign(t, res.data.task);
    rememberSaved(res.data.task);
    const saved = document.querySelector(`.task[data-id="${CSS.escape(id)}"] [data-saved]`);
    if (saved) { saved.classList.add('show'); setTimeout(() => saved.classList.remove('show'), 1600); }
    if (opts && opts.rerenderAfter) rerenderCard(id, true);
  } catch (e) {
