function mergeSaved(tasks, gone) {
  const byId = new Map(tasks.map((t) => [t.id, t]));
  const now = Date.now();
  for (const [id, m] of Object.entries(mineSaved)) {
    const server = byId.get(id);
    if (now - m.at > MINE_KEEP_MS) { forgetSaved(id); continue; }
    if (server) {
      // Сервер уже знает эту задачу — берём его версию, если она не старше нашей.
      if (String(server.updatedAt || '') >= String(m.task.updatedAt || '')) forgetSaved(id);
      else byId.set(id, m.task);
    } else if ((gone || []).includes(id) && now - m.at > 2 * 60000) {
      forgetSaved(id); // сервер прочитал её напрямую и не нашёл — значит, удалили
    } else {
      byId.set(id, m.task);
    }
  }
  return [...byId.values()];
}

