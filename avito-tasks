    RF.results = res.data.results; RF.current = res.data.current;
  }
  const R = RF.results;
  const clients = R.clients.map((id) => projectById(id)).filter(Boolean).sort((a, b) => a.name.localeCompare(b.name, 'ru'));
  const week = R.week;
  const prevWeek = new Date(Date.parse(week + 'T12:00:00Z') - 7 * 86400000).toISOString().slice(0, 10);
