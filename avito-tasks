// сортировка: сначала то, что горит
function byUrgency(now) { return (a, b) => urgency(b, now) - urgency(a, now) || (dueMs(a) || Infinity) - (dueMs(b) || Infinity) || String(b.updatedAt).localeCompare(String(a.updatedAt)); }

function renderLists() {
  const now = Date.now();
  const list = S.tasks.filter((t) => matches(t, now));
  const sort = byUrgency(now);
  const informFirst = canSeeClients() && S.f.status !== 'done';
  const inform = informFirst ? list.filter((t) => t.status === 'done' && t.projectId && t.assigneeId !== S.me.id).sort(sort) : [];
  const mine = list.filter((t) => t.assigneeId === S.me.id).sort(sort);
  const informIds = new Set(inform.map((t) => t.id));
  const rest = list.filter((t) => t.assigneeId !== S.me.id && !informIds.has(t.id));
  // Главное — до трёх горящих задач: подсвечены и с причиной.
  const focus = new Set(mine.filter((t) => isOpen(t) && urgency(t, now) >= 150).slice(0, 3).map((t) => t.id));
  let html = '';
  if (S.f.scope !== 'byme' || mine.length) {
    html += `<div class="section"><div class="sec-head"><h2>Мои задачи</h2><span class="n">${mine.length}</span></div>`;
    html += mine.length ? mine.map((t) => card(t, now, focus.has(t.id))).join('') : `<div class="empty">${S.f.q || S.f.client || S.f.priority || S.f.status !== 'active' ? 'Ничего не нашлось по фильтрам' : 'На вас сейчас ничего нет 🎉'}</div>`;
    html += '</div>';
  }
  if (inform.length) {
    html += `<div class="section"><div class="sec-head"><h2>Готово — сообщите клиентам</h2><span class="n">${inform.length}</span></div>${inform.map((t) => card(t, now)).join('')}</div>`;
  }
  if (S.f.scope !== 'mine') {
    html += `<div class="section"><div class="sec-head"><h2>${S.f.scope === 'byme' ? 'Поставленные мной' : 'Задачи команды'}</h2><span class="n">${rest.length}</span></div>`;
    html += rest.length ? groups(rest, now).map((g) => groupHtml(g, now)).join('') : '<div class="empty">Здесь пусто</div>';
    html += '</div>';
  }
  $('lists').innerHTML = html;
}

function groups(tasks, now) {
  const map = new Map();
  const add = (key, name, order, t) => { if (!map.has(key)) map.set(key, { key, name, order, tasks: [] }); map.get(key).tasks.push(t); };
  for (const t of tasks) {
    if (S.f.group === 'assignee') {
      const u = userById(t.assigneeId);
      add('a:' + (t.assigneeId || '-'), u ? u.name : t.owner ? `${t.owner} (не в команде)` : 'Без исполнителя', u ? 0 : 1, t);
    } else if (S.f.group === 'due') {
      const due = dueMs(t);
      const d = due ? Math.round((dayStart(due) - dayStart(now)) / 86400000) : null;
      const b = !isOpen(t) ? [9, 'Готово и закрытые'] : due == null ? [8, 'Без срока'] : due < now ? [0, 'Просрочено'] : d === 0 ? [1, 'Сегодня'] : d === 1 ? [2, 'Завтра'] : d < 7 ? [3, 'На этой неделе'] : [4, 'Позже'];
      add('d:' + b[0], b[1], b[0], t);
    } else {
      const name = clientName(t);
      add('c:' + (t.projectId || name || '-'), name || 'Без клиента', name ? 0 : 1, t);
    }
  }
  const sort = byUrgency(now);
  const gs = [...map.values()];
  gs.forEach((g) => { g.tasks.sort(sort); g.top = Math.max(...g.tasks.map((t) => urgency(t, now))); });
  if (S.f.group === 'due') gs.sort((a, b) => a.order - b.order);
  else gs.sort((a, b) => a.order - b.order || b.top - a.top || a.name.localeCompare(b.name, 'ru'));
  return gs;
}
function groupHtml(g, now) {
  const open = g.tasks.filter(isOpen);
  const over = open.filter((t) => dueMs(t) && dueMs(t) < now).length;
  const inform = g.tasks.filter((t) => t.status === 'done').length;
  const collapsed = prefs.collapsed[g.key];
  return `<div class="group ${collapsed ? 'collapsed' : ''}" data-group="${esc(g.key)}">
    <button class="g-head" data-act="toggle-group">${ico('chev', 'chev')}<span class="g-name">${esc(g.name)}</span>
      <span class="g-meta">${over ? `<span class="red">просрочено ${over}</span>` : ''}${inform ? `<span>сообщить ${inform}</span>` : ''}<span>${open.length} ${plural(open.length, 'открыта', 'открыты', 'открыто')}</span></span></button>
    <div class="g-list">${g.tasks.map((t) => card(t, now)).join('')}</div>
  </div>`;
}

function dueHtml(t, now) {
  const due = dueMs(t);
  if (!due) return isOpen(t) ? `<span>${ico('clock', 'ic-sm')}без срока</span>` : '';
  const late = isOpen(t) && due < now;
  const today = isOpen(t) && !late && dayStart(due) === dayStart(now);
  return `<span class="${late ? 'due-over' : today ? 'due-today' : ''}">${ico('clock', 'ic-sm')}${late ? 'просрочено · ' : ''}${fmtDay(due, now)}${fmtTime(due) !== '18:00' || today || late ? ' ' + fmtTime(due) : ''}</span>`;
}
function checkClass(t) { return t.status === 'done' ? 'half' : t.status === 'closed' ? 'full' : t.status === 'cancelled' ? 'cancel' : ''; }
function card(t, now, focus) {
  const sk = statusKey(t);
  const u = userById(t.assigneeId);
  const client = clientName(t);
  const reason = focus ? focusReason(t, now) : '';
  const tags = [];
  if (focus) tags.push(`<span class="tag tag-focus">${ico('fire', 'ic-sm')}Сначала${reason ? ' · ' + esc(reason) : ''}</span>`);
  if (t.priority === 'urgent' && !focus) tags.push(`<span class="tag tag-urgent">срочно</span>`);
  if (t.priority === 'high' && !focus) tags.push(`<span class="tag tag-high">высокий</span>`);
  if (sk === 'progress') tags.push('<span class="tag tag-progress">в работе</span>');
  if (sk === 'done') tags.push(`<span class="tag tag-done">${t.projectId ? 'готово · сообщить клиенту' : 'готово'}</span>`);
  if (sk === 'cancelled') tags.push('<span class="tag tag-cancelled">отменена</span>');
  const assignee = u ? `<span>${avatar(u, 'xs')}${esc(u.id === S.me.id ? 'я' : first(u.name))}</span>` : t.owner ? `<span>${esc(t.owner)}</span>` : '<span>без исполнителя</span>';
  const pc = isOpen(t) ? PRIO[t.priority] && t.priority !== 'normal' ? PRIO[t.priority][1] : 'transparent' : 'transparent';
  const expanded = S.expanded === t.id;
  return `<article class="task ${sk} ${focus ? 'focus' : ''} ${expanded ? 'expanded' : ''}" data-id="${esc(t.id)}" style="--pc:${pc}">
    <div class="t-row" data-act="expand">
      <button class="check ${checkClass(t)}" data-act="check" aria-label="${isOpen(t) ? 'Отметить готовой' : 'Изменить статус'}" title="${esc(STATUS[sk] || '')}">${ico(t.status === 'cancelled' ? 'x' : 'check')}</button>
      <div style="min-width:0">
        <div class="t-title">${esc(t.text)}</div>
        <div class="t-meta">
          ${tags.join('')}
          ${client ? `<span class="client">${esc(client)}</span>` : ''}
          ${assignee}
          ${dueHtml(t, now)}
          ${t.source === 'bot' ? `<span title="Бот нашёл задачу в чате">${ico('bot', 'ic-sm')}из чата</span>` : ''}
        </div>
      </div>
      <div class="t-side">
        ${t.link ? `<a class="tg-link tg" href="${esc(t.link)}" title="Открыть сообщение в Telegram" data-act="none">${ico('tg')}</a>` : ''}
        <span class="t-chev">${ico('chev')}</span>
      </div>
    </div>
    ${expanded ? editor(t, now) : ''}
  </article>`;
}

function dueChips(current, now) {
  const today18 = dayStart(now) + 18 * 3600000;
  const tomorrow = today18 + 86400000;
  let fri = today18; while (msk(fri).dow !== 5 || fri <= now) fri += 86400000;
  const week = today18 + 7 * 86400000;
  const cur = current ? fromInput(current) : null;
  const chip = (label, ms, key) => `<button type="button" class="pill ${cur === ms ? 'on' : ''}" data-due="${ms == null ? '' : toInput(ms)}" data-key="${key}">${label}</button>`;
  return `<div class="pills">
    ${today18 > now ? chip('Сегодня', today18, 'today') : ''}${chip('Завтра', tomorrow, 'tomorrow')}${fri !== tomorrow ? chip('Пятница', fri, 'fri') : ''}${chip('Через неделю', week, 'week')}
    <label class="pill ${cur != null && ![today18, tomorrow, fri, week].includes(cur) ? 'on' : ''}">${ico('clock', 'ic-sm')}<input type="datetime-local" data-f="due" value="${cur != null ? toInput(cur) : ''}" aria-label="Дата и время"></label>
    <button type="button" class="pill ${cur == null ? 'on' : ''}" data-due="" data-key="none">Без срока</button>
  </div>`;
}
function prioPills(cur) {
  return `<div class="pills">${Object.entries(PRIO).map(([k, [label, color]]) => `<button type="button" class="pill ${cur === k ? 'on' : ''}" data-prio="${k}"><span class="pd" style="background:${k === 'normal' ? 'var(--faint)' : color}"></span>${label}</button>`).join('')}</div>`;
}
function clientOptions(cur) {
  const active = S.projects.filter((p) => !p.inactive || p.id === cur);
  return `<option value="">Без клиента</option>` + active.map((p) => `<option value="${esc(p.id)}" ${p.id === cur ? 'selected' : ''}>${esc(p.name)}</option>`).join('');
}
function userOptions(cur) {
  return `<option value="">Без исполнителя</option>` + S.users.filter((u) => u.active || u.id === cur).map((u) => `<option value="${esc(u.id)}" ${u.id === cur ? 'selected' : ''}>${esc(u.name)}${u.id === S.me.id ? ' (я)' : ''} — ${esc(u.roleLabel)}</option>`).join('');
}
function editor(t, now) {
  const sk = statusKey(t);
  const created = Date.parse(t.startedAt || t.createdAt || 0);
  const canDelete = isOwner() || t.createdById === S.me.id;
  const statusBtns = ['new', 'progress', 'done', 'closed', 'cancelled'].map((k) => `<button type="button" class="pill ${sk === k ? 'on' : ''}" data-status="${k}">${k === 'done' ? (t.projectId ? 'Готово, сообщить клиенту' : 'Готово') : k === 'closed' && t.projectId ? 'Закрыта, клиенту сообщили' : STATUS[k]}</button>`).join('');
  const acts = (t.activity || []).slice().reverse();
  return `<div class="editor" data-editor>
    <textarea class="textarea ed-title" data-f="text" rows="1" maxlength="300" aria-label="Суть задачи">${esc(t.text)}</textarea>
    <div><label class="label">Описание и детали</label><textarea class="textarea" data-f="note" rows="3" maxlength="4000" placeholder="Что именно сделать, ссылки, договорённости…">${esc(t.note)}</textarea></div>
    <div class="grid2">
      <div><label class="label">Клиент</label><select class="select" data-f="projectId">${clientOptions(t.projectId)}</select></div>
      <div><label class="label">Исполнитель</label><select class="select" data-f="assigneeId">${userOptions(t.assigneeId)}</select></div>
    </div>
    <div><label class="label">Срок</label>${dueChips(dueMs(t) ? toInput(dueMs(t)) : null, now)}</div>
    <div><label class="label">Приоритет</label>${prioPills(t.priority || 'normal')}</div>
    <div><label class="label">Статус</label><div class="pills">${statusBtns}</div></div>
    ${acts.length ? `<details class="activity"><summary>${ico('chev', 'ic-sm')}История изменений · ${acts.length}</summary><ul style="margin-top:6px;display:grid;gap:3px">${acts.map((a) => `<li>${esc(ago(a.t, now))} — <b>${esc(a.by)}</b>: ${esc(a.what)}</li>`).join('')}</ul></details>` : ''}
    <div class="ed-foot">
      <span class="origin">${t.source === 'bot' ? 'Бот нашёл в чате' : 'Поставил(а) ' + esc(t.author || '—')}${created ? ` · ${esc(fmtDay(created, now))} в ${fmtTime(created)}` : ''}${t.author && t.source === 'bot' ? ` · ${esc(t.author)}` : ''}</span>
      <span class="saved" data-saved>Сохранено ✓</span>
      ${t.link ? `<a class="btn btn-ghost btn-sm tg" href="${esc(t.link)}">${ico('tg', 'ic-sm')}Сообщение в Telegram</a>` : ''}
      ${canDelete ? `<button class="btn btn-quiet btn-sm btn-danger" data-act="delete">${ico('trash', 'ic-sm')}Удалить</button>` : ''}
      <button class="btn btn-ghost btn-sm" data-act="collapse">Свернуть</button>
    </div>
  </div>`;
}

// ── действия с задачей (inline, без поп-апов) ──
function taskById(id) { return S.tasks.find((t) => t.id === id); }
function rerenderCard(id, keepFocus) {
  const el = document.querySelector(`.task[data-id="${CSS.escape(id)}"]`);
  const t = taskById(id);
  if (!el || !t) return renderLists();
  const now = Date.now();
  const focus = el.classList.contains('focus');
  const active = keepFocus && document.activeElement && document.activeElement.dataset ? document.activeElement.dataset.f : null;
  const tmp = document.createElement('div');
  tmp.innerHTML = card(t, now, focus && isOpen(t));
  el.replaceWith(tmp.firstElementChild);
  if (active) { const f = document.querySelector(`.task[data-id="${CSS.escape(id)}"] [data-f="${active}"]`); if (f) f.focus(); }
  autosize();
}
function applyLocal(t, patch) {
  const now = new Date().toISOString();
  if ('text' in patch) t.text = patch.text;
  if ('note' in patch) t.note = patch.note;
  if ('projectId' in patch) t.projectId = patch.projectId || null;
  if ('assigneeId' in patch) { t.assigneeId = patch.assigneeId || null; const u = userById(t.assigneeId); t.owner = u ? u.name : null; }
  if ('priority' in patch) t.priority = patch.priority;
  if ('due' in patch) t.due = patch.due ? patch.due + ':00+03:00' : null;
  if ('status' in patch) {
    const s = patch.status;
    if (s === 'new') Object.assign(t, { status: 'open', takenAt: null });
    if (s === 'progress') Object.assign(t, { status: 'open', takenAt: t.takenAt || now });
    if (s === 'done') Object.assign(t, { status: 'done', doneAt: now });
    if (s === 'closed') Object.assign(t, { status: 'closed', informedAt: t.projectId ? now : t.informedAt });
    if (s === 'cancelled') t.status = 'cancelled';
  }
}
async function saveTask(id, patch, opts) {
  const t = taskById(id);
  if (!t) return;
  const prev = JSON.parse(JSON.stringify(t));
  applyLocal(t, patch);
  if (!(opts && opts.noRender)) rerenderCard(id, true);
  try {
    const res = await api('task-save', { task: Object.assign({ id }, patch) });
    if (!res.ok) throw new Error(res.data.error);
    Object.assign(t, res.data.task);
    const saved = document.querySelector(`.task[data-id="${CSS.escape(id)}"] [data-saved]`);
    if (saved) { saved.classList.add('show'); setTimeout(() => saved.classList.remove('show'), 1600); }
    if (opts && opts.rerenderAfter) rerenderCard(id, true);
  } catch (e) {
    Object.assign(t, prev);
    rerenderCard(id);
    toast('Не сохранилось — нет связи. Попробуйте ещё раз.');
  }
}
function openTask(id) {
  const t = taskById(id);
  if (!t) return toast('Задача не найдена — возможно, её удалили.');
  if (S.view !== 'tasks') { S.view = 'tasks'; }
  if (!matches(t, Date.now())) { Object.assign(S.f, { scope: 'all', status: 'all', client: '', assignee: '', priority: '', q: '' }); $('q').value = ''; }
  const g = document.querySelector(`.task[data-id="${CSS.escape(id)}"]`);
  const group = g && g.closest('.group');
  if (group) delete prefs.collapsed[group.dataset.group];
  S.expanded = id;
  render();
  requestAnimationFrame(() => {
    const el = document.querySelector(`.task[data-id="${CSS.escape(id)}"]`);
    if (!el) return;
    const gr = el.closest('.group'); if (gr && gr.classList.contains('collapsed')) { gr.classList.remove('collapsed'); }
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    el.classList.add('flash');
    autosize();
  });
}
function openFromHash() {
  const m = location.hash.match(/^#t=(.+)$/);
  if (!m) return;
  history.replaceState(null, '', location.pathname + location.search);
  openTask(decodeURIComponent(m[1]));
}
window.addEventListener('hashchange', openFromHash);
function autosize() { document.querySelectorAll('.ed-title').forEach((el) => { el.style.height = 'auto'; el.style.height = el.scrollHeight + 2 + 'px'; }); }

$('lists').addEventListener('click', (e) => {
  const act = e.target.closest('[data-act]');
  const cardEl = e.target.closest('.task');
  const groupEl = e.target.closest('.group');
  if (act && act.dataset.act === 'toggle-group' && groupEl) {
    const k = groupEl.dataset.group;
    if (prefs.collapsed[k]) delete prefs.collapsed[k]; else prefs.collapsed[k] = 1;
    store.set(K_PREFS, JSON.stringify(prefs));
    groupEl.classList.toggle('collapsed');
    return;
  }
  if (!cardEl) return;
  const id = cardEl.dataset.id;
  const t = taskById(id);
  if (!t) return;
  if (e.target.closest('a')) return;
  if (act && act.dataset.act === 'check') {
    e.stopPropagation();
    const before = statusKey(t);
    const next = isOpen(t) ? (t.projectId ? 'done' : 'closed') : t.status === 'done' ? 'closed' : 'new';
    saveTask(id, { status: next });
    const msg = next === 'done' ? 'Готово — клиентский менеджер передаст клиенту' : next === 'closed' ? (before === 'done' ? 'Закрыто: клиенту сообщили' : 'Готово ✓') : 'Задача снова открыта';
    toast(msg, 'Отменить', () => saveTask(id, { status: before }));
    return;
  }
  if (act && act.dataset.act === 'collapse') { S.expanded = null; rerenderCard(id); return; }
  if (act && act.dataset.act === 'delete') {
    if (!confirm(`Удалить задачу «${t.text}»? Это нельзя отменить. Если задача просто больше не нужна — лучше поставьте статус «Отменена».`)) return;
    S.tasks = S.tasks.filter((x) => x.id !== id);
    S.expanded = null;
    renderLists();
    api('task-delete', { id }).then((r) => { if (!r.ok) throw new Error(); toast('Задача удалена'); }).catch(() => { S.tasks.push(t); renderLists(); toast('Не получилось удалить'); });
    return;
  }
  const inEditor = e.target.closest('[data-editor]');
  if (inEditor) {
    const due = e.target.closest('[data-due]');
    if (due) { saveTask(id, { due: due.dataset.due || null }); return; }
    const prio = e.target.closest('[data-prio]');
    if (prio) { saveTask(id, { priority: prio.dataset.prio }); return; }
    const st = e.target.closest('[data-status]');
    if (st) { saveTask(id, { status: st.dataset.status }); return; }
    return;
  }
  if (act && act.dataset.act === 'expand') {
    const prevId = S.expanded;
    S.expanded = prevId === id ? null : id;
    if (prevId && prevId !== id) rerenderCard(prevId);
    rerenderCard(id);
  }
});
$('lists').addEventListener('change', (e) => {
  const f = e.target.dataset.f;
  const cardEl = e.target.closest('.task');
  if (!f || !cardEl) return;
  const id = cardEl.dataset.id;
  if (f === 'projectId' || f === 'assigneeId') saveTask(id, { [f]: e.target.value || null }, { rerenderAfter: true });
  if (f === 'due') saveTask(id, { due: e.target.value || null });
});
$('lists').addEventListener('focusout', (e) => {
  const f = e.target.dataset.f;
  const cardEl = e.target.closest('.task');
  if (!cardEl || (f !== 'text' && f !== 'note')) return;
  const t = taskById(cardEl.dataset.id);
  const v = e.target.value.trim();
  if (!t || v === (t[f] || '').trim()) return;
  if (f === 'text' && !v) { e.target.value = t.text; return; }
  saveTask(t.id, { [f]: v }, { noRender: true });
});
$('lists').addEventListener('keydown', (e) => {
  if (e.target.dataset.f === 'text' && e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); e.target.blur(); }
});
$('lists').addEventListener('input', (e) => { if (e.target.classList.contains('ed-title')) autosize(); });

// ── новая задача (прямо в списке) ──
function newDraft() { return { text: '', note: '', projectId: '', assigneeId: S.me ? S.me.id : '', due: null, priority: 'normal', open: false }; }
function renderComposer() {
