// ── sync (каждую минуту, пока страница открыта) ──
let pollTimer = null;
function startPolling() { if (!pollTimer) pollTimer = setInterval(() => { if (!document.hidden) sync(false); }, POLL_MS); }
function stopPolling() { clearInterval(pollTimer); pollTimer = null; }
