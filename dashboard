<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Дашборд руководителя — Cantor Agency</title>
<meta name="robots" content="noindex, nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geologica:wght@300;400;500;600;700;800&family=Unbounded:wght@700;800;900&display=swap" rel="stylesheet">
<link rel="icon" type="image/svg+xml" href="/Frame 1000011449.svg">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --red:#E8391D;--red-dark:#C42D13;--red-light:#FF6347;
  --dark:#0F0F0F;--dark2:#1A1A1A;--text:#1C1C1C;--muted:#888;
  --bg:#F6F5F2;--white:#FFFFFF;--border:#E2E0DC;
  --accent-bg:#FFF3F0;--warm-bg:#FFFBF9;
  --shadow-sm:0 2px 8px rgba(0,0,0,0.06);
  --shadow-md:0 12px 40px rgba(0,0,0,0.1);
  --shadow-red:0 8px 28px rgba(232,57,29,0.28);
  --r-sm:6px;--r-md:10px;--r-lg:16px;--r-xl:20px;
  --green:#1e8449;--green-bg:#eafaf1;
  --amber:#9a6f00;--amber-bg:#fef9e7;
  --gray:#6b6b6b;--gray-bg:#f1f0ed;
}
html{-webkit-text-size-adjust:100%}
body{font-family:'Geologica',sans-serif;color:var(--text);background:var(--bg);line-height:1.5;min-height:100vh;-webkit-font-smoothing:antialiased}
.hidden{display:none !important}
.dim{visibility:hidden}
button{font-family:inherit;cursor:pointer}
input,textarea,select{font-family:inherit}

/* ── Password gate ── */
#gate{position:fixed;inset:0;background:var(--dark);display:flex;align-items:center;justify-content:center;z-index:1000;padding:20px}
#gate .box{background:var(--white);border-radius:var(--r-lg);padding:36px 32px;width:100%;max-width:340px;box-shadow:var(--shadow-md);text-align:center}
#gate h1{font-family:'Unbounded',sans-serif;font-size:16px;font-weight:800;margin-bottom:18px}
#gate input{width:100%;border:1.5px solid var(--border);border-radius:var(--r-sm);padding:12px 14px;font-size:15px;margin-bottom:12px}
#gate button{width:100%;background:var(--red);color:#fff;border:none;border-radius:var(--r-sm);padding:12px;font-size:14px;font-weight:600}
#gate button:hover{background:var(--red-dark)}
#gate .err{color:var(--red);font-size:12px;margin-bottom:10px;min-height:14px}

/* ── App shell ── */
#app{display:none}
#app.ready{display:block}
header.top{background:var(--dark);color:#fff;padding:18px 28px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}
.top-actions{display:flex;gap:10px;align-items:center;min-height:20px}
.tabs{display:flex;gap:6px;flex-wrap:wrap}
.tab-btn{background:none;border:none;color:#bbb;padding:10px 16px;border-radius:var(--r-sm);font-size:13px;font-weight:600}
.tab-btn.active{background:var(--red);color:#fff}
.tab-btn:hover:not(.active){background:#2a2a2a;color:#fff}
main{padding:24px 28px 80px;max-width:1300px;margin:0 auto}
.panel{display:none}
.panel.active{display:block}

.month-toggle{display:flex;gap:8px;margin-bottom:20px}
.month-toggle button{background:var(--white);border:1.5px solid var(--border);border-radius:var(--r-sm);padding:8px 16px;font-size:13px;font-weight:600;color:var(--muted)}
.month-toggle button.active{background:var(--dark);color:#fff;border-color:var(--dark)}

.btn{background:var(--red);color:#fff;border:none;border-radius:var(--r-sm);padding:10px 16px;font-size:13px;font-weight:600;box-shadow:var(--shadow-red)}
.btn:hover{background:var(--red-dark)}
.btn.secondary{background:var(--white);color:var(--text);border:1.5px solid var(--border);box-shadow:none}
.btn.secondary:hover{border-color:var(--red);color:var(--red)}
.btn.small{padding:6px 10px;font-size:12px}
.btn.danger{background:var(--white);color:var(--red);border:1.5px solid var(--border);box-shadow:none}
.btn.danger:hover{border-color:var(--red);background:var(--accent-bg)}
.btn.ghost{background:rgba(255,255,255,.08);color:#fff;border:1.5px solid rgba(255,255,255,.18);box-shadow:none}
.btn.ghost:hover{background:rgba(255,255,255,.16);border-color:rgba(255,255,255,.32)}

.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:18px}
.card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--r-lg);padding:20px;box-shadow:var(--shadow-sm)}
.card h3{font-size:16px;font-weight:700;margin-bottom:2px}
.card .sub{font-size:12px;color:var(--muted);margin-bottom:14px}
.field-row{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}
.field-row label{font-size:12px;color:var(--muted);flex-shrink:0}
.field-row select,.field-row input[type=text],.field-row input[type=number]{border:1.5px solid var(--border);border-radius:var(--r-sm);padding:6px 10px;font-size:13px;width:100%;max-width:190px}

.metrics{display:grid;grid-template-columns:1fr 1fr;gap:8px 14px;background:var(--warm-bg);border-radius:var(--r-md);padding:12px 14px;margin:12px 0}
.metric{display:flex;flex-direction:column}
.metric .v{font-size:16px;font-weight:700}
.metric .l{font-size:11px;color:var(--muted)}
.metric input{border:1.5px solid var(--border);border-radius:6px;padding:4px 6px;font-size:14px;font-weight:700;width:100%}

.computed-row{display:flex;justify-content:space-between;gap:10px;padding:10px 14px;margin:-2px 0 12px;background:var(--accent-bg);border-radius:var(--r-md)}
.computed-item{display:flex;flex-direction:column;align-items:center;flex:1;text-align:center}
.computed-item .l{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.03em}
.computed-item .v{font-size:14px;font-weight:700}

.stars{display:flex;gap:3px}
.stars button{background:none;border:none;font-size:18px;color:var(--border);padding:0;line-height:1}
.stars button.on{color:var(--red)}
.rating-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.rating-row .l{font-size:12px;color:var(--muted)}

textarea.review{width:100%;border:1.5px solid var(--border);border-radius:var(--r-sm);padding:8px 10px;font-size:13px;min-height:60px;resize:vertical;margin-top:6px}
.status-badge{display:inline-block;font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px}
.status-active{background:var(--green-bg);color:var(--green)}
.status-paused{background:var(--amber-bg);color:var(--amber)}
.status-done{background:var(--gray-bg);color:var(--gray)}

/* Ratings + Analytics range nav */
.range-nav{display:flex;align-items:center;gap:14px;margin-bottom:22px;flex-wrap:wrap}
.range-nav .arrow{width:36px;height:36px;border-radius:50%;background:var(--white);border:1.5px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:17px;color:var(--text);flex-shrink:0;transition:all .15s}
.range-nav .arrow:hover{border-color:var(--red);color:var(--red)}
.range-nav .label{font-family:'Unbounded',sans-serif;font-size:14px;font-weight:800;background:var(--dark);color:#fff;padding:11px 24px;border-radius:30px;letter-spacing:.01em;min-width:150px;text-align:center}
.range-nav .today-btn{background:none;border:none;color:var(--red);font-size:12px;font-weight:700;text-decoration:underline;text-underline-offset:3px}
.range-nav .today-btn:hover{color:var(--red-dark)}

.rating-card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--r-xl);padding:22px 22px 6px;box-shadow:var(--shadow-sm)}
.rating-card-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:18px}
.rating-card-head h3{font-size:17px;font-weight:700}
.rating-card-head .avg-pill{display:inline-flex;align-items:center;background:var(--accent-bg);color:var(--red-dark);font-family:'Unbounded',sans-serif;font-size:13px;font-weight:800;padding:5px 13px;border-radius:20px;letter-spacing:.01em;flex-shrink:0;cursor:default}
.rater{padding:16px 0}
.rater + .rater{border-top:1px solid var(--border)}
.rater-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.rater-head .who{display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:700;color:var(--text)}
.rater-head .who .dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.rater-head .score-badge{font-family:'Unbounded',sans-serif;font-size:16px;font-weight:800;color:var(--red);min-width:24px;text-align:right}
.score-scale{display:grid;grid-template-columns:repeat(10,1fr);gap:5px;margin-bottom:10px}
.score-scale button{aspect-ratio:1;border-radius:8px;border:1.5px solid var(--border);background:var(--warm-bg);font-size:12px;font-weight:700;color:var(--muted);transition:all .12s}
.score-scale button:hover{border-color:var(--red-light);color:var(--red)}
.score-scale button.on{background:var(--red);border-color:var(--red);color:#fff;box-shadow:var(--shadow-red)}
textarea.rater-comment{width:100%;border:1.5px solid var(--border);border-radius:var(--r-sm);padding:9px 11px;font-size:13px;min-height:52px;resize:vertical}
textarea.rater-comment:focus{outline:none;border-color:var(--red-light)}

/* Analytics */
.analytics-toolbar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:22px}
.analytics-toolbar .range-nav{margin-bottom:0}
.analytics-right{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.analytics-right .month-toggle{margin-bottom:0}
#analyticsViewToggle{min-width:172px;text-align:center;flex-shrink:0}
.analytics-table-wrap{overflow-x:auto;border:1.5px solid var(--border);border-radius:var(--r-lg);background:var(--white);scrollbar-width:none;-ms-overflow-style:none}
.analytics-table-wrap::-webkit-scrollbar{display:none;height:0}
.analytics-table{border-collapse:collapse;width:100%;font-size:13px}
.analytics-table th{background:var(--dark);color:#fff;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;padding:13px 12px;text-align:left;white-space:nowrap}
.analytics-table td{padding:9px 12px;border-bottom:1px solid var(--border);white-space:nowrap}
.analytics-table tbody tr{cursor:pointer}
.analytics-table tbody tr:last-child td{border-bottom:none}
.analytics-table tbody tr:hover{background:var(--warm-bg)}
.analytics-table td.name-cell,.analytics-table th.name-th{position:sticky;left:0;background:var(--white);font-weight:700;z-index:1;box-shadow:2px 0 6px rgba(0,0,0,.05)}
.analytics-table tbody tr:hover td.name-cell{background:var(--warm-bg)}
.analytics-table th.name-th{background:var(--dark);z-index:2}
.analytics-table th.group-divider,.analytics-table td.group-divider{border-left:2px solid var(--border)}
.analytics-table input{width:78px;border:1.5px solid var(--border);border-radius:6px;padding:6px 8px;font-size:13px;font-weight:600;cursor:auto}
.analytics-table input:focus{outline:none;border-color:var(--red-light)}
.analytics-table .derived{font-weight:700;color:var(--text)}
.analytics-table .derived.empty{color:var(--muted);font-weight:400}
.analytics-table .total-value{font-weight:700;color:var(--text)}
.analytics-table td.empty{color:var(--muted);text-align:center;white-space:normal;cursor:default}

/* Soft per-row status marker, cycled by clicking the row */
.analytics-table tbody tr.row-green{background:var(--green-bg)}
.analytics-table tbody tr.row-yellow{background:var(--amber-bg)}
.analytics-table tbody tr.row-red{background:var(--accent-bg)}
.analytics-table tbody tr.row-gray{background:var(--gray-bg)}
.analytics-table tbody tr.row-green td.name-cell{background:var(--green-bg)}
.analytics-table tbody tr.row-yellow td.name-cell{background:var(--amber-bg)}
.analytics-table tbody tr.row-red td.name-cell{background:var(--accent-bg)}
.analytics-table tbody tr.row-gray td.name-cell{background:var(--gray-bg)}

/* Hide the native up/down stepper on number inputs everywhere in the dashboard */
input[type=number]::-webkit-outer-spin-button,
input[type=number]::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
input[type=number]{-moz-appearance:textfield;appearance:textfield}

/* Modal */
#overlay{position:fixed;inset:0;background:rgba(10,10,10,0.5);z-index:900;display:none;align-items:center;justify-content:center;padding:20px}
#overlay.open{display:flex}
.modal{background:#fff;border-radius:var(--r-lg);padding:26px;width:100%;max-width:380px;box-shadow:var(--shadow-md)}
.modal h3{font-family:'Unbounded',sans-serif;font-size:15px;margin-bottom:16px}
.modal label{display:block;font-size:12px;color:var(--muted);margin:10px 0 4px}
.modal input,.modal select{width:100%;border:1.5px solid var(--border);border-radius:var(--r-sm);padding:9px 11px;font-size:13px}
.modal .actions{display:flex;gap:8px;justify-content:flex-end;margin-top:20px}

.empty{color:var(--muted);font-size:13px;padding:20px;text-align:center}
.toast{position:fixed;bottom:20px;right:20px;background:var(--dark);color:#fff;padding:10px 18px;border-radius:var(--r-sm);font-size:13px;z-index:1100;opacity:0;transform:translateY(8px);transition:all .2s}
.toast.show{opacity:1;transform:translateY(0)}
</style>
</head>
<body>

<div id="gate">
  <div class="box">
    <h1>Дашборд руководителя</h1>
    <div class="err" id="gateErr"></div>
    <input type="password" id="gatePassword" placeholder="Пароль" autocomplete="off" autofocus>
    <button id="gateSubmit">Войти</button>
  </div>
</div>

<div id="app">
  <header class="top">
    <div class="top-actions" id="topActions"></div>
    <nav class="tabs">
      <button class="tab-btn active" data-tab="projects">Проекты</button>
      <button class="tab-btn" data-tab="analytics">Аналитика</button>
      <button class="tab-btn" data-tab="ratings">Оценки</button>
    </nav>
  </header>

  <main>
    <!-- PROJECTS -->
    <section class="panel active" id="panel-projects">
      <div class="month-toggle" id="monthToggleProjects"></div>
      <div class="grid" id="projectsGrid"></div>
    </section>

    <!-- ANALYTICS -->
    <section class="panel" id="panel-analytics">
      <div class="analytics-toolbar">
        <div class="range-nav" id="analyticsRangeNav">
          <button class="arrow" id="dayPrev" aria-label="Предыдущий день">‹</button>
          <div class="label" id="dayLabel"></div>
          <button class="arrow" id="dayNext" aria-label="Следующий день">›</button>
          <button class="today-btn" id="dayYesterday">Вчера</button>
        </div>
        <div class="analytics-right">
          <div class="month-toggle" id="analyticsMonthToggle"></div>
          <button class="btn secondary small" id="analyticsViewToggle">Показать за всё время</button>
        </div>
      </div>
      <div class="analytics-table-wrap">
        <table class="analytics-table" id="analyticsTable"></table>
      </div>
    </section>

    <!-- RATINGS -->
    <section class="panel" id="panel-ratings">
      <div class="range-nav">
        <button class="arrow" id="weekPrev" aria-label="Предыдущая неделя">‹</button>
        <div class="label" id="weekLabel"></div>
        <button class="arrow" id="weekNext" aria-label="Следующая неделя">›</button>
        <button class="today-btn" id="weekToday">Текущая неделя</button>
      </div>
      <div class="grid" id="ratingsGrid"></div>
    </section>
  </main>
</div>

<div id="overlay">
  <div class="modal" id="modalBody"></div>
</div>

<div class="toast" id="toast"></div>

<script>
const ADMIN_STORAGE_KEY = 'agency_dashboard_ok';
const MONTHS = [
  { key: '2026-08', label: 'Август' },
  { key: '2026-09', label: 'Сентябрь' },
];
const STATUS_LABELS = { active: 'В работе', paused: 'На паузе', done: 'Завершён' };
const RATING_LABELS = { result: 'Результат', communication: 'Коммуникация', quality: 'Качество работы' };
const ROLE_LABELS = { client: 'От клиента', manager: 'От менеджера', specialist: 'От специалиста' };
const ROLE_DOT = { client: 'var(--red)', manager: 'var(--amber)', specialist: 'var(--green)' };
const MONTHS_GENITIVE_SHORT = ['янв', 'февр', 'мар', 'апр', 'мая', 'июня', 'июля', 'авг', 'сент', 'окт', 'нояб', 'дек'];

let state = { projects: [], employees: [], analytics: [], projectRatings: [], dailyMetrics: [], salePrices: { primary: 50000, repeat: 25000 } };
let currentMonth = MONTHS[MONTHS.length - 1].key;
let currentRatingWeek = isoMonday(new Date());
let currentAnalyticsDay = addDays(todayIso(), -1);

// ── Gate ──
function isUnlocked() { try { return localStorage.getItem(ADMIN_STORAGE_KEY) === '1'; } catch { return false; } }
function unlock(pw) {
  try { localStorage.setItem(ADMIN_STORAGE_KEY, '1'); localStorage.setItem('agency_dashboard_pw', pw); } catch {}
}
function getPassword() { try { return localStorage.getItem('agency_dashboard_pw') || ''; } catch { return ''; } }

document.getElementById('gateSubmit').addEventListener('click', tryGate);
document.getElementById('gatePassword').addEventListener('keydown', (e) => { if (e.key === 'Enter') tryGate(); });
async function tryGate() {
  const pw = document.getElementById('gatePassword').value;
  const ok = await api('/api/dashboard/bootstrap', {}, pw, true);
  if (ok) {
    unlock(pw);
    document.getElementById('gate').style.display = 'none';
    boot();
  } else {
    document.getElementById('gateErr').textContent = 'Неверный пароль';
  }
}

// ── API helper ──
// cantor.agency is a plain nginx static host, not the Cloudflare Worker itself, so /api/*
// has to be called on the Worker's own origin (same pattern as serp-analysis/avito-export/
// utm-create's API_BASE), relying on the worker's permissive CORS headers.
const API_BASE = 'https://mainweb.oxion-ezhkov.workers.dev';

async function api(path, options = {}, pwOverride, silent) {
  const pw = pwOverride || getPassword();
  const res = await fetch(API_BASE + path, {
    ...options,
    headers: { 'Content-Type': 'application/json', 'x-dashboard-password': pw, ...(options.headers || {}) },
  });
  if (res.status === 401) {
    if (silent) return false;
    try { localStorage.removeItem(ADMIN_STORAGE_KEY); } catch {}
    location.reload();
    return null;
  }
  if (silent) return true; // password accepted — any other status is a separate (server-side) problem
  if (!res.ok) {
    const data = await res.json().catch(() => null);
    toast((data && data.message) || 'Ошибка сохранения');
    return null;
  }
  return res.json().catch(() => null);
}

function toast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 1800);
}

// ── Boot ──
async function boot() {
  document.getElementById('app').classList.add('ready');
  const data = await api('/api/dashboard/bootstrap');
  if (!data) return;
  state = data;
  renderMonthToggles();
  renderProjects();
  renderAnalytics();
  renderRatings();
  renderTopActions('projects');
}

if (isUnlocked()) {
  document.getElementById('gate').style.display = 'none';
  boot();
}

// ── Tabs ──
document.querySelectorAll('.tab-btn').forEach((btn) => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tab-btn').forEach((b) => b.classList.remove('active'));
    document.querySelectorAll('.panel').forEach((p) => p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('panel-' + btn.dataset.tab).classList.add('active');
    renderTopActions(btn.dataset.tab);
  });
});

// ── Top-bar actions (per active tab, replaces the old static site title) ──
function renderTopActions(tab) {
  const el = document.getElementById('topActions');
  el.innerHTML = '';
  if (tab === 'projects') {
    const btn = document.createElement('button');
    btn.className = 'btn';
    btn.textContent = '+ Добавить проект';
    btn.addEventListener('click', openAddProjectModal);
    el.appendChild(btn);
  } else if (tab === 'analytics') {
    const btn = document.createElement('button');
    btn.className = 'btn ghost';
    btn.textContent = '⬇ Скачать CSV';
    btn.addEventListener('click', exportDailyMetricsCsv);
    el.appendChild(btn);
  }
}

// ── Month toggle (Projects tab; Sales follows the same currentMonth) ──
function renderMonthToggles() {
  const el = document.getElementById('monthToggleProjects');
  el.innerHTML = '';
  MONTHS.forEach((m) => {
    const b = document.createElement('button');
    b.textContent = m.label;
    if (m.key === currentMonth) b.classList.add('active');
    b.addEventListener('click', () => {
      currentMonth = m.key;
      renderMonthToggles();
      renderProjects();
    });
    el.appendChild(b);
  });
}

// ── Modal helpers ──
function openModal(html) {
  document.getElementById('modalBody').innerHTML = html;
  document.getElementById('overlay').classList.add('open');
}
function closeModal() { document.getElementById('overlay').classList.remove('open'); }
document.getElementById('overlay').addEventListener('click', (e) => { if (e.target.id === 'overlay') closeModal(); });

// ══════════════════════ PROJECTS ══════════════════════
function analyticsFor(projectId, month) {
  return state.analytics.find((a) => a.projectId === projectId && a.month === month) || null;
}

function starPicker(criterion, value, onSet) {
  const wrap = document.createElement('div');
  wrap.className = 'stars';
  for (let i = 1; i <= 5; i++) {
    const b = document.createElement('button');
    b.textContent = '★';
    if (i <= value) b.classList.add('on');
    b.addEventListener('click', () => onSet(i));
    wrap.appendChild(b);
  }
  return wrap;
}

function renderProjects() {
  const grid = document.getElementById('projectsGrid');
  grid.innerHTML = '';
  if (!state.projects.length) { grid.innerHTML = '<div class="empty">Пока нет ни одного проекта</div>'; return; }

  state.projects.forEach((p) => {
    const card = document.createElement('div');
    card.className = 'card';

    const a = analyticsFor(p.id, currentMonth);

    card.innerHTML = `<h3>${escapeHtml(p.name)}</h3>`;

    const statusRow = document.createElement('div');
    statusRow.className = 'field-row';
    statusRow.innerHTML = '<label>Статус</label>';
    const statusSel = document.createElement('select');
    Object.entries(STATUS_LABELS).forEach(([k, label]) => {
      const opt = document.createElement('option');
      opt.value = k; opt.textContent = label;
      if (k === p.status) opt.selected = true;
      statusSel.appendChild(opt);
    });
    statusSel.addEventListener('change', async () => {
      await api('/api/dashboard/project', { method: 'POST', body: JSON.stringify({ id: p.id, name: p.name, status: statusSel.value }) });
      p.status = statusSel.value;
      toast('Сохранено');
    });
    statusRow.appendChild(statusSel);
    card.appendChild(statusRow);

    const respRow = document.createElement('div');
    respRow.className = 'field-row';
    respRow.innerHTML = '<label>Ответственный</label>';
    const respSel = document.createElement('select');
    const noneOpt = document.createElement('option');
    noneOpt.value = ''; noneOpt.textContent = '— не назначен —';
    respSel.appendChild(noneOpt);
    state.employees.forEach((e) => {
      const opt = document.createElement('option');
      opt.value = e.id; opt.textContent = e.name;
      if (p.responsibleId === e.id) opt.selected = true;
      respSel.appendChild(opt);
    });
    respSel.addEventListener('change', async () => {
      await api('/api/dashboard/project', { method: 'POST', body: JSON.stringify({ id: p.id, name: p.name, responsibleId: respSel.value || null }) });
      p.responsibleId = respSel.value || null;
      toast('Сохранено');
    });
    respRow.appendChild(respSel);
    card.appendChild(respRow);

    // Metrics — editable inputs, plus a computed row (conversion/CPL/CAC) below them
    const metrics = document.createElement('div');
    metrics.className = 'metrics';
    const fields = [
      ['budget', 'Расход, ₽'], ['views', 'Просмотров'], ['contacts', 'Контактов'],
      ['diagnostics', 'Диагностик'], ['salesCount', 'Продаж'],
    ];
    const av = a || { budget: '', views: '', contacts: '', diagnostics: '', salesCount: '' };
    fields.forEach(([key, label]) => {
      const m = document.createElement('div');
      m.className = 'metric';
      m.innerHTML = `<span class="l">${label}</span>`;
      const input = document.createElement('input');
      input.type = 'number';
      input.dataset.key = key;
      input.value = av[key] ?? '';
      input.addEventListener('input', () => renderComputedRow(computedRow, metricsValues(metrics)));
      input.addEventListener('change', () => saveAnalytics(p.id, metrics, computedRow));
      m.appendChild(input);
      metrics.appendChild(m);
    });
    card.appendChild(metrics);

    const computedRow = document.createElement('div');
    computedRow.className = 'computed-row';
    card.appendChild(computedRow);
    renderComputedRow(computedRow, metricsValues(metrics));

    // Ratings
    const ratingsBlock = document.createElement('div');
    Object.entries(RATING_LABELS).forEach(([key, label]) => {
      const row = document.createElement('div');
      row.className = 'rating-row';
      row.innerHTML = `<span class="l">${label}</span>`;
      row.appendChild(starPicker(key, p.ratings[key] || 0, async (val) => {
        p.ratings[key] = val;
        await api('/api/dashboard/project', { method: 'POST', body: JSON.stringify({ id: p.id, name: p.name, ratings: p.ratings }) });
        renderProjects();
        toast('Оценка сохранена');
      }));
      ratingsBlock.appendChild(row);
    });
    card.appendChild(ratingsBlock);

    // Review
    const reviewLabel = document.createElement('div');
    reviewLabel.className = 'field-row';
    reviewLabel.innerHTML = '<label>Отзыв клиента</label>';
    card.appendChild(reviewLabel);
    const review = document.createElement('textarea');
    review.className = 'review';
    review.placeholder = 'Что клиент говорит о сотрудничестве...';
    review.value = p.review || '';
    review.addEventListener('blur', async () => {
      await api('/api/dashboard/project', { method: 'POST', body: JSON.stringify({ id: p.id, name: p.name, review: review.value }) });
      p.review = review.value;
      toast('Отзыв сохранён');
    });
    card.appendChild(review);

    grid.appendChild(card);

    async function saveAnalytics(projectId, metricsEl, computedRowEl) {
      const vals = metricsValues(metricsEl);
      const derived = computeDerived(vals);
      const body = { projectId, month: currentMonth, ...vals, ...derived };
      const res = await api('/api/dashboard/analytics', { method: 'POST', body: JSON.stringify(body) });
      if (res && res.analytics) {
        state.analytics = state.analytics.filter((x) => !(x.projectId === projectId && x.month === currentMonth));
        state.analytics.push(res.analytics);
        renderComputedRow(computedRowEl, vals);
        toast('Метрики сохранены');
      }
    }
  });
}

function metricsValues(metricsEl) {
  const vals = {};
  metricsEl.querySelectorAll('input[data-key]').forEach((inp) => { vals[inp.dataset.key] = inp.value; });
  return vals;
}

function computeDerived(vals) {
  const budget = Number(vals.budget) || 0;
  const views = Number(vals.views) || 0;
  const contacts = Number(vals.contacts) || 0;
  const salesCount = Number(vals.salesCount) || 0;
  return {
    conversionPct: views > 0 ? Math.round((contacts / views) * 100) : 0,
    cpl: contacts > 0 ? Math.round(budget / contacts) : 0,
    cac: salesCount > 0 ? Math.round(budget / salesCount) : null,
  };
}

function renderComputedRow(el, vals) {
  const { conversionPct, cpl, cac } = computeDerived(vals);
  el.innerHTML = `
    <div class="computed-item"><span class="l">Конверсия</span><span class="v">${conversionPct}%</span></div>
    <div class="computed-item"><span class="l">CPL</span><span class="v">${cpl ? cpl.toLocaleString('ru-RU') + ' ₽' : '—'}</span></div>
    <div class="computed-item"><span class="l">CAC</span><span class="v">${cac != null ? cac.toLocaleString('ru-RU') + ' ₽' : '—'}</span></div>
  `;
}

function openAddProjectModal() {
  openModal(`
    <h3>Новый проект</h3>
    <label>Название клиента</label>
    <input type="text" id="mProjectName" placeholder="Имя Фамилия">
    <div class="actions">
      <button class="btn secondary" onclick="closeModal()">Отмена</button>
      <button class="btn" id="mProjectSave">Создать</button>
    </div>
  `);
  document.getElementById('mProjectSave').addEventListener('click', async () => {
    const name = document.getElementById('mProjectName').value.trim();
    if (!name) return;
    const res = await api('/api/dashboard/project', { method: 'POST', body: JSON.stringify({ name }) });
    if (res && res.project) { state.projects.push(res.project); renderProjects(); closeModal(); }
  });
}

// ══════════════════════ ANALYTICS (по дням, все клиенты) ══════════════════════
const WEEKDAYS_SHORT = ['вс', 'пн', 'вт', 'ср', 'чт', 'пт', 'сб'];

// Local calendar date as YYYY-MM-DD. Deliberately not .toISOString().slice(0,10):
// that serializes in UTC, which silently rolls back a day for any positive UTC
// offset (e.g. Moscow) — "today" and "+/- N days" must stay in local time.
function ymd(date) {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${y}-${m}-${d}`;
}

function todayIso() {
  return ymd(new Date());
}

function fmtPct(n) { return n == null ? '—' : `${n.toFixed(1)}%`; }
function fmtMoney(n) { return n == null ? '—' : `${Math.round(n).toLocaleString('ru-RU')} ₽`; }

function formatDayLabel(dateStr) {
  const d = new Date(dateStr + 'T00:00:00');
  const today = todayIso();
  const yesterday = addDays(today, -1);
  let rel = '';
  if (dateStr === today) rel = 'Сегодня, ';
  else if (dateStr === yesterday) rel = 'Вчера, ';
  return `${rel}${WEEKDAYS_SHORT[d.getDay()]} ${d.getDate()} ${MONTHS_GENITIVE_SHORT[d.getMonth()]}`;
}

function dailyMetricFor(projectId, date) {
  const found = state.dailyMetrics.find((r) => r.projectId === projectId && r.date === date);
  return found ? found : { budget: 0, views: 0, contacts: 0, diagnostics: 0, sales: 0 };
}

function cumulativeFor(projectId, month) {
  return state.dailyMetrics
    .filter((r) => r.projectId === projectId && (!month || r.date.slice(0, 7) === month))
    .reduce((acc, r) => {
      acc.budget += r.budget; acc.views += r.views; acc.contacts += r.contacts;
      acc.diagnostics += r.diagnostics; acc.sales += r.sales;
      return acc;
    }, { budget: 0, views: 0, contacts: 0, diagnostics: 0, sales: 0 });
}

function deriveStats(c) {
  return {
    convAd: c.views > 0 ? (c.contacts / c.views) * 100 : null,
    convDialog: c.contacts > 0 ? (c.diagnostics / c.contacts) * 100 : null,
    convDiag: c.diagnostics > 0 ? (c.sales / c.diagnostics) * 100 : null,
    costContact: c.contacts > 0 ? c.budget / c.contacts : null,
    costDiag: c.diagnostics > 0 ? c.budget / c.diagnostics : null,
    costClient: c.sales > 0 ? c.budget / c.sales : null,
  };
}

const DERIVED_KEYS = ['convAd', 'convDialog', 'convDiag', 'costContact', 'costDiag', 'costClient'];
const DERIVED_FMT = { convAd: fmtPct, convDialog: fmtPct, convDiag: fmtPct, costContact: fmtMoney, costDiag: fmtMoney, costClient: fmtMoney };
const DERIVED_LABELS = { convAd: '% Объявления', convDialog: '% Диалога', convDiag: '% Диагностики', costContact: '₽ Контакта', costDiag: '₽ Диагностики', costClient: '₽ Клиента' };
const RAW_KEYS = ['budget', 'views', 'contacts', 'diagnostics', 'sales'];
const RAW_LABELS = { budget: 'Бюджет', views: 'Просмотры', contacts: 'Контакты', diagnostics: 'Диагностики', sales: 'Продажи' };

// Wound-down clients with sparse history — pinned to the bottom of the Analytics
// table instead of sorting alphabetically with active clients, and left out of
// Ratings entirely (nobody is actively rating them week to week any more).
const WOUND_DOWN_CLIENTS = new Set(['aydar-ziyazov', 'anna-kramorenko']);
function orderedAnalyticsProjects() {
  return [...state.projects].sort((a, b) => (WOUND_DOWN_CLIENTS.has(a.id) ? 1 : 0) - (WOUND_DOWN_CLIENTS.has(b.id) ? 1 : 0));
}

// Soft status marker a row can be clicked through: none -> green -> yellow -> red -> gray -> none.
const ROW_COLORS = ['', 'green', 'yellow', 'red', 'gray'];
function nextRowColor(current) {
  return ROW_COLORS[(ROW_COLORS.indexOf(current || '') + 1) % ROW_COLORS.length];
}
function applyRowColor(tr, color) {
  ROW_COLORS.forEach((c) => { if (c) tr.classList.remove('row-' + c); });
  if (color) tr.classList.add('row-' + color);
}
async function cycleRowColor(p, tr) {
  const next = nextRowColor(p.rowColor);
  p.rowColor = next;
  applyRowColor(tr, next);
  await api('/api/dashboard/project', { method: 'POST', body: JSON.stringify({ id: p.id, name: p.name, rowColor: next }) });
}

let analyticsView = 'day'; // 'day' | 'total'

// Month filter for the "total" view — matches the range covered by the seeded CSV history.
const ANALYTICS_MONTHS = [
  { key: '2026-06', label: 'Июнь' },
  { key: '2026-07', label: 'Июль' },
  { key: '2026-08', label: 'Август' },
  { key: '2026-09', label: 'Сентябрь' },
];
let analyticsMonth = ANALYTICS_MONTHS[ANALYTICS_MONTHS.length - 1].key;

document.getElementById('dayPrev').addEventListener('click', () => { currentAnalyticsDay = addDays(currentAnalyticsDay, -1); renderAnalytics(); });
document.getElementById('dayNext').addEventListener('click', () => { currentAnalyticsDay = addDays(currentAnalyticsDay, 1); renderAnalytics(); });
document.getElementById('dayYesterday').addEventListener('click', () => { currentAnalyticsDay = addDays(todayIso(), -1); renderAnalytics(); });
document.getElementById('analyticsViewToggle').addEventListener('click', () => {
  analyticsView = analyticsView === 'day' ? 'total' : 'day';
  renderAnalytics();
});

function renderAnalyticsMonthToggle() {
  const el = document.getElementById('analyticsMonthToggle');
  el.innerHTML = '';
  if (analyticsView !== 'total') return;
  ANALYTICS_MONTHS.forEach((m) => {
    const b = document.createElement('button');
    b.textContent = m.label;
    if (m.key === analyticsMonth) b.classList.add('active');
    b.addEventListener('click', () => { analyticsMonth = m.key; renderAnalytics(); });
    el.appendChild(b);
  });
}

function renderAnalytics() {
  document.getElementById('dayLabel').textContent = formatDayLabel(currentAnalyticsDay);
  // visibility, not display:none — keeps its layout space so the toggle button never shifts
  document.getElementById('analyticsRangeNav').classList.toggle('dim', analyticsView === 'total');
  document.getElementById('analyticsViewToggle').textContent = analyticsView === 'day' ? 'Показать за всё время' : 'Показать по дням';
  renderAnalyticsMonthToggle();

  const table = document.getElementById('analyticsTable');
  const colCount = 1 + RAW_KEYS.length + (analyticsView === 'total' ? DERIVED_KEYS.length : 0);
  table.innerHTML = `
    <thead><tr>
      <th class="name-th">Клиент</th>
      ${RAW_KEYS.map((k) => `<th>${RAW_LABELS[k]}</th>`).join('')}
      ${analyticsView === 'total' ? DERIVED_KEYS.map((k, i) => `<th${i === 0 || i === 3 ? ' class="group-divider"' : ''}>${DERIVED_LABELS[k]}</th>`).join('') : ''}
    </tr></thead>
    <tbody id="analyticsTbody"></tbody>
  `;
  const tbody = document.getElementById('analyticsTbody');

  const projects = orderedAnalyticsProjects();
  if (!projects.length) {
    tbody.innerHTML = `<tr><td colspan="${colCount}" class="empty">Пока нет ни одного проекта</td></tr>`;
    return;
  }

  projects.forEach((p) => {
    const tr = document.createElement('tr');
    tr.dataset.projectId = p.id;
    applyRowColor(tr, p.rowColor);
    tr.addEventListener('click', (e) => {
      if (e.target.closest('input, button, textarea, select')) return;
      cycleRowColor(p, tr);
    });

    const nameTd = document.createElement('td');
    nameTd.className = 'name-cell';
    nameTd.textContent = p.name;
    tr.appendChild(nameTd);

    if (analyticsView === 'day') {
      const dayData = dailyMetricFor(p.id, currentAnalyticsDay);
      RAW_KEYS.forEach((key) => {
        const td = document.createElement('td');
        const input = document.createElement('input');
        input.type = 'number';
        input.min = '0';
        input.dataset.key = key;
        input.value = dayData[key] || '';
        input.addEventListener('blur', () => saveDailyMetric(p.id, tr));
        td.appendChild(input);
        tr.appendChild(td);
      });
    } else {
      const totals = cumulativeFor(p.id, analyticsMonth);
      RAW_KEYS.forEach((key) => {
        const td = document.createElement('td');
        td.innerHTML = `<span class="total-value">${key === 'budget' ? fmtMoney(totals[key]) : totals[key].toLocaleString('ru-RU')}</span>`;
        tr.appendChild(td);
      });

      DERIVED_KEYS.forEach((key, i) => {
        const td = document.createElement('td');
        td.dataset.derived = key;
        if (i === 0 || i === 3) td.classList.add('group-divider');
        td.innerHTML = '<span class="derived"></span>';
        tr.appendChild(td);
      });
    }

    tbody.appendChild(tr);
    if (analyticsView === 'total') fillDerivedRow(tr, p.id);
  });
}

function fillDerivedRow(tr, projectId) {
  const derived = deriveStats(cumulativeFor(projectId, analyticsView === 'total' ? analyticsMonth : null));
  tr.querySelectorAll('td[data-derived]').forEach((td) => {
    const key = td.dataset.derived;
    const span = td.querySelector('.derived');
    span.textContent = DERIVED_FMT[key](derived[key]);
    span.classList.toggle('empty', derived[key] == null);
  });
}

async function saveDailyMetric(projectId, tr) {
  const vals = {};
  tr.querySelectorAll('input[data-key]').forEach((inp) => { vals[inp.dataset.key] = inp.value; });
  const res = await api('/api/dashboard/daily-metric', {
    method: 'POST',
    body: JSON.stringify({ projectId, date: currentAnalyticsDay, ...vals }),
  });
  if (res && res.dailyMetric) {
    state.dailyMetrics = state.dailyMetrics.filter((r) => !(r.projectId === projectId && r.date === currentAnalyticsDay));
    state.dailyMetrics.push(res.dailyMetric);
    fillDerivedRow(tr, projectId);
    toast('Сохранено');
  }
}

function exportDailyMetricsCsv() {
  const nameById = Object.fromEntries(state.projects.map((p) => [p.id, p.name]));
  const header = ['Клиент', 'Дата', 'Бюджет', 'Просмотры', 'Контакты', 'Диагностики', 'Продажи'];
  const rows = state.dailyMetrics
    .slice()
    .sort((a, b) => (nameById[a.projectId] || '').localeCompare(nameById[b.projectId] || '', 'ru') || (a.date < b.date ? -1 : 1))
    .map((r) => [nameById[r.projectId] || r.projectId, r.date, r.budget, r.views, r.contacts, r.diagnostics, r.sales]);
  const csvEscape = (v) => { const s = String(v); return /[",;\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s; };
  const csv = [header, ...rows].map((row) => row.map(csvEscape).join(';')).join('\r\n');
  const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `analytics_${currentAnalyticsDay}.csv`;
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
}

// ══════════════════════ RATINGS (по проектам, по неделям) ══════════════════════
function isoMonday(d) {
  const date = new Date(d);
  const day = date.getDay();
  const diff = (day === 0 ? -6 : 1) - day;
  date.setDate(date.getDate() + diff);
  return ymd(date);
}

function addDays(dateStr, n) {
  const d = new Date(dateStr + 'T00:00:00');
  d.setDate(d.getDate() + n);
  return ymd(d);
}

function formatWeekRange(weekStart) {
  const start = new Date(weekStart + 'T00:00:00');
  const end = new Date(start);
  end.setDate(end.getDate() + 6);
  const sm = start.getMonth(), em = end.getMonth();
  if (sm === em) return `${start.getDate()}-${end.getDate()} ${MONTHS_GENITIVE_SHORT[em]}`;
  return `${start.getDate()} ${MONTHS_GENITIVE_SHORT[sm]} - ${end.getDate()} ${MONTHS_GENITIVE_SHORT[em]}`;
}

function projectRatingFor(projectId, weekStart) {
  const found = state.projectRatings.find((r) => r.projectId === projectId && r.weekStart === weekStart);
  const blank = () => ({ score: 0, comment: '' });
  return {
    client: { ...blank(), ...(found && found.client) },
    manager: { ...blank(), ...(found && found.manager) },
    specialist: { ...blank(), ...(found && found.specialist) },
  };
}

function numberScale(value, onSet) {
  const wrap = document.createElement('div');
  wrap.className = 'score-scale';
  for (let i = 1; i <= 10; i++) {
    const b = document.createElement('button');
    b.type = 'button';
    b.textContent = String(i);
    if (i === value) b.classList.add('on');
    b.addEventListener('click', () => onSet(i));
    wrap.appendChild(b);
  }
  return wrap;
}

function avgScore(scores) {
  const valid = scores.filter((s) => s > 0);
  return valid.length ? valid.reduce((a, b) => a + b, 0) / valid.length : null;
}

function allTimeAvgFor(projectId) {
  const scores = [];
  state.projectRatings.filter((r) => r.projectId === projectId).forEach((r) => {
    ['client', 'manager', 'specialist'].forEach((role) => {
      if (r[role] && r[role].score > 0) scores.push(r[role].score);
    });
  });
  return avgScore(scores);
}

function fmtAvg(n) { return n == null ? '—' : String(Math.round(n * 10) / 10); }

document.getElementById('weekPrev').addEventListener('click', () => { currentRatingWeek = addDays(currentRatingWeek, -7); renderRatings(); });
document.getElementById('weekNext').addEventListener('click', () => { currentRatingWeek = addDays(currentRatingWeek, 7); renderRatings(); });
document.getElementById('weekToday').addEventListener('click', () => { currentRatingWeek = isoMonday(new Date()); renderRatings(); });

function renderRatings() {
  document.getElementById('weekLabel').textContent = formatWeekRange(currentRatingWeek);

  const grid = document.getElementById('ratingsGrid');
  grid.innerHTML = '';
  const projects = state.projects.filter((p) => !WOUND_DOWN_CLIENTS.has(p.id));
  if (!projects.length) { grid.innerHTML = '<div class="empty">Пока нет ни одного проекта</div>'; return; }

  projects.forEach((p) => {
    const draft = projectRatingFor(p.id, currentRatingWeek);
    const card = document.createElement('div');
    card.className = 'rating-card';

    const scores = [draft.client.score, draft.manager.score, draft.specialist.score];
    const weekAvg = avgScore(scores);
    const allTimeAvg = allTimeAvgFor(p.id);
    card.innerHTML = `
      <div class="rating-card-head">
        <h3>${escapeHtml(p.name)}</h3>
        <span class="avg-pill" title="Средняя за неделю / за всё время">${fmtAvg(weekAvg)}/${fmtAvg(allTimeAvg)}</span>
      </div>
    `;

    Object.entries(ROLE_LABELS).forEach(([role, label]) => {
      const block = document.createElement('div');
      block.className = 'rater';

      const head = document.createElement('div');
      head.className = 'rater-head';
      head.innerHTML = `<span class="who"><span class="dot" style="background:${ROLE_DOT[role]}"></span>${label}</span><span class="score-badge">${draft[role].score || '—'}</span>`;
      block.appendChild(head);

      block.appendChild(numberScale(draft[role].score, async (val) => {
        draft[role].score = val;
        await save();
        renderRatings();
      }));

      const comment = document.createElement('textarea');
      comment.className = 'rater-comment';
      comment.placeholder = 'Комментарий к оценке...';
      comment.value = draft[role].comment;
      comment.addEventListener('blur', () => { draft[role].comment = comment.value; save(); });
      block.appendChild(comment);

      card.appendChild(block);
    });

    grid.appendChild(card);

    async function save() {
      const res = await api('/api/dashboard/project-rating', {
        method: 'POST',
        body: JSON.stringify({ projectId: p.id, weekStart: currentRatingWeek, client: draft.client, manager: draft.manager, specialist: draft.specialist }),
      });
      if (res && res.projectRating) {
        state.projectRatings = state.projectRatings.filter((r) => !(r.projectId === p.id && r.weekStart === currentRatingWeek));
        state.projectRatings.push(res.projectRating);
        toast('Оценка сохранена');
      }
    }
  });
}

// ── util ──
function escapeHtml(s) {
  return String(s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}
