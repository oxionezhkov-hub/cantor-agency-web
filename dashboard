// ── API helper ──
// cantor.agency is a plain nginx static host, not the Cloudflare Worker itself, so /api/*
// has to be called on the Worker's own origin (same pattern as serp-analysis/avito-export/
// utm-create's API_BASE), relying on the worker's permissive CORS headers.
//
// Without a VPN *.workers.dev often doesn't load from Russia, while with a VPN cantor.agency
// (reg.ru) doesn't — so on cantor.agency the API goes through a Yandex Cloud function
// (yc-dashboard-api-proxy, reachable from anywhere) and falls back to the Worker directly;
// opened on the Worker's own domain (the VPN case) it talks to the Worker same-origin.
const API_BASE = 'https://mainweb.oxion-ezhkov.workers.dev';
const API_PROXY_URL = 'https://functions.yandexcloud.net/d4eiu56ijlg0jn5o9rch'; // yc-dashboard-api-proxy — see its README

const API_ROUTES = (() => {
  const direct = (path) => API_BASE + path;
  const proxy = (path) => `${API_PROXY_URL}?p=${encodeURIComponent(path)}`;
  if (location.hostname.endsWith('workers.dev')) return [(path) => location.origin + path, proxy];
  return API_PROXY_URL ? [proxy, direct] : [direct];
})().filter((r, i) => i === 0 || API_PROXY_URL);
let apiRouteIndex = 0;

// fetch() against the API with automatic failover between the proxy and the Worker:
// a route that fails at the network level (blocked / timed out) is swapped for the other
// one and the choice sticks for the rest of the session.
async function apiFetch(path, init) {
  let lastErr;
  for (let attempt = 0; attempt < API_ROUTES.length; attempt += 1) {
    const idx = (apiRouteIndex + attempt) % API_ROUTES.length;
    try {
      const res = await fetch(API_ROUTES[idx](path), { ...init, signal: AbortSignal.timeout(35000) });
      apiRouteIndex = idx;
      return res;
    } catch (e) {
      lastErr = e;
    }
  }
  throw lastErr;
}

async function api(path, options = {}, pwOverride, silent) {
  const pw = pwOverride || getPassword();
  let res;
  try {
    res = await apiFetch(path, {
      ...options,
      headers: { 'Content-Type': 'application/json', 'x-dashboard-password': pw, ...(options.headers || {}) },
    });
  } catch {
    if (silent) return false;
    toast('Нет связи с сервером — попробуйте ещё раз');
    return null;
  }
  if (res.status === 401) {
    if (silent) return false;
    try { localStorage.removeItem(ADMIN_STORAGE_KEY); } catch {}
    location.reload();
    return null;
  }
  if (silent) return true; // password accepted — any other status is a separate (server-side) problem
  if (!res.ok) {
    const data = await res.json().catch(() => null);
    toast((data && data.message) || 'Ошибка сохранения');
    return null;
  }
  return res.json().catch(() => null);
}

function toast(msg) {
