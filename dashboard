<script>
const ADMIN_STORAGE_KEY = 'agency_dashboard_ok';
const ROLE_LABELS = { client: 'От клиента', manager: 'От менеджера', specialist: 'От специалиста' };
const ROLE_DOT = { client: 'var(--red)', manager: 'var(--amber)', specialist: 'var(--green)' };
const MONTHS_GENITIVE_SHORT = ['янв', 'февр', 'мар', 'апр', 'мая', 'июня', 'июля', 'авг', 'сент', 'окт', 'нояб', 'дек'];

let state = { projects: [], employees: [], analytics: [], projectRatings: [], dailyMetrics: [], tasks: [], salePrices: { primary: 50000, repeat: 25000 } };
let currentRatingWeek = isoMonday(new Date());
let currentAnalyticsDay = addDays(todayIso(), -1);

// ── Gate ──
function isUnlocked() { try { return localStorage.getItem(ADMIN_STORAGE_KEY) === '1'; } catch { return false; } }
function unlock(pw) {
  try { localStorage.setItem(ADMIN_STORAGE_KEY, '1'); localStorage.setItem('agency_dashboard_pw', pw); } catch {}
}
function getPassword() { try { return localStorage.getItem('agency_dashboard_pw') || ''; } catch { return ''; } }

document.getElementById('gateSubmit').addEventListener('click', tryGate);
document.getElementById('gatePassword').addEventListener('keydown', (e) => { if (e.key === 'Enter') tryGate(); });
async function tryGate() {
  const pw = document.getElementById('gatePassword').value;
  const ok = await api('/api/dashboard/bootstrap', {}, pw, true);
  if (ok) {
    unlock(pw);
    document.getElementById('gate').style.display = 'none';
    boot();
  } else {
    document.getElementById('gateErr').textContent = 'Неверный пароль';
  }
}

// ── API helper ──
// cantor.agency is a plain nginx static host, not the Cloudflare Worker itself, so /api/*
// has to be called on the Worker's own origin (same pattern as serp-analysis/avito-export/
// utm-create's API_BASE), relying on the worker's permissive CORS headers.
//
// Without a VPN *.workers.dev often doesn't load from Russia, while with a VPN cantor.agency
// (reg.ru) doesn't — so on cantor.agency the API goes through a Yandex Cloud function
// (yc-dashboard-api-proxy, reachable from anywhere) and falls back to the Worker directly;
// opened on the Worker's own domain (the VPN case) it talks to the Worker same-origin.
const API_BASE = 'https://mainweb.oxion-ezhkov.workers.dev';
const API_PROXY_URL = 'https://functions.yandexcloud.net/d4eiu56ijlg0jn5o9rch'; // yc-dashboard-api-proxy — see its README

const API_ROUTES = (() => {
  const direct = (path) => API_BASE + path;
  const proxy = (path) => `${API_PROXY_URL}?p=${encodeURIComponent(path)}`;
  if (location.hostname.endsWith('workers.dev')) return [(path) => location.origin + path, proxy];
  return API_PROXY_URL ? [proxy, direct] : [direct];
})().filter((r, i) => i === 0 || API_PROXY_URL);
let apiRouteIndex = 0;

// fetch() against the API with automatic failover between the proxy and the Worker:
// a route that fails at the network level (blocked / timed out) is swapped for the other
// one and the choice sticks for the rest of the session.
async function apiFetch(path, init) {
  let lastErr;
  for (let attempt = 0; attempt < API_ROUTES.length; attempt += 1) {
    const idx = (apiRouteIndex + attempt) % API_ROUTES.length;
    try {
      const res = await fetch(API_ROUTES[idx](path), { ...init, signal: AbortSignal.timeout(35000) });
      apiRouteIndex = idx;
      return res;
    } catch (e) {
      lastErr = e;
    }
  }
  throw lastErr;
}

async function api(path, options = {}, pwOverride, silent) {
  const pw = pwOverride || getPassword();
  let res;
  try {
    res = await apiFetch(path, {
      ...options,
      headers: { 'Content-Type': 'application/json', 'x-dashboard-password': pw, ...(options.headers || {}) },
    });
  } catch {
    if (silent) return false;
    toast('Нет связи с сервером — попробуйте ещё раз');
    return null;
  }
  if (res.status === 401) {
    if (silent) return false;
    try { localStorage.removeItem(ADMIN_STORAGE_KEY); } catch {}
    location.reload();
    return null;
  }
  if (silent) return true; // password accepted — any other status is a separate (server-side) problem
  if (!res.ok) {
    const data = await res.json().catch(() => null);
    toast((data && data.message) || 'Ошибка сохранения');
    return null;
  }
  return res.json().catch(() => null);
}

function toast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 1800);
}

// ── Boot ──
let currentTab = 'projects';
let bootstrapped = false;

async function boot() {
  document.getElementById('app').classList.add('ready');
  renderTopActions(currentTab);
  const data = await api('/api/dashboard/bootstrap');
  if (!data) return;
  state = data;
  bootstrapped = true;
  renderProjects();
  renderAnalytics();
  renderTopActions(currentTab); // whatever tab the user moved to while data was loading
  resumeBackgroundJobs();
}


// ── Tabs ──
document.querySelectorAll('.tab-btn').forEach((btn) => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tab-btn').forEach((b) => b.classList.remove('active'));
    document.querySelectorAll('.panel').forEach((p) => p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('panel-' + btn.dataset.tab).classList.add('active');
    currentTab = btn.dataset.tab;
    renderTopActions(currentTab);
  });
});

// ── Icons (inline SVG, lucide-style strokes) ──
const ICON_PATHS = {
  folder: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  chart: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  tasks: '<path d="M9 11l2 2 4-4"/><rect x="3" y="3" width="18" height="18" rx="3"/>',
  crm: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18.5 14.5A6.5 6.5 0 0 1 21.5 20"/>',
  cards: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  table: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M3 15h18M9 4v16"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  sum: '<path d="M18 5H6l6 7-6 7h12"/>',
  download: '<path d="M12 4v11M7 10l5 5 5-5M5 20h14"/>',
  avito: '<path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/>',
  report: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/>',
  settings: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>',
};
function icon(name) { return `<svg class="ic" viewBox="0 0 24 24" aria-hidden="true">${ICON_PATHS[name] || ''}</svg>`; }
document.querySelectorAll('svg[data-icon]').forEach((el) => { el.outerHTML = icon(el.dataset.icon); });

// Per-tab actions. Always rendered for currentTab (also before data arrives), so the bar
// can never keep a previous tab's buttons.
const TOP_ACTIONS = {
  projects: [{ icon: 'plus', label: 'Новый проект', primary: true, run: () => openAddProjectModal() }],
  analytics: [
    { icon: 'sum', label: 'Итоги по клиентам', run: () => toggleSummaryPopup() },
    { icon: 'download', label: 'Экспорт в CSV', run: () => exportDailyMetricsCsv() },
    { icon: 'avito', label: 'Аналитика из Авито', run: () => toggleAvitoPanel() },
    { icon: 'report', label: 'Выгрузка отчёта', run: () => openReportModal() },
  ],
};

function renderTopActions(tab) {
  const el = document.getElementById('topActions');
  el.innerHTML = '';
  if (tab !== 'analytics') {
    document.getElementById('summaryPopup').classList.add('hidden');
    document.getElementById('avitoPanel').classList.add('hidden');
  }
  if (tab === 'projects') el.append(weekNav(), viewSwitch());
  (TOP_ACTIONS[tab] || []).forEach((a) => {
    const btn = document.createElement('button');
    btn.className = a.primary ? 'btn' : 'btn ghost';
    btn.title = a.label;
    btn.setAttribute('aria-label', a.label);
    btn.innerHTML = `${icon(a.icon)}<span class="lbl">${a.label}</span>`;
    btn.addEventListener('click', () => {
      if (!bootstrapped) { toast('Данные ещё загружаются…'); return; }
      a.run();
    });
    el.appendChild(btn);
  });
}

// ── Notices: background jobs report here, so any tab stays usable meanwhile ──
function notice(id, { title, text = '', kind = '', busy = false, actions = [] }) {
  const box = document.getElementById('notices');
  let el = document.getElementById(`notice-${id}`);
  if (!el) {
    el = document.createElement('div');
    el.id = `notice-${id}`;
    box.appendChild(el);
  }
  el.className = `notice ${kind}`;
  el.innerHTML = `<div class="notice-head"><b>${busy ? '<span class="spin"></span>' : ''}${escapeHtml(title)}</b><button class="popup-close" aria-label="Закрыть">×</button></div>
    ${text ? `<div class="notice-text">${escapeHtml(text)}</div>` : ''}
    ${actions.length ? '<div class="notice-actions"></div>' : ''}`;
  el.querySelector('.popup-close').addEventListener('click', () => dismissNotice(id));
  actions.forEach((a) => {
    const b = document.createElement('button');
    b.className = `btn small ${a.secondary ? 'secondary' : ''}`;
    b.textContent = a.label;
    b.addEventListener('click', a.run);
    el.querySelector('.notice-actions').appendChild(b);
  });
}
const noticeCloseHooks = {};
function dismissNotice(id) {
  const el = document.getElementById(`notice-${id}`);
  if (el) el.remove();
  if (noticeCloseHooks[id]) noticeCloseHooks[id]();
}

function storedJob(key, value) {
  try {
    if (value === undefined) return JSON.parse(localStorage.getItem(key) || 'null');
    if (value === null) localStorage.removeItem(key); else localStorage.setItem(key, JSON.stringify(value));
  } catch { return null; }
  return value;
}

function resumeBackgroundJobs() {
  const report = storedJob('dash_report_job');
  if (report && report.id) trackReportJob(report.id);
  const pull = storedJob('dash_avito_pull');
  if (pull && pull.date) trackAvitoPull(pull.date);
}

// ── Modal helpers ──
function openModal(html) {
  document.getElementById('modalBody').classList.remove('wide');
  document.getElementById('modalBody').innerHTML = html;
  document.getElementById('overlay').classList.add('open');
}
function closeModal() { document.getElementById('overlay').classList.remove('open'); }
document.getElementById('overlay').addEventListener('click', (e) => { if (e.target.id === 'overlay') closeModal(); });

// ══════════════════════ PROJECTS ══════════════════════
// One place per client: the permanent fields (status, stage, current work, colour) plus the
// three ratings of the week picked in the top bar — the week arrows change only the ratings.
const PROJECT_FIELDS = [
  { key: 'status', label: 'Статус' },
  { key: 'stage', label: 'Этап работы' },
  { key: 'currentWork', label: 'Сейчас работаем над' },
];
const COLOR_TITLES = { '': 'Без цвета', green: 'Зелёный', yellow: 'Жёлтый', red: 'Красный', gray: 'Серый — неактивный клиент' };

let projectsView = (() => { try { return localStorage.getItem('dash_projects_view') === 'table' ? 'table' : 'cards'; } catch { return 'cards'; } })();

function weekNav() {
  const wrap = document.createElement('div');
  wrap.className = 'week-nav';
  const isCurrent = currentRatingWeek === isoMonday(new Date());
  wrap.innerHTML = `<button class="arr" aria-label="Предыдущая неделя" title="Предыдущая неделя">‹</button>`
    + `<button class="lbl-week" title="К текущей неделе">${formatWeekRange(currentRatingWeek)}${isCurrent ? '<small>текущая</small>' : ''}</button>`
    + `<button class="arr" aria-label="Следующая неделя" title="Следующая неделя">›</button>`;
  const [prev, label, next] = wrap.querySelectorAll('button');
  prev.addEventListener('click', () => setRatingWeek(addDays(currentRatingWeek, -7)));
  label.addEventListener('click', () => setRatingWeek(isoMonday(new Date())));
  next.addEventListener('click', () => setRatingWeek(addDays(currentRatingWeek, 7)));
  return wrap;
}

function setRatingWeek(week) {
  currentRatingWeek = week;
  renderTopActions(currentTab);
  if (bootstrapped) renderProjects();
}

function viewSwitch() {
  const wrap = document.createElement('div');
  wrap.className = 'seg';
  [['cards', 'Карточки'], ['table', 'Таблица']].forEach(([view, title]) => {
    const b = document.createElement('button');
    b.className = projectsView === view ? 'on' : '';
    b.title = title;
    b.setAttribute('aria-label', title);
    b.innerHTML = icon(view);
    b.addEventListener('click', () => {
      projectsView = view;
      try { localStorage.setItem('dash_projects_view', view); } catch {}
      renderTopActions(currentTab);
      if (bootstrapped) renderProjects();
    });
    wrap.appendChild(b);
  });
  return wrap;
}

// Textareas grow with their text — no empty space under a short answer.
function fitTextarea(t) {
  if (!t.isConnected || !t.offsetParent) return;
  t.style.height = 'auto';
  t.style.height = `${t.scrollHeight + t.offsetHeight - t.clientHeight}px`;
}
function fitAllTextareas() { document.querySelectorAll('#panel-projects textarea.auto').forEach(fitTextarea); }
let refitTimer = null;
window.addEventListener('resize', () => { clearTimeout(refitTimer); refitTimer = setTimeout(fitAllTextareas, 120); });
if (document.fonts) document.fonts.ready.then(fitAllTextareas);

function autoTextarea(value, placeholder, onSave) {
  const t = document.createElement('textarea');
  t.className = 'auto';
  t.rows = 1;
  t.placeholder = placeholder;
  t.value = value || '';
  let saved = t.value;
  t.addEventListener('input', () => fitTextarea(t));
  t.addEventListener('blur', () => { if (t.value !== saved) { saved = t.value; onSave(t.value); } });
  return t;
}

async function saveProjectField(p, field, value) {
  const res = await api('/api/dashboard/project', { method: 'POST', body: JSON.stringify({ id: p.id, name: p.name, [field]: value }) });
  if (!res || !res.project) return false;
  Object.assign(p, res.project); // picks up what the server derives too (grey ⇒ inactive)
  toast('Сохранено');
  return true;
}

function weekAvgText(p) {
  const d = projectRatingFor(p.id, currentRatingWeek);
  return `${fmtAvg(avgScore([d.client.score, d.manager.score, d.specialist.score]))}/${fmtAvg(allTimeAvgFor(p.id))}`;
}

function inactiveTag(p) { return isInactive(p) ? '<span class="inactive-tag">неактивный</span>' : ''; }

// Status / stage / current work: heading on top, answer below; an empty one is a single short line.
function textField(p, key, label) {
  const f = document.createElement('div');
  f.className = 'f';
  f.innerHTML = `<div class="q">${label}</div>`;
  const t = autoTextarea(p[key], 'добавить…', (v) => saveProjectField(p, key, v));
  // re-checked on blur, not while typing, so the field doesn't jump under the cursor
  const syncEmpty = () => { f.classList.toggle('is-empty', !t.value.trim()); fitTextarea(t); };
  t.addEventListener('blur', syncEmpty);
  f.appendChild(t);
  syncEmpty();
  return f;
}

// One role's rating for the selected week. Filled: who · score, comment below.
// Empty: who + 1–10 in one line. «изменить» (or picking a score) opens the 1–10 + comment editor.
function raterBlock(p, role, { label = true, onSaved } = {}) {
  const el = document.createElement('div');
  const week = currentRatingWeek;
  let editing = false;
  let renderGen = 0; // a blur from the editor that the re-render itself removed must not count
  const current = () => projectRatingFor(p.id, week)[role];

  async function save(score, comment) {
    const res = await api('/api/dashboard/project-rating', {
      method: 'POST',
      body: JSON.stringify({ projectId: p.id, weekStart: week, role, score, comment }),
    });
    if (!res || !res.projectRating) return;
    // Client/manager/specialist are three different people, often on three different
    // devices — each role is its own independent record server-side (see _worker.js),
    // so this save can never race with or clobber another role's concurrent save.
    state.projectRatings = state.projectRatings.filter((r) => !(r.projectId === p.id && r.weekStart === week && r.role === role));
    state.projectRatings.push(res.projectRating);
    toast('Оценка сохранена');
    if (onSaved) onSaved();
  }

  function render() {
    const gen = ++renderGen;
    const d = current();
    const filled = d.score > 0 || Boolean(d.comment.trim());
    el.className = `r${filled || editing ? '' : ' is-empty'}`;
    const who = label ? `<span class="dot" style="background:${ROLE_DOT[role]}"></span>${ROLE_LABELS[role]}` : '';
    const score = d.score ? `<span class="score">${d.score}</span>` : '';
    const action = filled || editing ? `<button type="button" class="link-btn">${editing ? 'готово' : 'изменить'}</button>` : '';
    el.innerHTML = who || score || action ? `<div class="r-head">${who}${score}${action}</div>` : '';

    let comment = null;
    const finish = async () => {
      if (!editing || gen !== renderGen) return;
      editing = false;
      if (comment && comment.value !== d.comment) await save(d.score, comment.value);
      render();
    };

    if (!filled || editing) {
      const chips = document.createElement('div');
      chips.className = 'chips';
      for (let i = 1; i <= 10; i++) {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = String(i);
        if (i === d.score) b.classList.add('on');
        b.addEventListener('mousedown', (e) => e.preventDefault()); // keep the comment focused
        b.addEventListener('click', async () => {
          // clicking the already-set score again clears it back to unrated
          await save(d.score === i ? 0 : i, comment ? comment.value : d.comment);
          editing = true;
          render();
        });
        chips.appendChild(b);
      }
      el.appendChild(chips);
    }
    if (editing) {
      comment = autoTextarea(d.comment, 'Комментарий к оценке…', () => {});
      comment.addEventListener('blur', finish);
      el.appendChild(comment);
      fitTextarea(comment);
      comment.focus();
    } else if (d.comment.trim()) {
      el.insertAdjacentHTML('beforeend', `<div class="r-comment">${escapeHtml(d.comment)}</div>`);
    }

    const btn = el.querySelector('.link-btn');
    if (btn) {
      btn.addEventListener('mousedown', (e) => e.preventDefault());
      btn.addEventListener('click', () => { if (editing) finish(); else { editing = true; render(); } });
    }
  }

  render();
  return el;
}

