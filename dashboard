// ══════════════════════ ВЫГРУЗКА ОТЧЁТА (через рутину Claude Code) ══════════════════════
// The worker snapshots the Analytics table for the period, fires the Claude Code routine,
// and the routine posts back "Текущие наблюдения" per client; the .docx is then assembled
// by the worker in the agency's usual format. The modal closes right after "Сформировать";
// progress and the download button live in a notice, so every tab stays usable meanwhile.
let reportPollTimer = null;
const REPORT_TIMEOUT_MS = 15 * 60 * 1000;

async function openReportModal() {
  const info = await api('/api/dashboard/report-last');
  const yesterday = addDays(todayIso(), -1);
  // Default period: everything since the last generated report (covers weekends / skipped
  // days, which the report then shows as "За DD–DD месяц"), capped to a week back.
  let from = yesterday;
  if (info && info.lastTo && info.lastTo < yesterday) {
    const next = addDays(info.lastTo, 1);
    if (next >= addDays(yesterday, -6)) from = next;
  }
  openModal(`
    <h3>Выгрузка отчёта</h3>
    <div class="hint">Цифры берутся из таблицы аналитики, неактивные клиенты в отчёт не попадают. Если период больше одного дня — в отчёте будет блок «За DD–DD месяц» вместо «Вчера». Отчёт готовится в фоне — когда будет готов, появится уведомление с кнопкой «Скачать».</div>
    <div class="date-row">
      <div><label>С</label><input type="date" id="mRepFrom" value="${from}"></div>
      <div><label>По</label><input type="date" id="mRepTo" value="${yesterday}"></div>
    </div>
    <div class="actions">
      <button class="btn secondary" onclick="closeModal()">Отмена</button>
      <button class="btn" id="mRepGo">Сформировать</button>
    </div>
  `);
  document.getElementById('mRepGo').addEventListener('click', async () => {
    const dateFrom = document.getElementById('mRepFrom').value;
    const dateTo = document.getElementById('mRepTo').value;
    closeModal();
    notice('report', { title: 'Выгрузка отчёта: запускаю…', busy: true });
    const res = await api('/api/dashboard/report-job', { method: 'POST', body: JSON.stringify({ dateFrom, dateTo }) });
    if (!res || !res.job) { notice('report', { title: 'Выгрузка отчёта не запустилась', kind: 'bad', text: 'Попробуйте ещё раз.' }); return; }
    storedJob('dash_report_job', { id: res.job.id, startedAt: Date.now() });
    trackReportJob(res.job.id);
  });
}

function trackReportJob(id) {
  clearTimeout(reportPollTimer);
  const started = (storedJob('dash_report_job') || {}).startedAt || Date.now();
  const tick = async () => {
    const res = await api(`/api/dashboard/report-job?id=${id}`, {}, null, false);
    const job = res && res.job;
    if (!job) { storedJob('dash_report_job', null); dismissNotice('report'); return; }
    const period = `${job.periodLabel}, клиентов: ${job.clientsCount}`;
    const warnings = job.warnings && job.warnings.length ? `\n${job.warnings.join('\n')}` : '';
    const download = { label: 'Скачать', run: () => downloadReport(job) };
    const session = job.sessionUrl ? [{ label: 'Сессия Claude', secondary: true, run: () => window.open(job.sessionUrl, '_blank', 'noopener') }] : [];
    if (job.status === 'done') {
      storedJob('dash_report_job', null);
      notice('report', { title: 'Отчёт готов', kind: 'ok', text: period + warnings, actions: [download] });
      return;
    }
    const timedOut = Date.now() - started > REPORT_TIMEOUT_MS;
    if (job.status === 'not_configured' || job.status === 'failed' || timedOut) {
      storedJob('dash_report_job', null);
      notice('report', {
        title: timedOut ? 'Claude не ответил за 15 минут' : job.status === 'not_configured' ? 'Рутина Claude не подключена' : 'Рутина Claude не запустилась',
        kind: 'bad',
        text: `${period}\nМожно скачать отчёт с автоматическими наблюдениями.${warnings}`,
        actions: [{ ...download, label: 'Скачать с авто-наблюдениями' }, ...session],
      });
      return;
    }
    notice('report', {
      title: job.status === 'running' ? 'Claude пишет наблюдения…' : 'Отчёт готовится…',
      text: `${period}. Можно работать в других разделах — здесь появится кнопка «Скачать».`,
      busy: true,
      actions: [{ label: 'Скачать черновик сейчас', secondary: true, run: () => downloadReport(job) }, ...session],
    });
    reportPollTimer = setTimeout(tick, 5000);
  };
  tick();
}
noticeCloseHooks.report = () => { clearTimeout(reportPollTimer); storedJob('dash_report_job', null); };
noticeCloseHooks.avito = () => { clearTimeout(avitoPollTimer); storedJob('dash_avito_pull', null); };

async function downloadReport(job) {
  let res;
  try {
    res = await apiFetch(`/api/dashboard/report-job/file?id=${job.id}`, { headers: { 'x-dashboard-password': getPassword() } });
  } catch { res = null; }
  if (!res || !res.ok) { toast('Не удалось скачать'); return; }
  const blob = await res.blob();
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = job.fileName || 'report.docx';
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 2000);
}

// ══════════════════════ RATINGS (по проектам, по неделям) ══════════════════════
function isoMonday(d) {
  const date = new Date(d);
  const day = date.getDay();
  const diff = (day === 0 ? -6 : 1) - day;
  date.setDate(date.getDate() + diff);
  return ymd(date);
}

function addDays(dateStr, n) {
  const d = new Date(dateStr + 'T00:00:00');
  d.setDate(d.getDate() + n);
  return ymd(d);
}

function formatWeekRange(weekStart) {
  const start = new Date(weekStart + 'T00:00:00');
  const end = new Date(start);
  end.setDate(end.getDate() + 6);
  const sm = start.getMonth(), em = end.getMonth();
  if (sm === em) return `${start.getDate()}-${end.getDate()} ${MONTHS_GENITIVE_SHORT[em]}`;
  return `${start.getDate()} ${MONTHS_GENITIVE_SHORT[sm]} - ${end.getDate()} ${MONTHS_GENITIVE_SHORT[em]}`;
}

// state.projectRatings is a flat list of independent per-(project, week, role)
// rows — group the three roles for this project/week here for rendering.
function projectRatingFor(projectId, weekStart) {
  const draft = { client: { score: 0, comment: '' }, manager: { score: 0, comment: '' }, specialist: { score: 0, comment: '' } };
  state.projectRatings
    .filter((r) => r.projectId === projectId && r.weekStart === weekStart)
    .forEach((r) => { draft[r.role] = { score: r.score, comment: r.comment }; });
  return draft;
}

function numberScale(value, onSet) {
  const wrap = document.createElement('div');
  wrap.className = 'score-scale';
  for (let i = 1; i <= 10; i++) {
    const b = document.createElement('button');
    b.type = 'button';
    b.textContent = String(i);
    if (i === value) b.classList.add('on');
    b.addEventListener('click', () => onSet(i));
    wrap.appendChild(b);
  }
  return wrap;
}

function avgScore(scores) {
  const valid = scores.filter((s) => s > 0);
  return valid.length ? valid.reduce((a, b) => a + b, 0) / valid.length : null;
}

function allTimeAvgFor(projectId) {
  const scores = state.projectRatings
    .filter((r) => r.projectId === projectId && r.score > 0)
    .map((r) => r.score);
  return avgScore(scores);
}

function fmtAvg(n) { return n == null ? '—' : String(Math.round(n * 10) / 10); }

document.getElementById('weekPrev').addEventListener('click', () => { currentRatingWeek = addDays(currentRatingWeek, -7); renderRatings(); });
document.getElementById('weekNext').addEventListener('click', () => { currentRatingWeek = addDays(currentRatingWeek, 7); renderRatings(); });
document.getElementById('weekToday').addEventListener('click', () => { currentRatingWeek = isoMonday(new Date()); renderRatings(); });

// ══════════════════════ TASKS ══════════════════════
// Read-only view of the tasks the control bot extracts from the work chat and client chats;
// the owner corrects them from the bot itself (/done, /informed, /cancel).
const TASK_STATUS = {
  open: ['Открыта', 'status-active'],
  done: ['Сделана, клиенту не сообщили', 'status-paused'],
  closed: ['Закрыта', 'status-done'],
  cancelled: ['Отменена', 'status-done'],
};
document.getElementById('tasksProjectFilter').addEventListener('change', renderTasks);
document.getElementById('tasksStatusFilter').addEventListener('change', renderTasks);

function taskDueMs(t) { const ms = Date.parse(t.due || ''); return Number.isFinite(ms) ? ms : null; }
function fmtTaskDate(ms) {
  if (!ms) return '—';
  return new Date(ms).toLocaleString('ru-RU', { timeZone: 'Europe/Moscow', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
}

function renderTasks() {
  const tasks = (state.tasks || []).filter((t) => t.source === 'bot');
  const projectName = (id) => (state.projects.find((p) => p.id === id) || {}).name;
  const filterEl = document.getElementById('tasksProjectFilter');
  const current = filterEl.value;
  const ids = [...new Set(tasks.map((t) => t.projectId || ''))];
  filterEl.innerHTML = '<option value="">Все клиенты</option>' + ids
    .map((id) => [id, id ? projectName(id) || id : 'Без клиента'])
    .sort((a, b) => a[1].localeCompare(b[1], 'ru'))
    .map(([id, name]) => `<option value="${escapeHtml(id || '__none')}">${escapeHtml(name)}</option>`).join('');
  filterEl.value = current;

  const status = document.getElementById('tasksStatusFilter').value;
  const now = Date.now();
  const rows = tasks.filter((t) => {
    if (filterEl.value && (t.projectId || '__none') !== filterEl.value) return false;
    if (status === 'active') return t.status === 'open' || t.status === 'done';
    if (status === 'overdue') return t.status === 'open' && taskDueMs(t) && taskDueMs(t) < now;
    return true;
  }).sort((a, b) => (taskDueMs(a) || Infinity) - (taskDueMs(b) || Infinity) || String(b.createdAt).localeCompare(String(a.createdAt)));

  const table = document.getElementById('tasksTable');
  const head = '<thead><tr><th class="name-th">Клиент</th><th>Задача</th><th>Исполнитель</th><th>Срок</th><th>Статус</th><th>Поставлена</th><th></th></tr></thead>';
  if (!rows.length) {
    table.innerHTML = head + '<tbody><tr><td class="empty" colspan="7">Задач нет — бот добавляет их сюда сам из рабочего чата</td></tr></tbody>';
    return;
  }
  table.innerHTML = head + '<tbody>' + rows.map((t) => {
    const due = taskDueMs(t);
    const overdue = t.status === 'open' && due && due < now;
    const [label, cls] = overdue ? ['Просрочена', 'status-overdue'] : TASK_STATUS[t.status] || [t.status, ''];
    return `<tr>
      <td class="name-cell">${escapeHtml(projectName(t.projectId) || t.topicName || '—')}</td>
      <td class="task-text">${escapeHtml(t.text)}</td>
      <td>${escapeHtml(t.owner || '—')}</td>
      <td>${due ? fmtTaskDate(due) : 'без срока'}</td>
      <td><span class="status-badge ${cls}">${escapeHtml(label)}</span></td>
      <td>${fmtTaskDate(Date.parse(t.startedAt || t.createdAt))}${t.author ? ' · ' + escapeHtml(t.author) : ''}</td>
      <td>${t.link ? `<a href="${escapeHtml(t.link)}" target="_blank" rel="noopener">в чате ↗</a>` : ''}</td>
    </tr>`;
  }).join('') + '</tbody>';
}

function renderRatings() {
  document.getElementById('weekLabel').textContent = formatWeekRange(currentRatingWeek);

  const grid = document.getElementById('ratingsGrid');
  grid.innerHTML = '';
  const projects = state.projects.filter((p) => !isInactive(p));
  if (!projects.length) { grid.innerHTML = '<div class="empty">Пока нет ни одного проекта</div>'; return; }

  projects.forEach((p) => {
    const draft = projectRatingFor(p.id, currentRatingWeek);
    const card = document.createElement('div');
    card.className = 'rating-card';

    const scores = [draft.client.score, draft.manager.score, draft.specialist.score];
    const weekAvg = avgScore(scores);
    const allTimeAvg = allTimeAvgFor(p.id);
    card.innerHTML = `
      <div class="rating-card-head">
        <h3>${escapeHtml(p.name)}</h3>
        <span class="avg-pill" title="Средняя за неделю / за всё время">${fmtAvg(weekAvg)}/${fmtAvg(allTimeAvg)}</span>
      </div>
    `;

    Object.entries(ROLE_LABELS).forEach(([role, label]) => {
      const block = document.createElement('div');
      block.className = 'rater';

      const head = document.createElement('div');
      head.className = 'rater-head';
      head.innerHTML = `<span class="who"><span class="dot" style="background:${ROLE_DOT[role]}"></span>${label}</span><span class="score-badge">${draft[role].score || '—'}</span>`;
      block.appendChild(head);

      block.appendChild(numberScale(draft[role].score, async (val) => {
        // clicking the already-set score again clears it back to unrated
        draft[role].score = draft[role].score === val ? 0 : val;
        await save(role);
        renderRatings();
      }));

      const comment = document.createElement('textarea');
      comment.className = 'rater-comment';
      comment.placeholder = 'Комментарий к оценке...';
      comment.value = draft[role].comment;
      comment.addEventListener('blur', () => { draft[role].comment = comment.value; save(role); });
      block.appendChild(comment);

      card.appendChild(block);
    });

    grid.appendChild(card);

    // Client/manager/specialist are three different people, often on three different
    // devices — each role is its own independent record server-side (see _worker.js),
    // so this save can never race with or clobber another role's concurrent save.
    async function save(role) {
      const res = await api('/api/dashboard/project-rating', {
        method: 'POST',
        body: JSON.stringify({ projectId: p.id, weekStart: currentRatingWeek, role, score: draft[role].score, comment: draft[role].comment }),
      });
      if (res && res.projectRating) {
        state.projectRatings = state.projectRatings.filter((r) => !(r.projectId === p.id && r.weekStart === currentRatingWeek && r.role === role));
        state.projectRatings.push(res.projectRating);
        toast('Оценка сохранена');
      }
    }
  });
}

// ── util ──
function escapeHtml(s) {
  return String(s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

// Auto-login last, once every const above (icons, top-bar actions…) is initialised.
if (isUnlocked()) {
  document.getElementById('gate').style.display = 'none';
  boot();
}
