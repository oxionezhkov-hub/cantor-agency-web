<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Дашборд руководителя — Cantor Agency</title>
<meta name="robots" content="noindex, nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geologica:wght@300;400;500;600;700;800&family=Unbounded:wght@700;800;900&display=swap" rel="stylesheet">
<link rel="icon" type="image/svg+xml" href="/Frame 1000011449.svg">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --red:#E8391D;--red-dark:#C42D13;--red-light:#FF6347;
  --dark:#0F0F0F;--dark2:#1A1A1A;--text:#1C1C1C;--muted:#888;
  --bg:#F6F5F2;--white:#FFFFFF;--border:#E2E0DC;
  --accent-bg:#FFF3F0;--warm-bg:#FFFBF9;
  --shadow-sm:0 2px 8px rgba(0,0,0,0.06);
  --shadow-md:0 12px 40px rgba(0,0,0,0.1);
  --shadow-red:0 8px 28px rgba(232,57,29,0.28);
  --r-sm:6px;--r-md:10px;--r-lg:16px;--r-xl:20px;
  --green:#1e8449;--green-bg:#eafaf1;
  --amber:#9a6f00;--amber-bg:#fef9e7;
  --gray:#6b6b6b;--gray-bg:#f1f0ed;
}
html{-webkit-text-size-adjust:100%}
body{font-family:'Geologica',sans-serif;color:var(--text);background:var(--bg);line-height:1.5;min-height:100vh;-webkit-font-smoothing:antialiased}
.hidden{display:none !important}
.dim{visibility:hidden}
button{font-family:inherit;cursor:pointer}
input,textarea,select{font-family:inherit}

/* ── Password gate ── */
#gate{position:fixed;inset:0;background:var(--dark);display:flex;align-items:center;justify-content:center;z-index:1000;padding:20px}
#gate .box{background:var(--white);border-radius:var(--r-lg);padding:36px 32px;width:100%;max-width:340px;box-shadow:var(--shadow-md);text-align:center}
#gate h1{font-family:'Unbounded',sans-serif;font-size:16px;font-weight:800;margin-bottom:18px}
#gate input{width:100%;border:1.5px solid var(--border);border-radius:var(--r-sm);padding:12px 14px;font-size:15px;margin-bottom:12px}
#gate button{width:100%;background:var(--red);color:#fff;border:none;border-radius:var(--r-sm);padding:12px;font-size:14px;font-weight:600}
#gate button:hover{background:var(--red-dark)}
#gate .err{color:var(--red);font-size:12px;margin-bottom:10px;min-height:14px}

/* ── App shell ── */
#app{display:none}
#app.ready{display:block}
header.top{background:var(--dark);color:#fff;padding:18px 28px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}
.top-actions{display:flex;gap:10px;align-items:center;min-height:20px}
.tabs{display:flex;gap:6px;flex-wrap:wrap}
.tab-btn{background:none;border:none;color:#bbb;padding:10px 16px;border-radius:var(--r-sm);font-size:13px;font-weight:600}
.tab-btn.active{background:var(--red);color:#fff}
.tab-btn:hover:not(.active){background:#2a2a2a;color:#fff}
main{padding:24px 28px 80px;max-width:1300px;margin:0 auto}
.panel{display:none}
.panel.active{display:block}

.month-toggle{display:flex;gap:8px;margin-bottom:20px}
.month-toggle button{background:var(--white);border:1.5px solid var(--border);border-radius:var(--r-sm);padding:8px 16px;font-size:13px;font-weight:600;color:var(--muted)}
.month-toggle button.active{background:var(--dark);color:#fff;border-color:var(--dark)}

.btn{background:var(--red);color:#fff;border:none;border-radius:var(--r-sm);padding:10px 16px;font-size:13px;font-weight:600;box-shadow:var(--shadow-red)}
.btn:hover{background:var(--red-dark)}
.btn.secondary{background:var(--white);color:var(--text);border:1.5px solid var(--border);box-shadow:none}
.btn.secondary:hover{border-color:var(--red);color:var(--red)}
.btn.small{padding:6px 10px;font-size:12px}
.btn.danger{background:var(--white);color:var(--red);border:1.5px solid var(--border);box-shadow:none}
.btn.danger:hover{border-color:var(--red);background:var(--accent-bg)}
.btn.ghost{background:rgba(255,255,255,.08);color:#fff;border:1.5px solid rgba(255,255,255,.18);box-shadow:none}
.btn.ghost:hover{background:rgba(255,255,255,.16);border-color:rgba(255,255,255,.32)}

.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:18px}
.card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--r-lg);padding:20px;box-shadow:var(--shadow-sm)}
.card h3{font-size:16px;font-weight:700;margin-bottom:2px}
.card .sub{font-size:12px;color:var(--muted);margin-bottom:14px}
.field-row{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}
.field-row label{font-size:12px;color:var(--muted);flex-shrink:0}
.field-row select,.field-row input[type=text],.field-row input[type=number]{border:1.5px solid var(--border);border-radius:var(--r-sm);padding:6px 10px;font-size:13px;width:100%;max-width:190px}

textarea.field-textarea{width:100%;border:1.5px solid var(--border);border-radius:var(--r-sm);padding:8px 10px;font-size:13px;min-height:70px;resize:vertical;margin-top:6px}
.status-badge{display:inline-block;font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px}
.status-active{background:var(--green-bg);color:var(--green)}
.status-paused{background:var(--amber-bg);color:var(--amber)}
.status-done{background:var(--gray-bg);color:var(--gray)}
.status-overdue{background:var(--accent-bg);color:var(--red)}
.tasks-toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:14px}
.tasks-toolbar select{border:1.5px solid var(--border);border-radius:var(--r-sm);padding:8px 10px;font-size:13px;background:var(--white)}
.tasks-table td.task-text{white-space:normal;min-width:260px;max-width:460px}
.tasks-table tbody tr{cursor:default}
.tasks-table a{color:var(--red);text-decoration:none;font-weight:600}

/* Ratings + Analytics range nav */
.range-nav{display:flex;align-items:center;gap:14px;margin-bottom:22px;flex-wrap:wrap}
.range-nav .arrow{width:36px;height:36px;border-radius:50%;background:var(--white);border:1.5px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:17px;color:var(--text);flex-shrink:0;transition:all .15s}
.range-nav .arrow:hover{border-color:var(--red);color:var(--red)}
.range-nav .label{font-family:'Unbounded',sans-serif;font-size:14px;font-weight:800;background:var(--dark);color:#fff;padding:11px 24px;border-radius:30px;letter-spacing:.01em;min-width:150px;text-align:center}
.range-nav .today-btn{background:none;border:none;color:var(--red);font-size:12px;font-weight:700;text-decoration:underline;text-underline-offset:3px}
.range-nav .today-btn:hover{color:var(--red-dark)}

.rating-card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--r-xl);padding:22px 22px 6px;box-shadow:var(--shadow-sm)}
.rating-card-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:18px}
.rating-card-head h3{font-size:17px;font-weight:700}
.rating-card-head .avg-pill{display:inline-flex;align-items:center;background:var(--accent-bg);color:var(--red-dark);font-family:'Unbounded',sans-serif;font-size:13px;font-weight:800;padding:5px 13px;border-radius:20px;letter-spacing:.01em;flex-shrink:0;cursor:default}
.rater{padding:16px 0}
.rater + .rater{border-top:1px solid var(--border)}
.rater-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.rater-head .who{display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:700;color:var(--text)}
.rater-head .who .dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.rater-head .score-badge{font-family:'Unbounded',sans-serif;font-size:16px;font-weight:800;color:var(--red);min-width:24px;text-align:right}
.score-scale{display:grid;grid-template-columns:repeat(10,1fr);gap:5px;margin-bottom:10px}
.score-scale button{aspect-ratio:1;border-radius:8px;border:1.5px solid var(--border);background:var(--warm-bg);font-size:12px;font-weight:700;color:var(--muted);transition:all .12s}
.score-scale button:hover{border-color:var(--red-light);color:var(--red)}
.score-scale button.on{background:var(--red);border-color:var(--red);color:#fff;box-shadow:var(--shadow-red)}
textarea.rater-comment{width:100%;border:1.5px solid var(--border);border-radius:var(--r-sm);padding:9px 11px;font-size:13px;min-height:52px;resize:vertical}
textarea.rater-comment:focus{outline:none;border-color:var(--red-light)}

/* Analytics */
.analytics-toolbar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:22px}
.analytics-toolbar .range-nav{margin-bottom:0}
.analytics-right{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.analytics-right .month-toggle{margin-bottom:0}
#analyticsViewToggle{min-width:172px;text-align:center;flex-shrink:0}
.analytics-table-wrap{overflow-x:auto;border:1.5px solid var(--border);border-radius:var(--r-lg);background:var(--white);scrollbar-width:none;-ms-overflow-style:none}
.analytics-table-wrap::-webkit-scrollbar{display:none;height:0}
.analytics-table{border-collapse:collapse;width:100%;font-size:13px}
.analytics-table th{background:var(--dark);color:#fff;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;padding:13px 12px;text-align:left;white-space:nowrap}
.analytics-table td{padding:9px 12px;border-bottom:1px solid var(--border);white-space:nowrap}
.analytics-table tbody tr:last-child td{border-bottom:none}
.analytics-table tbody tr:hover{background:var(--warm-bg)}
.analytics-table td.name-cell,.analytics-table th.name-th{position:sticky;left:0;background:var(--white);font-weight:700;z-index:1;box-shadow:2px 0 6px rgba(0,0,0,.05)}
.analytics-table tbody tr:hover td.name-cell{background:var(--warm-bg)}
.analytics-table th.name-th{background:var(--dark);z-index:2}
.analytics-table th.group-divider,.analytics-table td.group-divider{border-left:2px solid var(--border)}
.analytics-table input{width:78px;border:1.5px solid var(--border);border-radius:6px;padding:6px 8px;font-size:13px;font-weight:600;cursor:auto}
.analytics-table input:focus{outline:none;border-color:var(--red-light)}
.analytics-table .derived{font-weight:700;color:var(--text)}
.analytics-table .derived.empty{color:var(--muted);font-weight:400}
.analytics-table .total-value{font-weight:700;color:var(--text)}
.analytics-table td.empty{color:var(--muted);text-align:center;white-space:normal;cursor:default}

/* Soft per-row status marker, cycled by clicking the row */
.analytics-table tbody tr.row-green{background:var(--green-bg)}
.analytics-table tbody tr.row-yellow{background:var(--amber-bg)}
.analytics-table tbody tr.row-red{background:var(--accent-bg)}
.analytics-table tbody tr.row-gray{background:var(--gray-bg)}
.analytics-table tbody tr.row-green td.name-cell{background:var(--green-bg)}
.analytics-table tbody tr.row-yellow td.name-cell{background:var(--amber-bg)}
.analytics-table tbody tr.row-red td.name-cell{background:var(--accent-bg)}
.analytics-table tbody tr.row-gray td.name-cell{background:var(--gray-bg)}

/* Hide the native up/down stepper on number inputs everywhere in the dashboard */
input[type=number]::-webkit-outer-spin-button,
input[type=number]::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
input[type=number]{-moz-appearance:textfield;appearance:textfield}

/* All-clients summary popup */
.summary-popup{position:fixed;top:78px;left:28px;z-index:950;background:var(--white);border:1.5px solid var(--border);border-radius:var(--r-lg);box-shadow:var(--shadow-md);padding:20px 22px;width:300px}
.summary-popup-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}
.summary-popup-head h4{font-family:'Unbounded',sans-serif;font-size:14px;font-weight:800}
.popup-close{background:none;border:none;font-size:20px;line-height:1;color:var(--muted);padding:0;width:26px;height:26px;border-radius:50%;flex-shrink:0}
.popup-close:hover{background:var(--warm-bg);color:var(--text)}
.summary-rows{display:flex;flex-direction:column;margin-bottom:16px}
.summary-row{display:flex;align-items:baseline;justify-content:space-between;gap:14px;padding:10px 0;border-bottom:1px solid var(--border)}
.summary-row:last-child{border-bottom:none;padding-bottom:0}
.summary-row .label{font-size:12.5px;color:var(--muted);font-weight:600}
.summary-row .value{font-family:'Unbounded',sans-serif;font-size:15px;font-weight:800;color:var(--text);text-align:right;white-space:nowrap}
.summary-row .value .derived{display:block;font-family:'Geologica',sans-serif;font-size:11px;font-weight:600;color:var(--red-dark);margin-top:2px}
#summaryCopyBtn{width:100%}

/* Avito "вчера" side panel (beta) */
.side-panel{position:fixed;top:78px;right:20px;bottom:20px;z-index:950;width:min(620px,calc(100vw - 32px));background:var(--white);border:1.5px solid var(--border);border-radius:var(--r-lg);box-shadow:var(--shadow-md);display:flex;flex-direction:column;overflow:hidden}
.side-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:18px 20px 12px;border-bottom:1px solid var(--border)}
.side-panel-head h4{font-family:'Unbounded',sans-serif;font-size:14px;font-weight:800}
.side-panel-head .sub{font-size:12px;color:var(--muted);margin-top:3px}
.beta-pill{display:inline-block;font-family:'Geologica',sans-serif;font-size:10px;font-weight:700;background:var(--accent-bg);color:var(--red-dark);padding:2px 8px;border-radius:20px;margin-left:6px;vertical-align:middle}
.side-panel-body{overflow:auto;flex:1}
.side-panel-foot{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;padding:12px 20px;border-top:1px solid var(--border)}
.mini-table{border-collapse:collapse;width:100%;font-size:13px}
.mini-table th{position:sticky;top:0;background:var(--dark);color:#fff;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;padding:10px;text-align:right;white-space:nowrap}
.mini-table th:first-child,.mini-table td:first-child{text-align:left}
.mini-table td{padding:8px 10px;border-bottom:1px solid var(--border);text-align:right;white-space:nowrap}
.mini-table td.muted{color:var(--muted);font-size:12px}
.mini-table tr.total td{font-weight:800;background:var(--warm-bg)}
.mini-table .warn{color:var(--amber);cursor:help;margin-left:4px}
.mini-table .src{display:block;font-size:10px;color:var(--muted);font-weight:400}

.modal.wide{max-width:720px;max-height:calc(100vh - 40px);overflow:auto}
.modal .hint{font-size:12px;color:var(--muted);line-height:1.5;margin-bottom:8px}
.modal textarea{width:100%;border:1.5px solid var(--border);border-radius:var(--r-sm);padding:9px 11px;font-size:12.5px;min-height:130px;font-family:ui-monospace,Menlo,monospace}
.modal .date-row{display:flex;gap:10px}
.modal .date-row>div{flex:1}
.link-list{border:1.5px solid var(--border);border-radius:var(--r-sm);max-height:260px;overflow:auto;margin-top:6px}
.link-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:7px 10px;border-bottom:1px solid var(--border);font-size:13px}
.link-row:last-child{border-bottom:none}
.link-row select{max-width:260px;padding:5px 8px;font-size:12px}
.import-result{font-size:12px;padding:4px 0}
.import-result.ok{color:var(--green)}
.import-result.bad{color:var(--red-dark)}
.job-status{margin-top:14px;padding:12px 14px;border-radius:var(--r-sm);background:var(--warm-bg);font-size:13px;line-height:1.5}
.job-status a{color:var(--red)}
.job-status ul{margin:6px 0 0 18px;font-size:12px;color:var(--amber)}

/* Modal */
#overlay{position:fixed;inset:0;background:rgba(10,10,10,0.5);z-index:1000;display:none;align-items:center;justify-content:center;padding:20px}
#overlay.open{display:flex}
.modal{background:#fff;border-radius:var(--r-lg);padding:26px;width:100%;max-width:380px;box-shadow:var(--shadow-md)}
.modal h3{font-family:'Unbounded',sans-serif;font-size:15px;margin-bottom:16px}
.modal label{display:block;font-size:12px;color:var(--muted);margin:10px 0 4px}
.modal input,.modal select{width:100%;border:1.5px solid var(--border);border-radius:var(--r-sm);padding:9px 11px;font-size:13px}
.modal .actions{display:flex;gap:8px;justify-content:flex-end;margin-top:20px}

.empty{color:var(--muted);font-size:13px;padding:20px;text-align:center}
/* Icons + icon buttons (top bar); labels hide on phones */
.ic{width:16px;height:16px;flex-shrink:0;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.top-actions .btn,.tab-btn{display:inline-flex;align-items:center;gap:7px}
.top-actions .btn{padding:9px 13px}
.icon-btn{background:none;border:1.5px solid var(--border);border-radius:var(--r-sm);width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;color:var(--muted);flex-shrink:0}
.icon-btn:hover{border-color:var(--red);color:var(--red)}
@media (max-width:760px){
  header.top{padding:12px 14px}
  .top-actions .btn .lbl,.tab-btn .lbl{display:none}
  .top-actions .btn{padding:9px 10px}
  .tab-btn{padding:10px 12px}
  main{padding:18px 14px 80px}
  .summary-popup{left:14px;right:14px;width:auto;top:70px}
  .side-panel{top:70px;right:8px;left:8px;width:auto}
}

/* Background-job notices (report export, Avito pull) — bottom right, stay until closed */
.notices{position:fixed;right:20px;bottom:20px;z-index:1050;display:flex;flex-direction:column;gap:10px;max-width:min(360px,calc(100vw - 32px))}
.notice{background:var(--white);border:1.5px solid var(--border);border-left:4px solid var(--amber);border-radius:var(--r-md);box-shadow:var(--shadow-md);padding:12px 14px;font-size:13px;line-height:1.45}
.notice.ok{border-left-color:var(--green)}
.notice.bad{border-left-color:var(--red)}
.notice-head{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
.notice-head b{font-size:13px}
.notice .popup-close{width:22px;height:22px;font-size:17px}
.notice-text{color:var(--muted);font-size:12px;margin-top:3px;white-space:pre-line}
.notice-actions{display:flex;gap:8px;margin-top:9px;flex-wrap:wrap}
.spin{display:inline-block;width:11px;height:11px;border:2px solid var(--border);border-top-color:var(--amber);border-radius:50%;animation:spin 1s linear infinite;margin-right:6px;vertical-align:-1px}
@keyframes spin{to{transform:rotate(360deg)}}

/* Project card: row colour for Analytics + inactive flag */
.swatches{display:flex;gap:6px}
.swatch{width:22px;height:22px;border-radius:50%;border:1.5px solid var(--border);padding:0}
.swatch.on{outline:2px solid var(--text);outline-offset:2px}
.swatch[data-color=""]{background:var(--white);background-image:linear-gradient(135deg,transparent 45%,var(--border) 45%,var(--border) 55%,transparent 55%)}
.swatch[data-color=green]{background:var(--green-bg);border-color:var(--green)}
.swatch[data-color=yellow]{background:var(--amber-bg);border-color:var(--amber)}
.swatch[data-color=red]{background:var(--accent-bg);border-color:var(--red)}
.swatch[data-color=gray]{background:var(--gray-bg);border-color:var(--gray)}
.card.inactive{opacity:.6}
.inactive-toggle{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--muted);margin-top:12px;cursor:pointer}
.analytics-table td.name-cell .inactive-tag{font-weight:400;font-size:11px;color:var(--muted);margin-left:6px}

.toast{position:fixed;bottom:20px;right:20px;background:var(--dark);color:#fff;padding:10px 18px;border-radius:var(--r-sm);font-size:13px;z-index:1100;opacity:0;transform:translateY(8px);transition:all .2s}
.toast.show{opacity:1;transform:translateY(0)}
</style>
</head>
<body>

<div id="gate">
  <div class="box">
    <h1>Дашборд руководителя</h1>
    <div class="err" id="gateErr"></div>
    <input type="password" id="gatePassword" placeholder="Пароль" autocomplete="off" autofocus>
    <button id="gateSubmit">Войти</button>
  </div>
</div>

<div id="app">
  <header class="top">
    <div class="top-actions" id="topActions"></div>
    <nav class="tabs">
      <button class="tab-btn active" data-tab="projects" title="Проекты"><svg class="ic" data-icon="folder"></svg><span class="lbl">Проекты</span></button>
      <button class="tab-btn" data-tab="analytics" title="Аналитика"><svg class="ic" data-icon="chart"></svg><span class="lbl">Аналитика</span></button>
      <button class="tab-btn" data-tab="ratings" title="Оценки"><svg class="ic" data-icon="star"></svg><span class="lbl">Оценки</span></button>
      <button class="tab-btn" data-tab="tasks" title="Задачи"><svg class="ic" data-icon="tasks"></svg><span class="lbl">Задачи</span></button>
    </nav>
  </header>

  <main>
    <!-- PROJECTS -->
    <section class="panel active" id="panel-projects">
      <div class="grid" id="projectsGrid"></div>
    </section>

    <!-- ANALYTICS -->
    <section class="panel" id="panel-analytics">
      <div class="analytics-toolbar">
        <div class="range-nav" id="analyticsRangeNav">
