// ══════════════════════ AVITO: ВЧЕРА (бета) ══════════════════════
// Yesterday's views / contacts / spend + current advance from every linked Avito cabinet.
// The pull runs on the server (and is prepared automatically every morning), so the panel
// just shows its state: press "Авито за вчера", go do something else, and a notice pops up
// when all cabinets are done — or reopen the panel later, the result is kept for the day.
let avitoLinks = null; // { accounts, links }
let avitoRows = {}; // projectId -> per-cabinet result from the pull
let avitoDate = null;
let avitoPull = null;
let avitoPollTimer = null;

async function loadAvitoLinks() {
  const res = await api('/api/dashboard/avito-links');
  if (res) avitoLinks = res;
  return avitoLinks;
}
function linkedAccountId(projectId) {
  const l = avitoLinks && avitoLinks.links.find((x) => x.projectId === projectId);
  return l ? l.accountId : null;
}

async function toggleAvitoPanel() {
  const panel = document.getElementById('avitoPanel');
  if (!panel.classList.contains('hidden')) { panel.classList.add('hidden'); return; }
  document.getElementById('summaryPopup').classList.add('hidden');
  panel.classList.remove('hidden');
  avitoDate = addDays(todayIso(), -1);
  renderAvitoPanel();
  await loadAvitoLinks();
  const res = await api(`/api/dashboard/avito-pull?date=${avitoDate}`);
  if (res && res.pull) {
    applyAvitoPull(res.pull);
    if (res.pull.status !== 'done') trackAvitoPull(res.pull.date); // e.g. the morning auto-pull still running
  } else startAvitoPull(false); // nothing prepared for yesterday yet — start it now
  renderAvitoPanel();
}

async function startAvitoPull(force) {
  avitoDate = addDays(todayIso(), -1);
  const res = await api('/api/dashboard/avito-pull', { method: 'POST', body: JSON.stringify({ date: avitoDate, force }) });
  if (res && res.pull) { applyAvitoPull(res.pull); trackAvitoPull(avitoDate); }
}

function applyAvitoPull(pull) {
  avitoPull = pull;
  avitoRows = pull.results || {};
  renderAvitoPanel();
}

// Polls the server-side pull until it's done, then leaves a notice with a short per-cabinet
// summary. Remembered in localStorage so a reload keeps tracking it.
function trackAvitoPull(date) {
  storedJob('dash_avito_pull', { date });
  clearTimeout(avitoPollTimer);
  const tick = async () => {
    const res = await api(`/api/dashboard/avito-pull?date=${date}`, {}, null, false);
    const pull = res && res.pull;
    if (!pull) { storedJob('dash_avito_pull', null); dismissNotice('avito'); return; }
    if (date === avitoDate) applyAvitoPull(pull);
    const total = Object.keys(pull.results || {}).length + (pull.pending || []).length;
    if (pull.status !== 'done') {
      notice('avito', { title: 'Авито за вчера: собираю данные', text: `Готово кабинетов: ${Object.keys(pull.results || {}).length} из ${total}. Можно работать в других разделах.`, busy: true });
      avitoPollTimer = setTimeout(tick, 5000);
      return;
    }
    storedJob('dash_avito_pull', null);
    const failed = Object.entries(pull.results || {}).filter(([, r]) => r.errors && r.errors.length);
    const nameOf = (id) => (state.projects.find((p) => p.id === id) || {}).name || id;
    notice('avito', {
      title: 'Авито за вчера: готово',
      kind: failed.length ? 'bad' : 'ok',
      text: failed.length
        ? `Получено: ${total - failed.length} из ${total}.\nС ошибками: ${failed.map(([id]) => nameOf(id)).join(', ')}`
        : `Все ${total} кабинетов загружены.`,
      actions: [{ label: 'Открыть', run: () => { dismissNotice('avito'); if (document.getElementById('avitoPanel').classList.contains('hidden')) openAnalyticsAnd(toggleAvitoPanel); } }],
    });
  };
  tick();
}

function openAnalyticsAnd(fn) {
  const tabBtn = document.querySelector('.tab-btn[data-tab="analytics"]');
  if (currentTab !== 'analytics') tabBtn.click();
  fn();
}

function renderAvitoPanel() {
  const table = document.getElementById('avitoPanelTable');
  const sub = document.getElementById('avitoPanelSub');
  const n = (v) => (v == null ? '—' : Math.round(v).toLocaleString('ru-RU'));
  const total = { views: 0, contacts: 0, spend: 0 };
  const pending = new Set((avitoPull && avitoPull.pending) || []);
  if (!avitoPull) sub.textContent = `${formatDayLabel(avitoDate || addDays(todayIso(), -1))} · загрузка…`;
  else if (avitoPull.status !== 'done') sub.textContent = `${formatDayLabel(avitoPull.date)} · собираю данные, можно закрыть окно — придёт уведомление`;
  else sub.textContent = `${formatDayLabel(avitoPull.date)} · собрано ${new Date(avitoPull.finishedAt).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' })}`;
  const rows = orderedAnalyticsProjects().map((p) => {
    const name = `${escapeHtml(p.name)}${isInactive(p) ? ' <span class="src">неактивный</span>' : ''}`;
    if (!avitoLinks) return `<tr><td>${name}</td><td colspan="4" class="muted">…</td></tr>`;
    if (!linkedAccountId(p.id)) return `<tr><td>${name}</td><td colspan="4" class="muted">кабинет не подключен</td></tr>`;
    const r = avitoRows[p.id];
    if (!r) return `<tr><td>${name}</td><td colspan="4" class="muted">${pending.has(p.id) ? 'в очереди…' : isInactive(p) ? 'не загружается' : '—'}</td></tr>`;
    ['views', 'contacts', 'spend'].forEach((k) => { if (r[k] != null) total[k] += r[k]; });
    const warn = r.errors && r.errors.length ? `<span class="warn" title="${escapeHtml(r.errors.join('\n'))}">⚠</span>` : '';
    const advance = r.advance != null
      ? `${n(r.advance)} ₽`
      : r.wallet != null ? `${n(r.wallet)} ₽<span class="src">кошелёк</span>` : '—';
    return `<tr><td>${name}${warn}</td><td>${n(r.views)}</td><td>${n(r.contacts)}</td><td>${r.spend == null ? '—' : `${n(r.spend)} ₽`}</td><td>${advance}</td></tr>`;
  });
  table.innerHTML = `
    <thead><tr><th>Клиент</th><th>Просмотры</th><th>Контакты</th><th>Бюджет</th><th>Аванс</th></tr></thead>
    <tbody>${rows.join('')}
      <tr class="total"><td>Итого</td><td>${n(total.views)}</td><td>${n(total.contacts)}</td><td>${n(total.spend)} ₽</td><td></td></tr>
    </tbody>`;
}

// Writes the pulled numbers into the Analytics table for that day (only fields Avito
// actually returned — a missing spend never overwrites a hand-entered budget with 0).
async function applyAvitoToTable() {
  const entries = Object.entries(avitoRows).filter(([, r]) => r && r.linked);
  if (!entries.length) { toast('Нечего вносить'); return; }
  if (!confirm(`Внести просмотры, контакты и бюджет за ${formatDayLabel(avitoDate)} в таблицу аналитики? Уже внесённые за этот день значения будут заменены.`)) return;
  let saved = 0;
  for (const [projectId, r] of entries) {
    const body = { projectId, date: avitoDate };
    if (r.views != null) body.views = r.views;
    if (r.contacts != null) body.contacts = r.contacts;
    if (r.spend != null) body.budget = r.spend;
    if (Object.keys(body).length === 2) continue;
    const res = await api('/api/dashboard/daily-metric', { method: 'POST', body: JSON.stringify(body) });
    if (res && res.dailyMetric) {
      state.dailyMetrics = state.dailyMetrics.filter((m) => !(m.projectId === projectId && m.date === avitoDate));
      state.dailyMetrics.push(res.dailyMetric);
      saved += 1;
    }
  }
  currentAnalyticsDay = avitoDate || currentAnalyticsDay;
  renderAnalytics();
  toast(`Внесено клиентов: ${saved}`);
}

document.getElementById('avitoPanelClose').addEventListener('click', () => document.getElementById('avitoPanel').classList.add('hidden'));
document.getElementById('avitoPanelRefresh').addEventListener('click', () => {
  if (avitoPull && avitoPull.status !== 'done') { toast('Уже собираю — дождитесь уведомления'); return; }
  startAvitoPull(true);
});
document.getElementById('avitoPanelSettings').addEventListener('click', () => openAvitoKeysModal());
document.getElementById('avitoPanelApply').addEventListener('click', applyAvitoToTable);

