html{scroll-behavior:smooth}
body{font-family:'Geologica',sans-serif;color:var(--text);background:var(--bg);line-height:1.65;-webkit-font-smoothing:antialiased}

a{color:var(--red)}
svg{display:block}

/* INTRO / CHECKLIST */
.intro{max-width:820px;margin:0 auto;padding:40px 24px 0}
.intro-card{background:var(--white);border:1px solid var(--border);border-radius:var(--r-xl);padding:32px 36px;box-shadow:var(--shadow-sm)}
.intro-badge{display:inline-flex;align-items:center;gap:8px;background:var(--dark);color:#fff;border-radius:100px;padding:6px 16px;font-size:11px;font-weight:600;margin-bottom:16px;letter-spacing:.04em;text-transform:uppercase}
.intro-badge-dot{width:5px;height:5px;border-radius:50%;background:var(--red-light)}
.intro-card > p{font-size:15.5px;color:var(--text);margin-bottom:20px}
.checklist-title{font-size:12.5px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:12px}
.checklist{list-style:none;display:flex;flex-direction:column;gap:11px}
.checklist li{display:flex;gap:12px;align-items:flex-start;font-size:15px;color:var(--text)}
.checklist li::before{content:"✓";flex:0 0 22px;height:22px;width:22px;border-radius:50%;background:var(--accent-bg);color:var(--red);font-weight:700;font-size:12px;line-height:22px;text-align:center;margin-top:1px}

/* FAQ */
.faq{max-width:820px;margin:0 auto;padding:26px 24px 0}
.faq h2{font-family:'Unbounded',sans-serif;font-size:16px;font-weight:800;color:var(--dark);margin-bottom:12px;letter-spacing:-0.01em}
.faq-item{background:var(--white);border:1px solid var(--border);border-radius:var(--r-md);margin-bottom:8px;overflow:hidden}
.faq-item summary{padding:15px 20px;font-size:14px;font-weight:700;color:var(--dark2);cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:12px}
.faq-item summary::-webkit-details-marker{display:none}
.faq-item summary::after{content:"+";color:var(--muted);font-size:18px;font-weight:400;flex:0 0 auto}
.faq-item[open] summary::after{content:"–"}
.faq-item p{padding:0 20px 16px;font-size:14px;color:var(--muted);line-height:1.7}
.faq-item p + p{padding-top:0}
.faq-item ol,.faq-item ul{margin:0 20px 16px 36px;padding:0;color:var(--muted);font-size:14px;line-height:1.7}
.faq-item li{margin-bottom:6px}
.faq-item strong{color:var(--dark2)}

/* TABS */
.tabs-wrap{position:sticky;top:0;background:var(--bg);z-index:40;border-bottom:1px solid var(--border);padding-top:28px;margin-top:8px}
.tabs{max-width:1000px;margin:0 auto;display:flex;justify-content:center;gap:6px;overflow-x:auto;padding:0 20px 10px;scrollbar-width:thin}
.tabs::-webkit-scrollbar{height:5px}
