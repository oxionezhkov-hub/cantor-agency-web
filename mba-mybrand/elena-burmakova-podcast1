.tab-btn:hover{color:var(--dark);border-color:#c9c6c0}
.tab-btn.active{background:var(--dark);color:#fff;border-color:var(--dark)}
.tab-btn svg{flex:0 0 auto}
.tabs-row2 .tab-btn{font-size:12.5px;padding:8px 16px}

