.kit-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:34px 0 14px}
.doc-card > .kit-head:first-child{margin-top:8px}
.kit-head h3{font-family:'Unbounded',sans-serif;font-size:18px;font-weight:700;color:var(--dark);letter-spacing:-0.01em;margin:0}

/* TELEGRAM POSTS */
.tg-card{background:var(--white);border:1px solid var(--border);border-radius:var(--r-xl);box-shadow:var(--shadow-sm);overflow:hidden}
.tg-topbar{display:flex;align-items:center;justify-content:space-between;background:var(--dark);padding:12px 20px;gap:10px}
