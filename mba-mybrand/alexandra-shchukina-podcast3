.tg-body h4{font-size:15.5px;font-weight:700;font-style:italic;color:var(--text);margin:18px 0 8px}
.tg-body p{font-size:15.5px;color:var(--text);margin-bottom:12px;white-space:pre-line}
.tg-body p:last-child{margin-bottom:0}
