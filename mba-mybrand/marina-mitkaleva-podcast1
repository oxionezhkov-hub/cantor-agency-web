  --red-dark:#C42D13;
  --red-light:#FF6347;
  --dark:#0F0F0F;
  --dark2:#1A1A1A;
  --text:#1C1C1C;
  --muted:#787672;
  --bg:#F6F5F2;
  --white:#FFFFFF;
  --border:#E2E0DC;
  --accent-bg:#FFF3F0;
  --shadow-sm:0 2px 8px rgba(0,0,0,0.06);
  --shadow-md:0 12px 40px rgba(0,0,0,0.1);
