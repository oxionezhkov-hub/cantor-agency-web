// Основной канал — функция в Yandex Cloud (см. yc-adviser-anketa-form/README.md):
// доступна из РФ и с VPN, и без.
const YC_FUNCTION_URL = 'https://functions.yandexcloud.net/d4edd523l7k6ujsjso9i';
// Запасной канал — напрямую в Google Apps Script.
const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzPk5CHyT_oDsWYZINg_bQTwXg64tJr4-3PugEpi_KU-56ix1lwTmdkkKIUOB-fAOOXeg/exec?sheet=ЭДВАЙЗЕРЫ';

// Одна колонка на направление (по id, не по названию) — порядок стабилен
// независимо от того, что человек отметил в анкете.
function collectFields() {
  const name = document.getElementById('f-name').value.trim();
  const phone = document.getElementById('f-phone').value.trim();
  const tg = document.getElementById('f-tg').value.trim();
  const checked = getCheckedChannels();

  const fields = {
    timestamp: new Date().toLocaleString('ru-RU'),
    name,
    telegram: tg,
    phone,
    channels: checked.map(c => c.name).join(', '),
  };
  checked.forEach(ch => {
    fields['result_' + ch.id] = document.getElementById('res-' + ch.id)?.value?.trim() || '';
  });
  return fields;
}

// 1) Яндекс-функция: успех, только если она ответила {ok:true}.
function sendToYandex(fields) {
  if (!YC_FUNCTION_URL) return Promise.reject(new Error('yc_not_configured'));
  const ctrl = typeof AbortController !== 'undefined' ? new AbortController() : null;
  const timer = ctrl ? setTimeout(() => ctrl.abort(), 12000) : null;
  return fetch(YC_FUNCTION_URL, {
    method: 'POST',
    // text/plain — «простой» запрос без CORS-preflight; функция всё равно парсит тело как JSON.
    headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
    body: JSON.stringify({ fields }),
    signal: ctrl ? ctrl.signal : undefined
  })
    .then(r => r.json().catch(() => ({})).then(data => {
      if (!r.ok || !data.ok) throw new Error('yc_failed_' + r.status);
    }))
    .finally(() => { if (timer) clearTimeout(timer); });
}

// 2) Запасной канал — напрямую в Apps Script.
// Apps Script always answers through a script.googleusercontent.com redirect, and reading
// that response back can fail intermittently in some browsers even though the write itself
// already happened server-side. Firing with no-cors and treating any resolved request as
// success avoids showing users a scary error for a submission that actually went through.
function sendToAppsScript(fields) {
  const fd = new FormData();
  Object.keys(fields).forEach(k => fd.append(k, fields[k]));
  return fetch(APPS_SCRIPT_URL, { method: 'POST', mode: 'no-cors', body: fd });
}

// Тексты вопросов в порядке анкеты — для копирования / .doc, если отправка не удалась.
// Направления результатов подставляются динамически, по факту того, что отметил человек.
function answersQuestions(fields) {
  const questions = [
    ['name', 'Имя'],
    ['telegram', 'Telegram'],
    ['phone', 'Телефон'],
    ['channels', 'Направления'],
  ];
  CHANNELS.forEach(ch => {
    if (fields['result_' + ch.id]) questions.push(['result_' + ch.id, 'Результаты — ' + ch.name]);
  });
  return questions;
}

function answersText(fields) {
  const lines = ['Анкета эдвайзера — Cantor Agency', ''];
  answersQuestions(fields).forEach(([key, q]) => {
    lines.push(q);
    lines.push(fields[key] ? fields[key] : '—');
    lines.push('');
  });
  return lines.join('\n').trim();
}

function escapeHtml(str) {
  return String(str).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
}

// Word-совместимый .doc (HTML внутри) — открывается в Word, Google Docs, Pages.
function downloadAnswers() {
  const fields = lastFields || collectFields();
  const rows = answersQuestions(fields).map(([key, q]) =>
    '<p style="margin:0 0 4px"><b>' + escapeHtml(q) + '</b></p>' +
    '<p style="margin:0 0 14px;white-space:pre-wrap">' + escapeHtml(fields[key] || '—') + '</p>'
  ).join('');
  const html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word"><head><meta charset="utf-8"><title>Анкета эдвайзера</title></head>' +
    '<body style="font-family:Arial,sans-serif;font-size:12pt"><h2>Анкета эдвайзера — Cantor Agency</h2>' +
    '<p style="color:#666">' + escapeHtml(fields.timestamp || '') + '</p>' + rows +
    '<p style="color:#666">Отправьте этот файл Олегу Ежкову в Telegram: https://t.me/oleg_ezhkov</p></body></html>';
  const blob = new Blob(['﻿', html], { type: 'application/msword' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  // Латиница: часть браузеров заменяет кириллическое имя файла на «download».
  a.download = 'Cantor_Adviser_anketa.doc';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}

function copyAnswers() {
  const text = answersText(lastFields || collectFields());
  const done = ok => {
    document.getElementById('sf-copied').textContent = ok
      ? '✓ Ответы скопированы — вставьте их в чат с Олегом'
      : 'Не получилось скопировать автоматически — выделите текст ниже и скопируйте вручную';
  };
  const legacy = () => {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    let ok = false;
    try { ok = document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta);
    done(ok);
  };
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(text).then(() => done(true), legacy);
  } else {
    legacy();
  }
}

function showSendFailed(fields) {
  document.getElementById('adviser-form').style.display = 'none';
  document.getElementById('sf-answers').textContent = answersText(fields);
  document.getElementById('sf-copied').textContent = '';
  document.getElementById('send-failed').classList.add('active');
  document.getElementById('send-failed').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function retrySubmit() {
  document.getElementById('send-failed').classList.remove('active');
  document.getElementById('adviser-form').style.display = '';
  submitForm();
}

let lastFields = null;

async function submitForm() {
  // Validate step 3
  const name = document.getElementById('f-name').value.trim();
  const phone = document.getElementById('f-phone').value.trim();
  const tg = document.getElementById('f-tg').value.trim();

  document.getElementById('name-error').classList.toggle('show', !name);
  document.getElementById('phone-error').classList.toggle('show', !phone);
  document.getElementById('tg-error').classList.toggle('show', !tg);
  if (!name || !phone || !tg) {
    document.getElementById('error-banner').classList.add('show');
    return;
  }
  document.getElementById('error-banner').classList.remove('show');

  const btn = document.getElementById('submit-btn');
  btn.disabled = true;
  document.getElementById('loading-overlay').classList.add('active');

  const fields = collectFields();
  lastFields = fields;

  try {
    await sendToYandex(fields);
  } catch (ycErr) {
    console.warn('yc_send_failed', ycErr);
    try {
      await sendToAppsScript(fields);
    } catch (asErr) {
      document.getElementById('loading-overlay').classList.remove('active');
      btn.disabled = false;
      showSendFailed(fields);
      return;
    }
  }

  document.getElementById('loading-overlay').classList.remove('active');
  document.getElementById('main-page').style.display = 'none';
  document.getElementById('thank-you').classList.add('show');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

document.getElementById('adviser-form').addEventListener('submit', (e) => {
  e.preventDefault();
  submitForm();
});

// ── INIT ──
renderChannels();
</script>
