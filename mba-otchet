<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="robots" content="noindex, nofollow">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Отчёт о прогрессе МБА | Cantor Agency</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;600;700&family=Geologica:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="icon" type="image/svg+xml" href="/Frame 1000011449.svg">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --red:#E8391D;--red-dark:#C42D13;--dark:#0F0F0F;--dark2:#1A1A1A;
  --text:#1C1C1C;--muted:#787672;--bg:#F6F5F2;--white:#fff;--border:#E2E0DC;--soft:#FFF3F0;
  --g:#1E9E5A;--y:#E9A216;--r:#DB3A2A;
  --g-bg:#E7F6EE;--y-bg:#FDF3DC;--r-bg:#FCE7E4;
  --track:#ECEAE5;
}
html{scroll-behavior:smooth}
body{font-family:'Geologica',sans-serif;color:var(--text);background:var(--bg);line-height:1.55;-webkit-font-smoothing:antialiased}
.wrap{max-width:1080px;margin:0 auto;padding:20px 16px 72px}
h1,h2,h3,.num{font-family:'Unbounded',sans-serif}
section{margin-top:36px}
.sec-h{display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px}
.sec-h h2{font-size:19px;line-height:1.25}
.sec-h .hint{font-size:13px;color:var(--muted)}

/* editable */
.ed{border-radius:6px;padding:0 3px;margin:0 -3px;cursor:text;transition:background .15s;outline:none;display:inline-block}
.ed:empty{min-width:70px}
.ed:hover{background:rgba(232,57,29,.09);box-shadow:0 0 0 1px rgba(232,57,29,.25)}
.ed[contenteditable="true"]{background:#fff;box-shadow:0 0 0 2px var(--red);color:var(--text)}
.ed:empty::before{content:attr(data-ph);color:#B0ADA6;font-weight:400;font-style:italic}
.hero .ed:hover{background:rgba(255,255,255,.12);box-shadow:0 0 0 1px rgba(255,255,255,.3)}
.hero .ed[contenteditable="true"]{background:#fff;color:#111}
.hero .ed:empty::before{color:#8d8a84}

/* hero */
.hero{background:var(--dark);color:#fff;border-radius:22px;padding:30px 28px;display:grid;grid-template-columns:auto 1fr;gap:28px;align-items:center}
.ring{position:relative;width:170px;height:170px}
.ring svg{transform:rotate(-90deg)}
.ring .val{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.ring .val b{font-family:'Unbounded',sans-serif;font-size:38px;line-height:1}
.ring .val small{font-size:12px;color:#B8B5AE;margin-top:6px}
.hero h1{font-size:26px;line-height:1.2;margin-bottom:6px}
.hero .sub{color:#B8B5AE;font-size:14px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-top:20px}
.kpi{background:var(--dark2);border:1px solid #2a2a2a;border-radius:14px;padding:12px 14px}
.kpi .k{font-size:12px;color:#B8B5AE}
.kpi .v{font-family:'Unbounded',sans-serif;font-size:22px;margin-top:2px}
.kpi .v.small{font-size:15px;padding-top:6px}
.hero-note{margin-top:14px;font-size:14px;color:#D8D5CE}
.hero-note b{color:#fff;font-weight:500}

/* generic card */
.card{background:var(--white);border:1px solid var(--border);border-radius:16px;padding:18px;box-shadow:0 2px 8px rgba(0,0,0,.04)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:14px}

/* progress bars */
.bar{height:10px;background:var(--track);border-radius:999px;overflow:hidden}
.bar>i{display:block;height:100%;border-radius:999px;transition:width .5s}
.g>i{background:var(--g)}.y>i{background:var(--y)}.r>i{background:var(--r)}
.pct{font-family:'Unbounded',sans-serif;font-weight:600;font-size:15px;white-space:nowrap}
.pct.g{color:var(--g)}.pct.y{color:#B97E00}.pct.r{color:var(--r)}
.pct.auto-off::after{content:"•";color:var(--red);margin-left:2px;font-size:12px}
.row-bar{display:flex;align-items:center;gap:12px}
.row-bar .bar{flex:1}

/* task cards */
.task h3{font-size:14px;margin-bottom:10px;line-height:1.3}
.task .top{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.task .cnt{font-size:12px;color:var(--muted);margin:6px 0 10px}
.stages{display:grid;gap:5px;margin:2px 0 10px}
.stage{display:grid;grid-template-columns:110px 1fr 54px;gap:8px;align-items:center;font-size:12.5px}
.stage .bar{height:6px}
.stage .n{text-align:right;color:var(--muted);font-variant-numeric:tabular-nums}
.meta{display:grid;gap:4px;font-size:13px;border-top:1px dashed var(--border);padding-top:10px;margin-top:auto}
.meta .l{color:var(--muted)}
.task{display:flex;flex-direction:column}

/* problems */
.prob{display:flex;gap:10px;align-items:flex-start;padding:10px 0;border-bottom:1px solid var(--border);font-size:14px}
.prob:last-child{border-bottom:0}
.lvl{flex-shrink:0;border:0;border-radius:999px;padding:2px 10px;font:600 11px 'Geologica',sans-serif;cursor:pointer;margin-top:2px}
.lvl.c{background:var(--r-bg);color:var(--r)}.lvl.w{background:var(--y-bg);color:#9A6B00}.lvl.o{background:var(--g-bg);color:var(--g)}
.prob .t{flex:1}
.x{border:0;background:none;color:#B0ADA6;font-size:20px;line-height:1;cursor:pointer;padding:0 4px}
.x:hover{color:var(--r)}
.add{margin-top:10px;background:var(--soft);color:var(--red-dark);border:1px dashed rgba(232,57,29,.4);border-radius:10px;padding:8px 14px;font:500 13px 'Geologica',sans-serif;cursor:pointer}
.add:hover{background:#ffe6e0}
.risk-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:10px}
.risk{background:var(--r-bg);border-radius:12px;padding:10px 12px;font-size:13px}
.risk b{display:block;font-weight:600;margin-bottom:2px}
.risk span{color:#6b3b35}
.subh{font-size:13px;color:var(--muted);margin:16px 0 8px;font-weight:500}

/* finance */
.fin{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:14px}
.fin .box{background:var(--bg);border-radius:12px;padding:14px}
.fin .k{font-size:12px;color:var(--muted)}
.fin .v{font-family:'Unbounded',sans-serif;font-size:22px;margin-top:2px}
.exp{display:grid;grid-template-columns:1fr auto 26px;gap:10px;align-items:center;padding:9px 0;border-bottom:1px solid var(--border);font-size:14px}
.exp:last-of-type{border-bottom:0}
.exp .amt{font-variant-numeric:tabular-nums;font-weight:500}

/* clients */
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--muted)}
.legend span::before{content:"";display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px;vertical-align:-1px}
.legend .lg::before{background:var(--g)}.legend .ly::before{background:var(--y)}.legend .lr::before{background:var(--r)}
.cl{display:grid;grid-template-columns:26px minmax(150px,1.1fr) minmax(190px,1.3fr) minmax(200px,1.6fr);gap:10px 16px;align-items:center;padding:12px 0;border-bottom:1px solid var(--border)}
.cl:last-child{border-bottom:0}
.rank{font-family:'Unbounded',sans-serif;font-size:12px;color:#B0ADA6}
.cl .name{font-weight:500;font-size:14.5px;line-height:1.3}
.chips{display:flex;gap:4px;flex-wrap:wrap;margin-top:5px}
.chip{font-size:10.5px;border-radius:6px;padding:1px 6px;background:var(--track);color:#8a877f;font-weight:500}
.chip.d{background:var(--g-bg);color:var(--g)}.chip.p{background:var(--y-bg);color:#9A6B00}
.tag-risk{font-size:10.5px;background:var(--r-bg);color:var(--r);border-radius:6px;padding:1px 6px;font-weight:600;margin-left:6px;vertical-align:1px}
.cl .side{font-size:13px;display:grid;gap:3px}
.cl .side .l{color:var(--muted)}
.cl .side .nt{color:#4a4741}

.toast{position:fixed;right:16px;bottom:16px;background:var(--dark);color:#fff;border-radius:10px;padding:9px 14px;font-size:13px;opacity:0;transform:translateY(8px);transition:.25s;pointer-events:none;z-index:9}
.toast.on{opacity:1;transform:none}
.toast.err{background:var(--r)}
.loading{padding:80px 0;text-align:center;color:var(--muted)}

@media(max-width:760px){
  .hero{grid-template-columns:1fr;justify-items:start;padding:22px 18px}
  .hero h1{font-size:21px}
  .cl{grid-template-columns:24px 1fr}
  .cl .barcol,.cl .side{grid-column:1 / -1}
  .stage{grid-template-columns:96px 1fr 50px}
}
</style>
</head>
<body>
<div class="wrap" id="app"><div class="loading">Загружаем данные CRM…</div></div>
<div class="toast" id="toast"></div>

<script>
var API='https://mainweb.oxion-ezhkov.workers.dev';
var STAGES=[['date','Дата назначена'],['script','Сценарий'],['recording','Запись'],['editing','Монтаж'],['texts','Тексты']];
var TASKS=[
  {id:'brief',label:'Собран бриф',type:'single'},
  {id:'serp',label:'Анализ поисковой выдачи',type:'single'},
  {id:'podcast1',label:'Подкаст 1',type:'group'},
  {id:'podcast2',label:'Подкаст 2',type:'group'},
  {id:'podcast3',label:'Подкаст 3',type:'group'},
  {id:'site',label:'Личный сайт',type:'single'}
];
var CHIPS=[['brief','Бриф'],['serp','Выдача'],['podcast1','П1'],['podcast2','П2'],['podcast3','П3'],['site','Сайт']];
var CLIENT=null,R=null,pw='';
try{pw=localStorage.getItem('mba_otchet_pw')||''}catch(e){}

function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
function defaults(){return{title:'Отчёт о прогрессе работ',subtitle:'МБА «Личный бренд» · Cantor Agency',
  overall:{eta:'',note:'',override:null},tasks:{},clients:{},problems:[],
  finance:{paid:null,paidNote:'',expenses:[]}}}
function getP(o,path){return path.split('.').reduce(function(a,k){return a==null?undefined:a[k]},o)}
function setP(o,path,v){var ks=path.split('.');var last=ks.pop();var cur=o;ks.forEach(function(k){if(cur[k]==null||typeof cur[k]!=='object')cur[k]={};cur=cur[k]});cur[last]=v}
function col(p){return p>=70?'g':p>=30?'y':'r'}
function money(n){return n==null||n===''?'':Number(n).toLocaleString('ru-RU')+' ₽'}
function isDone(t,id,sub){var x=t&&t[id];if(sub)x=x&&x[sub];return !!(x&&x.done)}

/* ---- compute ---- */
function clientStats(c){
  var t=c.tasks||{};var done=0,total=0,chips={};
  TASKS.forEach(function(k){
    if(k.type==='single'){total++;var d=isDone(t,k.id);if(d)done++;chips[k.id]=d?2:0}
    else{var n=0;STAGES.forEach(function(s){total++;if(isDone(t,k.id,s[0])){done++;n++}});chips[k.id]=n===5?2:(n>0?1:0)}
  });
  return{pct:Math.round(done/total*100),chips:chips};
}
function taskStats(id){
  var list=CLIENT,N=list.length||1;
  var t=TASKS.filter(function(x){return x.id===id})[0];
  if(t.type==='single'){var n=list.filter(function(c){return isDone(c.tasks,id)}).length;return{pct:Math.round(n/N*100),count:n,N:N}}
  var st=STAGES.map(function(s){var n=list.filter(function(c){return isDone(c.tasks,id,s[0])}).length;return{key:s[0],label:s[1],n:n,pct:Math.round(n/N*100)}});
  var avg=Math.round(st.reduce(function(a,b){return a+b.pct},0)/st.length);
  return{pct:avg,stages:st,N:N,count:st[4].n}
}
function shown(auto,ov){return typeof ov==='number'&&!isNaN(ov)?ov:auto}

/* ---- render ---- */
function ed(path,val,ph,type){return '<span class="ed" data-path="'+esc(path)+'" data-ph="'+esc(ph||'кликните, чтобы указать')+'" data-type="'+(type||'text')+'">'+esc(val)+'</span>'}
function pctEd(path,auto,ov){var v=shown(auto,ov);var off=typeof ov==='number';
  return '<span class="pct '+col(v)+(off?' auto-off':'')+'" title="'+(off?'Значение задано вручную (в CRM '+auto+'%). Очистите, чтобы вернуть авто.':'Считается из CRM. Кликните, чтобы задать вручную.')+'"><span class="ed" data-path="'+esc(path)+'" data-type="pct" data-auto="'+auto+'" data-ph="авто">'+v+'</span>%</span>'}
function bar(v){return '<div class="bar '+col(v)+'"><i style="width:'+Math.max(0,Math.min(100,v))+'%"></i></div>'}

function render(){
  var N=CLIENT.length;
  var cs=CLIENT.map(function(c){var s=clientStats(c);var o=getP(R,'clients.'+c.id)||{};return{c:c,auto:s.pct,pct:shown(s.pct,o.override),ov:o.override,chips:s.chips,o:o}});
  var autoAvg=Math.round(cs.reduce(function(a,b){return a+b.auto},0)/(N||1));
  var overall=shown(autoAvg,R.overall.override);
  var risk=CLIENT.filter(function(c){return c.problem});
  var recs=0,texts=0;CLIENT.forEach(function(c){[1,2,3].forEach(function(i){if(isDone(c.tasks,'podcast'+i,'recording'))recs++;if(isDone(c.tasks,'podcast'+i,'texts'))texts++})});
  var circ=2*Math.PI*74,dash=circ*overall/100;
  var h='';
  h+='<div class="hero"><div class="ring"><svg width="170" height="170" viewBox="0 0 170 170"><circle cx="85" cy="85" r="74" fill="none" stroke="#2a2a2a" stroke-width="14"/><circle cx="85" cy="85" r="74" fill="none" stroke="'+({g:'#2DBE73',y:'#F2B33A',r:'#F0523F'})[col(overall)]+'" stroke-width="14" stroke-linecap="round" stroke-dasharray="'+dash+' '+circ+'"/></svg><div class="val"><b>'+overall+'%</b><small>общий прогресс</small></div></div>';
  h+='<div><h1>'+ed('title',R.title,'Название отчёта')+'</h1><div class="sub">'+ed('subtitle',R.subtitle,'Подзаголовок')+' · данные CRM на '+new Date().toLocaleDateString('ru-RU')+'</div>';
  h+='<div class="kpis"><div class="kpi"><div class="k">Клиентов в проекте</div><div class="v">'+N+'</div></div>'
    +'<div class="kpi"><div class="k">Подкастов записано</div><div class="v">'+recs+'</div></div>'
    +'<div class="kpi"><div class="k">Подкастов с готовыми текстами</div><div class="v">'+texts+'</div></div>'
    +'<div class="kpi"><div class="k">Клиентов в риске</div><div class="v">'+risk.length+'</div></div>'
    +'<div class="kpi"><div class="k">Проект будет завершён</div><div class="v small">'+ed('overall.eta',R.overall.eta,'укажите срок')+'</div></div></div>';
  h+='<div class="hero-note"><b>Комментарий:</b> '+ed('overall.note',R.overall.note,'общий комментарий по проекту')+'</div>';
  h+='<div class="hero-note" style="font-size:12px;color:#8d8a84">Общий процент'+(typeof R.overall.override==='number'?' (задан вручную, в CRM '+autoAvg+'%)':' считается как средний по клиентам')+': <span class="ed" data-path="overall.override" data-type="pct" data-auto="'+autoAvg+'" data-ph="авто" style="color:#ddd">'+(typeof R.overall.override==='number'?R.overall.override:autoAvg)+'</span>%</div>';
  h+='</div></div>';

  /* tasks */
  h+='<section><div class="sec-h"><h2>Прогресс по задачам</h2><span class="hint">Доля клиентов, у которых задача выполнена. Срок и комментарий редактируются кликом.</span></div><div class="grid">';
  TASKS.forEach(function(t){
    var s=taskStats(t.id);var o=getP(R,'tasks.'+t.id)||{};var v=shown(s.pct,o.override);
    h+='<div class="card task"><div class="top"><h3>'+esc(t.label)+'</h3>'+pctEd('tasks.'+t.id+'.override',s.pct,o.override)+'</div>'+bar(v);
    if(t.type==='group'){
      h+='<div class="cnt">материалы готовы у '+s.count+' из '+s.N+' клиентов</div><div class="stages">';
      s.stages.forEach(function(x){h+='<div class="stage"><span>'+x.label+'</span>'+bar(x.pct)+'<span class="n">'+x.n+'/'+s.N+'</span></div>'});
      h+='</div>';
    }else h+='<div class="cnt">выполнено у '+s.count+' из '+s.N+' клиентов</div>';
    h+='<div class="meta"><div><span class="l">Будет готово:</span> '+ed('tasks.'+t.id+'.eta',o.eta,'укажите срок')+'</div><div><span class="l">Комментарий:</span> '+ed('tasks.'+t.id+'.note',o.note,'—')+'</div></div></div>';
  });
  h+='</div></section>';

  /* problems */
  h+='<section><div class="sec-h"><h2>Проблемы</h2><span class="hint">Отметка кликом меняет уровень, крестик удаляет</span></div><div class="card">';
  var LV={c:['Критично','c'],w:['Важно','w'],o:['Наблюдаем','o']};
  if(!R.problems.length)h+='<div style="color:var(--muted);font-size:14px;padding:4px 0">Проблемы проекта пока не добавлены.</div>';
  R.problems.forEach(function(p,i){h+='<div class="prob"><button class="lvl '+p.level+'" data-lvl="'+i+'">'+LV[p.level][0]+'</button><div class="t">'+ed('problems.'+i+'.text',p.text,'опишите проблему')+'</div><button class="x" data-del="problems:'+i+'" title="Удалить">×</button></div>'});
  h+='<button class="add" data-add="problems">+ Добавить проблему</button>';
  h+='<div class="subh">Клиенты в риске по данным CRM ('+risk.length+')</div><div class="risk-list">';
  risk.forEach(function(c){h+='<div class="risk"><b>'+esc(c.name||c.email)+'</b><span>'+esc(c.problemComment||'без комментария')+'</span></div>'});
  if(!risk.length)h+='<div style="color:var(--muted);font-size:14px">Нет клиентов, помеченных проблемными.</div>';
  h+='</div></div></section>';

  /* finance */
  var fin=R.finance,spent=fin.expenses.reduce(function(a,b){return a+(Number(b.amount)||0)},0);
  var paid=Number(fin.paid)||0;var left=paid-spent;var share=paid>0?Math.round(spent/paid*100):0;
  var fcol=share<70?'g':share<=95?'y':'r';
  h+='<section><div class="sec-h"><h2>Финансы</h2><span class="hint">Все суммы редактируются кликом</span></div><div class="card"><div class="fin">'
   +'<div class="box"><div class="k">Оплатил МБА (изначально)</div><div class="v">'+ed('finance.paid',fin.paid==null?'':money(fin.paid),'укажите сумму','money')+'</div></div>'
   +'<div class="box"><div class="k">Затраты на проект</div><div class="v">'+(spent?money(spent):'0 ₽')+'</div></div>'
   +'<div class="box"><div class="k">Остаток</div><div class="v" style="color:var(--'+(left<0?'r':'g')+')">'+(paid?money(left):'—')+'</div></div></div>';
  h+='<div class="row-bar" style="margin-bottom:6px"><div class="bar '+fcol+'"><i style="width:'+Math.min(100,share)+'%"></i></div><span class="pct '+fcol+'">'+share+'%</span></div><div style="font-size:12px;color:var(--muted);margin-bottom:8px">доля оплаты, уже потраченная на проект</div>';
  h+='<div style="font-size:13px;margin:6px 0 4px"><span style="color:var(--muted)">Примечание к оплате:</span> '+ed('finance.paidNote',fin.paidNote,'например: договор, этапы оплаты')+'</div>';
  h+='<div class="subh">Статьи затрат</div>';
  if(!fin.expenses.length)h+='<div style="color:var(--muted);font-size:14px;padding:4px 0">Статьи затрат пока не добавлены.</div>';
  fin.expenses.forEach(function(e,i){h+='<div class="exp"><div>'+ed('finance.expenses.'+i+'.name',e.name,'статья затрат')+'</div><div class="amt">'+ed('finance.expenses.'+i+'.amount',e.amount==null||e.amount===''?'':money(e.amount),'сумма','money')+'</div><button class="x" data-del="finance.expenses:'+i+'" title="Удалить">×</button></div>'});
  h+='<button class="add" data-add="expenses">+ Добавить статью затрат</button></div></section>';

  /* clients */
  cs.sort(function(a,b){return b.pct-a.pct||String(a.c.name).localeCompare(String(b.c.name),'ru')});
  h+='<section><div class="sec-h"><h2>Клиенты ('+N+')</h2><div class="legend"><span class="lg">70–100% хорошо</span><span class="ly">30–69% в работе</span><span class="lr">0–29% отстаёт</span></div></div><div class="card">';
  cs.forEach(function(x,i){
    var c=x.c;var note=x.o.note!=null?x.o.note:(c.problem?(c.problemComment||''):'');
    h+='<div class="cl"><div class="rank">'+(i+1)+'</div><div><div class="name">'+esc(c.name||c.email)+(c.problem?'<span class="tag-risk">риск</span>':'')+'</div><div class="chips">'
      +CHIPS.map(function(k){var st=x.chips[k[0]];return '<span class="chip '+(st===2?'d':st===1?'p':'')+'">'+k[1]+'</span>'}).join('')+'</div></div>'
      +'<div class="barcol"><div class="row-bar">'+bar(x.pct)+pctEd('clients.'+c.id+'.override',x.auto,x.ov)+'</div></div>'
      +'<div class="side"><div><span class="l">Будет готово:</span> '+ed('clients.'+c.id+'.eta',x.o.eta,'укажите срок')+'</div><div class="nt">'+ed('clients.'+c.id+'.note',note,'примечание')+'</div></div></div>';
  });
  h+='</div></section>';
  var app=document.getElementById('app'),y=window.scrollY;app.innerHTML=h;window.scrollTo(0,y);
}

/* ---- persistence ---- */
var toastT;
function toast(msg,err){var t=document.getElementById('toast');t.textContent=msg;t.className='toast on'+(err?' err':'');clearTimeout(toastT);toastT=setTimeout(function(){t.className='toast'},1800)}
var saving=Promise.resolve();
function save(){
  saving=saving.then(function(){return fetch(API+'/api/mba-report',{method:'PUT',headers:{'Content-Type':'application/json','x-dashboard-password':pw},body:JSON.stringify({report:R})})})
   .then(function(r){if(r.status===401){pw='';try{localStorage.removeItem('mba_otchet_pw')}catch(e){}toast('Неверный пароль, изменения не сохранены',true);return}
     if(!r.ok){toast('Не удалось сохранить',true);return}toast('Сохранено ✓')})
   .catch(function(){toast('Нет связи, изменения не сохранены',true)});
}
function ensureAuth(){
  if(pw)return true;
  var p=window.prompt('Пароль для редактирования отчёта:');
  if(!p)return false;pw=p;try{localStorage.setItem('mba_otchet_pw',p)}catch(e){}return true;
}
function normalizeReport(x){
  var d=defaults();x=x&&typeof x==='object'?x:{};
  var r=Object.assign(d,x);
  r.overall=Object.assign(d.overall,x.overall||{});r.tasks=x.tasks||{};r.clients=x.clients||{};
  r.problems=Array.isArray(x.problems)?x.problems:[];
  r.finance=Object.assign(d.finance,x.finance||{});r.finance.expenses=Array.isArray(r.finance.expenses)?r.finance.expenses:[];
  return r;
}

/* ---- editing ---- */
var editing=null;
document.addEventListener('mousedown',function(e){
  var el=e.target.closest('.ed');if(!el||!editing||el===editing)return;
  var path=el.dataset.path;e.preventDefault();finish(editing,true);
  var n=document.querySelector('.ed[data-path="'+path+'"]');if(n&&ensureAuth())startEdit(n);
});
document.addEventListener('click',function(e){
  var el=e.target.closest('.ed');
  if(el){
    if(editing===el)return;
    if(!ensureAuth())return;
    startEdit(el);return;
  }
  var lv=e.target.closest('[data-lvl]');
  if(lv){if(!ensureAuth())return;var i=+lv.dataset.lvl;var order=['c','w','o'];R.problems[i].level=order[(order.indexOf(R.problems[i].level)+1)%3];save();render();return}
  var dl=e.target.closest('[data-del]');
  if(dl){if(!ensureAuth())return;var a=dl.dataset.del.split(':');getP(R,a[0]).splice(+a[1],1);save();render();return}
  var ad=e.target.closest('[data-add]');
  if(ad){if(!ensureAuth())return;
    if(ad.dataset.add==='problems')R.problems.push({text:'',level:'w'});else R.finance.expenses.push({name:'',amount:null});
    save();render();var last=document.querySelectorAll(ad.dataset.add==='problems'?'.prob .ed':'.exp .ed');
    var idx=ad.dataset.add==='problems'?last.length-1:last.length-2;if(last[idx])startEdit(last[idx]);return}
});
function startEdit(el){
  editing=el;var type=el.dataset.type;var cur=getP(R,el.dataset.path);
  if(type==='pct'){el.textContent=typeof cur==='number'?cur:''}
  else if(type==='money'){el.textContent=cur==null||cur===''?'':cur}
  el.setAttribute('contenteditable','true');el.focus();
  var rg=document.createRange();rg.selectNodeContents(el);var sel=window.getSelection();sel.removeAllRanges();sel.addRange(rg);
}
function finish(el,commit){
  if(!el||editing!==el)return;editing=null;el.removeAttribute('contenteditable');
  if(commit){
    var raw=el.textContent.replace(/ /g,' ').trim();var type=el.dataset.type;var v;
    if(type==='pct'){v=raw===''?null:Math.max(0,Math.min(100,Math.round(parseFloat(raw.replace(',','.').replace(/[^\d.]/g,'')))));if(v!=null&&isNaN(v))v=null}
    else if(type==='money'){var d=raw.replace(/[^\d.,]/g,'').replace(',','.');v=d===''?null:parseFloat(d);if(v!=null&&isNaN(v))v=null}
    else v=raw;
    if(JSON.stringify(getP(R,el.dataset.path))!==JSON.stringify(v)){setP(R,el.dataset.path,v);save()}
  }
  render();
}
document.addEventListener('focusout',function(e){if(e.target.classList&&e.target.classList.contains('ed'))finish(e.target,true)});
document.addEventListener('keydown',function(e){
  if(!editing)return;
  if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();finish(editing,true)}
  if(e.key==='Escape'){e.preventDefault();var el=editing;finish(el,false)}
});
document.addEventListener('paste',function(e){if(!editing)return;e.preventDefault();var t=(e.clipboardData||window.clipboardData).getData('text/plain');document.execCommand('insertText',false,t.replace(/\s*\n\s*/g,' '))});

/* ---- load ---- */
Promise.all([
  fetch(API+'/api/crm/clients').then(function(r){return r.json()}),
  fetch(API+'/api/mba-report').then(function(r){return r.json()}).catch(function(){return{report:null}})
]).then(function(res){
  CLIENT=(res[0].clients||[]);R=normalizeReport(res[1].report);render();
}).catch(function(){document.getElementById('app').innerHTML='<div class="loading">Не удалось загрузить данные CRM. Обновите страницу.</div>'});
</script>
